    }

    /* ================================================================== *
     * 14. Pulmonary · cerebral AVM                                         *
     * ================================================================== */
    subgraph cluster_pavm {
        label=<<b>14. Pulmonary · cerebral AVM — embolism and haemorrhage</b><br/><font point-size="9">PAVM ~50% of HHT1; embolisation, never drugs</font>>;
        style="rounded,filled"; fillcolor="#f9ebea"; color="#e6b0aa"; fontsize=11;
