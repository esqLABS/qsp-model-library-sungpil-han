        ISCHSTR  [label="Ischaemic stroke · TIA", fillcolor="#f5b7b1"];
        CAVM     [label="Cerebral AVM S_c (~10%)\nhaemorrhage rate ~0.4-1.0%/year\n(PMID 25858236)", penwidth=2.4, fillcolor="#f5b7b1"];
        ICH      [label="Intracerebral haemorrhage", fillcolor="#f5b7b1"];
        SAVM     [label="Spinal AVM (rare)"];
        POLYCY   [label="Secondary erythrocytosis\n(hypoxic compensation)", fillcolor="#eaeded"];

        BASIN_A -> PAVM [color="#c0392b", penwidth=1.8];
        BASIN_A -> CAVM [color="#c0392b"];
        PAVM -> RLSHUNT [color="#2471a3", penwidth=1.6];
        RLSHUNT -> SPO2 [color="#c0392b", arrowhead=tee, penwidth=1.8];
        RLSHUNT -> PAREMB [color="#c0392b", penwidth=1.6];
        PAREMB -> BRAINABS [color="#c0392b"];
        PAREMB -> ISCHSTR [color="#c0392b"];
