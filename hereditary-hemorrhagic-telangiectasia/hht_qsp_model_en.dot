        PAVM -> SAVM [style=invis];
        SPO2 -> HYPOX [color="#c0392b", arrowhead=tee, penwidth=1.6];
        SPO2 -> POLYCY [color="#e67e22", style=dashed];
        G_ENG -> PAVM [style=dashed, label="HHT1 predominant"];
    }

    /* ================================================================== *
     * 15. ★ Iron metabolism — where the threshold is made                  *
     * ================================================================== */
    subgraph cluster_iron {
        label=<<b>15. ★ Iron flux balance — the origin of the clinical threshold</b><br/><font point-size="9">absorbed − obligatory = 0.0347 × Hb × blood loss</font>>;
        style="rounded,filled"; fillcolor="#fdf2e9"; color="#f5b041"; fontsize=12;
        node [fillcolor="#fceee0"];

        FEDIET   [label="Dietary iron intake ~15 mg/day\nfractional absorption 7% → 35% (demand-dependent)"];
        HEPC     [label="Hepcidin HEP\niron stores · inflammation ↑ / erythroferrone ↓", penwidth=2.4];
        FPN      [label="Ferroportin (duodenum · macrophage)\nthe target of hepcidin"];
        FEABS    [label="Absorbed iron (mg/day)\nabsolute ceiling ≈ 10 mg/day", penwidth=2.4, fillcolor="#f8c471"];
        FEORAL   [label="Oral iron\nabove 65 mg/day is pointless\n(the absorption ceiling saturates)", fillcolor="#f4ecf7"];
        FEIV     [label="Intravenous iron (ferric carboxymaltose)\nbypasses the hepcidin gate", fillcolor="#f4ecf7"];
        FEOBLIG  [label="Obligatory loss ~1 mg/day\ndesquamated epithelium · gut turnover"];
        FELOSS   [label="Iron lost to bleeding\n= 0.0347 × Hb × BLR", penwidth=2.4, fillcolor="#fadbd8"];
        FESTORE  [label="Iron stores FES (ferritin equivalent)\ndepleted first, then Hb falls", penwidth=2.6];
        ERFE     [label="Erythroferrone (ERFE)\nfrom erythroblasts · suppresses hepcidin"];
        CEIL     [label="★ Maximum sustainable bleeding rate\ndiet alone 8.4 · oral 17.8\n· 1 g IV monthly 88.3 mL/day", penwidth=2.8, fillcolor="#f8c471"];
        TSAT     [label="Transferrin saturation · ferritin\n(clinical readout)", fillcolor="#f9e79f"];

        FEDIET -> FEABS [color="#2471a3"];
        FEORAL -> FEABS [color="#8e44ad", style=dashed];
        HEPC -> FPN [color="#c0392b", arrowhead=tee];
        FPN -> FEABS [color="#1a7f37", penwidth=1.6];
        FEIV -> FESTORE [color="#8e44ad", style=dashed, penwidth=1.5];
        FEABS -> FESTORE [color="#2471a3", penwidth=1.6];
        FEOBLIG -> FESTORE [color="#c0392b", arrowhead=tee];
        BLRTOT -> FELOSS [color="#2471a3", penwidth=1.8];
        FELOSS -> FESTORE [color="#c0392b", arrowhead=tee, penwidth=1.8];
        FESTORE -> HEPC [color="#1a7f37"];
        ERFE -> HEPC [color="#c0392b", arrowhead=tee, penwidth=1.6];
        FEABS -> CEIL [color="#e67e22", penwidth=1.8];
        FEOBLIG -> CEIL [color="#e67e22"];
        FESTORE -> TSAT [color="#e67e22"];
        BLRTOT -> CEIL [color="#e67e22", style=dashed, label="above it or below it"];
    }

    /* ================================================================== *
     * 16. Erythropoiesis · anaemia                                         *
     * ================================================================== */
    subgraph cluster_ery {
        label=<<b>16. Erythropoiesis · iron deficiency anaemia</b><br/><font point-size="9">production is iron-FLUX limited, not store limited</font>>;
        style="rounded,filled"; fillcolor="#fdf2e9"; color="#f5b041"; fontsize=11;
        node [fillcolor="#fceee0"];

        EPO      [label="Erythropoietin EPO\nresponds exponentially to falling Hb", penwidth=2.4];
        MARROW   [label="Marrow erythroid capacity\nup to ~6.5×"];
        FERY     [label="Iron available for erythropoiesis\n= recycled + absorbed − obligatory loss + mobilised", penwidth=2.4];
        RECYC    [label="Iron recycled from senescent red cells\nmacrophages · almost lossless"];
        PROD     [label="Red cell production rate\n= min(EPO capacity, iron flux limit)", penwidth=2.6, fillcolor="#f8c471"];
        RETIC    [label="Reticulocyte index RET", penwidth=2.2];
        HB       [label="Haemoglobin HB (g/dL)", penwidth=2.8, fillcolor="#f5b7b1"];
        RBCLIFE  [label="Red cell lifespan ~110 days"];
        TXFUSION [label="Red cell transfusion\ntriggered below Hb 7 g/dL", fillcolor="#f4ecf7"];
        TXDEP    [label="Transfusion dependence\n= the clinically decisive state", penwidth=2.4, fillcolor="#f5b7b1"];
        FATIGUE  [label="Fatigue · reduced exercise capacity\nthe main determinant of quality of life", fillcolor="#f9e79f"];

        HB -> EPO [color="#c0392b", arrowhead=tee, penwidth=1.6];
        EPO -> MARROW [color="#1a7f37"];
        EPO -> ERFE [color="#1a7f37", penwidth=1.6];
        FESTORE -> FERY [color="#2471a3", penwidth=1.6];
        FEABS -> FERY [color="#2471a3"];
        RECYC -> FERY [color="#2471a3"];
        RBCLIFE -> RECYC [color="#2471a3"];
        MARROW -> PROD [color="#1a7f37", penwidth=1.6];
        FERY -> PROD [color="#1a7f37", penwidth=1.8, label="flux limit"];
        PROD -> RETIC [color="#1a7f37"];
        PROD -> HB [color="#2471a3", penwidth=1.8];
        RBCLIFE -> HB [color="#c0392b", arrowhead=tee];
        BLRTOT -> HB [color="#c0392b", arrowhead=tee, penwidth=1.8, label="direct loss"];
        TXFUSION -> HB [color="#8e44ad", style=dashed, penwidth=1.5];
        TXFUSION -> TXDEP [color="#e67e22"];
        CEIL -> TXDEP [color="#e67e22", penwidth=1.8, label="when the ceiling is exceeded"];
        HB -> FATIGUE [color="#e67e22"];
    }

    /* ================================================================== *
     * 17. ★ Cardiac output — the loop from anaemia back to the lesion      *
     * ================================================================== */
    subgraph cluster_cardiac {
        label=<<b>17. ★ Cardiac output · high-output heart failure — where the feedback closes</b><br/><font point-size="9">Hb ↓ → CO ↑ → WSS ↑ → lesion ↑ → bleeding ↑ → Hb ↓</font>>;
        style="rounded,filled"; fillcolor="#fdedec"; color="#e6b0aa"; fontsize=12;
        node [fillcolor="#fadbd8"];

        DO2      [label="Oxygen delivery DO2\n= CO × Hb × 1.34 × SaO2", penwidth=2.4];
        COANEM   [label="Anaemia-compensating cardiac output\nCI = CI_ref·((Hb_ref·Sa_ref)/(Hb·Sa))^0.70", penwidth=2.6, fillcolor="#f5b7b1"];
        CO       [label="Cardiac output CO (L/min)\n= anaemia component + shunt component", penwidth=2.8, fillcolor="#f5b7b1"];
        CI       [label="Cardiac index CI (L/min/m²)\n> 4.0 = high-output state", penwidth=2.6, fillcolor="#f9e79f"];
        PERFP    [label="Perfusion driving pressure (CO_rel)\nproportional to systemic flow", penwidth=2.4];
        LVR      [label="LV remodelling LVR\nvolume load · eccentric hypertrophy", penwidth=2.2];
        RAP      [label="Right atrial pressure · venous congestion\noedema · ascites", penwidth=2.2];
        HOCF     [label="High-output heart failure\nno cure other than liver transplantation", fillcolor="#f5b7b1"];
        AF       [label="Atrial fibrillation (volume load)", fillcolor="#fdebd0"];
        PHTN     [label="Pulmonary hypertension\n(post-capillary · rarely PAH)", fillcolor="#fdebd0"];

        HB -> DO2 [color="#1a7f37", penwidth=1.6];
        SPO2 -> DO2 [color="#1a7f37"];
        DO2 -> COANEM [color="#c0392b", arrowhead=tee, penwidth=1.8, label="defending DO2"];
        COANEM -> CO [color="#2471a3", penwidth=1.8];
        QSHUNT -> CO [color="#2471a3", penwidth=1.8];
        RLSHUNT -> CO [color="#2471a3"];
        CO -> CI [color="#e67e22", penwidth=1.6];
        CO -> PERFP [color="#b03a2e", penwidth=2.0];
        CO -> LVR [color="#1a7f37"];
        CI -> RAP [color="#1a7f37"];
        LVR -> HOCF [color="#c0392b"];
        RAP -> HOCF [color="#c0392b"];
        LVR -> AF [color="#c0392b", style=dashed];
        RAP -> PHTN [color="#c0392b", style=dashed];
        HOCF -> HEPFAIL [style=dashed];
    }
    PERFP -> WSS [color="#b03a2e", penwidth=2.4, label="★ the edge that closes the loop"];

    /* ================================================================== *
     * 18. Bevacizumab PK/PD (systemic vs nasal)                            *
     * ================================================================== */
    subgraph cluster_bev {
        label=<<b>18. Bevacizumab — why systemic works and nasal does not</b><br/><font point-size="9">PMID 22396517 (IV, works) vs 27599328 / 27599329 (topical, futile)</font>>;
        style="rounded,filled"; fillcolor="#f4ecf7"; color="#c39bd3"; fontsize=11;
        node [fillcolor="#ede0f3"];

        BEVIV    [label="Bevacizumab IV 5 mg/kg\nevery 2 weeks × 6"];
        BEVC     [label="Central compartment BEV_C\nCL 0.207 L/day · V1 2.9 L · t½ ~20 days", penwidth=2.4];
        BEVP     [label="Peripheral compartment BEV_P", penwidth=2.2];
        BEVTISS  [label="Tissue interstitial concentration\npartition coefficient KP ≈ 0.055 (IgG)", penwidth=2.2];
        BEVNAS   [label="Nasal spray 25/50/75 mg", fillcolor="#f9ebea"];
        BEVNS    [label="Nasal surface retention BEVN_S\nmucociliary clearance t½ ~15 min (k=66.5/day)", penwidth=2.4, fillcolor="#f9ebea"];
        BEVNT    [label="Submucosal venous plexus BEVN_T\ndelivered fraction F ≈ 1% (149 kDa IgG)", penwidth=2.4, fillcolor="#f9ebea"];
        BEVBIND  [label="1:1 binding to VEGF-A\nKD ≈ 1.1 nM · works by molar excess", penwidth=2.2];
        BEVFAIL  [label="★ The failure of the nasal route, quantified\n75 mg topical exposure ≪ systemic exposure\nnot too small a dose but the wrong route", penwidth=2.4, fillcolor="#f5b7b1"];
        BEVMAINT [label="Maintenance design\n5 mg/kg once monthly recommended\n(PMID 25751241)", fillcolor="#eaf2f8"];

        BEVIV -> BEVC [color="#8e44ad", penwidth=1.6];
        BEVC -> BEVP [dir=both, color="#2471a3"];
        BEVC -> BEVTISS [color="#2471a3", penwidth=1.6];
        BEVNAS -> BEVNS [color="#8e44ad"];
        BEVNS -> BEVNT [color="#2471a3", label="F≈1%"];
        BEVNS -> BEVFAIL [color="#c0392b", style=dashed, label="clearance t½ 15 min"];
        BEVNT -> BEVFAIL [color="#c0392b", style=dashed];
        BEVTISS -> BEVBIND [color="#8e44ad", penwidth=1.6];
        BEVNT -> BEVBIND [color="#8e44ad", style=dashed];
        BEVBIND -> VEGFFREE [color="#c0392b", arrowhead=tee, penwidth=2.0];
        BEVC -> BEVMAINT [style=dashed];
    }

    /* ================================================================== *
     * 19. Pazopanib PK/PD                                                  *
     * ================================================================== */
    subgraph cluster_paz {
        label=<<b>19. Pazopanib — two targets, opposite directions</b><br/><font point-size="9">VEGFR2 benefit vs PDGFRβ penalty → why 50-150 mg, not 800 mg</font>>;
        style="rounded,filled"; fillcolor="#f4ecf7"; color="#c39bd3"; fontsize=11;
        node [fillcolor="#ede0f3"];

        PAZDOSE  [label="Oral pazopanib 50-150 mg/day\n(under 1/5 of the 800 mg oncology dose)"];
