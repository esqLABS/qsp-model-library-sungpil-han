        RLSHUNT  [label="Right-to-left shunt fraction\n→ SpO2 falls", penwidth=2.2];
        SPO2     [label="Arterial oxygen saturation SpO2\n(orthostatic hypoxaemia · platypnea)", penwidth=2.4, fillcolor="#f9e79f"];
        PAREMB   [label="Paradoxical embolism\nloss of capillary filtration", fillcolor="#f5b7b1"];
