        HEPAVM   [label="Hepatic arteriovenous shunt S_h\nhepatic artery → hepatic vein, direct", penwidth=2.6, fillcolor="#f5b7b1"];
        HEPPV    [label="Hepatic artery → portal vein shunt\nthe portal hypertension subtype"];
        HEPBIL   [label="Biliary ischaemia\nthe cholangiopathy subtype", fillcolor="#fdebd0"];
        QSHUNT   [label="Shunt flow Q_shunt (L/min)\n= KSHUNT_H·S_h²", penwidth=2.4];
        NODULAR  [label="Nodular regenerative hyperplasia\n(not cirrhosis)"];
        HEPFAIL  [label="Liver failure · indication for transplantation\n(the only curative treatment)", fillcolor="#f5b7b1"];

        DIRECTAV -> HEPAVM [color="#c0392b"];
        BASIN_A -> HEPAVM [color="#c0392b", penwidth=1.8];
        HEPAVM -> QSHUNT [color="#2471a3", penwidth=1.8];
