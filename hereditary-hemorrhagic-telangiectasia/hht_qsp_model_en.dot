        PAZC     [label="Plasma PAZ_C\nCL 10.1 L/day · V 11.1 L", penwidth=2.4];
        PAZFU    [label="Free fraction fu ≈ 0.05%\n(>99.9% protein bound)"];
        PAZVR2   [label="VEGFR2 inhibition\nIC50 ≈ 1.2 ng/mL (free)", penwidth=2.2, fillcolor="#d4efdf"];
        PAZPDGFR [label="PDGFRβ inhibition\nIC50 ≈ 14 ng/mL (free)", penwidth=2.2, fillcolor="#f5b7b1"];
        PAZNET   [label="★ Reversal of the net effect\nat high dose the loss of mural cell coverage\nerodes the gain from blocking angiogenesis", penwidth=2.4, fillcolor="#f9e79f"];
        PAZKIT   [label="c-Kit · FGFR (secondary targets)"];

        PAZDOSE -> PAZA [color="#8e44ad"];
        PAZA -> PAZC [color="#2471a3"];
        PAZC -> PAZFU [color="#2471a3"];
        PAZFU -> PAZVR2 [color="#8e44ad", penwidth=1.6];
        PAZFU -> PAZPDGFR [color="#8e44ad", penwidth=1.6];
        PAZFU -> PAZKIT [color="#8e44ad", style=dashed];
        PAZVR2 -> VEGFR2 [color="#c0392b", arrowhead=tee, penwidth=2.0];
        PAZPDGFR -> MURAL [color="#c0392b", arrowhead=tee, penwidth=1.8, label="loss of coverage"];
        PAZVR2 -> PAZNET [color="#1a7f37"];
        PAZPDGFR -> PAZNET [color="#c0392b"];
    }

    /* ================================================================== *
     * 20. Immunomodulators (thalidomide class)                             *
     * ================================================================== */
    subgraph cluster_imid {
        label=<<b>20. Pomalidomide · thalidomide — inducing vessel maturation</b><br/><font point-size="9">PATH-HHT (PMID 39292928) · Lebrin 2010 (PMID 20364125)</font>>;
        style="rounded,filled"; fillcolor="#f4ecf7"; color="#c39bd3"; fontsize=11;
        node [fillcolor="#ede0f3"];

        POMDOSE  [label="Pomalidomide 4 mg/day\nthe basis of the PATH-HHT approval"];
        THALDOSE [label="Thalidomide 50-200 mg/day\n(the precursor drug · limited by neuropathy)"];
        POMA     [label="Absorption compartment POM_A", penwidth=2.2];
        POMC     [label="Plasma POM_C\nCL 168 L/day · t½ ~6 h", penwidth=2.4];
        CRBN     [label="Cereblon (CRBN) E3 ligase\nrewires substrate degradation"];
        POMPDGF  [label="Increased PDGF-B expression\n→ mural cell recruitment", penwidth=2.2, fillcolor="#d4efdf"];
        POMVEGF  [label="Modest fall in VEGF production\n(a secondary effect)", fillcolor="#d4efdf"];
        POMMECH  [label="★ The mechanistic distinction\nit does not shrink the lumen but\nmatures the vessel and so lowers fragility", penwidth=2.4, fillcolor="#f9e79f"];

        POMDOSE -> POMA [color="#8e44ad"];
        THALDOSE -> POMA [color="#8e44ad", style=dashed];
        POMA -> POMC [color="#2471a3"];
        POMC -> CRBN [color="#8e44ad"];
        CRBN -> POMPDGF [color="#1a7f37", penwidth=1.6];
        CRBN -> POMVEGF [color="#c0392b"];
        POMPDGF -> PDGFB [color="#1a7f37", penwidth=2.0];
        POMVEGF -> VEGFA [color="#c0392b", arrowhead=tee, penwidth=1.6];
        POMPDGF -> POMMECH [style=dashed];
    }

    /* ================================================================== *
     * 21. Tranexamic acid · topical · procedures                           *
     * ================================================================== */
    subgraph cluster_other {
        label=<<b>21. Tranexamic acid · topical therapy · procedures</b><br/><font point-size="9">what each can and cannot reach</font>>;
        style="rounded,filled"; fillcolor="#f4ecf7"; color="#c39bd3"; fontsize=11;
        node [fillcolor="#ede0f3"];

        TXADOSE  [label="Oral tranexamic acid 3 g/day\n(1 g three times daily)"];
        TXAC     [label="Plasma TXA_C\nCss ≈ 11 µg/mL", penwidth=2.4];
        TXAINH   [label="Plasmin inhibition\nIC50 6 µg/mL · Imax 0.92", penwidth=2.2];
        TXATOP   [label="Topical TXA 40 mg/day\nsystemic exposure negligible → ineffective", fillcolor="#f9ebea"];
        LASER    [label="Nasal laser ablation · KTP\nlocal reduction in lesion number"];
        SEPTO    [label="Septal dermoplasty · Young's procedure\nrefractory epistaxis"];
        HYDROGEL [label="Nasal hydrogel · moisturising therapy\nless mucosal trauma"];
        EMBOL    [label="Coil embolisation of a pulmonary AVM\n★ the only means that removes the flow itself", penwidth=2.4, fillcolor="#d4efdf"];
        LTX      [label="Liver transplantation\nthe definitive treatment for high-output heart failure", fillcolor="#d4efdf"];
        ESTRO    [label="Oestrogen · bazedoxifene\ninduces mucosal keratinisation (weak evidence)", fillcolor="#eaeded"];
        TIMOLOL  [label="Timolol nasal gel (negative trial)", fillcolor="#eaeded"];

        TXADOSE -> TXAC [color="#8e44ad"];
        TXATOP -> TXAC [color="#8e44ad", style=dashed, label="≈0"];
        TXAC -> TXAINH [color="#8e44ad", penwidth=1.6];
        TXAINH -> PLASMIN [color="#c0392b", arrowhead=tee, penwidth=2.0];
        LASER -> NLES [color="#c0392b", arrowhead=tee, penwidth=1.6];
        SEPTO -> NASMUC [color="#c0392b", arrowhead=tee];
        HYDROGEL -> NASTRAUM [color="#c0392b", arrowhead=tee];
        EMBOL -> PAVM [color="#c0392b", arrowhead=tee, penwidth=2.0];
        LTX -> HEPAVM [color="#c0392b", arrowhead=tee, penwidth=1.8];
        ESTRO -> NASMUC [style=dashed];
        TIMOLOL -> NASMUC [style=dashed];
    }

    /* ================================================================== *
     * 22. Clinical endpoints · scores · adverse events                     *
     * ================================================================== */
    subgraph cluster_end {
        label=<<b>22. Clinical endpoints · scores · adverse events</b><br/><font point-size="9">ESS (Hoag) · MED · HHT-QOL · Curaçao</font>>;
        style="rounded,filled"; fillcolor="#fef9e7"; color="#f4d03f"; fontsize=11;
        node [fillcolor="#fcf3cf"];

        ESS      [label="Epistaxis Severity Score ESS (0-10)\n6 domains: frequency·duration·intensity·healthcare use·transfusion·anaemia\nMCID = 0.71 (PMID 26393959)", penwidth=2.8, fillcolor="#f9e79f"];
        ESSDOM   [label="ESS domain composition\nF(frequency) D(duration) I(intensity)\nA(healthcare use) T(transfusion) AN(anaemia)"];
        HHTQOL   [label="HHT-specific quality of life (0-16)\n(PMID 35877137)", penwidth=2.4, fillcolor="#f9e79f"];
        NOSEHHT  [label="NOSE HHT score (alternative instrument)", fillcolor="#fdf6e3"];
        CURACAO  [label="The four Curaçao criteria\nepistaxis · telangiectasia · visceral lesions · family history"];
        TXBURDEN [label="Transfusion · intravenous iron requirement\n(the threshold endpoint)", penwidth=2.4, fillcolor="#f9e79f"];
        IRONINDEP[label="★ Iron independence\n= the endpoint a continuous score cannot show", penwidth=2.6, fillcolor="#f8c471"];
        AE_HTN   [label="Hypertension (bevacizumab · pazopanib)", fillcolor="#fadbd8"];
        AE_PROT  [label="Proteinuria (anti-VEGF)", fillcolor="#fadbd8"];
        AE_ALT   [label="Raised liver enzymes (pazopanib)", fillcolor="#fadbd8"];
        AE_NEUT  [label="Neutropenia (pomalidomide)", fillcolor="#fadbd8"];
        AE_CONST [label="Constipation · rash (pomalidomide)", fillcolor="#fadbd8"];
        AE_VTE   [label="Venous thrombosis risk (IMiD · TXA)", fillcolor="#fadbd8"];
        AE_NEURO [label="Peripheral neuropathy (thalidomide)", fillcolor="#fadbd8"];
        AE_WOUND [label="Delayed wound healing · perforation (anti-VEGF)", fillcolor="#fadbd8"];

        MED -> ESS [color="#e67e22", penwidth=1.6];
        EVRATE -> ESSDOM [color="#e67e22"];
        EVDUR -> ESSDOM [color="#e67e22"];
        EVRATE2 -> ESSDOM [color="#e67e22"];
        HB -> ESSDOM [color="#e67e22", penwidth=1.6];
        TXFUSION -> ESSDOM [color="#e67e22"];
        ESSDOM -> ESS [color="#e67e22", penwidth=1.8];
        ESS -> HHTQOL [color="#e67e22", penwidth=1.6];
        ESS -> NOSEHHT [style=dashed];
        CURACAO -> ESS [style=invis];
        TXFUSION -> TXBURDEN [color="#e67e22"];
        FEIV -> TXBURDEN [color="#e67e22", style=dashed];
        CEIL -> IRONINDEP [color="#e67e22", penwidth=2.0];
        TXBURDEN -> IRONINDEP [color="#e67e22", penwidth=1.6];
        BEVC -> AE_HTN [color="#c0392b", style=dashed];
        PAZC -> AE_HTN [color="#c0392b", style=dashed];
        BEVC -> AE_PROT [color="#c0392b", style=dashed];
        BEVC -> AE_WOUND [color="#c0392b", style=dashed];
        PAZC -> AE_ALT [color="#c0392b", style=dashed];
        POMC -> AE_NEUT [color="#c0392b", style=dashed];
        POMC -> AE_CONST [color="#c0392b", style=dashed];
        POMC -> AE_VTE [color="#c0392b", style=dashed];
        TXAC -> AE_VTE [color="#c0392b", style=dashed];
        THALDOSE -> AE_NEURO [color="#c0392b", style=dashed];
    }

    BLRTOT -> ESS [style=invis];
    SPO2 -> ESS [style=invis];
}
