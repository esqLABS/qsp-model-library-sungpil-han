/* ============================================================================
   X-linked Adrenoleukodystrophy (X-ALD) — QSP mechanistic map
   X-linked adrenoleukodystrophy · mechanistic map

   ORGANISING THESIS (organising principle)
   -----------------------------------------------------------------------------
   One lesion (ABCD1 loss) -> TWO INDEPENDENT VARIABLES:

     (1) VLCFA accumulation      : deterministic, dose-graded, MEASURABLE,
                                   and reachable from the periphery.
     (2) Cerebral inflammation   : BISTABLE (a switch, not a rate),
                                   UNMEASURABLE until MRI, and reachable
                                   ONLY from inside the CNS.

   The coupling (1) -> (2) is drawn as a THRESHOLD gated by a stochastic
   susceptibility term, not as a rate constant.  That single structural
   choice is why:

     * plasma C26:0 does not predict phenotype (brothers, identical
       mutation, CCALD at 6 vs pure AMN at 40);
     * Lorenzo's oil normalises the biomarker and does not stop the disease
       (it cannot cross the BBB and it does not touch variable 2);
     * HSCT / eli-cel stops the disease and barely moves the biomarker
       (it replaces microglia, i.e. variable 2, and does not touch 1);
     * the ~12-18 month post-transplant "lag window" exists at all
       (microglial replacement is slow; the switch keeps running).

   THE DRUG THAT FIXES THE BIOMARKER DOES NOT FIX THE DISEASE, AND THE DRUG
   THAT FIXES THE DISEASE DOES NOT FIX THE BIOMARKER.

   Nodes 169 · Edges 265 · Clusters 19 (18 mechanism + 1 legend)
   Render:  dot -Tsvg xald_qsp_model.dot -o xald_qsp_model_en.svg
            dot -Tpng -Gdpi=150 xald_qsp_model.dot -o xald_qsp_model_en.png
   ========================================================================== */

digraph XALD_QSP {
    graph [rankdir=TB, splines=spline, overlap=false, nodesep=0.28,
           ranksep=0.55, compound=true, concentrate=false,
           fontname="NanumGothic", fontsize=13, labelloc="t",
           bgcolor="white", pad=0.4,
           label=<<b>X-linked Adrenoleukodystrophy (X-ALD) — Quantitative Systems Pharmacology map</b><br/>
<i>X-linked Adrenoleukodystrophy · Quantitative Systems Pharmacology map</i><br/>
<font point-size="11">One lesion (ABCD1 loss), two independent variables — measurable VLCFA accumulation (reachable from the periphery) vs unmeasurable bistable cerebral inflammation switch (reachable only from inside the CNS)</font><br/>
<font point-size="10">169 nodes · 265 edges · 18 mechanism clusters</font>>];

    node [shape=box, style="rounded,filled", fontname="NanumGothic",
          fontsize=10, margin="0.10,0.055", penwidth=1.0, color="#555555"];
    edge [fontname="NanumGothic", fontsize=8, arrowsize=0.65,
          color="#666666", penwidth=1.0];

    /* ---------- edge semantics legend --------------------------------- */
    subgraph cluster_legend {
        label=<<b>Legend</b>>;
        style="rounded,filled"; fillcolor="#fafafa"; color="#bbbbbb";
        fontsize=11;
        node [shape=plaintext, style="", fillcolor="none", fontsize=9];
        LEG [label=<<table border="0" cellborder="0" cellspacing="1">
<tr><td align="left"><font color="#1a7f37">━━▶</font></td><td align="left">activation / promotion</td></tr>
<tr><td align="left"><font color="#c0392b">━━⊣</font></td><td align="left">inhibition / blockade</td></tr>
<tr><td align="left"><font color="#8e44ad">┅┅▶</font></td><td align="left">drug action</td></tr>
<tr><td align="left"><font color="#e67e22">━━▶</font></td><td align="left">clinical readout</td></tr>
<tr><td align="left"><font color="#2471a3">━━▶</font></td><td align="left">mass flux / transport</td></tr>
<tr><td align="left"><b>bold border</b></td><td align="left">ODE state variable</td></tr>
</table>>];
    }

    /* ================================================================== *
     * 1. Gene · transcription · vector                                   *
     * ================================================================== */
    subgraph cluster_gene {
        label=<<b>1. ABCD1 gene · paralogue redundancy · gene-therapy vector</b><br/><i>Gene, paralogue redundancy, vector</i>>;
        style="rounded,filled"; fillcolor="#eef4fb"; color="#7fa8d4"; fontsize=11;
        node [fillcolor="#d6e6f7"];

        ABCD1     [label="ABCD1 gene (Xq28)\nABCD1 locus"];
        MUT       [label="900+ pathogenic variants\nmissense·nonsense·frameshift·del"];
        ALDP      [label="ALDP half-transporter\n(ABCD1 protein, dimer)", penwidth=2.2];
        ALDPD     [label="ALDP loss of function\n(unstable·misfolded·absent)", penwidth=2.2, fillcolor="#f7d6d6"];
        ABCD2     [label="ABCD2 / ALDRP\nparalogue — partly redundant", penwidth=2.2];
        ABCD3     [label="ABCD3 / PMP70"];
        PEXMEM    [label="peroxisomal membrane integrity\nperoxisome membrane"];
        LENTID    [label="Lenti-D lentivirus\nABCD1 cDNA vector"];
        VCN       [label="vector copy number VCN\n(copies/genome)", penwidth=2.2];
        XINACT    [label="X-inactivation bias\nskewed X-inactivation"];
        MOSAIC    [label="fraction of ALDP-deficient cells\n(female carrier mosaicism)", penwidth=2.2];
        CROSSC    [label="intercellular metabolic complementation\nmetabolic cross-correction"];
    }

    /* ================================================================== *
     * 2. Peroxisomal β-oxidation vs microsomal elongation — mass balance *
     * ================================================================== */
    subgraph cluster_perox {
        label=<<b>2. VLCFA mass balance — peroxisomal degradation vs ELOVL1 elongation</b><br/><i>Peroxisomal degradation vs microsomal elongation</i>>;
        style="rounded,filled"; fillcolor="#eefbf3"; color="#63b98a"; fontsize=11;
        node [fillcolor="#d3f0e0"];

        DIET      [label="dietary VLCFA input\n(~20% of total)"];
        DENOVO    [label="endogenous de novo elongation\n(~80% — the dominant input)"];
        ELOVL1    [label="ELOVL1 elongase\nC22:0→C24:0→C26:0", penwidth=2.2];
        ELONG     [label="elongation flux", penwidth=2.2];
        ACSVL1    [label="ACSVL1 / SLC27A2\nVLCFA→VLCFA-CoA activation"];
        VLCFACOA  [label="cytosolic VLCFA-CoA pool\nC24:0/C26:0-CoA", penwidth=2.2];
        IMPORT    [label="import into the peroxisome\n(the step absolutely ALDP-dependent)", penwidth=2.2, fillcolor="#f9e5c4"];
        ACOX1     [label="ACOX1 acyl-CoA oxidase"];
        DBP       [label="D-bifunctional protein (HSD17B4)"];
        SCPX      [label="SCPx thiolase"];
        BETAOX    [label="peroxisomal β-oxidation flux", penwidth=2.2];
        SREBP     [label="SREBP / lipogenic transcription"];
    }

    /* ================================================================== *
     * 3. VLCFA tissue distribution · lipid species                       *
     * ================================================================== */
    subgraph cluster_lipid {
        label=<<b>3. VLCFA tissue accumulation and lipid species (lipidome)</b><br/><i>Tissue distribution and lipid species</i>>;
        style="rounded,filled"; fillcolor="#fdf6e9"; color="#d9a94c"; fontsize=11;
        node [fillcolor="#faeaca"];

        C26PL     [label="plasma C26:0\nnormal 0.35 → ALD 1.3 μmol/L", penwidth=2.2, fillcolor="#f6d98a"];
        C26LPC    [label="C26:0-lysoPC\n(DBS screening marker, ~10-fold)", penwidth=2.2, fillcolor="#f6d98a"];
        C24C22    [label="C24:0/C22:0 ratio\n(supporting diagnostic index)"];
        C26CE     [label="cholesteryl ester-C26:0\n(storage form in adrenal·brain)", penwidth=2.2];
        C26GANG   [label="ganglioside-C26:0"];
        C26PC     [label="membrane phospholipid-C26:0\n(PC/PE acyl chain)", penwidth=2.2];
        C26ADR    [label="adrenocortical VLCFA", penwidth=2.2];
        C26BR     [label="cerebral white matter VLCFA", penwidth=2.2];
        C26SC     [label="spinal cord white matter VLCFA", penwidth=2.2];
        C26TEST   [label="testicular VLCFA"];
        MEMB      [label="reduced membrane fluidity\nmicrodomain (raft) disruption", penwidth=2.2];
        LAMEL     [label="lamellar cytoplasmic inclusions\nlamellar inclusions"];
    }

    /* ================================================================== *
     * 4. Cellular stress — oxidative · mitochondrial · autophagy         *
     * ================================================================== */
    subgraph cluster_stress {
        label=<<b>4. Cellular stress — mitochondria · ROS · autophagy · Nrf2</b><br/><i>Redox and organelle stress</i>>;
        style="rounded,filled"; fillcolor="#fdeeee"; color="#d98080"; fontsize=11;
        node [fillcolor="#f9d8d8"];

        MITO      [label="mitochondrial membrane depolarisation", penwidth=2.2];
        NOX       [label="NADPH oxidase (NOX2)"];
        ROS       [label="ROS / oxidative stress", penwidth=2.2];
        OXPROT    [label="oxidised protein·8-OHdG\n(already raised pre-symptomatically)"];
        CA        [label="collapse of intracellular Ca²⁺ homeostasis", penwidth=2.2];
        ER        [label="ER stress / UPR"];
        AUTOPH    [label="autophagic flux blocked\n(autophagy block)", penwidth=2.2];
        NRF2      [label="Nrf2-ARE antioxidant response\n(attenuated in X-ALD)", penwidth=2.2];
        SIRT1     [label="SIRT1 / PGC-1α\nmitochondrial biogenesis"];
        ATPX      [label="axonal ATP deficit", penwidth=2.2];
    }

    /* ================================================================== *
     * 5. Adrenocortical axis — the third independent axis                *
     * ================================================================== */
    subgraph cluster_adrenal {
        label=<<b>5. Adrenocortical axis — a third axis entirely independent of the CNS</b><br/><i>Adrenocortical axis: an independent third axis</i>>;
        style="rounded,filled"; fillcolor="#f3eefb"; color="#9b7fd4"; fontsize=11;
        node [fillcolor="#e2d6f7"];

        CRH       [label="hypothalamic CRH"];
        ACTHP     [label="pituitary ACTH", penwidth=2.2, fillcolor="#cfc0f0"];
        MC2R      [label="MC2R / MRAP receptor\n(membrane microdomain dependent)", penwidth=2.2];
        STAR      [label="StAR cholesterol transport"];
        STEROID   [label="steroidogenic flux", penwidth=2.2];
        ADMASS    [label="functional adrenocortical mass", penwidth=2.2, fillcolor="#cfc0f0"];
        CORT      [label="cortisol", penwidth=2.2, fillcolor="#cfc0f0"];
        ALDOS     [label="aldosterone", penwidth=2.2];
        RENIN     [label="raised renin-angiotensin reactivity", penwidth=2.2];
        NAK       [label="Na⁺ loss · K⁺ rise\nhypotension · dehydration"];
        MSH       [label="POMC / α-MSH\n→ skin·mucosal hyperpigmentation"];
        ADCRISIS  [label="adrenal crisis\n— often the first presentation", fillcolor="#f5b7b1"];
        ACTHTESTR [label="peak cortisol on ACTH stimulation\n< 500 nmol/L = adrenal insufficiency"];
    }

    /* ================================================================== *
     * 6. Testis · other endocrine                                        *
     * ================================================================== */
    subgraph cluster_gonad {
        label=<<b>6. Testicular axis</b><br/><i>Testicular axis</i>>;
        style="rounded,filled"; fillcolor="#f3eefb"; color="#9b7fd4"; fontsize=11;
        node [fillcolor="#e8dff8"];

        LEYDIG    [label="Leydig cell function", penwidth=2.2];
        LH        [label="LH rise (compensatory)"];
        TESTO     [label="testosterone", penwidth=2.2];
        HYPOG     [label="reduced sexual function · erectile dysfunction"];
        SPERM     [label="impaired spermatogenesis"];
    }

    /* ================================================================== *
     * 7. Microglia — the trigger of the switch                           *
     * ================================================================== */
    subgraph cluster_mgl {
        label=<<b>7. Microglia — they die before demyelination (a pre-lesional event)</b><br/><i>Microglia: apoptosis PRECEDES demyelination</i>>;
        style="rounded,filled"; fillcolor="#eaf6f8"; color="#5aa9b8"; fontsize=11;
        node [fillcolor="#cfeaf0"];

        MGL       [label="ALDP-deficient resident microglia", penwidth=2.2, fillcolor="#aadbe6"];
        TREM2     [label="TREM2 / lipid-sensing signalling"];
        MGLPHAG   [label="capacity to phagocytose myelin debris", penwidth=2.2];
        MGLAP     [label="microglial apoptosis\n(pre-lesional stage)", penwidth=2.2, fillcolor="#f5b7b1"];
        MGLDEP    [label="microglial depletion around the lesion\nperi-lesional depletion", penwidth=2.2];
        MGLPRO    [label="switch to a pro-inflammatory phenotype\n(pro-inflammatory switch)", penwidth=2.2];
        DEBRIS    [label="accumulation of uncleared myelin debris", penwidth=2.2];
    }

    /* ================================================================== *
     * 8. Self-amplifying neuroinflammatory loop — the bistable core      *
     * ================================================================== */
    subgraph cluster_inflam {
        label=<<b>8. Self-amplifying neuroinflammatory loop — what the bistable switch actually is</b><br/><i>Self-amplifying loop = the bistable core</i>>;
        style="rounded,filled"; fillcolor="#fdecec"; color="#cc5555"; fontsize=11;
        node [fillcolor="#fad4d4"];

        TNFA      [label="TNF-α", penwidth=2.2];
        IL1B      [label="IL-1β", penwidth=2.2];
        MCP1      [label="CCL2 / MCP-1", penwidth=2.2];
        IFNG      [label="IFN-γ"];
        INOS      [label="iNOS / NO·peroxynitrite"];
        MONOIN    [label="peripheral monocyte infiltration", penwidth=2.2];
        CD8T      [label="CD8⁺ cytotoxic T infiltration", penwidth=2.2];
        PERF      [label="perforin / granzyme cytotoxicity"];
        MMP9      [label="MMP-9 (basement membrane degradation)"];
        COMPL     [label="complement activation (C3d/C9)"];
        ASTRO     [label="reactive astrocytes", penwidth=2.2];
        LOOP      [label="◆ self-amplifying loop gain\nG > 1 and it cannot be reversed",
                   shape=octagon, penwidth=3.0, fillcolor="#e74c3c", fontcolor="white"];
    }

    /* ================================================================== *
     * 9. Blood-brain barrier                                             *
     * ================================================================== */
    subgraph cluster_bbb {
        label=<<b>9. Blood-brain barrier — the line drugs cannot cross</b><br/><i>The line most drugs cannot cross</i>>;
        style="rounded,filled"; fillcolor="#eef0fb"; color="#7f88d4"; fontsize=11;
        node [fillcolor="#d8dcf7"];

        TJ        [label="tight junctions (claudin-5·occludin)", penwidth=2.2];
        BBBP      [label="BBB permeability", penwidth=2.2, fillcolor="#c2c8f0"];
        VEGF      [label="VEGF / vascular permeability factor"];
        GDENH     [label="gadolinium enhancement\n(the only in-vivo marker of an active lesion)", penwidth=2.2, fillcolor="#f6d98a"];
        PERIV     [label="perivascular lymphocytic infiltration (cuffing)"];
    }

    /* ================================================================== *
     * 10. Myelin · axons (cerebral)                                      *
     * ================================================================== */
    subgraph cluster_myelin {
        label=<<b>10. Cerebral myelin · axons — the Schaumburg three-zone lesion</b><br/><i>Cerebral myelin and axons</i>>;
        style="rounded,filled"; fillcolor="#f0f0f0"; color="#888888"; fontsize=11;
        node [fillcolor="#e0e0e0"];

        OLG       [label="oligodendrocyte pool", penwidth=2.2];
        OLGAP     [label="oligodendrocyte death", penwidth=2.2];
        MYE       [label="cerebral myelin content", penwidth=2.2, fillcolor="#cccccc"];
        DEMY      [label="demyelinated volume", penwidth=2.2, fillcolor="#cccccc"];
        ZONE      [label="three-zone structure\ncentral scar / active inflammation / outer demyelination"];
        SPLENIUM  [label="splenium of the corpus callosum\n— where the lesion starts (80%)"];
        FRONTAL   [label="frontal-predominant subtype (~15%)"];
        AXBR      [label="cerebral axonal integrity", penwidth=2.2];
        GLIOSIS   [label="glial scarring (gliosis)", penwidth=2.2];
    }

    /* ================================================================== *
     * 11. Spinal cord axonopathy (AMN)                                   *
     * ================================================================== */
    subgraph cluster_cord {
        label=<<b>11. Spinal cord axonopathy (AMN) — length-dependent dying-back</b><br/><i>Adrenomyeloneuropathy: length-dependent axonopathy</i>>;
        style="rounded,filled";
        fillcolor="#eef8ee"; color="#77b877"; fontsize=11;
        node [fillcolor="#d5edd5"];

        CST       [label="corticospinal tract", penwidth=2.2];
        DC        [label="dorsal columns", penwidth=2.2];
        LENGTH    [label="length-dependent vulnerability\n(the longest axons first)"];
        DISTAX    [label="distal axonal degeneration (dying-back)", penwidth=2.2];
        MYESC     [label="spinal cord myelin (secondary loss)", penwidth=2.2];
        SPAST     [label="spasticity · gait disturbance"];
        BLADDER   [label="bladder · bowel dysfunction"];
        PERIPH    [label="peripheral nerve involvement (mild)"];
    }

    /* ================================================================== *
     * 12. Phenotype determination — why brothers get different diseases  *
     * ================================================================== */
    subgraph cluster_pheno {
        label=<<b>12. Phenotype determination — same mutation, different disease (the model's central claim)</b><br/><i>Phenotype determination: same mutation, different disease</i>>;
        style="rounded,filled"; fillcolor="#fff4e6"; color="#e08a2e"; fontsize=11;
        node [fillcolor="#ffe0b8"];

        SWITCH    [label="◆ cerebral conversion switch (threshold)\nVLCFA is necessary, not sufficient",
                   shape=doubleoctagon, penwidth=3.0, fillcolor="#e67e22", fontcolor="white"];
        SUSC      [label="susceptibility coefficient\nmodifier genes + environment + chance", penwidth=2.2, fillcolor="#ffd08a"];
        MODGEN    [label="candidate modifier genes\n(immune·redox·lipid pathways)"];
        HEADTR    [label="head trauma · infection\n(reported to trigger conversion)"];
        CONCORD   [label="monozygotic twin discordance\n= genes alone do not decide it"];
        NOCORR    [label="◆ plasma C26:0 ↔ phenotype: no correlation\n(the largest negative result in this disease)",
                   shape=note, penwidth=2.4, fillcolor="#fdebd0"];
        CCALD     [label="childhood cerebral form (CCALD)\n~35-40%, onset at age 4-8", penwidth=2.2, fillcolor="#f5b7b1"];
        AMN       [label="AMN (adult spinal form)\n20s-40s, a course of decades", penwidth=2.2];
        AMNCONV   [label="AMN → cerebral conversion\n~20% of adult AMN", penwidth=2.2, fillcolor="#f5b7b1"];
        ADDIONLY  [label="Addison-only form\n(first phenotype in childhood)"];
        FEMALE    [label="female carrier spinal form\n~80% by age 60", penwidth=2.2];
    }

    /* ================================================================== *
     * 13. Clinical readouts                                              *
     * ================================================================== */
    subgraph cluster_clin {
        label=<<b>13. Clinical endpoints</b><br/><i>Clinical endpoints</i>>;
        style="rounded,filled"; fillcolor="#fdeef7"; color="#c07fa8"; fontsize=11;
        node [fillcolor="#f7d6e8", shape=box];

        LOES      [label="Loes MRI severity (0-34)", penwidth=2.2];
        NFS       [label="neurological function score NFS (0-25)", penwidth=2.2];
        MFD       [label="major functional disability MFD (6 items)", penwidth=2.2];
        SURV      [label="MFD-free survival", penwidth=2.2];
        EDSS      [label="EDSS / SSPROM (spinal form)", penwidth=2.2];
        SIXMWT    [label="6-minute walk distance (6MWT)"];
        COGN      [label="cognitive·behavioural decline (ADHD-like early on)"];
        VISUAL    [label="visual · auditory decline"];
        SEIZ      [label="seizures"];
        DEATH     [label="death / vegetative state", fillcolor="#e74c3c", fontcolor="white"];
    }

    /* ================================================================== *
     * 14. Newborn screening · diagnosis                                  *
     * ================================================================== */
    subgraph cluster_dx {
        label=<<b>14. Newborn screening · surveillance (early diagnosis is what creates the only therapeutic window)</b><br/><i>Newborn screening and surveillance</i>>;
        style="rounded,filled"; fillcolor="#e9f7f4"; color="#4aa899"; fontsize=11;
        node [fillcolor="#cfeee7"];

        NBS       [label="newborn screening DBS\nC26:0-lysoPC", penwidth=2.2];
        RUSP      [label="RUSP listing (USA 2016)"];
        ABCD1SEQ  [label="confirmation by ABCD1 sequencing"];
        MRISURV   [label="MRI surveillance every 6-12 months", penwidth=2.2];
        ACTHTEST  [label="ACTH stimulation test 1-2×/year"];
        WINDOW    [label="◆ therapeutic window\nLoes ≤ 9 · NFS ≤ 1",
                   shape=octagon, penwidth=2.6, fillcolor="#48c9b0"];
        FALSEPOS  [label="false positive/indeterminate (ACOX1·PEX etc.)"];
    }

    /* ================================================================== *
     * 15. Metabolism-targeting drugs — reach the periphery only          *
     * ================================================================== */
    subgraph cluster_drugmet {
        label=<<b>15. Metabolism-targeting drugs — they reach variable (1) only</b><br/><i>Metabolic drugs: reach variable (1) only</i>>;
        style="rounded,filled"; fillcolor="#f5eafd"; color="#a05fd0"; fontsize=11;
        node [fillcolor="#e7d0f7", shape=box, style="filled,rounded,bold"];

        LO        [label="Lorenzo's oil\nGTE:GTO 4:1 (oral)", penwidth=2.2];
        ERUC      [label="erucic acid C22:1\n(plasma, the active component)", penwidth=2.2];
        OLEIC     [label="oleic acid C18:1"];
        COMPINH   [label="competitive inhibition of ELOVL1\n(substrate competition)", penwidth=2.2];
        LOBBB     [label="⊘ does not cross the BBB\nno change in brain VLCFA",
                   shape=note, fillcolor="#f5b7b1", penwidth=2.2];
        ELOVLI    [label="direct ELOVL1 inhibitor\n(preclinical)"];
        BEZA      [label="bezafibrate (attempted ABCD2 induction)"];
        SOBE      [label="sobetirome / Sob-AM2\nCNS-penetrant thyromimetic", penwidth=2.2];
        PBA       [label="4-phenylbutyrate (ABCD2 induction)"];
        LOWFAT    [label="VLCFA-restricted diet (blocks dietary input)"];
    }

    /* ================================================================== *
     * 16. CNS-penetrant · anti-inflammatory drugs                        *
     * ================================================================== */
    subgraph cluster_drugcns {
        label=<<b>16. CNS-penetrant · anti-inflammatory drugs — aimed at variable (2)</b><br/><i>CNS-penetrant / anti-inflammatory: aimed at variable (2)</i>>;
        style="rounded,filled"; fillcolor="#eaf2fd"; color="#5f8fd0"; fontsize=11;
        node [fillcolor="#d0e0f7", style="filled,rounded,bold"];

        LERI      [label="leriglitazone (MIN-102)\nplasma", penwidth=2.2];
        LERIB     [label="leriglitazone brain exposure\n(designed for CNS penetration)", penwidth=2.2];
        PPARG     [label="PPARγ activation", penwidth=2.2];
        DMF       [label="dimethyl fumarate (Nrf2)"];
        NAC       [label="triple antioxidant\nNAC + α-tocopherol + lipoic acid"];
        STEROIDX  [label="⊘ high-dose steroids\nfail to halt cerebral progression",
                   shape=note, fillcolor="#f5b7b1"];
        IMMSUPX   [label="⊘ conventional immunosuppression\nfails to suppress CCALD",
                   shape=note, fillcolor="#f5b7b1"];
    }

    /* ================================================================== *
     * 17. HSCT / gene therapy — the only real fix for variable (2)       *
     * ================================================================== */
    subgraph cluster_hsct {
        label=<<b>17. HSCT / autologous gene therapy — it replaces microglia, not metabolism</b><br/><i>HSCT / ex-vivo gene therapy: replaces microglia, not metabolism</i>>;
        style="rounded,filled"; fillcolor="#e9f0f7"; color="#4a7fb8"; fontsize=11;
        node [fillcolor="#cfdff0"];

        CD34      [label="autologous CD34⁺ collection (mobilisation)"];
        TRANSD    [label="Lenti-D ex-vivo transduction"];
        ALLOHSCT  [label="allogeneic HSCT (sibling/unrelated)"];
        BUSU      [label="busulfan conditioning\n(AUC-targeted)", penwidth=2.2];
        MYELOAB   [label="myeloablation", penwidth=2.2];
        NEUT      [label="neutrophil engraftment (median ~13 days)", penwidth=2.2];
        HSCE      [label="engraftment of corrected haematopoietic stem cells", penwidth=2.2];
        MONOCH    [label="peripheral monocyte chimerism", penwidth=2.2];
        MGLREP    [label="microglial replacement\n(half-life months to years — slow)", penwidth=2.2, fillcolor="#f9e5c4"];
        LAG       [label="◆ 12-18 month therapeutic lag window\nLoes keeps rising after transplant",
                   shape=octagon, penwidth=2.8, fillcolor="#e67e22", fontcolor="white"];
        GVHD      [label="graft-versus-host disease (allogeneic only)", fillcolor="#f5b7b1"];
        CLONAL    [label="insertional mutagenesis clonal expansion", penwidth=2.2, fillcolor="#f5b7b1"];
        MDS       [label="MDS / AML (observed safety signal)", fillcolor="#e74c3c", fontcolor="white"];
        TRM       [label="transplant-related mortality", fillcolor="#f5b7b1"];
    }

    /* ================================================================== *
     * 18. Hormone replacement — fixes the adrenal, not the CNS           *
     * ================================================================== */
    subgraph cluster_horm {
        label=<<b>18. Hormone replacement — it reverses the adrenal axis only</b><br/><i>Replacement: reverses the adrenal axis only</i>>;
        style="rounded,filled"; fillcolor="#f7f2e9" ; color="#b89a5a"; fontsize=11;
        node [fillcolor="#eee0c4", style="filled,rounded,bold"];

        HC        [label="hydrocortisone (oral/emergency IV)", penwidth=2.2];
        FLUDRO    [label="fludrocortisone"];
        TESTOR    [label="testosterone replacement"];
        CORTREP   [label="total cortisol exposure (incl. replacement)", penwidth=2.2];
    }

    /* ================================================================================
       EDGES
       ================================================================================ */

    /* ---- 1. gene -> protein ---- */
    ABCD1  -> MUT      [label="variant", color="#2471a3"];
    MUT    -> ALDPD    [label="loss of function", color="#c0392b", arrowhead=tee];
    ABCD1  -> ALDP     [label="transcription·translation", color="#1a7f37"];
    ALDPD  -> ALDP     [label="less effective ALDP", color="#c0392b", arrowhead=tee, penwidth=1.8];
    LENTID -> VCN      [label="transduction", color="#8e44ad", style=dashed];
    VCN    -> ALDP     [label="corrected ALDP expression", color="#8e44ad", style=dashed, penwidth=1.8];
    ABCD2  -> IMPORT   [label="partial substitute transport", color="#1a7f37"];
    ABCD3  -> PEXMEM   [color="#1a7f37"];
    PEXMEM -> IMPORT   [color="#2471a3"];
    ALDP   -> IMPORT   [label="C26:0-CoA transport", color="#2471a3", penwidth=2.2];
    XINACT -> MOSAIC   [label="degree of skewing", color="#2471a3"];
    MOSAIC -> ALDP     [label="mean function of the cell population", color="#c0392b", arrowhead=tee];
    MOSAIC -> CROSSC   [color="#1a7f37"];
    CROSSC -> BETAOX   [label="normal cells compensate in part", color="#1a7f37"];
    MOSAIC -> FEMALE   [label="the more skewed, the more expressed", color="#e67e22"];

    /* ---- 2. mass balance ---- */
    DIET     -> VLCFACOA [label="~20%", color="#2471a3"];
    DENOVO   -> ELONG    [color="#2471a3"];
    ELOVL1   -> ELONG    [label="rate-determining", color="#1a7f37", penwidth=1.8];
    ELONG    -> VLCFACOA [label="~80% (dominant)", color="#2471a3", penwidth=2.2];
    ACSVL1   -> VLCFACOA [label="CoA activation", color="#1a7f37"];
    SREBP    -> ELOVL1   [label="transcriptional induction", color="#1a7f37"];
    VLCFACOA -> IMPORT   [color="#2471a3", penwidth=2.0];
    IMPORT   -> BETAOX   [label="substrate supply", color="#2471a3", penwidth=2.2];
    ACOX1    -> BETAOX   [color="#1a7f37"];
    DBP      -> BETAOX   [color="#1a7f37"];
    SCPX     -> BETAOX   [color="#1a7f37"];
    BETAOX   -> VLCFACOA [label="degradation (removal)", color="#c0392b", arrowhead=tee, penwidth=2.2];
    LOWFAT   -> DIET     [label="dietary block", color="#8e44ad", style=dashed, arrowhead=tee];

    /* ---- 2->3 accumulation ---- */
    VLCFACOA -> C26PL   [label="efflux·plasma equilibrium", color="#2471a3", penwidth=2.2];
    C26PL    -> C26LPC  [label="PC remodelling → lysoPC", color="#2471a3", penwidth=1.8];
    C26PL    -> C24C22  [color="#e67e22"];
    C26PL    -> C26CE   [label="esterification", color="#2471a3"];
    C26PL    -> C26PC   [color="#2471a3"];
    C26PL    -> C26GANG [color="#2471a3"];
    C26PL    -> C26ADR  [label="tissue distribution", color="#2471a3", penwidth=1.8];
    C26PL    -> C26BR   [label="tissue distribution (slow)", color="#2471a3", penwidth=1.8];
    C26PL    -> C26SC   [color="#2471a3", penwidth=1.8];
    C26PL    -> C26TEST [color="#2471a3"];
    C26BR    -> C26PC   [color="#2471a3"];
    C26CE    -> LAMEL   [label="inclusion formation", color="#2471a3"];
    C26PC    -> MEMB    [label="acyl chain length → membrane properties", color="#c0392b", penwidth=2.0];
    C26GANG  -> MEMB    [color="#c0392b"];
    LAMEL    -> MEMB    [color="#c0392b"];

    /* ---- 3->4 stress ---- */
    C26PC  -> MITO   [label="depolarisation", color="#c0392b", penwidth=1.8];
    MEMB   -> MITO   [color="#c0392b"];
    MEMB   -> CA     [color="#c0392b"];
    C26PL  -> NOX    [label="NOX2 activation", color="#1a7f37"];
    NOX    -> ROS    [color="#1a7f37", penwidth=1.8];
    MITO   -> ROS    [color="#1a7f37", penwidth=1.8];
    ROS    -> OXPROT [color="#e67e22"];
    ROS    -> MITO   [label="positive feedback", color="#c0392b", style=bold, penwidth=1.6];
    ROS    -> ER     [color="#1a7f37"];
    ER     -> AUTOPH [color="#c0392b"];
    ROS    -> AUTOPH [label="flux blocked", color="#c0392b", arrowhead=tee];
    AUTOPH -> C26CE  [label="clearance fails → accumulation", color="#c0392b", penwidth=1.6];
    ROS    -> NRF2   [label="induced when normal, but\nattenuated in X-ALD", color="#1a7f37", style=dotted];
    NRF2   -> ROS    [label="antioxidant defence", color="#c0392b", arrowhead=tee, penwidth=1.6];
    SIRT1  -> MITO   [label="biogenesis restored", color="#c0392b", arrowhead=tee];
    MITO   -> ATPX   [color="#c0392b", penwidth=1.8];
    CA     -> ATPX   [color="#c0392b"];
    ROS    -> CA     [color="#1a7f37"];

    /* ---- 5. adrenal axis ---- */
    C26ADR  -> C26CE    [label="adrenal storage (highest-concentration tissue)", color="#2471a3"];
    C26ADR  -> MEMB     [color="#c0392b"];
    MEMB    -> MC2R     [label="microdomain disruption → poorer receptor coupling",
                         color="#c0392b", arrowhead=tee, penwidth=2.0];
    C26ADR  -> ADMASS   [label="cell damage·atrophy", color="#c0392b", arrowhead=tee, penwidth=2.0];
    ROS     -> ADMASS   [color="#c0392b", arrowhead=tee];
    CRH     -> ACTHP    [color="#1a7f37"];
    ACTHP   -> MC2R     [label="ligand", color="#1a7f37"];
    MC2R    -> STAR     [label="cAMP/PKA", color="#1a7f37", penwidth=1.8];
    STAR    -> STEROID  [color="#1a7f37", penwidth=1.8];
    ADMASS  -> STEROID  [label="capacity limit", color="#1a7f37", penwidth=2.0];
    STEROID -> CORT     [color="#2471a3", penwidth=2.2];
    STEROID -> ALDOS    [color="#2471a3"];
    CORT    -> ACTHP    [label="negative feedback", color="#c0392b", arrowhead=tee, penwidth=2.0];
    CORT    -> CRH      [label="negative feedback", color="#c0392b", arrowhead=tee];
    ACTHP   -> MSH      [label="shared POMC precursor", color="#1a7f37", penwidth=1.6];
    ALDOS   -> NAK      [label="Na⁺ conservation", color="#c0392b", arrowhead=tee, penwidth=1.8];
    ALDOS   -> RENIN    [label="negative feedback", color="#c0392b", arrowhead=tee];
    RENIN   -> ALDOS    [label="stimulation (compensatory)", color="#1a7f37"];
    CORT    -> ACTHTESTR[label="peak after stimulation", color="#e67e22", penwidth=1.8];
    NAK     -> ADCRISIS [color="#e67e22", penwidth=1.8];
    CORT    -> ADCRISIS [label="when deficient", color="#e67e22", arrowhead=tee, penwidth=1.8];
    ADCRISIS-> DEATH    [label="if untreated", color="#e67e22"];
    HC      -> CORTREP  [label="replacement", color="#8e44ad", style=dashed, penwidth=2.0];
    CORT    -> CORTREP  [color="#2471a3"];
    CORTREP -> ADCRISIS [label="prevention", color="#8e44ad", style=dashed, arrowhead=tee, penwidth=1.8];
    FLUDRO  -> NAK      [label="mineralocorticoid replacement", color="#8e44ad", style=dashed, arrowhead=tee];
    CORTREP -> MSH      [label="pigmentation resolves", color="#8e44ad", style=dashed, arrowhead=tee];
    ACTHTEST-> ACTHTESTR[label="test", color="#e67e22"];

    /* ---- 6. gonad ---- */
    C26TEST -> LEYDIG  [color="#c0392b", arrowhead=tee, penwidth=1.6];
    LEYDIG  -> TESTO   [color="#2471a3", penwidth=1.8];
    TESTO   -> LH      [label="negative feedback", color="#c0392b", arrowhead=tee];
    LH      -> LEYDIG  [label="stimulation", color="#1a7f37"];
    TESTO   -> HYPOG   [color="#e67e22", arrowhead=tee];
    LEYDIG  -> SPERM   [color="#1a7f37"];
    TESTOR  -> TESTO   [label="replacement", color="#8e44ad", style=dashed, penwidth=1.8];

    /* ---- 7. microglia: the trigger ---- */
    C26BR   -> MGL     [label="ALDP deficiency + VLCFA load", color="#c0392b", penwidth=2.0];
    MGL     -> MGLPHAG [color="#1a7f37", penwidth=1.6];
    TREM2   -> MGLPHAG [color="#1a7f37"];
    C26BR   -> MGLAP   [label="induces apoptosis", color="#1a7f37", penwidth=2.2];
    ROS     -> MGLAP   [color="#1a7f37", penwidth=1.6];
    MGLAP   -> MGL     [label="resident pool lost", color="#c0392b", arrowhead=tee, penwidth=2.2];
    MGLAP   -> MGLDEP  [color="#1a7f37", penwidth=2.0];
    MGLDEP  -> MGLPHAG [label="debris-clearing capacity collapses", color="#c0392b", arrowhead=tee, penwidth=2.0];
    MGLPHAG -> DEBRIS  [label="clearance", color="#c0392b", arrowhead=tee, penwidth=2.0];
    DEBRIS  -> MGLPRO  [label="debris switches the phenotype", color="#1a7f37", penwidth=2.0];
    C26BR   -> MGLPRO  [color="#1a7f37"];
    MGL     -> MGLPRO  [color="#2471a3"];

    /* ---- 8. inflammatory loop ---- */
    MGLPRO -> TNFA   [color="#1a7f37", penwidth=2.0];
    MGLPRO -> IL1B   [color="#1a7f37", penwidth=2.0];
    MGLPRO -> MCP1   [color="#1a7f37", penwidth=1.8];
    MGLPRO -> INOS   [color="#1a7f37"];
    MCP1   -> MONOIN [label="chemotaxis", color="#1a7f37", penwidth=2.0];
    MONOIN -> TNFA   [label="amplification", color="#1a7f37", penwidth=1.8];
    TNFA   -> MMP9   [color="#1a7f37"];
    TNFA   -> TJ     [label="junction breakdown", color="#c0392b", arrowhead=tee, penwidth=2.0];
    IL1B   -> VEGF   [color="#1a7f37"];
    MMP9   -> TJ     [label="basement membrane degradation", color="#c0392b", arrowhead=tee, penwidth=1.8];
    VEGF   -> BBBP   [color="#1a7f37", penwidth=1.8];
    TJ     -> BBBP   [label="barrier maintenance", color="#c0392b", arrowhead=tee, penwidth=2.2];
    BBBP   -> MONOIN [label="route of entry", color="#1a7f37", penwidth=2.2];
    BBBP   -> CD8T   [color="#1a7f37", penwidth=1.8];
    BBBP   -> GDENH  [label="contrast leakage", color="#e67e22", penwidth=2.2];
    BBBP   -> PERIV  [color="#1a7f37"];
    CD8T   -> PERF   [color="#1a7f37", penwidth=1.8];
    CD8T   -> IFNG   [color="#1a7f37"];
    IFNG   -> MGLPRO [label="amplification", color="#1a7f37", penwidth=1.8];
    PERF   -> OLGAP  [label="cytotoxic killing", color="#1a7f37", penwidth=2.2];
    TNFA   -> OLGAP  [color="#1a7f37", penwidth=2.0];
    IL1B   -> OLGAP  [color="#1a7f37", penwidth=1.6];
    INOS   -> OLGAP  [color="#1a7f37"];
    COMPL  -> OLGAP  [color="#1a7f37"];
    TNFA   -> ASTRO  [color="#1a7f37", penwidth=1.6];
    ASTRO  -> MCP1   [label="amplification", color="#1a7f37", penwidth=1.8];
    ASTRO  -> GLIOSIS[color="#1a7f37", penwidth=1.8];
    MGLPRO -> COMPL  [color="#1a7f37"];

    /* the loop-gain node: gathers the amplifying arms */
    TNFA   -> LOOP   [color="#c0392b", penwidth=1.6];
    MONOIN -> LOOP   [color="#c0392b", penwidth=1.6];
    CD8T   -> LOOP   [color="#c0392b", penwidth=1.6];
    DEBRIS -> LOOP   [color="#c0392b", penwidth=1.6];
    ASTRO  -> LOOP   [color="#c0392b", penwidth=1.2];
    LOOP   -> MGLPRO [label="G > 1 → runaway", color="#c0392b", style=bold, penwidth=2.6];
    LOOP   -> SWITCH [label="sets the state of the switch", color="#e67e22", style=bold, penwidth=2.6];

    /* ---- 10. myelin / axon ---- */
    OLGAP    -> OLG      [color="#c0392b", arrowhead=tee, penwidth=2.2];
    OLG      -> MYE      [label="myelin maintenance·regeneration", color="#1a7f37", penwidth=2.2];
    MYE      -> DEMY     [label="loss → demyelinated volume", color="#c0392b", penwidth=2.2];
    OLGAP    -> DEBRIS   [label="debris generation", color="#1a7f37", penwidth=2.0];
    DEMY     -> ZONE     [color="#2471a3"];
    ZONE     -> GLIOSIS  [color="#2471a3"];
    SPLENIUM -> DEMY     [label="site of onset", color="#2471a3"];
    FRONTAL  -> DEMY     [label="subtype", color="#2471a3", style=dotted];
    DEMY     -> AXBR     [label="axonal transection·damage", color="#c0392b", arrowhead=tee, penwidth=2.0];
    ATPX     -> AXBR     [color="#c0392b", arrowhead=tee, penwidth=1.8];
    PERF     -> AXBR     [color="#c0392b", arrowhead=tee];
    DEMY     -> LOES     [label="volume·region weighting", color="#e67e22", penwidth=2.4];
    GLIOSIS  -> LOES     [color="#e67e22"];
    GDENH    -> LOES     [label="enhancement adds points", color="#e67e22", penwidth=1.6];
    AXBR     -> NFS      [label="loss of function", color="#e67e22", arrowhead=tee, penwidth=2.4];
    AXBR     -> COGN     [color="#e67e22", arrowhead=tee, penwidth=1.8];
    DEMY     -> VISUAL   [color="#e67e22", penwidth=1.6];
    DEMY     -> SEIZ     [color="#e67e22"];
    NFS      -> MFD      [label="threshold crossed", color="#e67e22", penwidth=2.2];
    MFD      -> SURV     [color="#e67e22", arrowhead=tee, penwidth=2.2];
    NFS      -> DEATH    [label="terminal stage", color="#e67e22", penwidth=1.8];

    /* ---- 11. cord / AMN ---- */
    C26SC  -> ATPX    [label="axonal energy metabolism impaired", color="#c0392b", penwidth=1.8];
    LENGTH -> CST     [label="longest axons first", color="#2471a3", penwidth=1.8];
    LENGTH -> DC      [color="#2471a3", penwidth=1.8];
    ATPX   -> DISTAX  [label="from the distal end", color="#1a7f37", penwidth=2.2];
    ROS    -> DISTAX  [color="#1a7f37", penwidth=1.6];
    DISTAX -> CST     [color="#c0392b", arrowhead=tee, penwidth=2.2];
    DISTAX -> DC      [color="#c0392b", arrowhead=tee, penwidth=2.2];
    CST    -> MYESC   [label="secondary myelin loss", color="#c0392b", arrowhead=tee];
    CST    -> SPAST   [color="#e67e22", arrowhead=tee, penwidth=2.0];
    DC     -> SPAST   [color="#e67e22", arrowhead=tee];
    CST    -> BLADDER [color="#e67e22", arrowhead=tee, penwidth=1.6];
    DISTAX -> PERIPH  [color="#e67e22"];
    SPAST  -> EDSS    [color="#e67e22", penwidth=2.2];
    BLADDER-> EDSS    [color="#e67e22"];
    SPAST  -> SIXMWT  [color="#e67e22", arrowhead=tee, penwidth=1.8];
    EDSS   -> MFD     [color="#e67e22", style=dotted];

    /* ---- 12. phenotype determination — the central claim ---- */
    C26BR    -> SWITCH  [label="necessary", color="#e67e22", penwidth=2.4];
    SUSC     -> SWITCH  [label="decides sufficiency", color="#e67e22", penwidth=2.6];
    MODGEN   -> SUSC    [color="#2471a3"];
    HEADTR   -> SUSC    [label="trigger", color="#2471a3"];
    HEADTR   -> BBBP    [label="transient barrier breach", color="#1a7f37", style=dotted];
    CONCORD  -> SUSC    [label="evidence of a stochastic component", color="#2471a3", style=dotted];
    SWITCH   -> MGLPRO  [label="ignition", color="#e67e22", style=bold, penwidth=2.6];
    SWITCH   -> CCALD   [label="ON (childhood)", color="#e67e22", penwidth=2.2];
    SWITCH   -> AMNCONV [label="ON (adult AMN)", color="#e67e22", penwidth=2.0];
    DISTAX   -> AMN     [label="OFF branch", color="#e67e22", penwidth=2.2];
    ADMASS   -> ADDIONLY[label="adrenal-only phenotype", color="#e67e22", arrowhead=tee, penwidth=1.8];
    CCALD    -> DEMY    [color="#e67e22", penwidth=2.2];
    AMNCONV  -> DEMY    [color="#e67e22", penwidth=1.8];
    AMN      -> EDSS    [color="#e67e22", penwidth=1.8];
    FEMALE   -> DISTAX  [color="#e67e22", penwidth=1.6];
    C26PL    -> NOCORR  [label="it is measured", color="#e67e22", style=dashed];
    SWITCH   -> NOCORR  [label="it is not measured", color="#e67e22", style=dashed];
    NOCORR   -> MRISURV [label="which is why MRI surveillance\nis irreplaceable", color="#e67e22", penwidth=2.0];

    /* ---- 14. screening ---- */
    C26LPC   -> NBS      [label="DBS quantitation", color="#e67e22", penwidth=2.2];
    NBS      -> RUSP     [color="#2471a3", style=dotted];
    NBS      -> ABCD1SEQ [label="second-tier confirmation", color="#2471a3", penwidth=1.8];
    NBS      -> FALSEPOS [label="other peroxisomal disorders", color="#2471a3", style=dotted];
    ABCD1SEQ -> MRISURV  [label="entry into surveillance", color="#2471a3", penwidth=1.8];
    ABCD1SEQ -> ACTHTEST [color="#2471a3", penwidth=1.8];
    MRISURV  -> LOES     [label="early detection", color="#e67e22", penwidth=1.8];
    LOES     -> WINDOW   [label="≤ 9 is inside the window", color="#e67e22", penwidth=2.2];
    NFS      -> WINDOW   [label="≤ 1 is inside the window", color="#e67e22", penwidth=2.2];
    WINDOW   -> CD34     [label="indication for transplant", color="#4a7fb8", penwidth=2.2];
    WINDOW   -> ALLOHSCT [color="#4a7fb8", penwidth=1.8];
    ACTHTEST -> HC       [label="start replacement early", color="#8e44ad", style=dashed, penwidth=1.8];

    /* ---- 15. metabolic drugs ---- */
    LO      -> ERUC     [label="absorption·ester hydrolysis", color="#8e44ad", style=dashed, penwidth=2.0];
    LO      -> OLEIC    [color="#8e44ad", style=dashed];
    ERUC    -> COMPINH  [label="substrate competition", color="#8e44ad", style=dashed, penwidth=2.2];
    OLEIC   -> COMPINH  [color="#8e44ad", style=dashed];
    COMPINH -> ELOVL1   [label="competitive inhibition → lower elongation flux",
                         color="#c0392b", arrowhead=tee, penwidth=2.4];
    ERUC    -> LOBBB    [label="it does not go to the brain", color="#c0392b", style=dashed, penwidth=2.0];
    LOBBB   -> C26BR    [label="no change (no effect)", color="#c0392b", style=dotted, penwidth=2.0];
    ELOVLI  -> ELOVL1   [label="direct inhibition", color="#8e44ad", style=dashed, arrowhead=tee, penwidth=1.8];
    BEZA    -> ABCD2    [label="attempted induction", color="#8e44ad", style=dashed];
    PBA     -> ABCD2    [label="attempted induction", color="#8e44ad", style=dashed];
    SOBE    -> ABCD2    [label="induction inside the CNS", color="#8e44ad", style=dashed, penwidth=2.0];
    SOBE    -> C26BR    [label="lowers brain VLCFA directly", color="#c0392b", style=dashed, arrowhead=tee, penwidth=2.0];
    ABCD2   -> BETAOX   [label="substitute transport → degradation restored", color="#1a7f37", penwidth=1.8];

    /* ---- 16. CNS drugs ---- */
    LERI   -> LERIB   [label="crosses the BBB (penetration by design)", color="#8e44ad", style=dashed, penwidth=2.2];
    LERIB  -> PPARG   [color="#8e44ad", style=dashed, penwidth=2.0];
    PPARG  -> SIRT1   [label="mitochondrial biogenesis", color="#1a7f37", penwidth=1.8];
    PPARG  -> NRF2    [color="#1a7f37", penwidth=1.6];
    PPARG  -> TNFA    [label="transcriptional repression", color="#c0392b", arrowhead=tee, penwidth=1.8];
    PPARG  -> MCP1    [color="#c0392b", arrowhead=tee];
    PPARG  -> TJ      [label="barrier stabilisation", color="#1a7f37", penwidth=1.8];
    DMF    -> NRF2    [color="#8e44ad", style=dashed, penwidth=1.8];
    NAC    -> ROS     [color="#8e44ad", style=dashed, arrowhead=tee, penwidth=1.8];
    STEROIDX-> TNFA   [label="a transient fall, but progression is not stopped",
                       color="#8e44ad", style=dotted, arrowhead=tee];
    IMMSUPX -> CD8T   [label="it does not break the loop", color="#8e44ad", style=dotted, arrowhead=tee];
    LERIB  -> LOOP    [label="lowers gain G (partly)", color="#c0392b", arrowhead=tee, penwidth=1.8];

    /* ---- 17. HSCT / gene therapy ---- */
    CD34    -> TRANSD  [color="#4a7fb8", penwidth=1.8];
    TRANSD  -> LENTID  [label="vector introduction", color="#4a7fb8", penwidth=1.8];
    TRANSD  -> HSCE    [color="#4a7fb8", penwidth=1.8];
    ALLOHSCT-> HSCE    [label="donor cells", color="#4a7fb8", penwidth=1.8];
    ALLOHSCT-> GVHD    [color="#4a7fb8"];
    BUSU    -> MYELOAB [label="exposure (AUC) dependent", color="#4a7fb8", penwidth=2.0];
    MYELOAB -> NEUT    [label="transient agranulocytosis", color="#c0392b", arrowhead=tee, penwidth=1.8];
    MYELOAB -> HSCE    [label="makes space for engraftment", color="#1a7f37", penwidth=2.0];
    MYELOAB -> TRM     [label="toxicity", color="#c0392b"];
    GVHD    -> TRM     [color="#c0392b"];
    NEUT    -> TRM     [label="infection risk", color="#c0392b", arrowhead=tee];
    HSCE    -> MONOCH  [label="peripheral reconstitution", color="#4a7fb8", penwidth=2.2];
    HSCE    -> VCN     [color="#4a7fb8", penwidth=1.8];
    MONOCH  -> MGLREP  [label="slow replacement (rate-limiting step)", color="#4a7fb8", penwidth=2.4];
    MGLREP  -> MGL     [label="supply of corrected microglia", color="#1a7f37", penwidth=2.4];
    MGLREP  -> MGLPHAG [label="debris-clearing capacity restored", color="#1a7f37", penwidth=2.4];
    MGLREP  -> LAG     [label="the cause of the lag", color="#e67e22", penwidth=2.2];
    LAG     -> LOES    [label="still rises after transplant", color="#e67e22", penwidth=2.2];
    LAG     -> NFS     [color="#e67e22", penwidth=1.8];
    MGLREP  -> LOOP    [label="brings gain G back below 1", color="#c0392b", arrowhead=tee, penwidth=2.6];
    VCN     -> CLONAL  [label="insertion-site dependent", color="#c0392b", penwidth=1.8];
    CLONAL  -> MDS     [color="#c0392b", penwidth=2.0];
    MDS     -> DEATH   [color="#e67e22"];
    TRM     -> DEATH   [color="#e67e22"];
    HSCE    -> ALDP    [label="correction confined to haematopoiesis", color="#1a7f37", style=dashed];
    MGLREP  -> C26BR   [label="brain VLCFA barely changes",
                        color="#c0392b", style=dotted, penwidth=1.6];

    /* ---- the two dissociation statements, drawn explicitly ---- */
    COMPINH -> C26PL   [label="the biomarker normalises", color="#8e44ad", arrowhead=tee, penwidth=2.4];
    COMPINH -> SWITCH  [label="it cannot touch the switch",
                        color="#c0392b", style=dotted, penwidth=2.4];
    MGLREP  -> SURV    [label="the disease stops", color="#1a7f37", penwidth=2.4];
    MGLREP  -> C26PL   [label="the biomarker barely changes",
                        color="#c0392b", style=dotted, penwidth=2.0];

}
