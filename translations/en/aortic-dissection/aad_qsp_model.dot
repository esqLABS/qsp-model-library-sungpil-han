    REFLEX_T -> HR [penwidth=2.2];
    REFLEX_T -> DPDT [label="impulse restored", penwidth=2.2, color="#b22222"];
    REFLEX_T -> PPFL [label="ω rises → damping rises", penwidth=2.0, color="#b22222"];

    /* 10 : pain */
    INTIMAL_T -> NOCICEPT;
