        REFRAC_HTN[label="Refractory hypertension\nSBP 140 vs 113 on the same regimen, at the same target", fillcolor="#f4b6b6", penwidth=2.2];
        FIX       [label="The fix: not a fourth vasodilator\nbut open the kidney (stent · fenestration · TEVAR)", fillcolor="#c3cbee", penwidth=2.0];
    }

