    THR_FL -> ORGANISE;
    ORGANISE -> FL [label="indolent shrinkage", arrowhead=tee, color="#2e7d32"];
    THR_FL -> DDIMER;
    FL_FLOW -> DDIMER;

    /* 12 : inflammation */
    INTIMAL_T -> INJ [penwidth=2.0];
    INJ -> IL6 [penwidth=2.0];
