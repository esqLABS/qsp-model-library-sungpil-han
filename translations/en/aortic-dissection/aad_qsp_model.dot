/* ===========================================================================
   aad_qsp_model.dot
   Acute Type B Aortic Dissection (AAD) — mechanistic QSP map
   Acute Type B Aortic Dissection — mechanistic QSP map

   The organising idea of the map
     Read it as ONE PRODUCT and ONE DIVIDER.

     THE PRODUCT (clusters 5-8, centre).  What tears an aorta is not blood
     pressure.  It is

         ASI  =  (sigma_FL_sys / sigma_ref)  x  (dP/dt_max / dPdt_ref)

     a STRESS term and an IMPULSE term, and they are generated by different
     organs.  sigma = P*r/h comes from the pressure inside a false lumen whose
     outer wall is media+adventitia only (h_FL = 0.40 * h_aorta, so the false
     lumen carries ~2.5x the true lumen's circumferential stress at identical
     pressure).  dP/dt_max comes from the left ventricle, and is set by
     contractility and heart rate — which the arterial baroreflex RAISES when
     the pressure falls.  A pure vasodilator therefore lowers the first factor
     and pushes up the second.  In the simulations that ship with this map, a
     nicardipine infusion titrated to systolic 118 mmHg leaves dP/dt max
     UNCHANGED (1468 vs 1463 mmHg/s untreated, +0.3%), grows the entry tear
     13.3% in 72 h against 1.0% for an esmolol-first regimen at the same
     pressure, and comes out with a HIGHER 72-h mortality than giving nothing
     at all (5.1% vs 2.3%).  "Beta-blockade before vasodilatation" is a
     statement about a product, and it can be computed.

     THE DIVIDER (cluster 4, upper centre).  The false lumen is a compliant
     chamber joined to the true lumen by an entry-tear conductance G_en and a
     distal re-entry conductance G_re.  Everything the false lumen does follows
     from that resistive divider plus its RC time constant tau_FL:

       G_en high, G_re high -> brisk through-flow, pulsatile, no thrombus
       G_en high, G_re ~ 0  -> BLIND SAC.  No outflow, so no pressure drop:
                               mean false-lumen pressure equals systemic mean,
                               and because the pulse is low-pass filtered out,
                               false-lumen DIASTOLIC pressure rises to the
                               systemic MEAN — above true-lumen diastolic.
                               The stagnant distal sac clots while the entry
                               tear stays wide open.  This is "partial
                               thrombosis", and it is the worst configuration
                               in the model (5-y survival 0.613 vs 0.813 for a
                               patent false lumen; implied hazard ratio 2.36
                               against the 2.69 reported by Tsai in IRAD).
       G_en small           -> the whole sac clots, the entry seals, the false
                               lumen depressurises to 9 mmHg and the aorta
                               stops growing (-0.2 mm/y, survival 0.890).

     Nowhere does the map assert that partial thrombosis is dangerous.  Two
     anatomical numbers produce it.

   Reading order
      1  substrate and trigger: what makes a medial layer splittable
      2  the medial wall: elastin, collagen, SMC, MMP/TIMP, TGF-beta
      3  the tear and the two lumens
      4  THE HYDRAULIC DIVIDER — G_en, G_re, tau_FL, false-lumen pressure
      5  Laplace mechanics — where thinness becomes stress
      6  THE PRODUCT — ASI and the propagation threshold
      7  the left ventricle as an impulse generator (dP/dt max)
      8  systemic haemodynamics: resistance, compliance, pulse pressure
      9  autonomic control and baroreflex resetting
     10  pain as a haemodynamic drug
     11  false-lumen thrombus: support and proteolysis at the same time
     12  inflammation, IL-6, MMP-9, D-dimer
     13  branch malperfusion: static vs dynamic obstruction
     14  the renin trap — why aggressive BP control can fail
     15  the spinal collateral network as a clock
     16  beta-blockers (esmolol, labetalol, metoprolol)
     17  vasodilators (nicardipine, clevidipine, nitroprusside + cyanide)
     18  analgesia and RAAS blockade
     19  interventions: TEVAR, PETTICOAT, open repair, staged coverage
     20  clinical endpoints and complications

   Colour key
     substrate / genetics .......... pale olive
     aortic wall / ECM ............. wheat
     lumen / haemodynamic state .... light blue
     THE PRODUCT / index ........... gold (heavy border)
     cardiac ....................... salmon
     autonomic / neural ............ lavender
     inflammation .................. pale pink
     thrombus ...................... light grey
     organ perfusion ............... pale cyan
     RAAS .......................... periwinkle
     beta-blocker .................. pale green
     vasodilator ................... pale turquoise
     analgesic / ARB ............... light violet
     intervention .................. light steel
     clinical endpoint ............. light yellow
     complication .................. light coral
   =========================================================================== */

digraph AAD_QSP {
    graph [rankdir=LR, splines=spline, overlap=false, nodesep=0.30, ranksep=1.05, newrank=true,
           fontname="Helvetica", fontsize=11,
           labelloc="t", fontcolor="#1a1a1a",
           label=<<B>Acute Type B Aortic Dissection — Quantitative Systems Pharmacology Map</B><BR/>
                  <FONT POINT-SIZE="12">AAD · 191 nodes · 323 edges · 20 clusters<BR/>
                  One product (stress x impulse) and one divider (entry tear vs re-entry): the tearing index is arithmetic, not a pressure</FONT>>];
    node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10,
           color="#555555", penwidth=1.0];
    edge  [fontname="Helvetica", fontsize=8, color="#666666", arrowsize=0.7];

    /* ---------- 1. SUBSTRATE AND TRIGGER -------------------------------- */
    subgraph cluster_sub {
        label="1 · Substrate & trigger";
        style="rounded,filled"; fillcolor="#f7f8ee"; color="#a3a86a"; fontsize=13;
        HTN_CHRON [label="Chronic hypertension\n(~75% of IRAD type B)", fillcolor="#dfe3bd"];
        AGE       [label="Age 65 · male\ncumulative elastic lamella fatigue", fillcolor="#dfe3bd"];
        FBN1      [label="FBN1 (Marfan)\nfibrillin-1 deficiency\n→ failed TGF-β sequestration", fillcolor="#c9d18f"];
        TGFBR     [label="TGFBR1/2 · SMAD3\nLoeys-Dietz", fillcolor="#c9d18f"];
        ACTA2     [label="ACTA2 · MYH11 · MYLK\ncontractile apparatus mutations", fillcolor="#c9d18f"];
        COL3A1    [label="COL3A1\nvascular Ehlers-Danlos", fillcolor="#c9d18f"];
        BAV       [label="Bicuspid aortic valve", fillcolor="#dfe3bd"];
        COARCT    [label="Coarctation · Turner", fillcolor="#dfe3bd"];
        COCAINE   [label="Cocaine · amphetamine\nacute sympathetic surge", fillcolor="#dfe3bd"];
        PREG      [label="Third trimester · postpartum\nhormonal wall changes", fillcolor="#dfe3bd"];
        FQ        [label="Fluoroquinolones\nMMP induction (contested)", fillcolor="#dfe3bd"];
        DECEL     [label="Deceleration trauma", fillcolor="#dfe3bd"];
        IATRO     [label="Iatrogenic\ncatheter · CABG · TAVR", fillcolor="#dfe3bd"];
        WEIGHTLIFT[label="Isometric exercise · Valsalva\nmomentary dP/dt spike", fillcolor="#dfe3bd"];
    }

    /* ---------- 2. THE MEDIAL WALL -------------------------------------- */
    subgraph cluster_wall {
        label="2 · Medial wall & extracellular matrix";
        style="rounded,filled"; fillcolor="#fdf6e8"; color="#c9a45c"; fontsize=13;
        LAMELLA   [label="Elastic lamellar unit\n(~55 layers in the descending thoracic aorta)", fillcolor="#f0d9a8"];
        ELASTIN   [label="Elastin integrity ELN\n0-1 (baseline 0.82)\nhalf-life ~decades", fillcolor="#e8c477", penwidth=1.8];
        COLLAGEN  [label="Type I · III collagen\nthe bearer of tensile strength", fillcolor="#f0d9a8"];
        VSMC      [label="Medial smooth muscle cells\ncontractile → synthetic switch", fillcolor="#f0d9a8"];
        VSMC_APO  [label="VSMC apoptosis\nloss of medial cellularity", fillcolor="#f0d9a8"];
        GAG       [label="Glycosaminoglycan accumulation\ncystic medial degeneration", fillcolor="#f0d9a8"];
        MMP2      [label="MMP-2\nconstitutive elastase", fillcolor="#f0d9a8"];
        MMP9_W    [label="MMP-9\ninducible elastase\n(model state variable)", fillcolor="#e8c477", penwidth=1.8];
        TIMP      [label="TIMP-1/2\nendogenous inhibitors", fillcolor="#f0d9a8"];
        TGFB_W    [label="TGF-β signalling\nboth faces: fibrosis ↔ proteolysis", fillcolor="#e8c477", penwidth=1.8];
        ADVENT    [label="Adventitial collagen COL\nadaptive thickening\n(the only negative feedback)", fillcolor="#e8c477", penwidth=1.8];
        HFL_N     [label="False lumen outer wall thickness h_FL\n= 0.40 × h_aorta = 0.76 mm\nthe dissection plane lies in the outer 1/3", fillcolor="#e8c477", penwidth=2.2];
        VASA      [label="Vasa vasorum\noxygen supply to the outer media", fillcolor="#f0d9a8"];
        WALL_STR  [label="Wall tensile strength S\n= 760 kPa × ELN^0.3 × (0.6+0.4·COL)", fillcolor="#e8c477", penwidth=1.8];
    }

    /* ---------- 3. THE TEAR AND THE TWO LUMENS -------------------------- */
    subgraph cluster_tear {
        label="3 · The tear & the two lumens";
        style="rounded,filled"; fillcolor="#eef4fb"; color="#6a90bd"; fontsize=13;
        INTIMAL_T [label="Intimal entry tear\narea A_en (baseline 42 mm² ≈ 7 mm)", fillcolor="#b8d0ea", penwidth=2.0];
        FLAP      [label="Intimal flap\nmobility ∝ √(A_en/A_ref)", fillcolor="#b8d0ea"];
        PROPAG    [label="Dissection propagation\nantegrade / retrograde", fillcolor="#b8d0ea"];
        TL        [label="True lumen\ndiameter D_TL (20 mm)", fillcolor="#b8d0ea"];
        FL        [label="False lumen\ndiameter D_FL (17 mm)", fillcolor="#b8d0ea", penwidth=2.0];
        REENTRY   [label="Re-entry tear\ndistal outflow route (G_re)", fillcolor="#b8d0ea", penwidth=2.0];
        DEBAKEY   [label="Classification: Stanford B\nDeBakey III · distal to the left subclavian", fillcolor="#d6e4f2"];
        EXTENT    [label="Dissection length\ndescending thoracic → abdominal → iliac", fillcolor="#d6e4f2"];
        TL_COLL   [label="True lumen collapse\nD_TL ← 1 − 0.32·collapse", fillcolor="#b8d0ea"];
        DAO       [label="Total aortic diameter\nD_ao = √(D_TL² + D_FL²)", fillcolor="#b8d0ea", penwidth=1.8];
    }

    /* ---------- 4. THE HYDRAULIC DIVIDER -------------------------------- */
    subgraph cluster_div {
        label="4 · Haemodynamic potential divider (THE DIVIDER — the arithmetic that makes the phenotype)";
        style="rounded,filled"; fillcolor="#fffaea"; color="#c9a227"; fontsize=13;
        G_EN      [label="Entry conductance G_en\n∝ A_en · (thrombus sealing) · (stent sealing)", fillcolor="#ffd24d", penwidth=2.2];
        G_RE      [label="Re-entry conductance G_re\n∝ (1 − distal thrombus)²", fillcolor="#ffd24d", penwidth=2.2];
        TAU_FL    [label="False lumen RC time constant\nτ_FL = 0.30 s / (G_en + G_re)", fillcolor="#ffd24d", penwidth=2.0];
        PFL_MEAN  [label="False lumen mean pressure P_FL\ndP/dt = k[G_en(MAP−P_FL) + G_re(P_dist−P_FL)]\n − (P_FL − 9)/336h", fillcolor="#ffd24d", penwidth=2.2];
        PPFL      [label="False lumen pulse pressure PP_FL\n= PP / √(1 + (ω·τ_FL)²)\nlow-pass filter", fillcolor="#ffd24d", penwidth=2.0];
        PFL_DIA   [label="False lumen diastolic pressure P_FL,dia\nin a blind sac it rises to systemic mean\n(higher than true lumen diastolic)", fillcolor="#ffd24d", penwidth=2.2];
        FL_FLOW   [label="False lumen flow FLOW\n= through-flow (in series) + to-and-fro (entry alone)\n× (1 − 0.60·thrombus)", fillcolor="#ffd24d", penwidth=2.0];
        BLIND     [label="Blind sac\nG_re → 0: no outflow = no pressure drop", fillcolor="#ffe699", penwidth=1.8];
        PATENT    [label="Patent FL\nlarge G_re: brisk through-flow, no thrombus", fillcolor="#ffe699", penwidth=1.8];
        SEALED    [label="Completely thrombosed, sealed\nG_en → 0: P_FL → 9 mmHg", fillcolor="#ffe699", penwidth=1.8];
        TOFRO     [label="To-and-fro flow\n∝ G_en · (PP − PP_FL)\nthe greater the damping, the larger it is", fillcolor="#ffe699"];
    }

    /* ---------- 5. LAPLACE MECHANICS ------------------------------------ */
    subgraph cluster_lap {
        label="5 · Laplace mechanics (Where thinness becomes stress)";
        style="rounded,filled"; fillcolor="#fdf1e6"; color="#c98f5e"; fontsize=13;
        LAPLACE   [label="Laplace's law\nσ = P · r / h", fillcolor="#f3c9a0", penwidth=2.2];
        SIG_FL    [label="False lumen circumferential stress σ_FL\n= P_FL · (D_FL/2) / h_FL\nbaseline 118 kPa · at presentation ~176 kPa", fillcolor="#f3c9a0", penwidth=2.2];
        SIG_TL    [label="True lumen circumferential stress σ_TL\nuses the intact wall thickness 1.14 mm", fillcolor="#f3c9a0"];
        SIG_FLAP  [label="Flap stress σ_flap\n= |SBP − P_FL,sys| · r / 0.25 mm\n× exposure (1−thrombus)(1−stent)", fillcolor="#f3c9a0", penwidth=2.2];
        ASYM      [label="The core asymmetry\nat the same pressure, false lumen stress ≈ 2.5× the true lumen", fillcolor="#f9dfc6", penwidth=1.8];
        CYCLIC    [label="Cyclic fatigue\ncyclic stretch (PP_FL)", fillcolor="#f9dfc6"];
        SR        [label="Stress/strength ratio σ/S\nthe single index of rupture risk", fillcolor="#f3c9a0", penwidth=2.0];
        GROWTH    [label="False lumen expansion rate\n∝ (σ_FL/118)^1.9 × (1 − 0.85·thrombus)", fillcolor="#f3c9a0", penwidth=2.0];
    }

    /* ---------- 6. THE PRODUCT ------------------------------------------ */
    subgraph cluster_asi {
        label="6 · Stress × impulse product (THE PRODUCT — the tearing index)";
        style="rounded,filled"; fillcolor="#fff5d6"; color="#b8860b"; fontsize=13;
        ASI       [label="ASI = (σ_FL,sys/σ_ref) × (dP/dt / dPdt_ref)\naortic stress-impulse index", fillcolor="#ffc72c", penwidth=3.0];
        ASI_FLAP  [label="Flap stress-impulse\nASI_flap = (σ_flap/σ_ref)·(dP/dt/ref)^1.2", fillcolor="#ffc72c", penwidth=2.6];
        TEAR_TH   [label="Propagation threshold TEAR_TH = 0.45\nonly below this value is the tear stable", fillcolor="#ffc72c", penwidth=2.6];
        TEAR_RATE [label="Tear growth rate dA_en/dt\n= k·A_en·softplus(ASI_flap − 0.45)", fillcolor="#ffc72c", penwidth=2.2];
        WHEAT     [label="Wheat's principle (1965)\nlower dP/dt, not the pressure", fillcolor="#ffe9a8", penwidth=1.8];
        DISSOC    [label="Dissociation\nvasodilator alone: SBP −33 mmHg, dP/dt +0.3%\nASI 1.65 vs β-blockade 1.16", fillcolor="#ffe9a8", penwidth=2.2];
    }

    /* ---------- 7. THE LEFT VENTRICLE ----------------------------------- */
    subgraph cluster_lv {
        label="7 · The LV as an impulse generator";
        style="rounded,filled"; fillcolor="#fff2ee"; color="#c98f7e"; fontsize=13;
        CTR       [label="Myocardial contractility CTR\n(relative, baseline 1.0)", fillcolor="#f4a582", penwidth=2.0];
        HR        [label="Heart rate HR\nbaseline 62 · untreated 71 · β-blockade 57", fillcolor="#f4a582", penwidth=2.0];
        DPDT      [label="dP/dt max\n= 1180 · CTR · (HR/62)^0.25 · (DBP/80)^0.35\nmmHg/s", fillcolor="#f4a582", penwidth=3.0];
        SV        [label="Stroke volume SV\n= 76 · CTR · preload^0.6 · SVR^−0.2", fillcolor="#f4a582"];
        CO        [label="Cardiac output CO = HR × SV", fillcolor="#f4a582"];
        PRELOAD   [label="Preload\nblood volume · venous volume", fillcolor="#f6c4ad"];
        B1_HEART  [label="β1 receptors (heart)\ncontractility −42% · HR −46% (full blockade)", fillcolor="#f6c4ad"];
        AV_VALVE  [label="Aortic valve (normal in type B)\nthe source of regurgitation in type A", fillcolor="#f6c4ad"];
        EJECT     [label="Ejection acceleration\n= the impulse on the flap", fillcolor="#f6c4ad"];
    }

    /* ---------- 8. SYSTEMIC HAEMODYNAMICS ------------------------------- */
    subgraph cluster_haemo {
        label="8 · Systemic haemodynamics";
        style="rounded,filled"; fillcolor="#eef4fb"; color="#6a90bd"; fontsize=13;
        SVR       [label="Systemic vascular resistance SVR\nbaseline 17.5 mmHg·min/L", fillcolor="#b8d0ea", penwidth=2.0];
        CART      [label="Arterial compliance C_art\n= 1.72 / (1+0.55(1−ELN))\n× (1 + 0.25·CCB + 0.30·NO)", fillcolor="#b8d0ea", penwidth=1.8];
        PP_N      [label="Pulse pressure PP = SV / C_art\nuntreated 52 · vasodilator 55 mmHg", fillcolor="#b8d0ea", penwidth=1.8];
        MAP_N     [label="Mean arterial pressure MAP\n= CO × SVR + 5", fillcolor="#b8d0ea", penwidth=2.0];
        SBP_N     [label="Systolic pressure SBP = MAP + 2PP/3", fillcolor="#b8d0ea", penwidth=2.0];
        DBP_N     [label="Diastolic pressure DBP = MAP − PP/3", fillcolor="#b8d0ea"];
        BV        [label="Circulating blood volume BV\naldosterone-mediated Na · water", fillcolor="#d6e4f2"];
        VENO      [label="Venous capacitance, venodilation\npreload −25% with an NO donor", fillcolor="#d6e4f2"];
        PDIST     [label="Distal true lumen pressure P_dist\n= MAP − 4 mmHg", fillcolor="#d6e4f2"];
        STIFF_N   [label="Aortic stiffness\nloss of ELN → widened PP", fillcolor="#d6e4f2"];
    }

    /* ---------- 9. AUTONOMIC CONTROL ------------------------------------ */
    subgraph cluster_auto {
        label="9 · Autonomic control & baroreceptor resetting";
        style="rounded,filled"; fillcolor="#f4f0fb"; color="#8b7bb8"; fontsize=13;
        BARO_R    [label="Aortic · carotid baroreceptors", fillcolor="#cdb4e8"];
        BAROSET   [label="Baroreceptor set point BAROSET\ndP/dt = (0.55·106 + 0.45·MAP − set)/48h\nonly partial resetting occurs", fillcolor="#cdb4e8", penwidth=2.2];
        SNA       [label="Sympathetic outflow SNA\n= baro × (1+0.55·pain/10) × (1+0.35·AngII)", fillcolor="#cdb4e8", penwidth=2.6];
        VAGAL     [label="Parasympathetic vagal tone", fillcolor="#ddcdf0"];
        REFLEX_T  [label="Reflex tachycardia\nHR 71 → 84 on a vasodilator", fillcolor="#cdb4e8", penwidth=2.2];
        NE_SPILL  [label="Noradrenaline spillover\nsimultaneous α1 + β1 stimulation", fillcolor="#ddcdf0"];
        A1_VASC   [label="α1 receptors (vascular)\nthe axis labetalol blocks", fillcolor="#ddcdf0"];
        B1_JG     [label="β1 receptors (renal JG cells)\nrenin release −40% (under β-blockade)", fillcolor="#ddcdf0"];
        BARO_BLUNT[label="Baroreceptor sensitivity blunted at 65 with hypertension\nKBARO 1.25", fillcolor="#ddcdf0"];
    }

    /* ---------- 10. PAIN ------------------------------------------------ */
    subgraph cluster_pain {
        label="10 · Pain as a haemodynamic drug";
        style="rounded,filled"; fillcolor="#f6f0f8"; color="#a07bb0"; fontsize=13;
        NOCICEPT  [label="Adventitial mechanosensitive nociceptors\nC-fibre · Aδ", fillcolor="#e0c8ea"];
        PAIN_ONSET[label="Tearing pain at onset\n= injury signal INJ (τ 30 h)", fillcolor="#e0c8ea", penwidth=2.0];
        PAIN_PERS [label="Persistent · recurrent pain\n= wall stress (gated by flap vulnerability)", fillcolor="#e0c8ea", penwidth=2.2];
        PAIN_SCORE[label="Pain intensity 0-10\nuntreated 4.7 · full therapy 1.2", fillcolor="#e0c8ea", penwidth=1.8];
        SYMPEXC   [label="Pain-driven sympathetic excitation\nSNA +55% (at 10/10)", fillcolor="#e0c8ea", penwidth=2.0];
        PAIN_HTN  [label="Analgesia alone takes SBP 154 → 143\ndP/dt −7%: analgesia is an antihypertensive", fillcolor="#e0c8ea", penwidth=2.2];
        REFRACT   [label="Refractory · recurrent pain\n= a class I indication for intervention\n(not an indication to escalate morphine)", fillcolor="#f4b6b6", penwidth=2.0];
    }

    /* ---------- 11. FALSE-LUMEN THROMBUS ------------------------------- */
    subgraph cluster_thr {
        label="11 · False lumen thrombus: support and proteolysis at once";
        style="rounded,filled"; fillcolor="#f2f2f2"; color="#8a8a8a"; fontsize=13;
        STASIS    [label="Stasis\n= 1/(1+(FLOW/0.30)²)", fillcolor="#d9d9d9", penwidth=1.8];
        THR_FL    [label="Thrombus fraction in the FL body THR\npatent 0.05 · partial 0.47 · complete 1.00", fillcolor="#d9d9d9", penwidth=2.6];
        THR_DIST  [label="Thrombus in the distal stasis zone\ncloses the re-entry tear and makes a blind sac", fillcolor="#d9d9d9", penwidth=2.2];
        LYSIS     [label="Flow-dependent fibrinolysis\n∝ FLOW", fillcolor="#d9d9d9"];
        SUPPORT   [label="Mechanical support\ngrowth × (1 − 0.85·THR) — linear", fillcolor="#d9d9d9", penwidth=2.2];
        ILT_PROT  [label="Subthrombus proteolysis\nh_FL ÷ (1 + 1.0·THR)\nhypoxia · neutrophil elastase · plasmin", fillcolor="#d9d9d9", penwidth=2.2];
        PARADOX   [label="The partial-thrombosis paradox\nsupport is linear, thinning goes as the power 1.9\n→ the worst case is THR* = 0.426 (analytic)", fillcolor="#ffc72c", penwidth=3.0];
        ORGANISE  [label="Thrombus organisation · contraction\nindolent shrinkage of a sealed sac", fillcolor="#d9d9d9"];
    }

    /* ---------- 12. INFLAMMATION --------------------------------------- */
    subgraph cluster_infl {
        label="12 · Inflammation & biomarkers";
        style="rounded,filled"; fillcolor="#fdeff3"; color="#c07d95"; fontsize=13;
        INJ       [label="Acute dissection injury signal INJ\nexponential decay τ = 30 h", fillcolor="#f2c4d3", penwidth=2.0];
        IL6       [label="IL-6\npeak ~8× · the stress-driven part saturates", fillcolor="#f2c4d3", penwidth=2.0];
        CRP       [label="CRP\ndelayed rise · prognostic marker", fillcolor="#f2c4d3"];
        NEUT      [label="Neutrophil infiltration\nelastase release", fillcolor="#f2c4d3"];
        MAC       [label="M1 macrophages\nthe principal source of MMP-9", fillcolor="#f2c4d3"];
        MMP9_S    [label="MMP-9 (model)\n= (1+0.55·ΔIL6)(1+0.6·AT1) × genetic multiplier", fillcolor="#f2c4d3", penwidth=2.2];
        DDIMER    [label="D-dimer\nindex of FL patency · thrombus turnover\na negative result is useful for ruling out", fillcolor="#f2c4d3", penwidth=1.8];
        SMC_SIG   [label="Soluble elastin fragments\nchemotactic cascade", fillcolor="#f2c4d3"];
        FEVER     [label="Resorption fever · leucocytosis\nconfused with infection", fillcolor="#f2c4d3"];
    }

    /* ---------- 13. BRANCH MALPERFUSION ------------------------------- */
    subgraph cluster_mal {
        label="13 · Branch malperfusion: static vs dynamic";
        style="rounded,filled"; fillcolor="#eafaf7"; color="#5aa89a"; fontsize=13;
        STATIC    [label="Static obstruction\nthe branch origin arises from the false lumen", fillcolor="#bfe8df", penwidth=2.0];
        DYNAMIC   [label="Dynamic obstruction\n= sig((P_FL,dia − DBP − 5)/4) × false lumen dominance", fillcolor="#bfe8df", penwidth=2.2];
        RENAL_P   [label="Renal perfusion Q_ren\nautoregulatory plateau (PP > 80 mmHg)", fillcolor="#bfe8df", penwidth=2.0];
        MESENT    [label="Mesenteric perfusion Q_mes\n→ lactate", fillcolor="#bfe8df"];
        SPINAL_P  [label="Spinal cord perfusion pressure SCPP\n= MAP − CSF pressure (10)", fillcolor="#bfe8df", penwidth=2.0];
        LIMB      [label="Lower limb perfusion\npulse deficit · acute limb ischaemia", fillcolor="#bfe8df"];
        CELIAC    [label="Coeliac · hepatic artery", fillcolor="#d5f0ea"];
        CREAT_N   [label="Serum creatinine\n1.05 → 2.10 mg/dL with malperfusion", fillcolor="#d5f0ea"];
        LACT_N    [label="Arterial lactate\nshared by gut ischaemia and cyanide toxicity", fillcolor="#d5f0ea", penwidth=1.8];
        PETTIC    [label="Distal true lumen opening strategy\nPETTICOAT · bare stent", fillcolor="#d5f0ea"];
    }

    /* ---------- 14. THE RENIN TRAP ------------------------------------- */
    subgraph cluster_raas {
        label="14 · The renin trap — refractory hypertension";
        style="rounded,filled"; fillcolor="#eef0fa"; color="#7a85c4"; fontsize=13;
        JG        [label="Juxtaglomerular cells (JG)\nsense the perfusion pressure", fillcolor="#c3cbee", penwidth=2.0];
        PRA       [label="Plasma renin activity PRA\nperfusion 0.50 → PRA 2.5×", fillcolor="#c3cbee", penwidth=2.4];
        ANGII     [label="Angiotensin II\nSVR +30% · MMP-9 induction · sympathetic facilitation", fillcolor="#c3cbee", penwidth=2.4];
        ALDO      [label="Aldosterone\n→ Na · water retention → preload", fillcolor="#c3cbee"];
        AT1       [label="AT1 receptor\nthe target of an ARB", fillcolor="#c3cbee"];
