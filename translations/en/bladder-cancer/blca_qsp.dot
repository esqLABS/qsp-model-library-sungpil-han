digraph BLCA_QSP {
  graph [
    label="Urothelial Bladder Cancer (BLCA)\nQSP Mechanistic Map"
    labelloc=t fontname="Helvetica-Bold" fontsize=18
    rankdir=LR splines=polyline overlap=false
    nodesep=0.35 ranksep=1.2 bgcolor="#FAFAFA"
    compound=true
  ]
  node [fontname="Helvetica" fontsize=9 style="filled,rounded" shape=box]
  edge [fontname="Helvetica" fontsize=7.5 arrowsize=0.7]

  // ==================== CLUSTER 1: Risk Factors ====================
  subgraph cluster_risk {
    label="Risk Factors"
    style=filled fillcolor="#FFF3E0" color="#BF360C" fontcolor="#BF360C" fontsize=11
    Smoking      [label="Smoking" fillcolor="#FFCC80"]
    Arylamines   [label="Arylamines\n(4-ABP)" fillcolor="#FFCC80"]
    Acrolein     [label="Acrolein\n(Urinary Metabolite)" fillcolor="#FFCC80"]
    OccExposure  [label="Occupational Exposure\n(Benzidine, 2-Naphthylamine)" fillcolor="#FFCC80"]
    Arsenic      [label="Arsenic Exposure\n(Drinking Water)" fillcolor="#FFCC80"]
    PelvicRad    [label="Prior Pelvic Radiation" fillcolor="#FFCC80"]
    CycloPhos    [label="Prior Cyclophosphamide" fillcolor="#FFCC80"]
    ChronicUTI   [label="Chronic UTI/Schistosoma haematobium" fillcolor="#FFCC80"]
    MaleAge      [label="Male Sex, Age>60" fillcolor="#FFCC80"]
    GeneticSusc  [label="Genetic Polymorphisms\n(NAT2, GSTM1, GSTT1)" fillcolor="#FFCC80"]
  }

  // ==================== CLUSTER 2: Molecular Alterations ====================
  subgraph cluster_molecular {
    label="Molecular Alterations"
    style=filled fillcolor="#E8F5E9" color="#1B5E20" fontcolor="#1B5E20" fontsize=11
    FGFR3mut   [label="FGFR3 Mutation/Fusion\n(~60% NMIBC)" fillcolor="#A5D6A7"]
    TP53mut    [label="TP53 Mutation\n(~50% MIBC)" fillcolor="#A5D6A7"]
    RB1del     [label="RB1 Deletion\n(~25%)" fillcolor="#A5D6A7"]
    CDKN2Adel  [label="CDKN2A(p16) Deletion\n(~50%)" fillcolor="#A5D6A7"]
    PIK3CAmut  [label="PIK3CA Mutation\n(~20%)" fillcolor="#A5D6A7"]
    ERBB2amp   [label="HER2/ERBB2 Amplification\n(~15%)" fillcolor="#A5D6A7"]
    MYCamp     [label="MYC Amplification" fillcolor="#A5D6A7"]
    KDM6Amut   [label="KDM6A(UTX) Mutation\n(Chromatin Remodeling, ~30%)" fillcolor="#A5D6A7"]
    STAG2mut   [label="STAG2 Mutation\n(Cohesin Complex, ~35%)" fillcolor="#A5D6A7"]
    TERT_prom  [label="TERT Promoter Mutation\n(~65%)" fillcolor="#A5D6A7"]
    Nectin4hi  [label="Nectin-4/PVRL4 High Expression" fillcolor="#81C784"]
    TROP2hi    [label="TROP2/TACSTD2 High Expression" fillcolor="#81C784"]
    PDL1expr   [label="PD-L1 (CD274) Expression" fillcolor="#81C784"]
    MSIstat    [label="MSI-H / TMB-H\n(Microsatellite Instability-High)" fillcolor="#66BB6A"]
  }

  // ==================== CLUSTER 3: Oncogenic Signaling ====================
  subgraph cluster_signaling {
    label="Oncogenic Signaling"
    style=filled fillcolor="#E3F2FD" color="#0D47A1" fontcolor="#0D47A1" fontsize=11
    FGFR3sig   [label="FGFR3-RAS Signaling Cascade" fillcolor="#90CAF9"]
    RASact     [label="RAS Activation\n(RAS/RAF)" fillcolor="#90CAF9"]
    MAPKpath   [label="MEK/ERK Pathway\n(MAPK Proliferation)" fillcolor="#90CAF9"]
    PI3Kpath   [label="PI3K/AKT/mTOR\n(Survival and Growth)" fillcolor="#90CAF9"]
    STAT3sig   [label="JAK/STAT3 Activation\n(Oncogenic Signaling)" fillcolor="#90CAF9"]
    NFkBtumor  [label="Tumor NF-κB Survival" fillcolor="#90CAF9"]
    WNTsig     [label="Wnt/β-catenin Pathway" fillcolor="#90CAF9"]
    p53loss    [label="p53 Loss of Function" fillcolor="#90CAF9"]
    BCL2sig    [label="BCL-2/BCL-XL\n(Anti-apoptotic Proteins)" fillcolor="#90CAF9"]
    CyclD1     [label="Cyclin D1 (CCND1)\n(G1/S Cell Cycle Driver)" fillcolor="#64B5F6"]
    CellCycle  [label="Cell Cycle Progression\n(G1→S→G2/M)" fillcolor="#64B5F6"]
    Proliferat [label="Tumor Proliferation\n(kgrow)" fillcolor="#42A5F5"]
    Apop_inh   [label="Apoptosis Inhibition" fillcolor="#90CAF9"]
    EMT        [label="Epithelial-Mesenchymal Transition\n(EMT, Invasion/Migration)" fillcolor="#1E88E5"]
    Angiogen   [label="VEGF-driven Angiogenesis" fillcolor="#1E88E5"]
  }

  // ==================== CLUSTER 4: Tumor Microenvironment ====================
  subgraph cluster_tme {
    label="Tumor Microenvironment"
    style=filled fillcolor="#FCE4EC" color="#880E4F" fontcolor="#880E4F" fontsize=11
    TumorCells   [label="Tumor Cells\n(T(t))" fillcolor="#F48FB1"]
    MDSC_tme     [label="MDSC\n(Myeloid-derived Suppressor Cells)" fillcolor="#F48FB1"]
    Treg_tme     [label="Regulatory T Cells\n(Foxp3+)" fillcolor="#F48FB1"]
    TAM_M2       [label="M2 TAM\n(Tumor-associated Macrophage, M2)" fillcolor="#F48FB1"]
    CAF_tme      [label="Cancer-associated Fibroblasts" fillcolor="#F48FB1"]
    TGFb_tme     [label="TGF-β\n(Immunosuppressive Cytokine)" fillcolor="#F48FB1"]
    IL10_tme     [label="IL-10\n(Anti-inflammatory Cytokine)" fillcolor="#F48FB1"]
    VEGF_tme     [label="VEGF\n(Vascular Endothelial Growth Factor)" fillcolor="#EC407A"]
    IDO1_tme     [label="IDO1\n(Tryptophan→Kynurenine Pathway)" fillcolor="#F48FB1"]
    Hypoxia_tme  [label="Tumor Hypoxia\n(HIF-1α)" fillcolor="#F48FB1"]
    Btme         [label="Tumor-infiltrating B Cells\n(Breg)" fillcolor="#F48FB1"]
    NeutroTME    [label="Tumor-associated Neutrophils" fillcolor="#F48FB1"]
  }

  // ==================== CLUSTER 5: Immune System ====================
  subgraph cluster_immune {
    label="Immune System"
    style=filled fillcolor="#F3E5F5" color="#4A148C" fontcolor="#4A148C" fontsize=11
    BCGstim    [label="BCG Immunostimulation\n(TLR)" fillcolor="#CE93D8"]
    TLR2_4     [label="TLR2/TLR4 Activation\n(Pattern Recognition Receptors)" fillcolor="#CE93D8"]
    DC_mature  [label="Dendritic Cell Maturation\n(Antigen Presentation)" fillcolor="#CE93D8"]
    IL12_imm   [label="IL-12\n(Th1 Polarization Cytokine)" fillcolor="#CE93D8"]
    IL2_imm    [label="IL-2\n(T cell Proliferation)" fillcolor="#CE93D8"]
    CD4_Th1    [label="CD4+ Th1 Cells\n(IFN-γ Producer)" fillcolor="#BA68C8"]
    CD8_eff    [label="CD8+ CTL\n(Cytotoxic T Lymphocytes)" fillcolor="#AB47BC"]
    NK_cells   [label="Natural Killer Cells (NK)" fillcolor="#CE93D8"]
    IFNg_imm   [label="IFN-γ\n(Anti-tumor, PD-L1 Inducer)" fillcolor="#9C27B0"]
    TNFa_imm   [label="TNF-α\n(Cytotoxic Cytokine)" fillcolor="#CE93D8"]
    CTLA4_expr [label="CTLA-4\n(Early Checkpoint, Ipilimumab Target)" fillcolor="#CE93D8"]
    PD1_expr   [label="PD-1\n(T cell Exhaustion Marker)" fillcolor="#CE93D8"]
    LAG3_expr  [label="LAG-3\n(Co-inhibitory Receptor)" fillcolor="#CE93D8"]
    TIM3_expr  [label="TIM-3\n(Late Exhaustion Marker)" fillcolor="#CE93D8"]
  }

  // ==================== CLUSTER 6: Drug PK — BCG & Chemotherapy ====================
  subgraph cluster_pk_conv {
    label="PK — BCG & Chemotherapy"
    style=filled fillcolor="#FFFDE7" color="#E65100" fontcolor="#E65100" fontsize=11
    BCG_depot  [label="BCG 81mg Intravesical" fillcolor="#FFF176"]
    BCG_eff    [label="BCG Bladder Wall Effect Conc." fillcolor="#FFF176"]
    Cis_plasm  [label="Cisplatin Plasma Concentration\n(70mg/m² IV)" fillcolor="#FFF176"]
    Gem_plasm  [label="Gemcitabine Plasma Concentration\n(1000mg/m² IV)" fillcolor="#FFF176"]
    Cis_DNA    [label="Cisplatin-DNA Adducts\n(Pt-DNA)" fillcolor="#FFD54F"]
    Gem_act    [label="Gemcitabine Triphosphate\n(dFdCTP, Active Metabolite)" fillcolor="#FFD54F"]
  }

  // ==================== CLUSTER 7: Drug PK — Checkpoint Inhibitors ====================
  subgraph cluster_pk_io {
    label="PK — Checkpoint Inhibitors"
    style=filled fillcolor="#E0F7FA" color="#004D40" fontcolor="#004D40" fontsize=11
    Pembro_c   [label="Pembrolizumab 200mg q3w\n(Central Compartment)" fillcolor="#80DEEA"]
    Pembro_p   [label="Pembrolizumab Peripheral Compartment" fillcolor="#80DEEA"]
    Atezo_c    [label="Atezolizumab 1200mg q3w\n(Central Compartment)" fillcolor="#80DEEA"]
    Atezo_p    [label="Atezolizumab Peripheral Compartment" fillcolor="#80DEEA"]
    Pembro_RO  [label="Pembrolizumab PD-1 RO\n(Receptor Occupancy)" fillcolor="#4DD0E1"]
    Atezo_RO   [label="Atezolizumab PD-L1 RO\n(Receptor Occupancy)" fillcolor="#4DD0E1"]
  }

  // ==================== CLUSTER 8: Drug PK — Targeted & ADC ====================
  subgraph cluster_pk_tgt {
    label="PK — Targeted Therapies & ADCs"
    style=filled fillcolor="#EFEBE9" color="#3E2723" fontcolor="#3E2723" fontsize=11
    Erda_dep   [label="Erdafitinib 8mg PO QD\n(Absorption Depot)" fillcolor="#D7CCC8"]
    Erda_plasm [label="Erdafitinib Plasma Concentration\n(FGFR1-4 Inhibitor)" fillcolor="#D7CCC8"]
    EnFV_c     [label="Enfortumab Vedotin\n(1.25mg/kg IV)" fillcolor="#D7CCC8"]
    EV_Nectin4 [label="EV–Nectin-4 Internalized Complex" fillcolor="#BCAAA4"]
    MMAE_ic    [label="MMAE Intracellular Concentration\n(Tubulin Disruption)" fillcolor="#BCAAA4"]
    SG_c       [label="Sacituzumab Govitecan\n(10mg/kg IV)" fillcolor="#D7CCC8"]
    SG_TROP2   [label="SG–TROP2 Internalized Complex" fillcolor="#BCAAA4"]
    SN38_ic    [label="SN-38 Intracellular\n(Topoisomerase I Inhibitor)" fillcolor="#BCAAA4"]
  }

  // ==================== CLUSTER 9: PD Effects ====================
  subgraph cluster_pd {
    label="Pharmacodynamics — Tumor Kill"
    style=filled fillcolor="#E8EAF6" color="#1A237E" fontcolor="#1A237E" fontsize=11
    Kill_BCG   [label="BCG-mediated Tumor Kill" fillcolor="#9FA8DA"]
    Kill_Chemo [label="GC Chemotherapy Tumor Kill" fillcolor="#9FA8DA"]
    Kill_IO    [label="IO-enhanced CTL Tumor Kill" fillcolor="#7986CB"]
    Kill_Erda  [label="Erdafitinib FGFR-inhibition Tumor Kill" fillcolor="#9FA8DA"]
    Kill_EV    [label="Enfortumab Vedotin (EV-ADC) Tumor Kill" fillcolor="#9FA8DA"]
    Kill_SG    [label="Sacituzumab Govitecan (SG-ADC) Tumor Kill" fillcolor="#9FA8DA"]
    ImmuneRes  [label="Immune Restoration\n(IO: PD-1/PD-L1 Blockade → CTL)" fillcolor="#5C6BC0"]
    TumShrink  [label="Tumor Burden Decrease\n(SLD↓)" fillcolor="#3949AB"]
    ResistMech [label="Resistance Mechanisms\n(Antigen Loss, EMT, PD-L1↑, TME Remodeling)" fillcolor="#9FA8DA"]
  }

  // ==================== CLUSTER 10: Clinical Outcomes ====================
  subgraph cluster_outcomes {
    label="Clinical Outcomes"
    style=filled fillcolor="#FFEBEE" color="#B71C1C" fontcolor="#B71C1C" fontsize=11
    NMIBC_s    [label="Non-muscle-invasive Bladder Cancer\n(NMIBC: Ta/T1/CIS)" fillcolor="#FFCDD2"]
    MIBC_s     [label="Muscle-invasive Bladder Cancer\n(MIBC: T2-T4a)" fillcolor="#FFCDD2"]
    Metastatic [label="Metastatic Urothelial Bladder Cancer\n(Stage IV)" fillcolor="#EF9A9A"]
    CRR_out    [label="Complete Response Rate\n(CRR — BCG NMIBC)" fillcolor="#FFCDD2"]
    ORR_out    [label="Objective Response Rate\n(ORR — Advanced UBC)" fillcolor="#FFCDD2"]
    RFS_out    [label="Recurrence-free Survival\n(RFS)" fillcolor="#FFCDD2"]
    PFS_out    [label="Progression-free Survival\n(PFS)" fillcolor="#FFCDD2"]
    OS_out     [label="Overall Survival\n(OS)" fillcolor="#EF9A9A"]
    BladPres   [label="Bladder Preservation Rate" fillcolor="#FFCDD2"]
    Cystoscopy [label="Cystoscopy Tumor Burden\n(SLD)" fillcolor="#FFCDD2"]
  }

  // ==================== CLUSTER 11: Biomarkers ====================
  subgraph cluster_bio {
    label="Biomarkers"
    style=filled fillcolor="#F1F8E9" color="#33691E" fontcolor="#33691E" fontsize=11
    FGFR3_ctDNA  [label="Urinary FGFR3 Mutation ctDNA" fillcolor="#DCEDC8"]
    Plasma_ctDNA [label="Plasma ctDNA Tumor Fraction" fillcolor="#DCEDC8"]
    NMP22_bio    [label="NMP22 Urinary Marker" fillcolor="#DCEDC8"]
    PDL1_IHC     [label="PD-L1 IHC\n(CPS/TC Score — KEYNOTE-045)" fillcolor="#DCEDC8"]
    TMB_bio      [label="TMB-H\n(Tumor Mutational Burden High)" fillcolor="#DCEDC8"]
    Nectin4_IHC  [label="Nectin-4 IHC\n(EV Eligibility: H-score)" fillcolor="#DCEDC8"]
    TROP2_IHC    [label="TROP2 IHC\n(SG Eligibility: H-score)" fillcolor="#DCEDC8"]
    CRP_bio      [label="Serum C-reactive Protein (CRP)" fillcolor="#DCEDC8"]
    Fibronectin  [label="Urinary Fibronectin" fillcolor="#DCEDC8"]
  }

  // ========================= EDGES =========================

  // Risk → Molecular
  Smoking -> Arylamines [label="combustion\nproducts"]
  Smoking -> Acrolein
  Arylamines -> FGFR3mut
  Arylamines -> TP53mut
  Acrolein   -> TP53mut
  OccExposure -> FGFR3mut
  OccExposure -> TP53mut
  Arsenic -> TP53mut
  Arsenic -> RB1del
  PelvicRad -> RB1del
  PelvicRad -> CDKN2Adel
  CycloPhos -> TP53mut
  ChronicUTI -> PIK3CAmut [label="chronic\ninflammation"]
  MaleAge -> FGFR3mut [label="sex/age\nbias"]
  GeneticSusc -> FGFR3mut [label="carcinogen\nactivation"]
  GeneticSusc -> TP53mut

  // Molecular → Signaling
  FGFR3mut  -> FGFR3sig [label="gain-of-function"]
  FGFR3sig  -> RASact -> MAPKpath -> Proliferat
  FGFR3sig  -> PI3Kpath
  PIK3CAmut -> PI3Kpath -> Proliferat
  PI3Kpath  -> Apop_inh
  PI3Kpath  -> BCL2sig -> Apop_inh
  ERBB2amp  -> MAPKpath
  ERBB2amp  -> STAT3sig -> Proliferat
  MYCamp    -> Proliferat
  TERT_prom -> Proliferat [label="telomere\nmaintain"]
  KDM6Amut  -> TP53mut [style=dashed label="chromatin\nremodel"]
  TP53mut   -> p53loss -> CellCycle -> Proliferat
  p53loss   -> Apop_inh
  RB1del    -> CellCycle
  CDKN2Adel -> CyclD1 [label="CDK4/6\nde-repressed"]
  CyclD1    -> CellCycle
  NFkBtumor -> Proliferat
  NFkBtumor -> Apop_inh
  WNTsig    -> Proliferat
  WNTsig    -> EMT [label="β-catenin\nnuclear"]
  STAT3sig  -> BCL2sig
  Proliferat -> TumorCells
  EMT       -> TumorCells [label="invasion"]
  EMT       -> Metastatic [label="distant\nspread"]

  // Tumor → TME
  TumorCells -> VEGF_tme [label="HIF-1α"]
  TumorCells -> TGFb_tme
  TumorCells -> IL10_tme
  TumorCells -> IDO1_tme
  TumorCells -> PDL1expr [label="IFN-γ\ninduction"]
  TumorCells -> Hypoxia_tme
  Hypoxia_tme -> VEGF_tme
  Hypoxia_tme -> IDO1_tme
  VEGF_tme   -> Angiogen
  VEGF_tme   -> CAF_tme [label="stroma\nrecruitment"]
  CAF_tme    -> TGFb_tme
  TGFb_tme   -> MDSC_tme [label="recruit/\nexpand"]
  TGFb_tme   -> Treg_tme [label="induce\nFoxp3+"]
  IL10_tme   -> MDSC_tme
  IL10_tme   -> TAM_M2 [label="M2\npolarize"]
  IDO1_tme   -> Treg_tme [label="kynurenine\ndrive"]
  TAM_M2     -> IL10_tme [label="M2 secrete"]
  TAM_M2     -> TGFb_tme
  NeutroTME  -> TGFb_tme
  Btme       -> IL10_tme [label="Breg\nfunction" style=dashed]

  // TME → immune suppression
  MDSC_tme -> CD8_eff [label="suppress CTL" color="#AD1457"]
  Treg_tme -> CD8_eff [label="suppress" color="#AD1457" constraint=false]
  TGFb_tme -> CD8_eff [label="inhibit" color="#AD1457" constraint=false]

  // Immune activation
  BCGstim -> TLR2_4 -> DC_mature
  DC_mature -> IL12_imm -> CD4_Th1 -> IL2_imm -> CD8_eff
  CD4_Th1   -> IFNg_imm
  CD8_eff   -> IFNg_imm
  NK_cells  -> TNFa_imm -> Kill_BCG
  NK_cells  -> IFNg_imm
  IFNg_imm  -> PDL1expr [label="IFN-γ\nupregulates\nPD-L1"]
  IFNg_imm  -> Kill_BCG
  IFNg_imm  -> Kill_IO
  MSIstat   -> TMB_bio [label="high\nneoantigen"]
  MSIstat   -> CD8_eff [label="neoantigen\nload"]

  // T cell exhaustion
  PD1_expr  -> CD8_eff [label="exhaust" color="#AD1457" constraint=false]
  PDL1expr  -> PD1_expr [label="engage\ncheckpoint" constraint=false]
  LAG3_expr -> CD8_eff [label="co-inhibit" color="#AD1457" constraint=false]
  TIM3_expr -> CD8_eff [label="co-inhibit" color="#AD1457" constraint=false]
  CTLA4_expr -> DC_mature [label="block\nco-stimul" color="#AD1457" constraint=false]

  // ---- BCG PK ----
  BCG_depot -> BCG_eff [label="kabs_BCG\n(bladder wall)"]
  BCG_eff   -> BCGstim [label="TLR activation"]
  BCG_eff   -> Kill_BCG

  // ---- Chemo PK ----
  Cis_plasm -> Cis_DNA  [label="DNA crosslink"]
  Gem_plasm -> Gem_act  [label="phosphorylation\n→ dFdCTP"]
  Cis_DNA   -> Kill_Chemo
  Gem_act   -> Kill_Chemo

  // ---- IO PK ----
  Pembro_c -> Pembro_p [label="CL2 dist" constraint=false]
  Pembro_p -> Pembro_c [label="redist" constraint=false]
  Pembro_c -> Pembro_RO [label="PD-1 binding"]
  Atezo_c  -> Atezo_p  [label="CL2 dist" constraint=false]
  Atezo_p  -> Atezo_c  [label="redist" constraint=false]
  Atezo_c  -> Atezo_RO [label="PD-L1 binding"]
  Pembro_RO -> ImmuneRes [label="PD-1\nblockade"]
  Atezo_RO  -> ImmuneRes [label="PD-L1\nblockade"]
  ImmuneRes -> CD8_eff [label="CTL rescue" constraint=false]
  ImmuneRes -> Kill_IO

  // ---- Erdafitinib PK ----
  Erda_dep   -> Erda_plasm [label="oral Fabs~70%"]
  Erda_plasm -> FGFR3sig   [label="FGFR1-4\ninhibition" color="#0D47A1"]
  FGFR3sig   -> Kill_Erda  [constraint=false]

  // ---- Enfortumab vedotin PK ----
  EnFV_c   -> EV_Nectin4 [label="Nectin-4 bind"]
  Nectin4hi -> EV_Nectin4
  EV_Nectin4 -> MMAE_ic  [label="internalize/\nprotease cleavage"]
  MMAE_ic    -> Kill_EV   [label="tubulin\ndisruption"]

  // ---- Sacituzumab govitecan PK ----
  SG_c     -> SG_TROP2  [label="TROP2 bind"]
  TROP2hi  -> SG_TROP2
  SG_TROP2 -> SN38_ic   [label="internalize\n/pH cleavage"]
  SN38_ic  -> Kill_SG   [label="TopoisomeraseI\ninhibit"]

  // PD → Tumor burden
  Kill_BCG   -> TumShrink
  Kill_Chemo -> TumShrink
  Kill_IO    -> TumShrink
  Kill_Erda  -> TumShrink
  Kill_EV    -> TumShrink
  Kill_SG    -> TumShrink
  TumShrink  -> TumorCells [label="reduce" constraint=false]
  TumorCells -> ResistMech [label="clonal\nevolution" constraint=false]
  ResistMech -> PFS_out    [label="limit\nbenefit" constraint=false]

  // Clinical staging
  TumorCells -> NMIBC_s [label="early\nstage"]
  EMT        -> MIBC_s
  MIBC_s     -> Metastatic [label="stage\nprogression" constraint=false]

  // Clinical outcomes
  NMIBC_s    -> RFS_out
  TumShrink  -> CRR_out  [label="NMIBC\ncomplete\nresponse"]
  TumShrink  -> ORR_out  [label="advanced\nUBC response"]
  ORR_out    -> PFS_out
  PFS_out    -> OS_out   [constraint=false]
  TumorCells -> Cystoscopy
  Cystoscopy -> CRR_out
  CRR_out    -> BladPres

  // Biomarkers
  FGFR3mut    -> FGFR3_ctDNA
  TumorCells  -> Plasma_ctDNA
  TumorCells  -> NMP22_bio
  PDL1expr    -> PDL1_IHC
  MSIstat     -> TMB_bio
  Nectin4hi   -> Nectin4_IHC
  TROP2hi     -> TROP2_IHC
  TGFb_tme    -> CRP_bio
  TumorCells  -> Fibronectin

  // Nectin-4/TROP2 expressed on tumor cells
  TumorCells  -> Nectin4hi
  TumorCells  -> TROP2hi

  // IFN-gamma → BCG amplification
  IFNg_imm -> BCGstim [label="amplify" constraint=false]

  // Biomarker → treatment eligibility (dashed)
  FGFR3_ctDNA -> Erda_dep  [label="FGFR-altered\npatient" style=dashed color="#0D47A1"]
  PDL1_IHC    -> Pembro_c  [label="CPS≥10\nselection" style=dashed color="#004D40"]
  Nectin4_IHC -> EnFV_c    [label="Nectin-4+\nselection" style=dashed color="#3E2723"]
  TROP2_IHC   -> SG_c      [label="TROP2+\nselection" style=dashed color="#3E2723"]
}
