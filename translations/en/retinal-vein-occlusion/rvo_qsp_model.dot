    label = "23 · Adverse effects — the cost side of the ledger";
    style = "rounded,filled"; fillcolor = "#fce4ec"; color = "#ad1457"; fontsize = 12;
    ENDOPH  [label = "Endophthalmitis ~0.02–0.05% / injection\ncumulative with injection number", fillcolor = "#f8bbd0"];
    IOPSPIKE[label = "Transient IOP spike just after injection\n(0.05 mL into 4 mL)", fillcolor = "#f8bbd0"];
    STEROIOP[label = "★ Steroid-induced IOP rise\nIOP ≥ 10 mmHg rise in ~16% (GENEVA)\nglaucoma surgery ~1%", fillcolor = "#f48fb1"];
    CATN    [label = "★★ CAT — cataract\ndCAT/dt = 0.0024·CDEX/(150+CDEX) + age\n~30%/yr with implants; 68% at 3 yr (MEAD)", fillcolor = "#f48fb1", penwidth = 2.4];
    IOI     [label = "Intraocular inflammation · occlusive retinal\nvasculitis (brolucizumab ~4%)", fillcolor = "#f8bbd0"];
    RPETEAR [label = "RPE tear · vitreous haemorrhage · retinal detachment", fillcolor = "#f8bbd0"];
    SYSVEGF [label = "★ Systemic VEGF suppression\naflibercept: plasma free VEGF ~99% suppressed\nranibizumab: ~40%\n→ theoretical ATE / BP / renal signal", fillcolor = "#f48fb1", penwidth = 2.2];
    GEOATR  [label = "Atrophy · retinal thinning (long-term)\nMacular atrophy with chronic\nVEGF suppression (trophic role)", fillcolor = "#f8bbd0"];
    TACHY   [label = "Tachyphylaxis · anti-drug antibodies", fillcolor = "#f8bbd0"];
    IVT -> ENDOPH [penwidth = 1.8]; IVT -> IOPSPIKE [penwidth = 1.6];
    IVT -> RPETEAR [style = dashed]; BROLU -> IOI [penwidth = 1.8];
    ESTER -> STEROIOP [penwidth = 2.2]; ESTER -> CATN [penwidth = 2.4];
    STEROIOP -> IOPN [penwidth = 2.2]; CATN -> LCAT [penwidth = 2.4];
    ASYSN -> SYSVEGF [penwidth = 2.2];
    CRETN -> GEOATR [style = dashed]; DVITN -> TACHY [style = dashed];
    ENDOPH -> BCVAN [color = "#c62828", style = dashed];
  }

  /* =====================================================================
     24 · BIOMARKERS AND IMAGING
     ===================================================================== */
  subgraph cluster_24 {
    label = "24 · Biomarkers and imaging";
    style = "rounded,filled"; fillcolor = "#eceff1"; color = "#455a64"; fontsize = 12;
    OCTM    [label = "OCT — CST · cysts · SRF · EZ · DRIL\nthe workhorse", fillcolor = "#e0e0e0"];
    OCTA    [label = "OCT-A — FAZ area · vessel density\nSCP / DCP perfusion, DCP loss\npredicts letters", fillcolor = "#e0e0e0"];
    FA      [label = "Fluorescein angiography (FA) — non-perfused area\nUltra-widefield FA: DA of non-perfusion", fillcolor = "#e0e0e0"];
    AQHUM   [label = "Aqueous humour cytokines\nAqueous VEGF, IL-6, IL-8, MCP-1, Ang-2\n(research; correlates with CST)", fillcolor = "#e0e0e0"];
    ERGB    [label = "ERG b/a ratio · pupil response\nERG b-wave, RAPD (ischaemia marker)", fillcolor = "#e0e0e0"];
    GONIO   [label = "Gonioscopy · iris angiography\nGonioscopy (undilated!), iris FA", fillcolor = "#e0e0e0"];
    BPMON   [label = "24-hour ambulatory BP · nocturnal dip\n24-h ABPM", fillcolor = "#e0e0e0"];
    CST -> OCTM [style = dotted, color = "#616161"];
    EZONE -> OCTM [style = dotted, color = "#616161"];
    DRILN -> OCTM [style = dotted, color = "#616161"];
    MISCH -> OCTA [style = dotted, color = "#616161"];
    NPAREA -> FA [style = dotted, color = "#616161"];
    VTONE -> AQHUM [style = dotted, color = "#616161"];
    IL6N -> AQHUM [style = dotted, color = "#616161"];
    ANG2 -> AQHUM [style = dotted, color = "#616161"];
    MISCH -> ERGB [style = dotted, color = "#616161"];
    NVISTATE -> GONIO [style = dotted, color = "#616161"];
    PAIN -> BPMON [style = dotted, color = "#616161"];
  }

  /* =====================================================================
     25 · CLINICAL DECISION LAYER
     ===================================================================== */
  subgraph cluster_25 {
    label = "25 · The decision layer";
    style = "rounded,filled"; fillcolor = "#fffde7"; color = "#f9a825"; fontsize = 13;
    LOAD    [label = "Loading regimen\nq4w × 3–6 injections", fillcolor = "#fff59d"];
    PRN     [label = "PRN (as-needed)\nmonthly monitoring, treat if wet", fillcolor = "#fff59d"];
    TAE     [label = "Treat-and-extend\nextend +4 w if dry, shorten −4 w if wet\ncap 16 w", fillcolor = "#fff59d"];
    FIXEDQ  [label = "Fixed q8w maintenance", fillcolor = "#fff59d"];
    SWITCH  [label = "Switching agent\nSwitch agent for persistent oedema\n★ useless if the eye is a FLOOR eye", fillcolor = "#ffe082", penwidth = 2.2];
    ADDSTER [label = "Add a steroid\nfor the non-VEGF mediators\n(pseudophakic, non-responder)", fillcolor = "#fff59d"];
    NVGWATCH[label = "Ischaemia surveillance: gonioscopy,\nwidefield FA, do NOT stop the drug\nwhile NP persists", fillcolor = "#ffe082", penwidth = 2.2];
    UNDER   [label = "★ Undertreatment in real practice\nReal world: 4–5 injections/yr\n→ about half the trial letter gain", fillcolor = "#ffcc80", penwidth = 2.2];
    SYSWORK [label = "Systemic work-up\nBP, lipids, glucose, CBC;\nthrombophilia only if young/bilateral", fillcolor = "#fff59d"];
    FELLOW  [label = "Fellow-eye risk\nFellow-eye RVO risk ~7–10% / 5 yr\n→ systemic risk control matters twice", fillcolor = "#fff59d"];
    CST -> PRN [style = dotted, color = "#616161", label = "retreat if\nCST > 310 µm"];
    CST -> TAE [style = dotted, color = "#616161"];
    LOAD -> PRN; LOAD -> TAE; LOAD -> FIXEDQ;
    PRN -> IVT [color = "#1565c0", style = dashed];
    TAE -> IVT [color = "#1565c0", style = dashed];
    FIXEDQ -> IVT [color = "#1565c0", style = dashed];
    SWITCH -> IVT [color = "#1565c0", style = dashed];
    DRYDAYS -> SWITCH [style = dashed, color = "#bf360c",
                       label = "if wet WHILE suppressed,\ndo not switch"];
    PCSTAR -> ADDSTER [style = dashed];
    PCSTAR -> BPRX [style = dashed, color = "#00838f", penwidth = 2.0,
                    label = "treat the LEFT half"];
    NPAREA -> NVGWATCH [style = dotted, color = "#616161"];
    REBOUND -> NVGWATCH [style = dashed, color = "#c62828"];
    ADDSTER -> OZUR [color = "#1565c0", style = dashed];
    UNDER -> BCVAN [color = "#c62828", style = dashed];
    SYSWORK -> BPRX [style = dashed]; SYSWORK -> FELLOW [style = dashed];
    HTN -> SYSWORK [style = dotted, color = "#616161"];
  }

  /* =====================================================================
     GLOBAL LAYOUT HINTS
     ===================================================================== */
  { rank = same; PCAP; TJSTATE; }
  { rank = same; BRACK; LPNODE; }
  { rank = same; JVNODE; PCSTAR; }
  { rank = same; CST; BCVAN; }
}
