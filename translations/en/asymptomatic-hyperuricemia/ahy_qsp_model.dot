digraph AsymptomaticHyperuricemia {
    graph [
        label="Asymptomatic Hyperuricemia (AHY)\nQuantitative Systems Pharmacology Model\nQSP Mechanistic Map"
        labelloc=t
        fontsize=22
        fontname="Helvetica-Bold"
        rankdir=LR
        bgcolor="#FAFAFA"
        splines=ortho
        nodesep=0.4
        ranksep=0.8
        compound=true
    ]
    node [fontname="Helvetica" fontsize=10 style=filled shape=box]
    edge [fontname="Helvetica" fontsize=8]

    /* =============================================
       CLUSTER 1: DIETARY & EXOGENOUS INPUTS
       ============================================= */
    subgraph cluster_diet {
        label="1. Dietary & Exogenous Purine Input"
        style=filled fillcolor="#FFF8E7" color="#E8A000" penwidth=2
        fontname="Helvetica-Bold" fontsize=13

        DietPurine     [label="Dietary Purines" fillcolor="#FFE082"]
        DietFructose   [label="Dietary Fructose" fillcolor="#FFE082"]
        Alcohol        [label="Alcohol\n(Ethanol)" fillcolor="#FFE082"]
        RedMeat        [label="Red Meat/Organ Meat" fillcolor="#FFE082"]
        Seafood        [label="Seafood" fillcolor="#FFE082"]
        SugarDrinks    [label="Sugary Beverages" fillcolor="#FFE082"]
        GIAbsorption   [label="GI Absorption" shape=ellipse fillcolor="#FFD54F"]
    }

    /* =============================================
       CLUSTER 2: PURINE DE NOVO BIOSYNTHESIS
       ============================================= */
    subgraph cluster_denovo {
        label="2. De Novo Purine Synthesis"
        style=filled fillcolor="#E8F5E9" color="#2E7D32" penwidth=2
        fontname="Helvetica-Bold" fontsize=13

        PRPP           [label="PRPP\n(5-phosphoribosyl-1-PP)" fillcolor="#A5D6A7"]
        PRPP_synthetase [label="PRPP Synthetase" shape=diamond fillcolor="#66BB6A"]
        ATPP_feedback  [label="AMP/GMP Feedback" shape=ellipse fillcolor="#81C784"]
        IMP            [label="IMP\n(Inosinate)" fillcolor="#A5D6A7"]
        AMP            [label="AMP\n(Adenosine 5'-MP)" fillcolor="#A5D6A7"]
        GMP            [label="GMP\n(Guanosine 5'-MP)" fillcolor="#A5D6A7"]
        ATP            [label="ATP" fillcolor="#A5D6A7"]
        GTP            [label="GTP" fillcolor="#A5D6A7"]
        AdenyloSucc    [label="Adenylosuccinate" fillcolor="#C8E6C9"]
        XMP            [label="XMP\n(Xanthylate)" fillcolor="#C8E6C9"]
        FGAM           [label="FGAM\n(Formylglycinamidine)" fillcolor="#C8E6C9"]
        SAICAR         [label="SAICAR step\n(Bicyclic intermediate)" fillcolor="#C8E6C9"]
    }

    /* =============================================
       CLUSTER 3: PURINE CATABOLISM & SALVAGE
       ============================================= */
    subgraph cluster_catabolism {
        label="3. Purine Catabolism & Salvage"
        style=filled fillcolor="#E3F2FD" color="#1565C0" penwidth=2
        fontname="Helvetica-Bold" fontsize=13

        Adenosine      [label="Adenosine" fillcolor="#90CAF9"]
        Inosine        [label="Inosine" fillcolor="#90CAF9"]
        Hypoxanthine   [label="Hypoxanthine" fillcolor="#64B5F6"]
        Xanthine       [label="Xanthine" fillcolor="#42A5F5"]
        UricAcid_prod  [label="Uric Acid Production" fillcolor="#1E88E5"]
        Guanosine      [label="Guanosine" fillcolor="#90CAF9"]
        Guanine        [label="Guanine" fillcolor="#64B5F6"]
        ADA            [label="ADA\n(Adenosine Deaminase)" shape=diamond fillcolor="#42A5F5"]
        PNP            [label="PNP\n(Purine Nucleoside\nPhosphorylase)" shape=diamond fillcolor="#42A5F5"]
        XO             [label="XO/XDH\n(Xanthine Oxidase/\nDehydrogenase)" shape=diamond fillcolor="#1565C0" fontcolor=white]
        HGPRT          [label="HGPRT\n(Hypoxanthine-Guanine\nPhosphoribosyl Transferase)" shape=diamond fillcolor="#1E88E5" fontcolor=white]
        APRT           [label="APRT\n(Adenine\nPhosphoribosyl Transferase)" shape=diamond fillcolor="#42A5F5"]
        H2O2_ROS       [label="H₂O₂/ROS\n(Oxidative Stress)" fillcolor="#BBDEFB"]
        Superoxide     [label="Superoxide O₂⁻" fillcolor="#BBDEFB"]
    }

    /* =============================================
       CLUSTER 4: RENAL URIC ACID HANDLING
       ============================================= */
    subgraph cluster_renal {
        label="4. Renal Uric Acid Handling"
        style=filled fillcolor="#F3E5F5" color="#6A1B9A" penwidth=2
        fontname="Helvetica-Bold" fontsize=13

        GFR            [label="Glomerular Filtration Rate\n(GFR, mL/min)" fillcolor="#CE93D8"]
        FilteredUA     [label="Filtered UA\n(~70%)" fillcolor="#BA68C8"]
        S1_reabs       [label="S1 reabsorption (~98%)\nearly proximal tubule" fillcolor="#AB47BC"]
        S2_secr        [label="S2 secretion\nmid proximal tubule" fillcolor="#9C27B0" fontcolor=white]
        S3_postsecr    [label="S3 post-secretory reabsorption\nlate proximal tubule" fillcolor="#8E24AA" fontcolor=white]
        URAT1          [label="URAT1\n(SLC22A12)\nreabsorptive transporter" shape=diamond fillcolor="#CE93D8"]
        GLUT9          [label="GLUT9\n(SLC2A9)\nbasolateral transporter" shape=diamond fillcolor="#CE93D8"]
        OAT1           [label="OAT1\n(SLC22A6)\nsecretory transporter" shape=diamond fillcolor="#BA68C8"]
        OAT3           [label="OAT3\n(SLC22A8)\nsecretory transporter" shape=diamond fillcolor="#BA68C8"]
        OAT4           [label="OAT4\n(SLC22A11)\nreabsorptive transporter" shape=diamond fillcolor="#BA68C8"]
        NPT1           [label="NPT1\n(SLC17A1)\nsecretory transporter" shape=diamond fillcolor="#CE93D8"]
        NPT4           [label="NPT4\n(SLC17A3)\nsecretory transporter" shape=diamond fillcolor="#CE93D8"]
        ABCG2_renal    [label="ABCG2\n(renal secretion)" shape=diamond fillcolor="#AB47BC"]
        FractExcretion [label="Fractional Excretion\n(FEUA, 3-10%)" fillcolor="#CE93D8"]
        UrinaryUA      [label="Urinary UA\n(mg/day)" fillcolor="#CE93D8"]
        CrystalRisk    [label="Crystal Formation Risk" shape=hexagon fillcolor="#EF9A9A"]
    }

    /* =============================================
       CLUSTER 5: INTESTINAL HANDLING
       ============================================= */
    subgraph cluster_gut {
        label="5. Intestinal UA Secretion"
        style=filled fillcolor="#FFF3E0" color="#E65100" penwidth=2
        fontname="Helvetica-Bold" fontsize=13

        ABCG2_gut      [label="Intestinal ABCG2\n(SLC → Gut Lumen)" shape=diamond fillcolor="#FFCC80"]
        GutSecretion   [label="Intestinal secretion\n(~33% of total\nexcretion)" fillcolor="#FFB74D"]
        GutMicrobiome  [label="Gut Microbiome\n(Uricase+/-)" fillcolor="#FFA726"]
        FecalUA        [label="Fecal UA" fillcolor="#FF9800"]
        Uricase_micro  [label="Microbial Uricase\n→ Allantoin" shape=diamond fillcolor="#FFCC80"]
        BacterialAllantoin [label="Allantoin\n(from microbiome)" fillcolor="#FFB74D"]
    }

    /* =============================================
       CLUSTER 6: SERUM URIC ACID POOL
       ============================================= */
    subgraph cluster_SUA {
        label="6. Serum Uric Acid Pool & Saturation"
        style=filled fillcolor="#FCE4EC" color="#880E4F" penwidth=2
        fontname="Helvetica-Bold" fontsize=13

        SUA            [label="Serum Uric Acid\n(SUA, mg/dL)\nNormal: ♂<7.0, ♀<6.0\nAHY: ≥7.0" shape=octagon fillcolor="#F48FB1" fontsize=12]
        SUA_saturation [label="MSU saturation\n(6.8mg/dL)" fillcolor="#F06292"]
        MSU_crystal    [label="Monosodium Urate\nCrystal Nucleation" shape=hexagon fillcolor="#EC407A"]
        BodyPool_UA    [label="Body UA Pool\n(~1000-1500mg normal)" fillcolor="#F48FB1"]
        Tophus_risk    [label="Tophus Formation\nRisk Score" shape=hexagon fillcolor="#E91E63"]
        GoutFlare_risk [label="Gout Flare Risk\n(>9mg/dL ↑10x)" shape=hexagon fillcolor="#AD1457" fontcolor=white]
    }

    /* =============================================
       CLUSTER 7: CARDIOVASCULAR EFFECTS
       ============================================= */
    subgraph cluster_cardio {
        label="7. Cardiovascular Effects"
        style=filled fillcolor="#E8EAF6" color="#283593" penwidth=2
        fontname="Helvetica-Bold" fontsize=13

        Endothelium    [label="Vascular Endothelium" fillcolor="#9FA8DA"]
        eNOS_inhibit   [label="eNOS inhibition\n(eNOS↓ → NO↓)" fillcolor="#7986CB"]
        NO_deficiency  [label="Nitric Oxide deficiency\n(NO↓ → Vasodilation↓)" fillcolor="#5C6BC0"]
        RAAS_activ     [label="RAAS activation\n(AngII↑, Aldosterone↑)" fillcolor="#3949AB"]
        BP_elevation   [label="Blood pressure elevation\n(Hypertension risk)" shape=hexagon fillcolor="#EF5350"]
        Oxidative_CV   [label="Vascular oxidative stress\n(Vascular ROS↑)" fillcolor="#7986CB"]
        Inflammation_CV [label="Vascular\nInflammation: CRP↑" fillcolor="#7986CB"]
        Platelet_activ [label="Platelet Activation↑" fillcolor="#9FA8DA"]
        Thrombosis_risk [label="Thrombosis Risk" shape=hexagon fillcolor="#EF5350"]
        LDL_oxidation  [label="LDL oxidation\n(ox-LDL↑)" fillcolor="#9FA8DA"]
        Atherogenesis  [label="Atherosclerosis\nProgression" shape=hexagon fillcolor="#C62828" fontcolor=white]
        CV_events      [label="CV Events: MI, Stroke\nrisk +27%" shape=hexagon fillcolor="#B71C1C" fontcolor=white]
        CardiacHyp     [label="Cardiac Hypertrophy" fillcolor="#7986CB"]
        HeartFailure_risk [label="Heart Failure Risk" shape=hexagon fillcolor="#EF5350"]
    }

    /* =============================================
       CLUSTER 8: RENAL & METABOLIC EFFECTS
       ============================================= */
    subgraph cluster_renal_eff {
        label="8. Renal & Metabolic Effects"
        style=filled fillcolor="#E0F7FA" color="#00695C" penwidth=2
        fontname="Helvetica-Bold" fontsize=13

        RenalTubular   [label="Tubular Injury" fillcolor="#80DEEA"]
        TubuloInters   [label="Tubulointerstitial\nFibrosis" fillcolor="#4DD0E1"]
        GFR_decline    [label="GFR Decline\n(CKD Progression)" shape=hexagon fillcolor="#EF5350"]
        Afferent_art   [label="Afferent Arteriole\nConstriction" fillcolor="#26C6DA"]
        RAAS_renal     [label="Intra-renal RAAS↑" fillcolor="#00BCD4"]
        Microalbumin   [label="Microalbuminuria" shape=hexagon fillcolor="#EF5350"]
        InsulinResist  [label="Insulin Resistance" fillcolor="#80DEEA"]
        HyperTG        [label="Hypertriglyceridemia" fillcolor="#4DD0E1"]
        FattyLiver_risk [label="NAFLD Risk" shape=hexagon fillcolor="#FF8F00"]
        Hyperglycemia  [label="Hyperglycemia↑" fillcolor="#80DEEA"]
        MetSyn_assoc   [label="MetSyn Association" shape=hexagon fillcolor="#FF8F00"]
    }

    /* =============================================
       CLUSTER 9: INFLAMMATORY PATHWAY
       ============================================= */
    subgraph cluster_inflam {
        label="9. Subclinical Inflammation Pathway"
        style=filled fillcolor="#FFEFFE" color="#7B1FA2" penwidth=2
        fontname="Helvetica-Bold" fontsize=13

        NLRP3          [label="NLRP3\nInflammasome" shape=diamond fillcolor="#CE93D8"]
        Caspase1       [label="Caspase-1" shape=diamond fillcolor="#BA68C8"]
        IL1beta        [label="IL-1β\n(Interleukin-1β)" fillcolor="#AB47BC"]
        IL6            [label="IL-6\n(Interleukin-6)" fillcolor="#9C27B0" fontcolor=white]
        TNFalpha       [label="TNF-α\n(Tumor Necrosis Factor-α)" fillcolor="#8E24AA" fontcolor=white]
        NFkB           [label="NF-κB\n(activated transcription factor)" shape=diamond fillcolor="#6A1B9A" fontcolor=white]
        CRP            [label="CRP\n(C-reactive protein: hs-CRP↑)" fillcolor="#CE93D8"]
        Neutrophils    [label="Neutrophil Activation" fillcolor="#BA68C8"]
        MacroInfil     [label="Macrophage Infiltration" fillcolor="#AB47BC"]
        MAPK           [label="MAPK/JNK pathway\n(Stress Signaling)" shape=diamond fillcolor="#CE93D8"]
        Pyroptosis     [label="Pyroptosis" fillcolor="#E1BEE7"]
    }

    /* =============================================
       CLUSTER 10: DRUG PK/PD — ALLOPURINOL
       ============================================= */
    subgraph cluster_allopurinol {
        label="10. Drug PK/PD — Allopurinol"
        style=filled fillcolor="#E8F5E9" color="#1B5E20" penwidth=2
        fontname="Helvetica-Bold" fontsize=13

        Allopurinol_dose [label="Allopurinol dosing\n(100-900mg/day)" fillcolor="#A5D6A7"]
        Allopurinol_abs  [label="Allopurinol absorption\n(F=0.90)" fillcolor="#81C784"]
        Allopurinol_C    [label="Plasma allopurinol\n(Cmax: 2-3μg/mL\nt½=1-2h)" fillcolor="#66BB6A"]
        Oxypurinol_form  [label="Oxypurinol Formation\nby XO/AO" shape=diamond fillcolor="#4CAF50"]
        Oxypurinol_C     [label="Plasma oxypurinol\n(Active Metabolite\nCss=5-15mg/L\nt½=18-30h)" fillcolor="#388E3C" fontcolor=white]
        Oxypurinol_renal [label="Oxypurinol renal excretion\n(Renal Clearance\nCL=30mL/min)" fillcolor="#2E7D32" fontcolor=white]
        XO_inhibit_all   [label="XO competitive/irreversible\ninhibition" shape=diamond fillcolor="#1B5E20" fontcolor=white]
        UA_reduction_all [label="Urate-lowering effect\n(SUA↓ 30-40%)" shape=hexagon fillcolor="#C8E6C9"]
        Allo_tox         [label="Toxicity risk\n(Stevens-Johnson\nSyn: HLA-B*58:01)" shape=hexagon fillcolor="#FFCDD2"]
    }

    /* =============================================
       CLUSTER 11: DRUG PK/PD — FEBUXOSTAT
       ============================================= */
    subgraph cluster_febuxostat {
        label="11. Drug PK/PD — Febuxostat"
        style=filled fillcolor="#FFF8E1" color="#F57F17" penwidth=2
        fontname="Helvetica-Bold" fontsize=13

        Febux_dose     [label="Febuxostat dosing\n(40-120mg/day)" fillcolor="#FFE082"]
        Febux_abs      [label="Absorption\n(F=0.84, Tmax=1-1.5h)" fillcolor="#FFD54F"]
        Febux_C        [label="Plasma concentration\n(Cmax: 5.4μg/mL at 120mg\nt½=5-8h)" fillcolor="#FFCA28"]
        Febux_met      [label="Metabolism\n(CYP1A2, 2C8, UGT\nAcyl glucuronide)" fillcolor="#FFC107"]
        XO_inhibit_feb [label="Selective XO inhibition\n(Non-purine scaffold\nIC50=0.6nM)" shape=diamond fillcolor="#FF8F00" fontcolor=white]
        UA_reduction_feb [label="Urate-lowering effect\n(SUA↓ 40-53%\nvs allopurinol)" shape=hexagon fillcolor="#FFE082"]
        Febux_CV_risk  [label="CV safety\n(CARES Trial:\nCV death↑ vs. Allo)" shape=hexagon fillcolor="#FF7043"]
        Febux_renal    [label="Renal safety\n(preferred in CKD)" fillcolor="#FFE082"]
    }

    /* =============================================
       CLUSTER 12: DRUG PK/PD — URICOSURICS
       ============================================= */
    subgraph cluster_uricosuric {
        label="12. Drug PK/PD — Uricosuric Agents"
        style=filled fillcolor="#E0F2F1" color="#004D40" penwidth=2
        fontname="Helvetica-Bold" fontsize=13

        Probenecid_dose [label="Probenecid dosing\n(500-2000mg/day)" fillcolor="#80CBC4"]
        Probenecid_C    [label="Plasma probenecid\n(t½=6-12h, CL=12mL/min)" fillcolor="#4DB6AC"]
        URAT1_inhibit  [label="URAT1 inhibition\n(blocks renal reabsorption)" shape=diamond fillcolor="#26A69A"]
        UA_excr_incr   [label="Uricosuria↑" fillcolor="#80CBC4"]
        Lesinurad_dose [label="Lesinurad dosing\n(200-400mg/day)" fillcolor="#80CBC4"]
        Lesinurad_C    [label="Plasma lesinurad\n(t½=5h, F=1.00)" fillcolor="#4DB6AC"]
        URAT1_OAT4_inh [label="Dual URAT1/OAT4\nInhibition" shape=diamond fillcolor="#00897B" fontcolor=white]
        Dotinurad_dose [label="Dotinurad dosing\n(0.5-4mg/day)" fillcolor="#80CBC4"]
        URAT1_ABCG2_sel [label="Selective URAT1 inhibition\n(vs. Probenecid)" shape=diamond fillcolor="#00796B" fontcolor=white]
        SUA_uricosuric [label="Urate-lowering effect\n(SUA↓ 15-30%)" shape=hexagon fillcolor="#B2DFDB"]
        Urolith_risk   [label="Urolithiasis Risk↑\n+ hydration required" shape=hexagon fillcolor="#FFCDD2"]
    }

    /* =============================================
       CLUSTER 13: BIOLOGICAL — PEGLOTICASE
       ============================================= */
    subgraph cluster_biologic {
        label="13. Biologics — Pegloticase/Uricase"
        style=filled fillcolor="#EDE7F6" color="#4527A0" penwidth=2
        fontname="Helvetica-Bold" fontsize=13

        Pegloticase_dose [label="Pegloticase dosing\n(8mg IV\nq2weeks)" fillcolor="#D1C4E9"]
        Pegloti_C      [label="Plasma concentration\n(t½=6-14days\nPEGylated uricase)" fillcolor="#B39DDB"]
        Uricase_rxn    [label="Uricase reaction\n(UA→Allantoin\n5-10x solubility↑)" shape=diamond fillcolor="#9575CD"]
        Allantoin_prod [label="Allantoin production\n(readily renally\nexcreted)" fillcolor="#7E57C2" fontcolor=white]
        SUA_rapid_drop [label="Rapid urate lowering\n(SUA↓ >80%\n<6mg/dL in 24h)" shape=hexagon fillcolor="#B39DDB"]
        AntiPEG_Ab     [label="Anti-PEG Antibody\n→ ADA-mediated\nfailure" shape=hexagon fillcolor="#EF5350"]
        Infusion_rxn   [label="Infusion Reaction\n(26-47%)" shape=hexagon fillcolor="#FFCDD2"]
    }

    /* =============================================
       CLUSTER 14: GENETIC FACTORS
       ============================================= */
    subgraph cluster_genetics {
        label="14. Genetic Determinants"
        style=filled fillcolor="#F1F8E9" color="#33691E" penwidth=2
        fontname="Helvetica-Bold" fontsize=13

        ABCG2_Q141K    [label="ABCG2 Q141K\n(rs2231142)\nsecretory function 50%↓" fillcolor="#DCEDC8"]
        SLC22A12_var   [label="SLC22A12 variant\n(URAT1\nreabsorption↑)" fillcolor="#DCEDC8"]
        SLC2A9_var     [label="SLC2A9 variant\n(GLUT9\nreabsorption↑)" fillcolor="#DCEDC8"]
        HLAB5801       [label="HLA-B*58:01\n(allopurinol\ntoxicity risk↑)" fillcolor="#FFCDD2"]
        XDH_var        [label="XDH variant\n(XO superactivity\n→ production↑)" fillcolor="#DCEDC8"]
        PRPPS_var      [label="PRPP synthetase\nX-linked mutation\n(XL Superactivity)" fillcolor="#DCEDC8"]
        HGPRT_def      [label="HGPRT deficiency\n(Lesch-Nyhan\npartial form)" fillcolor="#FFCDD2"]
        Polygenic_SUA  [label="Polygenic SUA\nScore: GWAS\n180+ loci" fillcolor="#C5E1A5"]
    }

    /* =============================================
       CLUSTER 15: CLINICAL ENDPOINTS & MONITORING
       ============================================= */
    subgraph cluster_endpoints {
        label="15. Clinical Endpoints & Treatment Targets"
        style=filled fillcolor="#FFEBEE" color="#B71C1C" penwidth=2
        fontname="Helvetica-Bold" fontsize=13

        SUA_target     [label="SUA treatment target\n(Target SUA\n<6.0mg/dL general\n<5.0mg/dL gout)" shape=octagon fillcolor="#FFCDD2"]
        Flare_freq     [label="Gout Flare Frequency\n(≥1 per year\n→ treat)" shape=hexagon fillcolor="#EF5350"]
        Tophus_resolve [label="Tophus Resolution\n(>1 year of\ntreatment needed)" shape=hexagon fillcolor="#E53935"]
        Renal_protect  [label="Renal Protection\n(SUA<6 → GFR\npreserved)" shape=hexagon fillcolor="#D32F2F" fontcolor=white]
        CV_protect     [label="CV Protection\n(controversial:\nSUA<6?)" shape=hexagon fillcolor="#C62828" fontcolor=white]
        JointDamage    [label="Joint Damage\n(X-ray erosions)" shape=hexagon fillcolor="#EF5350"]
        QoL            [label="Quality of Life\n(HAQ/SF-36)" shape=hexagon fillcolor="#E53935"]
        Treatment_dur  [label="Treatment decision\n(AHY: when to treat?\nAsymptomatic vs.\n>9mg/dL high risk)" shape=octagon fillcolor="#FFCDD2"]
    }

    /* =============================================
       INTER-CLUSTER EDGES
       ============================================= */

    /* Dietary inputs → GI absorption */
    DietPurine -> GIAbsorption [label="intestinal absorption" color="#E8A000"]
    DietFructose -> GIAbsorption [label="fructose→purine" color="#E8A000"]
    RedMeat -> GIAbsorption [color="#E8A000"]
    Seafood -> GIAbsorption [color="#E8A000"]
    Alcohol -> GIAbsorption [label="ethanol→UA" color="#E8A000"]
    SugarDrinks -> GIAbsorption [color="#E8A000"]

    /* GI absorption → purines */
    GIAbsorption -> AMP [color="#1565C0"]
    GIAbsorption -> GMP [color="#1565C0"]
    GIAbsorption -> Hypoxanthine [color="#1565C0"]
    GIAbsorption -> Guanine [color="#1565C0"]

    /* De novo synthesis */
    PRPP_synthetase -> PRPP [color="#2E7D32"]
    PRPP -> FGAM [color="#2E7D32"]
    FGAM -> SAICAR [color="#2E7D32"]
    SAICAR -> IMP [color="#2E7D32"]
    IMP -> AdenyloSucc [color="#2E7D32"]
    AdenyloSucc -> AMP [color="#2E7D32"]
    IMP -> XMP [color="#2E7D32"]
    XMP -> GMP [color="#2E7D32"]
    AMP -> ATP [color="#2E7D32"]
    GMP -> GTP [color="#2E7D32"]
    ATPP_feedback -> PRPP_synthetase [label="feedback inhibition" color="#C62828" style=dashed]
    AMP -> ATPP_feedback [color="#C62828" style=dashed]
    GMP -> ATPP_feedback [color="#C62828" style=dashed]

    /* Catabolism pathway */
    ATP -> AMP [label="ATPase" color="#1565C0"]
    AMP -> Adenosine [label="5'-NT" color="#1565C0"]
    Adenosine -> Inosine [label="ADA" color="#1565C0"]
    ADA -> Inosine [style=dashed color="#1565C0"]
    Inosine -> Hypoxanthine [label="PNP" color="#1565C0"]
    PNP -> Hypoxanthine [style=dashed color="#1565C0"]
    GTP -> GMP [label="GTPase" color="#1565C0"]
    GMP -> Guanosine [label="5'-NT" color="#1565C0"]
    Guanosine -> Guanine [label="PNP" color="#1565C0"]
    Guanine -> Hypoxanthine [label="Guanase" color="#1565C0"]
    Hypoxanthine -> Xanthine [label="XO" color="#0D47A1" penwidth=2]
    XO -> Xanthine [style=dashed color="#0D47A1"]
    Xanthine -> UricAcid_prod [label="XO" color="#0D47A1" penwidth=2]
    XO -> UricAcid_prod [style=dashed color="#0D47A1"]
    UricAcid_prod -> H2O2_ROS [label="XO by-product" color="#EF5350"]
    UricAcid_prod -> Superoxide [color="#EF5350"]

    /* Salvage */
    Hypoxanthine -> IMP [label="HGPRT" color="#2196F3" style=dashed]
    HGPRT -> IMP [style=dashed color="#2196F3"]
    Guanine -> GMP [label="HGPRT" color="#2196F3" style=dashed]
    Adenosine -> AMP [label="APRT" color="#2196F3" style=dashed]

    /* UA production → SUA pool */
    UricAcid_prod -> SUA [color="#AD1457" penwidth=2]
    SUA -> SUA_saturation [color="#880E4F"]
    SUA_saturation -> MSU_crystal [label=">6.8mg/dL" color="#880E4F" penwidth=2]
    SUA -> BodyPool_UA [color="#880E4F"]
    MSU_crystal -> Tophus_risk [color="#E91E63"]
    MSU_crystal -> GoutFlare_risk [color="#E91E63"]
    GoutFlare_risk -> NLRP3 [color="#7B1FA2" penwidth=2]

    /* Renal handling */
    GFR -> FilteredUA [color="#6A1B9A" penwidth=2]
    SUA -> FilteredUA [color="#6A1B9A"]
    FilteredUA -> S1_reabs [color="#6A1B9A"]
    URAT1 -> S1_reabs [style=dashed color="#6A1B9A"]
    GLUT9 -> S1_reabs [style=dashed color="#6A1B9A"]
    S1_reabs -> S2_secr [color="#6A1B9A"]
    OAT1 -> S2_secr [style=dashed color="#6A1B9A"]
    OAT3 -> S2_secr [style=dashed color="#6A1B9A"]
