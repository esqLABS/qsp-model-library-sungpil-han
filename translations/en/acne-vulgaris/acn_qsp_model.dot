  d_retpd -> i_nfkb   [style=dashed, color="#1E8449", arrowhead=tee];
  d_retpd -> d_irrit  [style=dashed, color="#E67E22"];

  d_clinda  -> c_plank   [style=dashed, color="#1E8449", arrowhead=tee, penwidth=2];
