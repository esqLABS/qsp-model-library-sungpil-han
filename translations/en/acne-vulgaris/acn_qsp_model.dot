    p_iga     [label="IGA / EGSS (0–4)", fillcolor="#5DADE2", penwidth=2, fontcolor="white"];
    p_succ    [label="IGA success = 0 or 1 with\n≥2-grade improvement from baseline", fillcolor="#2E86C1", penwidth=2, fontcolor="white"];
    p_time    [label="Time to response (weeks)"];
    p_scarQ   [label="Acne scar burden (SCAR-S)"];
    p_dlqi    [label="Quality of life (DLQI · CADI · Acne-QoL)"];
