/*
 * acn_qsp_model.dot
 * ---------------------------------------------------------------------------
 * Acne vulgaris (ACN)
 * Quantitative Systems Pharmacology mechanistic map
 *
 * 18 clusters · ~230 nodes · ~400 edges
 *
 * Render:
 *   dot -Tsvg acn_qsp_model.dot -o acn_qsp_model.svg
 *   dot -Tpng -Gdpi=150 acn_qsp_model.dot -o acn_qsp_model.png
 *
 * Legend (edge style):
 *   solid black   = mass flux / differentiation / lesion transit
 *   blue          = stimulation / activation
 *   red (tee)     = inhibition / suppression
 *   dashed green  = drug action
 *   dotted grey   = feedback / amplification loop
 *   dashed orange = adverse effect / safety liability
 *
 * The four classical pathogenic pillars are colour-anchored:
 *   (1) hyperseborrhoea .................. cluster 4  (gold)
 *   (2) infundibular hyperkeratinisation . cluster 5  (tan)
 *   (3) C. acnes dysbiosis / biofilm ..... cluster 6  (green)
 *   (4) inflammation ..................... clusters 7-9 (red/purple)
 * ---------------------------------------------------------------------------
 */
digraph ACN_QSP {
  graph [rankdir=TB, newrank=true, splines=spline, overlap=false, nodesep=0.26, ranksep=0.52,
         fontname="Helvetica", fontsize=11, compound=true,
         labelloc="t", label=<<B>Acne Vulgaris — QSP Mechanistic Map</B><BR/>
         <FONT POINT-SIZE="11">Androgen–IGF-1/mTORC1–sebocyte axis · infundibular hyperkeratinisation · <I>C. acnes</I> phylotype/biofilm/resistance · NLRP3–IL-1β–Th17 inflammation · lesion-transit kinetics · topical/systemic/hormonal/isotretinoin pharmacology</FONT>>];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10,
         color="#555555", penwidth=1.0, margin="0.08,0.05"];
  edge  [fontname="Helvetica", fontsize=8, color="#444444", arrowsize=0.6];

  /* ===================================================================== */
  /* 1. Aetiology — genetics · age · exposome                              */
  /* ===================================================================== */
  subgraph cluster_etio {
    label=<<B>1. Aetiology — Genetics · Adrenarche · Exposome</B>>;
    style="rounded,filled"; fillcolor="#FDF2F2"; color="#C0392B"; fontcolor="#943126";
    node [fillcolor="#FADBD8"];

    e_herit   [label="Heritability 78–81%\n(twin studies)", fillcolor="#F5B7B1", penwidth=2];
    e_gwas    [label="GWAS risk loci\n(TGFB2 · OVOL1 · FST · WNT10A\nSEMA4B · 11q13.1)"];
    e_fst     [label="FST (Follistatin)\n→ modulates TGF-β/activin signalling"];
    e_tgfb2   [label="TGFB2 → altered pilosebaceous\ndifferentiation programme"];
    e_ovol1   [label="OVOL1 → keratinocyte\ndifferentiation control"];
    e_cyp     [label="CYP17A1 · CYP1A1 polymorphisms\n(steroidogenesis variants)"];
    e_ar_cag  [label="Short AR gene CAG repeat\n→ receptor transactivation↑"];
    e_srd5a1  [label="SRD5A1 (5α-reductase type 1)\nsebaceous expression variation"];

    e_adrenar [label="Adrenarche\nage 8–10 y · DHEA-S rise", fillcolor="#F5B7B1", penwidth=2];
    e_puberty [label="Pubertal gonadal maturation\n(LH/FSH → gonadal androgens)"];
    e_age     [label="Age distribution\npeak 15–19 y · persistent adult female 12–22%"];
    e_sex     [label="Sex: adolescence M>F\nadulthood F>M (jawline · lower face)"];

    e_diet_gi [label="High glycaemic-index /\nhigh glycaemic-load diet", fillcolor="#F5B7B1", penwidth=2];
    e_dairy   [label="Dairy (skimmed milk especially)\nwhey protein · leucine"];
    e_whey    [label="Whey/BCAA supplements\n(exercise supplements)"];
    e_smoke   [label="Smoking (associated with comedonal acne)"];
    e_humid   [label="Heat and humidity · occlusive cosmetics\n(Acne cosmetica)"];
    e_mech    [label="Mechanical friction and pressure\n(Acne mechanica · masks)"];
    e_drug    [label="Drug-induced acneiform eruption\n(EGFR inhibitors · corticosteroids ·\nlithium · isoniazid · androgens)"];
    e_pcos    [label="PCOS · hyperandrogenaemia\n(SAHA syndrome)", fillcolor="#F5B7B1", penwidth=2];
    e_stress  [label="Psychological stress\n(exam-period flares reproducible)"];
    e_micro   [label="Skin microbiome\ndiversity loss"];
  }

  /* ===================================================================== */
  /* 2. Androgen axis                                                      */
  /* ===================================================================== */
  subgraph cluster_andro {
    label=<<B>2. Androgen axis — adrenal · gonadal · local steroidogenesis</B>>;
    style="rounded,filled"; fillcolor="#FEF9E7"; color="#B7950B"; fontcolor="#7D6608";
    node [fillcolor="#FCF3CF"];

    a_crhhpa  [label="Hypothalamic CRH → pituitary ACTH"];
    a_zr      [label="Adrenal zona reticularis"];
    a_dheas   [label="DHEA-S (circulating reservoir)", fillcolor="#F9E79F", penwidth=2];
    a_dhea    [label="DHEA"];
    a_andros  [label="Androstenedione"];
    a_lh      [label="LH → ovarian theca cells /\ntesticular Leydig cells"];
    a_tt      [label="Total testosterone (TT)", fillcolor="#F9E79F", penwidth=2];
    a_shbg    [label="SHBG (hepatic synthesis)", fillcolor="#F9E79F", penwidth=2];
    a_ft      [label="Free testosterone (FT)\n= biologically active fraction", fillcolor="#F9E79F", penwidth=2];
    a_5ar1    [label="5α-reductase type 1 (SRD5A1)\npredominant in the sebaceous gland", fillcolor="#F9E79F", penwidth=2];
    a_dht     [label="Intrafollicular DHT\n(5–10× AR affinity)", fillcolor="#F5B041", penwidth=2];
    a_3bhsd   [label="3β-HSD · 17β-HSD\n(local sebaceous conversion)"];
    a_ar      [label="Androgen receptor (AR)\nsebocyte / keratinocyte nuclear receptor", fillcolor="#F5B041", penwidth=2];
    a_arE     [label="AR–ARE binding → target gene transcription"];
    a_aromat  [label="Aromatase → oestradiol\n(sebum-suppressing direction)"];
    a_insSHBG [label="Insulin → suppresses hepatic SHBG synthesis", fillcolor="#F8C471"];
    a_ee      [label="Oestrogen (EE) → induces SHBG synthesis"];
    a_pcosdrv [label="PCOS: LH/FSH ratio↑ · theca cell\nandrogen hypersecretion"];
    a_lateCAH [label="Non-classical 21-hydroxylase deficiency\n(differential in refractory adult female acne)"];
  }

  /* ===================================================================== */
  /* 3. Nutrient / metabolic signalling                                    */
  /* ===================================================================== */
  subgraph cluster_metab {
    label=<<B>3. Nutrient–metabolic signalling — insulin · IGF-1 · mTORC1/FoxO1</B>>;
    style="rounded,filled"; fillcolor="#EAF7F0"; color="#1E8449"; fontcolor="#145A32";
    node [fillcolor="#D5F5E3"];

    m_gl      [label="Glycaemic load ↑"];
    m_ins     [label="Circulating insulin ↑", fillcolor="#ABEBC6", penwidth=2];
    m_igfbp3  [label="IGFBP-3 ↓ (free IGF-1 rises)"];
    m_igf1    [label="IGF-1 (circulating · local)", fillcolor="#7DCEA0", penwidth=2];
    m_igf1r   [label="IGF-1R / insulin receptor\n(sebocyte)"];
    m_pi3k    [label="PI3K → AKT"];
    m_foxo1   [label="FoxO1 (repression lifted on nuclear exclusion)", fillcolor="#7DCEA0", penwidth=2];
    m_mtorc1  [label="mTORC1 (nutrient–growth hub)", fillcolor="#52BE80", penwidth=2];
    m_leu     [label="Leucine/BCAA → Rag GTPase\n→ direct mTORC1 activation"];
    m_srebp   [label="SREBP-1c (lipogenic transcription factor)", fillcolor="#7DCEA0", penwidth=2];
    m_pparg   [label="PPAR-γ (sebocyte differentiation · lipid accumulation)"];
    m_lxr     [label="LXR-α → supports lipogenesis"];
    m_ampk    [label="AMPK (metformin target) ⟂ mTORC1"];
    m_ir      [label="Insulin resistance (HOMA-IR↑)"];
    m_obes    [label="Obesity · adipose tissue inflammation"];
  }

  /* ===================================================================== */
  /* 4. Sebaceous gland & sebum composition (pillar 1: hyperseborrhoea)    */
  /* ===================================================================== */
  subgraph cluster_seb {
    label=<<B>4. Sebaceous gland · sebum composition — pillar ① Hyperseborrhoea</B>>;
    style="rounded,filled"; fillcolor="#FDF6E3"; color="#B9770E"; fontcolor="#7E5109";
    node [fillcolor="#FAE5D3"];

    s_stem    [label="Sebaceous stem cells (Blimp1⁺ · LRIG1⁺)"];
    s_prolif  [label="Sebocyte proliferation\n(basal sebocytes)", fillcolor="#F0B27A", penwidth=2];
    s_diff    [label="Sebocyte terminal differentiation\n(lipid loading · holocrine)", fillcolor="#F0B27A", penwidth=2];
    s_mass    [label="Effective sebaceous gland mass (SGM)", fillcolor="#E67E22", penwidth=2, fontcolor="white"];
    s_apop    [label="Sebocyte apoptosis\n(isotretinoin target)", fillcolor="#F0B27A"];
    s_holo    [label="Holocrine secretion → sebum output"];
    s_ser     [label="Sebum excretion rate SER\n(µg/cm²/min)", fillcolor="#E67E22", penwidth=2, fontcolor="white"];

    s_tg      [label="Triglycerides (~40%)"];
    s_wax     [label="Wax esters (~25%)"];
    s_squal   [label="Squalene (~12%, skin-specific)", fillcolor="#F0B27A", penwidth=2];
    s_sapien  [label="Sapienic acid (C16:1Δ6)\n(antimicrobial · SCD-1 product)"];
    s_chol    [label="Cholesterol · cholesteryl esters"];
    s_la      [label="Linoleic acid (essential fatty acid)\ndilutional deficiency as sebum rises", fillcolor="#F5CBA7", penwidth=2];
    s_scd     [label="SCD-1 (fatty acid desaturation)"];
    s_fasn    [label="FASN · ACC (de novo lipogenesis)"];
    s_sqox    [label="Squalene peroxides (SQOX)\ncomedogenic + pro-inflammatory", fillcolor="#DC7633", penwidth=2, fontcolor="white"];
    s_ros     [label="ROS · lipid peroxidation\n(UV · porphyrin photoreaction)"];
    s_vitE    [label="Sebum vitamin E ↓\n(antioxidant defence exhausted)"];
    s_crhr    [label="Sebocyte CRH-R1\n(neuroendocrine receptor)"];
    s_msh     [label="MC1R / α-MSH → lipogenesis↑"];
    s_cb2     [label="CB2 cannabinoid receptor\n(endocannabinoid lipogenesis)"];
    s_sp      [label="Substance P → NK-1R\nsebaceous hypertrophy · mast cell activation"];
  }

  /* ===================================================================== */
  /* 5. Infundibular keratinisation (pillar 2)                             */
  /* ===================================================================== */
  subgraph cluster_ker {
    label=<<B>5. Infundibular hyperkeratinisation — pillar ②</B>>;
    style="rounded,filled"; fillcolor="#FBF3E4"; color="#9A7D0A"; fontcolor="#7D6608";
    node [fillcolor="#F9E79F"];

    k_kc      [label="Infundibular keratinocytes"];
    k_prolif  [label="Keratinocyte proliferation↑ (Ki-67↑)", fillcolor="#F7DC6F", penwidth=2];
    k_diff    [label="Aberrant terminal differentiation\n(K6/K16 · involucrin abnormality)"];
    k_desmo   [label="Delayed desmosome breakdown\n(corneocyte cohesion maintained)", fillcolor="#F7DC6F", penwidth=2];
    k_fillag  [label="Increased filaggrin expression\n(confined to the infundibulum)"];
    k_ladef   [label="Linoleic acid deficiency\n→ barrier defect · drives hyperkeratosis", fillcolor="#F7DC6F", penwidth=2];
    k_il1a    [label="IL-1α (keratinocyte autocrine)\nearliest signal of comedo formation", fillcolor="#F4D03F", penwidth=2];
    k_il1r    [label="IL-1R → MyD88 → NF-κB"];
    k_androk  [label="AR-mediated keratinocyte proliferation"];
    k_retrar  [label="RAR-β/γ → restores normal differentiation\n(retinoid target)", fillcolor="#F7DC6F", penwidth=2];
    k_plug    [label="Corneocyte plug", fillcolor="#D4AC0D", penwidth=2, fontcolor="white"];
    k_micro   [label="Microcomedone\nsubclinical lesion reservoir", fillcolor="#D4AC0D", penwidth=2, fontcolor="white"];
    k_dilate  [label="Follicular dilatation · wall thinning"];
    k_rupture [label="Follicular wall rupture\n(contents spill into the dermis)", fillcolor="#CA6F1E", penwidth=2, fontcolor="white"];
  }

  /* ===================================================================== */
  /* 6. Cutibacterium acnes ecology (pillar 3)                             */
  /* ===================================================================== */
  subgraph cluster_cacnes {
    label=<<B>6. <I>Cutibacterium acnes</I> — pillar ③ dysbiosis · biofilm · resistance</B>>;
    style="rounded,filled"; fillcolor="#E8F8F5"; color="#117A65"; fontcolor="#0E6251";
    node [fillcolor="#D1F2EB"];

    c_niche   [label="Anaerobic · lipid-rich follicular niche"];
    c_growth  [label="C. acnes growth (lipid-dependent)", fillcolor="#A3E4D7", penwidth=2];
    c_ia1     [label="Phylotype IA1 (acne-predominant)", fillcolor="#76D7C4", penwidth=2];
    c_ib_ii   [label="Phylotype IB · II (predominant in healthy skin)"];
    c_iii     [label="Phylotype III (progressive macrophage response)"];
    c_loss    [label="Loss of phylotype diversity\n(community imbalance = the true dysbiosis)", fillcolor="#76D7C4", penwidth=2];
    c_biofilm [label="Biofilm (EPS polysaccharide)\nimpaired antibiotic penetration · MIC several hundredfold↑", fillcolor="#48C9B0", penwidth=2, fontcolor="white"];
    c_plank   [label="Planktonic population"];
    c_lipase  [label="Bacterial lipase (GehA)\n→ free fatty acid generation", fillcolor="#76D7C4", penwidth=2];
    c_ffa     [label="Free fatty acids (FFA)\ncomedogenic + irritant", fillcolor="#45B39D", penwidth=2, fontcolor="white"];
    c_porph   [label="Porphyrins (copro-/protoporphyrin III)\n→ photoactivated ROS", fillcolor="#76D7C4", penwidth=2];
    c_camp    [label="CAMP factor (haemolysin)\n→ keratinocyte cytotoxicity"];
    c_hyal    [label="Hyaluronate lyase"];
    c_prote   [label="Bacterial proteases → PAR-2 activation"];
    c_scfa    [label="Short-chain fatty acids (propionate)\n→ HDAC inhibition · altered keratinocyte response"];
    c_res23   [label="23S rRNA mutation\n(erythromycin / clindamycin resistance)", fillcolor="#F1948A", penwidth=2];
    c_res16   [label="16S rRNA G1058C\n(tetracycline resistance)", fillcolor="#F1948A", penwidth=2];
    c_erm     [label="erm(X) acquired resistance gene"];
    c_resfrac [label="Resistant fraction (RESFRAC)\nrises under antibiotic selection pressure", fillcolor="#E74C3C", penwidth=2, fontcolor="white"];
    c_sepi    [label="S. epidermidis (antagonist)\nsuccinate production → inhibits C. acnes"];
    c_malas   [label="Malassezia spp.\n(folliculitis differential)"];
  }

  /* ===================================================================== */
  /* 7. Innate immune recognition                                          */
  /* ===================================================================== */
  subgraph cluster_innate {
    label=<<B>7. Innate recognition — TLR2 · inflammasome · antimicrobial peptides</B>>;
    style="rounded,filled"; fillcolor="#FDEDEC"; color="#B03A2E"; fontcolor="#922B21";
    node [fillcolor="#FADBD8"];

    i_tlr2    [label="TLR2 (perifollicular monocytes · keratinocytes)", fillcolor="#F1948A", penwidth=2];
    i_tlr4    [label="TLR4"];
    i_nod2    [label="NOD2 (intracellular peptidoglycan sensing)"];
    i_par2    [label="PAR-2 (protease-activated receptor)"];
    i_cd36    [label="CD36 (lipid scavenger receptor)"];
    i_myd88   [label="MyD88 → IRAK → TRAF6"];
    i_nfkb    [label="NF-κB activation", fillcolor="#EC7063", penwidth=2, fontcolor="white"];
    i_ap1     [label="AP-1 (c-Jun/c-Fos)\n→ MMP transcription"];
    i_nlrp3   [label="NLRP3 inflammasome\n(NLRP3–ASC–procaspase-1)", fillcolor="#EC7063", penwidth=2, fontcolor="white"];
    i_casp1   [label="Caspase-1 activation"];
    i_prol1b  [label="pro-IL-1β → IL-1β maturation", fillcolor="#E74C3C", penwidth=2, fontcolor="white"];
    i_kefflux [label="K⁺ efflux · lysosomal rupture · ROS\n(NLRP3 second signal)"];
    i_hbd2    [label="hBD-2 (β-defensin 2)"];
    i_ll37    [label="LL-37 (cathelicidin)"];
    i_psor    [label="Psoriasin (S100A7)"];
    i_gran    [label="Granulysin · RNase 7"];
  }

  /* ===================================================================== */
  /* 8. Cytokines · neutrophils · matrix degradation                       */
  /* ===================================================================== */
  subgraph cluster_cyto {
    label=<<B>8. Cytokines · neutrophils · matrix degradation</B>>;
    style="rounded,filled"; fillcolor="#F5EEF8"; color="#7D3C98"; fontcolor="#5B2C6F";
    node [fillcolor="#E8DAEF"];

    y_il1b    [label="IL-1β", fillcolor="#C39BD3", penwidth=2];
    y_il8     [label="IL-8 / CXCL8 (neutrophil chemotaxis)", fillcolor="#C39BD3", penwidth=2];
    y_tnf     [label="TNF-α", fillcolor="#C39BD3", penwidth=2];
    y_il6     [label="IL-6"];
    y_gmcsf   [label="GM-CSF"];
    y_il12    [label="IL-12 / IL-23 (dendritic cells)"];
    y_ifng    [label="IFN-γ (Th1)"];
    y_neu     [label="Perifollicular neutrophil infiltration\n→ pustule formation", fillcolor="#AF7AC5", penwidth=2, fontcolor="white"];
    y_mpo     [label="MPO · elastase · NETs"];
    y_mac     [label="Macrophages · foreign-body giant cells\n(granulomatous response after rupture)"];
    y_mmp     [label="MMP-1 · MMP-9 · MMP-13\n(dermal collagen degradation)", fillcolor="#AF7AC5", penwidth=2, fontcolor="white"];
    y_timp    [label="TIMP-1/2 (inhibitor) imbalance"];
    y_vegf    [label="VEGF → erythema · vasodilatation"];
    y_pge2    [label="PGE₂ / LTB₄ (5-LOX · COX-2)"];
  }

  /* ===================================================================== */
  /* 9. Adaptive immunity Th17 axis                                        */
  /* ===================================================================== */
  subgraph cluster_adapt {
    label=<<B>9. Adaptive immunity — Th17/Th1 and regulatory failure</B>>;
    style="rounded,filled"; fillcolor="#F4ECF7"; color="#6C3483"; fontcolor="#4A235A";
    node [fillcolor="#D7BDE2"];

    t_dc      [label="Dermal dendritic cells · Langerhans cells\n(C. acnes antigen presentation)"];
    t_naive   [label="Naïve CD4⁺ T cells"];
    t_rorgt   [label="RORγt induction (IL-1β + IL-6 + TGF-β)", fillcolor="#BB8FCE", penwidth=2];
    t_th17    [label="Th17 cells", fillcolor="#A569BD", penwidth=2, fontcolor="white"];
    t_il17    [label="IL-17A / IL-17F", fillcolor="#A569BD", penwidth=2, fontcolor="white"];
    t_il22    [label="IL-22 (promotes keratinocyte proliferation)"];
    t_th1     [label="Th1 (IFN-γ) — phylotype III response"];
    t_treg    [label="Relative Treg functional deficiency"];
    t_mem     [label="Tissue-resident memory T cells\n(predisposition to relapse)"];
    t_ampl    [label="IL-17 → keratinocyte CXCL8 · hBD-2\n→ neutrophil re-influx (amplification loop)"];
  }

  /* ===================================================================== */
  /* 10. Lesion transit kinetics                                           */
  /* ===================================================================== */
  subgraph cluster_lesion {
    label=<<B>10. Lesion transit kinetics — the model's clinical output chain</B>>;
    style="rounded,filled"; fillcolor="#FEF5E7"; color="#CA6F1E"; fontcolor="#873600";
    node [fillcolor="#FAD7A0"];

    L_mc    [label="Microcomedone (MC)\nclinically undetectable reservoir", fillcolor="#F8C471", penwidth=2];
    L_cc    [label="Closed comedone (whitehead)", fillcolor="#F5B041", penwidth=2];
    L_oc    [label="Open comedone (blackhead)\nmelanin+SQOX oxidative pigmentation", fillcolor="#F5B041", penwidth=2];
    L_pap   [label="Inflammatory papule", fillcolor="#E59866", penwidth=2];
    L_pus   [label="Pustule", fillcolor="#DC7633", penwidth=2, fontcolor="white"];
    L_nod   [label="Nodule · cyst", fillcolor="#BA4A00", penwidth=2, fontcolor="white"];
    L_sinus [label="Sinus tract · fistula\n(acne conglobata)"];
    L_res   [label="Lesion resolution"];
    L_pih   [label="Post-inflammatory hyperpigmentation (PIH)\n(Fitzpatrick IV–VI high risk)", fillcolor="#A04000", penwidth=2, fontcolor="white"];
    L_ery   [label="Post-inflammatory erythema (PIE)"];
    L_atro  [label="Atrophic scarring\n(icepick · boxcar · rolling)", fillcolor="#7E5109", penwidth=2, fontcolor="white"];
    L_hyper [label="Hypertrophic scars · keloid\n(truncal predilection)"];
    L_reser [label="Residual microcomedone reservoir\n= source of relapse after treatment stops", fillcolor="#F8C471", penwidth=2];
  }

  /* ===================================================================== */
  /* 11. Neuroendocrine · stress axis                                      */
  /* ===================================================================== */
  subgraph cluster_neuro {
    label=<<B>11. Neuroendocrine · oxidative stress axis</B>>;
    style="rounded,filled"; fillcolor="#EBF5FB"; color="#2874A6"; fontcolor="#1B4F72";
    node [fillcolor="#D4E6F1"];

    n_stress  [label="Psychological stress", fillcolor="#AED6F1", penwidth=2];
    n_crh     [label="Local cutaneous CRH production\n(peripheral HPA equivalent)", fillcolor="#AED6F1", penwidth=2];
    n_crhr1   [label="CRH-R1 (sebocytes · mast cells)"];
    n_cort    [label="Cortisol (systemic · local 11β-HSD1)"];
    n_subp    [label="Substance P (sensory nerve endings)"];
    n_ngf     [label="NGF → neural sensitisation"];
    n_mast    [label="Mast cell degranulation (histamine · tryptase)"];
    n_sleep   [label="Sleep deprivation · circadian disruption"];
    n_uv      [label="UV exposure → squalene photo-oxidation"];
    n_nrf2    [label="Nrf2 antioxidant response (relatively deficient)"];
  }

  /* ===================================================================== */
  /* 12. Topical therapy PK/PD                                             */
  /* ===================================================================== */
  subgraph cluster_topical {
    label=<<B>12. Topical therapy — follicular delivery PK/PD</B>>;
    style="rounded,filled"; fillcolor="#EAFAF1"; color="#1E8449"; fontcolor="#145A32";
    node [style="rounded,filled", fillcolor="#D5F5E3", shape=note];

    d_apply   [label="Applied dose\nsurface → stratum corneum reservoir"];
    d_folli   [label="Follicular route delivery\n(~0.1% of surface area,\nlarge contribution to actual absorption)", penwidth=2];
    d_bpo     [label="Benzoyl peroxide 2.5–5%\n→ benzoic acid + free radicals", fillcolor="#ABEBC6", penwidth=2];
    d_bpo_kill[label="Non-specific oxidative killing\n(resistance cannot arise)", fillcolor="#ABEBC6", penwidth=2];
    d_bpo_ox  [label="Intrinsic oxidative stress → irritation · dryness"];
    d_treti   [label="Tretinoin 0.025–0.1%\n(RAR-α/β/γ)"];
    d_adapa   [label="Adapalene 0.1 / 0.3%\n(RAR-β/γ selective · photostable)", fillcolor="#ABEBC6", penwidth=2];
    d_tazar   [label="Tazarotene 0.045–0.1%\n(RAR-β/γ · high potency)"];
    d_trifa   [label="Trifarotene 0.005%\n(RAR-γ selective · truncal indication)", fillcolor="#ABEBC6", penwidth=2];
    d_retpd   [label="Comedolysis · normalised keratinocyte differentiation\n· penetration enhancement · anti-inflammatory", penwidth=2];
    d_clinda  [label="Clindamycin 1%\n(50S ribosome)"];
    d_eryth   [label="Erythromycin 2% (resistance widespread)"];
    d_azelaic [label="Azelaic acid 15–20%\n(normalises keratinisation · antimicrobial · tyrosinase inhibition)"];
    d_dapsone [label="Dapsone 5–7.5% gel\n(neutrophil MPO inhibition)"];
    d_clasco  [label="Clascoterone 1% cream\n(topical AR antagonist · cortexolone 17α-propionate)", fillcolor="#ABEBC6", penwidth=2];
    d_minofoam[label="Minocycline 4% foam\n(minimal systemic exposure)"];
    d_salicyl [label="Salicylic acid 0.5–2% (BHA)"];
    d_niacin  [label="Niacinamide (adjunctive anti-inflammatory)"];
    d_irrit   [label="Retinoid dermatitis\n(erythema · scaling · burning) → adherence↓", fillcolor="#FADBD8"];
  }

  /* ===================================================================== */
  /* 13. Systemic antibiotics PK/PD and resistance                         */
  /* ===================================================================== */
  subgraph cluster_abx {
    label=<<B>13. Systemic antibiotics — PK/PD · anti-inflammatory action · resistance stewardship</B>>;
    style="rounded,filled"; fillcolor="#FEF9E7"; color="#9A7D0A"; fontcolor="#7D6608";
    node [style="rounded,filled", fillcolor="#FCF3CF", shape=note];

    b_doxy    [label="Doxycycline 50–100 mg\n(t½ ~18 h · lipophilic · reaches the follicle)", penwidth=2];
    b_mino    [label="Minocycline 50–100 mg\n(CNS penetration · dizziness)"];
    b_sarec   [label="Sarecycline 1.5 mg/kg\n(narrow spectrum · spares gut flora)", penwidth=2];
    b_subanti [label="Sub-antimicrobial dose doxycycline 40 mg MR\n(20 mg IR + 30 mg DR)", penwidth=2];
    b_ribo    [label="30S ribosome binding → protein synthesis inhibition"];
    b_antiinf [label="Non-antimicrobial anti-inflammatory action:\nMMP inhibition · NF-κB inhibition ·\nneutrophil chemotaxis inhibition", penwidth=2];
    b_tmpsmx  [label="TMP-SMX (second line on resistance/intolerance)"];
    b_azithro [label="Azithromycin (alternative in pregnancy)"];
    b_limit   [label="Guideline: no antibiotic monotherapy\n· stop within 3–4 months", fillcolor="#FADBD8", penwidth=2];
    b_stew    [label="Antibiotic stewardship principle\n= always combine with BPO or a retinoid", fillcolor="#FADBD8", penwidth=2];
    b_gutmb   [label="Gut microbiome disruption\n(broad-spectrum tetracyclines)", fillcolor="#FADBD8"];
    b_photo   [label="Photosensitivity (doxycycline)", fillcolor="#FADBD8"];
    b_vestib  [label="Vestibular adverse effects · pigmentation\n· drug-induced lupus (minocycline)", fillcolor="#FADBD8"];
    b_iih     [label="Idiopathic intracranial hypertension\n(tetracycline + isotretinoin combination contraindicated)", fillcolor="#F5B7B1", penwidth=2];
  }

  /* ===================================================================== */
  /* 14. Hormonal therapy                                                  */
  /* ===================================================================== */
  subgraph cluster_horm {
    label=<<B>14. Hormonal therapy — COC · antiandrogens</B>>;
    style="rounded,filled"; fillcolor="#FDEDEC"; color="#CB4335"; fontcolor="#943126";
    node [style="rounded,filled", fillcolor="#FADBD8", shape=note];

    h_coc     [label="Combined oral contraceptive (EE 20–35 µg +\nprogestin)", penwidth=2];
    h_ee      [label="Ethinylestradiol\n→ hepatic SHBG synthesis ↑↑", penwidth=2];
    h_drsp    [label="Drospirenone (antiandrogenic · antimineralocorticoid)"];
    h_cpa     [label="Cyproterone acetate (potent AR antagonist)"];
    h_norg    [label="Norgestimate · norethindrone\n(FDA acne indication)"];
    h_lhsupp  [label="LH suppression → ovarian androgen production ↓"];
    h_spiro   [label="Spironolactone 50–200 mg/d\n(AR antagonism + 17,20-lyase inhibition)", penwidth=2];
    h_canre   [label="Canrenone (active metabolite, t½ ~16 h)"];
    h_hyperk  [label="Hyperkalaemia (low risk in healthy\nyoung women · routine monitoring unnecessary)", fillcolor="#F5B7B1"];
    h_spiroae [label="Menstrual irregularity · breast tenderness · diuresis\n· risk of feminising a male fetus", fillcolor="#F5B7B1"];
    h_metf    [label="Metformin (PCOS · with insulin resistance)"];
    h_finas   [label="5α-reductase inhibitor (off-label · not contraindicated in men)"];
    h_vte     [label="Venous thromboembolism risk (COC)\ncontraindicated: smoking · age 35+ · migraine with aura", fillcolor="#F5B7B1", penwidth=2];
  }

  /* ===================================================================== */
  /* 15. Isotretinoin PK/PD                                                */
  /* ===================================================================== */
  subgraph cluster_iso {
    label=<<B>15. Isotretinoin — PK · sebaceous gland atrophy · cumulative dose–relapse relationship</B>>;
    style="rounded,filled"; fillcolor="#E8F6F3"; color="#0E6251"; fontcolor="#0B5345";
    node [style="rounded,filled", fillcolor="#D0ECE7", shape=note];

    r_dose    [label="Isotretinoin 0.25–1.0 mg/kg/d PO", penwidth=2];
    r_food    [label="Absorption doubled with a high-fat meal\n(Lidose/micronised formulations reduce food dependence)", penwidth=2];
    r_abs     [label="Absorption (F ~25% fasting / ~50% fed)"];
    r_central [label="Central compartment (t½ ~20 h)"];
    r_4oxo    [label="4-oxo-isotretinoin (CYP2C8)\nactive metabolite · t½ ~24–29 h", penwidth=2];
    r_isotret [label="Tretinoin · isomerisation interconversion"];
    r_crabp   [label="Intracellular CRABP-II ↑ → nuclear delivery"];
    r_rar     [label="RAR-α/β/γ · RXR heterodimer"];
    r_foxo    [label="FoxO1/FoxO3 nuclear restoration\n→ suppression of mTORC1 · AR signalling", penwidth=2];
    r_tram    [label="TRAIL · ER stress-mediated\nsebocyte apoptosis", penwidth=2];
    r_atrophy [label="Sebaceous gland atrophy (up to 90% SER reduction)", penwidth=2];
    r_lipoc   [label="LCN2 (lipocalin-2) induction\n→ mediates sebocyte apoptosis"];
    r_micrb   [label="Sebum reduction → loss of the C. acnes niche\n(not a direct antimicrobial action)", penwidth=2];
    r_cum     [label="Cumulative dose (mg/kg)\n120–150 mg/kg target", fillcolor="#A2D9CE", penwidth=2];
    r_durab   [label="Permanently shrunken gland fraction\n= cumulative-dose dependent (sets relapse rate)", fillcolor="#A2D9CE", penwidth=2];
    r_relapse [label="Relapse after discontinuation\n(low cumulative dose · younger age · female · truncal)", fillcolor="#F5B7B1", penwidth=2];
    r_flare   [label="Initial flare (2–4 weeks)\nsteroid pre-treatment needed in severe nodular disease", fillcolor="#F5B7B1"];
    r_fulmin  [label="Acne fulminans\nrisk of precipitation", fillcolor="#F5B7B1"];
    r_terato  [label="Teratogenicity (retinoic acid embryopathy)\niPLEDGE · two forms of contraception · pregnancy testing", fillcolor="#E74C3C", penwidth=2, fontcolor="white"];
    r_muco    [label="Mucocutaneous toxicity (cheilitis approaching 100% ·\ndryness · epistaxis) = dose surrogate", fillcolor="#F5B7B1", penwidth=2];
    r_lipid   [label="Triglycerides ↑ (~25–45%) · LDL ↑\n· pancreatitis (rare, TG>800)", fillcolor="#F5B7B1"];
    r_alt     [label="AST/ALT elevation (~10–15%, usually mild)", fillcolor="#F5B7B1"];
    r_msk     [label="Musculoskeletal pain · CK elevation (on exercise)", fillcolor="#F5B7B1"];
    r_mood    [label="Mood-change signal (causality unestablished,\nsystematic monitoring recommended)", fillcolor="#F5B7B1"];
    r_night   [label="Night blindness · corneal opacity (rare)", fillcolor="#F5B7B1"];
  }

  /* ===================================================================== */
