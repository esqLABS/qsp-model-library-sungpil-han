  d_salicyl -> k_desmo   [style=dashed, color="#1E8449", arrowhead=tee];
  d_niacin  -> i_nfkb    [style=dashed, color="#1E8449", arrowhead=tee];

  b_doxy    -> b_ribo    [style=dashed, color="#1E8449", penwidth=2];
