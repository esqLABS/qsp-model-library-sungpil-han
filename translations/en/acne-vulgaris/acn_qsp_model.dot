  t_th17  -> t_il17  [penwidth=2];
  t_th17  -> t_il22  [];
  t_il17  -> t_ampl  [color="#2E86C1", penwidth=2];
  t_ampl  -> y_il8   [color="#2E86C1", penwidth=2];
