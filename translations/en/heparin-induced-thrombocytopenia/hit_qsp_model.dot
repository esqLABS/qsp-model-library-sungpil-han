  AG_ULC -> PF4_CONF; PF4_CONF -> PF4_NEO [penwidth=1.4];
  PF4_EC -> AG_LOCAL; PF4_SURF -> AG_LOCAL; AG_LOCAL -> AG_ULC [penwidth=1.3];

  AG_RATIO -> AG_NEUT; AG_NEUT -> AG_ULC [penwidth=1.6, color="#C62828"];
  AG_RATIO -> AG_BIN; AG_BIN -> AG_ULC [label="polymerise\nat optimal ratio"];
  AG_RATIO -> AG_BELL [penwidth=1.4]; AG_BELL -> AG_ULC [penwidth=1.4];
  AG_EXCESS -> AG_ULC [arrowhead=tee, penwidth=1.6, color="#2E7D32"];
  HEP_PK1 -> AG_EXCESS [label="at very high\n[heparin]", color="#2E7D32"];
  AG_PF4EX -> AG_ULC [arrowhead=tee, style=dashed];
  PF4_PLAS -> AG_PF4EX [style=dashed];
  AG_LEN -> AG_ULC [penwidth=1.4];
  AG_ULC -> AG_EPDENS [penwidth=1.4]; AG_EPDENS -> AG_STAB;
  AG_ULC -> NEO_CRYPT; NEO_CRYPT -> NEO_KKO; PF4_NEO -> NEO_KKO [penwidth=1.4];
  PF4_TET -> NEO_RTO [label="monomeric\nepitope", style=dashed];
  AG_ULC -> NEO_C3; NEO_C3 -> NEO_CR2; AG_ULC -> NEO_APC;

  /* ================================================================
     EDGES — LAYER 2: IMMUNITY
     ================================================================ */
  NEO_KKO -> B_ACT [penwidth=1.4]; NEO_CR2 -> B_ACT [label="lowers\nthreshold"];
  NEO_APC -> NEO_TDEP; NEO_TDEP -> B_ACT [style=dashed];
  NEO_PRE -> B_NAIVE [penwidth=1.3]; NEO_MZB -> B_ACT;
  NEO_PRE -> NEO_MZB;
  B_NAIVE -> B_ACT; B_ACT -> B_PROLIF; B_PROLIF -> B_PLASMA [penwidth=1.4];
  B_PROLIF -> B_LLPC [style=dashed, label="minimal"];
  B_PROLIF -> B_MEM [style=dashed, label="functionally\ndeficient"];
  B_BAFF -> B_PLASMA; B_NAIVE -> B_CD20; B_ACT -> B_CD20;
  B_PLASMA -> AB_IGG [penwidth=1.6];
  B_PLASMA -> AB_IGM; B_PLASMA -> AB_IGA;
  B_LLPC -> AB_IGG [style=dashed];
  B_MEM -> K_NOBOOST [penwidth=1.3, color="#2E7D32", label="no boost"];

  AB_IGG -> AB_TITRE; AB_TITRE -> AB_PATH [penwidth=1.4];
  AB_TITRE -> AB_NONP [label="majority"];
  NEO_RTO -> AB_NONP; AB_AFF -> AB_PATH [penwidth=1.3];
  AB_IGG -> AB_AFF; AG_EPDENS -> AB_AFF [label="valency", penwidth=1.3];
  AB_PATH -> AB_STOICH [penwidth=1.6, color="#C62828"];
  AG_ULC -> AB_STOICH [penwidth=1.6, color="#C62828"];
  AB_HDEP -> AB_STOICH [penwidth=1.3];
  AB_IGG -> AB_CLEAR; AB_CLEAR -> K_SEROREV [penwidth=1.3];
  AB_IGG -> AB_CROSS; AB_CROSS -> AG_ULC [style=dashed, label="LMWH ~90%,\nfonda ~0-5%"];
  AB_IGM -> AB_STOICH [arrowhead=tee, style=dashed, label="cannot\nengage FcγRIIa"];

  B_ACT -> K_TYPICAL [style=dashed, label="maturation delay\n→ day 5-10", penwidth=1.4];
  AB_TITRE -> K_TYPICAL; K_SEROREV -> K_PERSIST; K_PERSIST -> K_RAPID [penwidth=1.3];
  K_PERSIST -> K_NOBOOST [arrowhead=tee, style=dashed];
  AB_HDEP -> K_DELAY [penwidth=1.3, color="#D84315"];
  HEP_STOP -> K_DELAY [style=dashed, label="disease continues"];

  /* ================================================================
     EDGES — LAYER 3: EFFECTOR
     ================================================================ */
  AB_STOICH -> FCR_BOUND [penwidth=1.6]; FCR_NUM -> FCR_BOUND;
  FCR_POLY -> FCR_BOUND [label="H131/R131\naffinity"];
  FCR_BOUND -> FCR_XLINK [penwidth=1.6, color="#C62828"];
  AG_EPDENS -> FCR_XLINK [label="multivalency\nrequired", penwidth=1.4];
  FCR_XLINK -> FCR_THR [penwidth=1.4]; FCR_THR -> FCR_ITAM [penwidth=1.4];
