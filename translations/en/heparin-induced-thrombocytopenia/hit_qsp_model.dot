  subgraph cluster_trap {
    label="19 · The Two Pharmacological Traps  ★ half-life mismatch";
    style="filled,rounded"; color="#E65100"; fillcolor="#FFF3E0"; fontsize=11;
    node [shape=box, fillcolor="#FFCC80", color="#E65100"];

    TR_VKA    [label="WARFARIN (VKA)\nblocks VKORC1 → all\nvitamin-K-dependent factors"];
    TR_PCFALL [label="Protein C falls FAST\nt½ 8 h → ~70% gone by 24 h"];
    TR_FIIFALL[label="Prothrombin falls SLOWLY\nt½ 60-72 h → ~20% gone\nby 24 h"];
    TR_MISM   [label="HALF-LIFE MISMATCH\n→ transient NET\nPROCOAGULANT state"];
    TR_VLG    [label="VENOUS LIMB GANGRENE\n★ iatrogenic amputation in a\npatient 'being anticoagulated'"];
    TR_SKINN  [label="Warfarin-induced skin\nnecrosis (breast, thigh)"];
    TR_DELAY  [label="Rule for deferring VKA\nWithhold VKA until\nplatelets >150 x10⁹/L,\noverlap ≥5 days"];
    TR_INRART [label="ARGATROBAN-INR ARTIFACT\nDTI prolongs PT with NO\nfactor depletion"];
    TR_INRFAL [label="Falsely therapeutic INR\n→ premature DTI cessation\n→ patient UNCOVERED"];
    TR_FXACT  [label="Chromogenic factor X activity\n(the correct surrogate\nduring overlap)"];
    TR_VITK   [label="Vitamin K reversal\n(if VKA started early)"];
  }

