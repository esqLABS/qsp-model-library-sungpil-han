  /* ================================================================
     22. VARIANTS — ONE COEFFICIENT, NOT ONE MORE MODEL
     ================================================================ */
  subgraph cluster_var {
    label="22 · The variants — one coefficient (aHIT · Spontaneous HIT · VITT)  ★ heparin-independence";
    style="filled,rounded"; color="#D84315"; fillcolor="#FBE9E7"; fontsize=11;
    node [shape=box, fillcolor="#FFAB91", color="#D84315"];

    VR_AHIT   [label="Autoimmune HIT (aHIT)\nantibody clusters PF4 WITHOUT\nheparin → persists after\ncessation; more severe"];
    VR_SPONT  [label="Spontaneous HIT syndrome\nNO heparin exposure ever\n(post-infection, post-ortho\nsurgery, knee arthroplasty)"];
    VR_VITT   [label="Vaccine-induced immune thrombotic\nthrombocytopenia (VITT)\nAdenoviral-vector vaccine;\nantibody binds the HEPARIN-\nBINDING SITE of PF4"];
    VR_EPI    [label="EPITOPE SHIFT\nKKO-like site → heparin-\nbinding site itself"];
    VR_AFF    [label="Higher affinity, oligoclonal,\nstronger platelet activation"];
    VR_HEPIND [label="Heparin-INDEPENDENT clustering\n(PF4 alone at high local\nconcentration)"];
    VR_HEPOK  [label="Heparin NOT contraindicated\nin VITT — there is no heparin\nin the antigen\n★ counter-intuitive prediction"];
    VR_IVIGY  [label="IVIG-responsive\n(receptor competition is\nepitope-agnostic)"];
    VR_PFDNA  [label="Endogenous polyanions as\nthe bridging agent\n(DNA, polyP, bacterial\nsurfaces)"];
  }

  /* ================================================================
     EDGES — LAYER 1: ANTIGEN
     ================================================================ */
  HEP_IND -> HEP_UFH; HEP_IND -> HEP_LMWH; HEP_IND -> HEP_FONDA; HEP_IND -> HEP_DANA;
  HEP_UFH -> HEP_PK1; HEP_LMWH -> HEP_PK2; HEP_FONDA -> HEP_PK3;
  HEP_IND -> HEP_DOSE; HEP_DOSE -> HEP_PK1;
