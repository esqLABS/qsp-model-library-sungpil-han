    /* ================================================================== *
     * 21. Patient heterogeneity · age-of-onset forms                      *
     * ================================================================== */
    subgraph cluster_hetero {
        label=<<b>21. Patient heterogeneity — the age-of-onset form is a function of residual activity</b><br/><font point-size="9">the same structure, a different f_NPC1 → an entirely different phenotype</font>>;
        style="rounded,filled"; fillcolor="#f4f6f6"; color="#aab7b8"; fontsize=11;
        node [fillcolor="#eaeded"];

        FORM_PERI   [label="Perinatal form (f_NPC1 ≈ 0)\ncholestasis · liver failure · early death"];
        FORM_EI     [label="Early infantile form (<2 years)\ndevelopmental delay · hypotonia"];
        FORM_LI     [label="Late infantile form (2-6 years)\nataxia · cognitive decline · cataplexy"];
        FORM_JUV    [label="Juvenile form (6-15 years)\nlearning difficulty · VSGP · ataxia"];
        FORM_ADULT  [label="Adult form (>15 years, f_NPC1 highest)\npsychiatric symptoms · slowly progressive ataxia"];
        AGE_ONSET   [label="Age at neurological onset\n(the strongest predictor of survival)", penwidth=2.2];
        SEX_MOD     [label="Sex · environment · modifier genes"];

        NPC1_FUNC -> FORM_PERI [color="#7f8c8d", style=dashed];
        NPC1_FUNC -> FORM_EI [color="#7f8c8d", style=dashed];
        NPC1_FUNC -> FORM_LI [color="#7f8c8d", style=dashed];
        NPC1_FUNC -> FORM_JUV [color="#7f8c8d", style=dashed];
        NPC1_FUNC -> FORM_ADULT [color="#7f8c8d", style=dashed];
        FORM_LI -> AGE_ONSET [color="#e67e22"];
        FORM_JUV -> AGE_ONSET [color="#e67e22"];
        FORM_ADULT -> AGE_ONSET [color="#e67e22"];
        AGE_ONSET -> SURVIVAL [color="#e67e22", penwidth=1.8];
        SEX_MOD -> AGE_ONSET [color="#7f8c8d", style=dashed];
    }

    /* ================================================================== *
     * 22. What a trial design can see (the measurement structure)         *
     * ================================================================== */
    subgraph cluster_trialdesign {
        label=<<b>22. ★ Trial design × the mechanistic trap</b><br/><font point-size="9">each drug was tested in a design that can only see the mechanism it assumed</font>>;
        style="rounded,filled"; fillcolor="#fdf2e2"; color="#d68910"; fontsize=12; penwidth=2.0;
        node [fillcolor="#fdebd0", color="#b9770e"];

        TRIAL_12WK  [label="12-week crossover design · change in SARA\n(IB1001-301, n=60)\nΔ = −1.28 points", penwidth=2.4];
        TRIAL_12MO  [label="12-month parallel design · change in NPCCSS\n(arimoclomol, n=50, 2:1)\nΔ = −1.40 (5D) / −1.70 (4D)", penwidth=2.4];
        TRIAL_OL    [label="Open label · historical control\n(Ory 2017 IT-HPβCD, n=14)\n21/21 vs 7/14 progressed"];
        TRIAL_SHAM  [label="Randomised · sham controlled\n(adrabetadex 2b/3)\nno difference on any measure", fillcolor="#f5b7b1"];
        POWER_REV   [label="A short window = sensitive only to the reversible component\n(it sees the symptomatic effect)", shape=note, fillcolor="#fef9e7"];
        POWER_IRREV [label="A long window + change from baseline\n= cannot separate a constant offset from a slope", shape=note, fillcolor="#fef9e7"];
        CONFOUND_OL [label="Open label + historical control\n= overestimates the reduction in slope", shape=note, fillcolor="#fadbd8"];
        WITHDRAW    [label="Whether it worsens again after withdrawal\n= the only design that separates the two components", shape=note, fillcolor="#d4efdf"];

        SARA -> TRIAL_12WK [color="#7f8c8d", style=dashed];
        NPCCSS5 -> TRIAL_12MO [color="#7f8c8d", style=dashed];
        NPCCSS4 -> TRIAL_12MO [color="#7f8c8d", style=dashed];
        NPCCSS17 -> TRIAL_OL [color="#7f8c8d", style=dashed];
        HEARING -> TRIAL_SHAM [label="including hearing\ncancels the effect", color="#c0392b", style=dashed];
        TRIAL_12WK -> POWER_REV [color="#7f8c8d", style=dashed];
        TRIAL_12MO -> POWER_IRREV [color="#7f8c8d", style=dashed];
        TRIAL_OL -> CONFOUND_OL [color="#7f8c8d", style=dashed];
        TRIAL_OL -> TRIAL_SHAM [label="same drug, opposite conclusion", color="#c0392b", penwidth=1.8];
        F_REV -> POWER_REV [color="#7f8c8d", style=dashed];
        F_IRREV -> POWER_IRREV [color="#7f8c8d", style=dashed];
        WITHDRAW -> F_REV [color="#7f8c8d", style=dashed];
        WITHDRAW -> F_IRREV [color="#7f8c8d", style=dashed];
        OX_TRIOL -> CHOL_VISC [label="ρ = 0.265 only — because it is\nmeasuring a different compartment", color="#7f8c8d", style=dashed, dir=back];
        OX_TRIOL -> NPCCSS5 [label="weak correlation", color="#7f8c8d", style=dashed];
    }

    /* ================================================================== *
     * Cross-cluster: stress → damage integral → reserve gate → death      *
     * (kept inside a cluster, 11↔14 becomes a cycle and rank breaks)      *
     * ================================================================== */
    CHOL_CNS   -> STRESS_NODE [color="#c0392b", penwidth=1.6];
    NEUROINFL  -> STRESS_NODE [color="#c0392b"];
    ROS        -> STRESS_NODE [color="#c0392b"];
    LY_CA_STORE-> STRESS_NODE [label="the deficit is the stress", color="#c0392b", arrowhead=tee];
    AUTOPH     -> STRESS_NODE [style=invis];
    GATE_NODE  -> PC_LOST     [label="death begins (once the gate is open)", color="#c0392b", penwidth=2.2];

    /* ================================================================== *
     * Drug access between compartments (the central asymmetry)            *
     * ================================================================== */
    MIG_PLASMA  -> CHOL_VISC [label="oral → reaches the viscera", color="#8e44ad", style=dashed];
    MIG_BRAIN   -> CHOL_CNS  [label="partial BBB penetration", color="#8e44ad", style=dashed];
    ARI_PLASMA  -> CHOL_VISC [color="#8e44ad", style=dashed];
    ARI_CSF     -> CHOL_CNS  [color="#8e44ad", style=dashed];
    CD_CSF      -> CHOL_VISC [label="intrathecal does not reach\nthe viscera", color="#c0392b", arrowhead=tee, style=dotted];
    CHOL_VISC   -> CHOL_STORE [style=invis];
    NPC1_FUNC   -> CHOL_VISC [label="same lesion, different compartment", color="#c0392b", arrowhead=tee];
    NPC1_FUNC   -> CHOL_CNS  [color="#c0392b", arrowhead=tee, penwidth=1.8];
    BBB         -> MIG_BRAIN [style=invis];
}
