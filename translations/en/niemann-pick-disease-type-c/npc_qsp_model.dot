        MIG_PLASMA -> MIG_GCS [color="#8e44ad", style=dashed];
        MIG_GCS -> UGCG [color="#c0392b", arrowhead=tee, penwidth=2.0];
        MIG_GUT -> MIG_GI_AE [color="#c0392b"];
        MIG_PLASMA -> MIG_TREMOR [color="#c0392b"];
        MIG_GI_AE -> MIG_DOSE [label="dose reduction · discontinuation", color="#c0392b", arrowhead=tee, style=dotted];
    }

    /* ================================================================== *
