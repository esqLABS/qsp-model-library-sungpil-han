    subgraph cluster_clinical {
        label=<<b>15. Clinical endpoints · scales</b><br/><font point-size="9">SARA · NPCCSS(17/5/4-domain) · survival</font>>;
        style="rounded,filled"; fillcolor="#fef9e7"; color="#d9c26a"; fontsize=11;
