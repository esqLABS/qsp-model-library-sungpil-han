        AMBUL       [label="Ambulation (NPCCSS domain)"];
        FINE_MOTOR  [label="Fine motor function (9-hole peg)"];
        SPEECH      [label="Dysarthria · speech"];
        SWALLOW     [label="Swallowing (VFSS)", penwidth=2.2];
        COGNITION   [label="Cognitive decline (environment dependent\n→ excluded from the 4-domain score)", fillcolor="#eaeded"];
        SEIZURE     [label="Seizures (drug resistant)"];
        CATAPLEXY   [label="Laughter-induced loss of tone\ngelastic cataplexy"];
        PSYCH       [label="Psychiatric symptoms (first presentation of the adult form)"];
        HEARING     [label="Hearing (ABR · pure tone)", penwidth=2.2];
        NPCCSS17    [label="17-domain NPCCSS\nprogression 2.7-2.9 points/year", penwidth=2.4, fillcolor="#f9e79f"];
        NPCCSS5     [label="5-domain NPCCSS\nprogression 1.5 points/year", penwidth=2.4, fillcolor="#f9e79f"];
        NPCCSS4     [label="R4DNPCCSS (rescored 4 domains)\nambulation·fine motor·speech·swallowing", penwidth=2.4, fillcolor="#f9e79f"];
        ASPIRATION  [label="Aspiration pneumonia", fillcolor="#f5b7b1"];
        SURVIVAL    [label="Survival · age at death", penwidth=2.6, fillcolor="#f5b7b1"];

        F_IRREV -> VSGP [color="#e67e22"];
        F_REV -> SACCADE [color="#e67e22"];
        F_IRREV -> SACCADE [color="#e67e22"];
        VSGP -> SACCADE [color="#e67e22"];
        NEURO_FUNC -> ATAXIA [color="#e67e22", arrowhead=tee, penwidth=1.6];
        ATAXIA -> SARA [color="#e67e22", penwidth=1.8];
        NEURO_FUNC -> AMBUL [color="#e67e22", arrowhead=tee];
        NEURO_FUNC -> FINE_MOTOR [color="#e67e22", arrowhead=tee];
        NEURO_FUNC -> SPEECH [color="#e67e22", arrowhead=tee];
        NEURO_FUNC -> SWALLOW [color="#e67e22", arrowhead=tee];
        THAL_CORT -> COGNITION [color="#e67e22"];
        THAL_CORT -> PSYCH [color="#e67e22"];
        CHOL_CNS -> SEIZURE [color="#e67e22"];
        CHOL_CNS -> CATAPLEXY [color="#e67e22"];
        AMBUL -> NPCCSS5 [color="#e67e22"];
        FINE_MOTOR -> NPCCSS5 [color="#e67e22"];
        SPEECH -> NPCCSS5 [color="#e67e22"];
        SWALLOW -> NPCCSS5 [color="#e67e22"];
        COGNITION -> NPCCSS5 [color="#e67e22"];
        AMBUL -> NPCCSS4 [color="#e67e22"];
        FINE_MOTOR -> NPCCSS4 [color="#e67e22"];
        SPEECH -> NPCCSS4 [color="#e67e22"];
        SWALLOW -> NPCCSS4 [color="#e67e22"];
        NPCCSS5 -> NPCCSS17 [color="#e67e22"];
        HEARING -> NPCCSS17 [color="#e67e22"];
        SEIZURE -> NPCCSS17 [color="#e67e22"];
        CATAPLEXY -> NPCCSS17 [color="#e67e22"];
        SWALLOW -> ASPIRATION [color="#c0392b", arrowhead=tee, penwidth=1.8];
        ASPIRATION -> SURVIVAL [color="#c0392b", arrowhead=tee, penwidth=1.8];
        SEIZURE -> SURVIVAL [color="#c0392b", arrowhead=tee];
        LIVER_FAIL -> SURVIVAL [color="#c0392b", arrowhead=tee];
    }

    /* ================================================================== *
     * 16. Miglustat PK/PD                                                 *
     * ================================================================== */
    subgraph cluster_miglustat {
        label=<<b>16. Miglustat (Zavesca) — substrate reduction</b><br/><font point-size="9">oral 200 mg tid · GCS inhibition · reduces the influx flux</font>>;
        style="rounded,filled"; fillcolor="#f5eef8"; color="#a569bd"; fontsize=11;
        node [fillcolor="#ebdef0", color="#8e44ad"];

        MIG_DOSE    [label="Miglustat oral\n200 mg tid (adult) · BSA-based in children"];
        MIG_GUT     [label="Intestinal absorption\nF ≈ 0.97 · Tmax 2-2.5 h", penwidth=2.2];
        MIG_PLASMA  [label="Plasma concentration\nCss ~11-14 μM · t½ 6-7 h", penwidth=2.2];
        MIG_RENAL   [label="Renal excretion (mostly unchanged drug)"];
        MIG_BRAIN   [label="Brain tissue concentration\nbrain/plasma ratio ~0.3-0.6", penwidth=2.2];
        MIG_GCS     [label="UGCG (GCS) inhibition\nIC₅₀ ~20-50 μM"];
        MIG_GI_AE   [label="Diarrhoea · weight loss\n(inhibition of intestinal disaccharidases)", fillcolor="#fadbd8"];
        MIG_TREMOR  [label="Peripheral neuropathy · tremor", fillcolor="#fadbd8"];

        MIG_DOSE -> MIG_GUT [color="#8e44ad", style=dashed];
        MIG_GUT -> MIG_PLASMA [color="#2471a3"];
        MIG_PLASMA -> MIG_RENAL [color="#2471a3"];
