/* ============================================================================
   Niemann-Pick Disease Type C (NPC) — QSP mechanistic map
   Niemann-Pick Disease Type C · mechanistic map

   ORGANISING THESIS
   -----------------------------------------------------------------------------
   NPC has four drugs (two of them FDA-approved in the same month, Sep 2024)
   acting at four different points of ONE causal chain.  The chain BRANCHES,
   and neither branch is what the trials measured.

   BRANCH POINT 1 — WHERE the storage is.
     The plasma biomarkers (cholestane-3beta,5alpha,6beta-triol, lysoSM-509/
     PPCS, trihydroxycholanoyl-glycine) are made by OXIDATION of stored sterol
     in LIVER and SPLENIC macrophages.  They read the VISCERAL pool.
     The disease that kills people is in the CEREBELLUM.  The two pools have
     different drug accessibility (oral vs intrathecal), different turnover
     (days vs years) and different reversibility.  So triol tracks severity
     only weakly (rho = 0.265, PMID 33228797) — not because the assay is
     noisy but because IT IS MEASURING A DIFFERENT COMPARTMENT.

   BRANCH POINT 2 — WHICH pool of lost function.
     Neurological function is written here as
         FUNCTION = f( reversible dysfunction , IRREVERSIBLE neuron loss )
     Two therapies with the SAME effect on lysosomal storage give completely
     different trajectories depending on the split, because only the
     reversible pool can be recovered.  This is the single structural choice
     that separates a SYMPTOMATIC drug from a DISEASE-MODIFYING one.

   CONSEQUENCE — the trial-design trap (cluster 22).
     * Levacetylleucine was tested as a 12-week crossover on SARA
       (-1.28 pt, PMID 39383461).  A 12-week window can ONLY see the
       reversible pool: it has near-zero power for a rate effect.
     * Arimoclomol was tested as a 12-month parallel trial on a rate
       endpoint (-1.70 pt/yr on R4DNPCCSS, PMID 40520915).  A change-from-
       baseline endpoint at 12 months CANNOT separate a constant offset
       from a slope change.
     EACH DRUG WAS TESTED WITH THE DESIGN THAT COULD ONLY SEE ITS OWN
     ASSUMED MECHANISM, so the field has no evidence on the other half.

   GENOTYPE x MECHANISM (cluster 2 -> clusters 18-20).
     Arimoclomol works by HSP70-assisted FOLDING of mutant NPC1.  Its effect
     is therefore multiplied by the amount of misfolding-competent protein:
     large for I1061T, ZERO for null alleles and for NPC2 disease.
     Cyclodextrin bypasses NPC1 entirely -> genotype-independent.
     Miglustat lowers the substrate load the residual NPC1 must handle.
     Arimoclomol x miglustat therefore act MULTIPLICATIVELY on the same flux
     (yield x load), which is why the miglustat subgroup showed the LARGER
     arimoclomol effect (-2.06 vs -1.40), not the smaller one.

   MECHANISM-INSEPARABLE TOXICITY (cluster 20).
     Cyclodextrin's efficacy IS cholesterol extraction from membranes; the
     outer hair cell is a membrane whose cholesterol is load-bearing.  The
     dose-limiting ototoxicity cannot be engineered away from the mechanism,
     and the Ory trial had to score "NSS minus hearing" to see any effect.

   Nodes 198 · Edges 287 · Clusters 22 (21 mechanism + 1 legend)
   Render:  dot -Tsvg npc_qsp_model.dot -o npc_qsp_model.svg
            dot -Tpng -Gdpi=150 npc_qsp_model.dot -o npc_qsp_model.png
   ========================================================================== */

digraph NPC_QSP {
    graph [rankdir=TB, splines=spline, overlap=false, nodesep=0.28,
           ranksep=0.55, compound=true, concentrate=false,
           fontname="NanumGothic", fontsize=13, labelloc="t",
           bgcolor="white", pad=0.4,
           label=<<b>Niemann-Pick Disease Type C (NPC) — Quantitative Systems Pharmacology map</b><br/>
<i>Niemann-Pick Disease Type C · Quantitative Systems Pharmacology map</i><br/>
<font point-size="11">The plasma markers read the visceral (liver · spleen) store, while the disease that kills the patient sits in the cerebellum — the two compartments differ in drug access, in turnover and in reversibility</font><br/>
<font point-size="11">Function = f(reversible dysfunction, <b>irreversible neuronal loss</b>) — this one line of structure is what separates a symptomatic drug from a disease-modifying one</font><br/>
<font point-size="10">198 nodes · 287 edges · 21 mechanism clusters</font>>];

    node [shape=box, style="rounded,filled", fontname="NanumGothic",
          fontsize=10, margin="0.10,0.055", penwidth=1.0, color="#555555"];
    edge [fontname="NanumGothic", fontsize=8, arrowsize=0.65,
          color="#666666", penwidth=1.0];

    /* ---------- edge semantics legend --------------------------------- */
    subgraph cluster_legend {
        label=<<b>Legend</b>>;
        style="rounded,filled"; fillcolor="#fafafa"; color="#bbbbbb";
        fontsize=11;
        node [shape=plaintext, style="", fillcolor="none", fontsize=9];
        LEG [label=<<table border="0" cellborder="0" cellspacing="1">
<tr><td align="left"><font color="#1a7f37">━━▶</font></td><td align="left">activation / promotion</td></tr>
<tr><td align="left"><font color="#c0392b">━━⊣</font></td><td align="left">inhibition / blockade</td></tr>
<tr><td align="left"><font color="#8e44ad">┅┅▶</font></td><td align="left">drug action</td></tr>
<tr><td align="left"><font color="#e67e22">━━▶</font></td><td align="left">clinical readout</td></tr>
<tr><td align="left"><font color="#2471a3">━━▶</font></td><td align="left">mass flux / transport</td></tr>
<tr><td align="left"><font color="#7f8c8d">┅┅▶</font></td><td align="left">measurement · trial design</td></tr>
<tr><td align="left"><b>bold border</b></td><td align="left">ODE state variable</td></tr>
<tr><td align="left"><font color="#c0392b"><b>red fill</b></font></td><td align="left">irreversible</td></tr>
</table>>];
    }

    /* ================================================================== *
     * 2. Gene · transcription · folding (genotype -> foldable protein)    *
     * ================================================================== */
    subgraph cluster_gene {
        label=<<b>2. NPC1/NPC2 gene · folding quality control</b><br/><font point-size="9">genotype → foldable protein · arimoclomol's entry point</font>>;
        style="rounded,filled"; fillcolor="#eef6fd"; color="#a9cce3"; fontsize=11;
        node [fillcolor="#e8f4fd"];

        NPC1_GENE   [label="NPC1 gene\n18q11.2 · 25 exons\n1278 aa · 13 TM"];
        NPC2_GENE   [label="NPC2 gene\n14q24.3 · small secreted protein\n151 aa"];
        MUT_MISFOLD [label="Folding-defective variants\nI1061T (~20% of alleles)\nP1007A · temperature-sensitive", fillcolor="#fdf2e9"];
        MUT_NULL    [label="Nonsense/frameshift variants\nnull alleles (~15-20%)\nno protein", fillcolor="#fadbd8"];
        MUT_NPC2    [label="NPC2 variants (~4%)\nloss of the lysosomal luminal carrier", fillcolor="#fadbd8"];
        NPC1_MRNA   [label="NPC1 mRNA"];
        NPC1_NASCENT[label="Nascent NPC1 polypeptide\nER membrane insertion"];
        ER_QC       [label="ER quality control\ncalnexin · BiP"];
        ERAD        [label="ERAD\nubiquitin-proteasome\npremature degradation of mutant NPC1", fillcolor="#fdedec"];
        NPC1_FOLDED [label="Successfully folded NPC1\n(escapes the ER)", penwidth=2.2];
        NPC1_LYSO   [label="Lysosomal membrane NPC1 protein\n(the functional unit)", penwidth=2.2, fillcolor="#d6eaf8"];
        NPC1_FUNC   [label="Effective NPC1 activity\nf_NPC1 = genotype × folding yield", penwidth=2.2, fillcolor="#d6eaf8"];
        NPC2_PROT   [label="NPC2 protein\nlysosomal lumen", penwidth=2.2];
        HSP70_FOLD  [label="HSP70 folding assistance\nrescues mutant NPC1"];

        NPC1_GENE -> NPC1_MRNA [color="#1a7f37"];
        NPC1_MRNA -> NPC1_NASCENT [color="#2471a3"];
        NPC1_NASCENT -> ER_QC [color="#2471a3"];
        MUT_MISFOLD -> ER_QC [label="folding failure", color="#c0392b", arrowhead=tee];
        MUT_NULL -> NPC1_MRNA [label="NMD / no protein", color="#c0392b", arrowhead=tee];
        ER_QC -> ERAD [color="#c0392b"];
        ER_QC -> NPC1_FOLDED [label="folding success", color="#1a7f37"];
        ERAD -> NPC1_FOLDED [color="#c0392b", arrowhead=tee];
        HSP70_FOLD -> ER_QC [label="yield↑", color="#1a7f37"];
        HSP70_FOLD -> ERAD [color="#c0392b", arrowhead=tee];
        NPC1_FOLDED -> NPC1_LYSO [label="Golgi→LE/LY transport", color="#2471a3"];
        NPC1_LYSO -> NPC1_FUNC [color="#1a7f37"];
        NPC2_GENE -> NPC2_PROT [color="#1a7f37"];
        MUT_NPC2 -> NPC2_PROT [color="#c0392b", arrowhead=tee];
        MUT_NULL -> HSP70_FOLD [label="nothing to rescue\n(effect = 0)", color="#c0392b", arrowhead=tee, style=dashed];
    }

    /* ================================================================== *
     * 3. LDL uptake · lysosomal cholesterol egress                        *
     * ================================================================== */
    subgraph cluster_egress {
        label=<<b>3. LDL uptake → lysosomal cholesterol egress</b><br/><font point-size="9">the primary lesion of the disease · NPC2→NPC1 hydrophobic hand-off</font>>;
        style="rounded,filled"; fillcolor="#fef5ea"; color="#e5b880"; fontsize=11;
        node [fillcolor="#fdf0e6"];

        LDL_PLASMA  [label="Plasma LDL particle"];
        LDLR        [label="LDL receptor\n(SREBP2 target)"];
        ENDOCYT     [label="Receptor-mediated endocytosis\nclathrin vesicle"];
        EE          [label="Early endosome"];
        LE_LY       [label="Late endosome / lysosome\npH 4.5-5.0", penwidth=2.2];
        LAL         [label="Lysosomal acid lipase\nLIPA · CE→FC hydrolysis"];
        FC_LUMEN    [label="Lysosomal luminal free cholesterol", penwidth=2.2];
        NPC2_BIND   [label="NPC2–cholesterol complex\n3β-OH exposed orientation"];
        NTD_NPC1    [label="NPC1 N-terminal domain (NTD)\nacceptor of the hydrophobic hand-off"];
        NPC1_TUNNEL [label="NPC1 internal sterol tunnel\nmembrane insertion via the SSD"];
        LY_MEMB_CHOL[label="Lysosomal limiting membrane cholesterol", penwidth=2.2];
        EGRESS_ER   [label="Egress to the ER\n(esterification · sensing)"];
        EGRESS_PM   [label="Direct delivery to the plasma membrane\nGRAMD1/Aster · STARD3"];
        CHOL_STORE  [label="Lysosomal cholesterol store\nCHOL_LY (core state variable)", penwidth=2.6, fillcolor="#f9e79f"];
        FILIPIN     [label="Filipin staining / esterification defect\n(diagnostic cellular marker)", fillcolor="#eaeded"];

        LDL_PLASMA -> ENDOCYT [color="#2471a3"];
        LDLR -> ENDOCYT [color="#1a7f37"];
        ENDOCYT -> EE [color="#2471a3"];
        EE -> LE_LY [label="maturation", color="#2471a3"];
        LE_LY -> LAL [color="#1a7f37"];
        LAL -> FC_LUMEN [color="#2471a3"];
        FC_LUMEN -> NPC2_BIND [color="#2471a3"];
        NPC2_PROT -> NPC2_BIND [color="#1a7f37"];
        NPC2_BIND -> NTD_NPC1 [label="hand-off", color="#2471a3"];
        NPC1_FUNC -> NTD_NPC1 [color="#1a7f37"];
        NTD_NPC1 -> NPC1_TUNNEL [color="#2471a3"];
        NPC1_TUNNEL -> LY_MEMB_CHOL [color="#2471a3"];
        LY_MEMB_CHOL -> EGRESS_ER [color="#2471a3"];
        LY_MEMB_CHOL -> EGRESS_PM [color="#2471a3"];
        FC_LUMEN -> CHOL_STORE [label="accumulates when egress fails", color="#c0392b"];
        NPC1_FUNC -> CHOL_STORE [label="egress flux", color="#c0392b", arrowhead=tee, penwidth=1.8];
        CHOL_STORE -> FILIPIN [color="#e67e22", style=dashed];
    }

    /* ================================================================== *
     * 4. Cellular cholesterol homeostasis (the paradox of failed sensing) *
     * ================================================================== */
    subgraph cluster_homeo {
        label=<<b>4. Cellular cholesterol homeostasis</b><br/><font point-size="9">the store overflows while the ER starves — the SREBP2 paradox</font>>;
        style="rounded,filled"; fillcolor="#fdfaec"; color="#d9c26a"; fontsize=11;
        node [fillcolor="#fef9e7"];

        ER_CHOL     [label="ER cholesterol pool\n(the sensing compartment)", penwidth=2.2];
        SCAP_INSIG  [label="SCAP–INSIG sensor"];
        SREBP2      [label="SREBP2 cleavage · activation"];
        HMGCR       [label="HMG-CoA reductase\nde novo synthesis↑"];
        SOAT1       [label="ACAT1/SOAT1\nCE esterification"];
        CE_POOL     [label="Cholesteryl ester pool"];
        LXR         [label="Reduced LXR activity\n(ligand shortage)"];
        ABCA1       [label="Reduced ABCA1 efflux\nHDL formation↓"];
        PM_CHOL     [label="Plasma membrane cholesterol\n(rafts · signalling)"];
        MITO_CHOL   [label="Mitochondrial membrane cholesterol↑", fillcolor="#fdedec"];

        CHOL_STORE -> ER_CHOL [label="never gets there", color="#c0392b", arrowhead=tee, penwidth=1.6];
        EGRESS_ER -> ER_CHOL [color="#2471a3"];
        EGRESS_PM -> PM_CHOL [color="#2471a3"];
        ER_CHOL -> SCAP_INSIG [color="#1a7f37"];
        SCAP_INSIG -> SREBP2 [label="low cholesterol → activation", color="#c0392b", arrowhead=tee];
        SREBP2 -> HMGCR [color="#1a7f37"];
        SREBP2 -> LDLR [label="receptor expression↑\n(even more uptake)", color="#1a7f37"];
        HMGCR -> ER_CHOL [color="#2471a3"];
        ER_CHOL -> SOAT1 [color="#1a7f37"];
        SOAT1 -> CE_POOL [color="#2471a3"];
        LXR -> ABCA1 [color="#1a7f37"];
        ER_CHOL -> LXR [color="#1a7f37"];
        CHOL_STORE -> MITO_CHOL [label="LY–mito contact", color="#c0392b"];
    }

    /* ================================================================== *
     * 5. Sphingolipid · glycolipid metabolism (miglustat's entry point)   *
     * ================================================================== */
    subgraph cluster_sphingo {
        label=<<b>5. Secondary sphingolipid · glycolipid accumulation</b><br/><font point-size="9">miglustat's entry point · the sphingosine-first hypothesis</font>>;
        style="rounded,filled"; fillcolor="#fdf2e9"; color="#e0a86a"; fontsize=11;
        node [fillcolor="#fbe5d6"];

        SM_LY       [label="Lysosomal sphingomyelin"];
        ASM         [label="Acid sphingomyelinase\n(SMPD1)"];
        CERAMIDE    [label="Ceramide"];
        ACID_CERase [label="Acid ceramidase"];
        SPHINGOSINE [label="Sphingosine accumulation\nSPH_LY (the first lipid to accumulate)", penwidth=2.4, fillcolor="#f9e79f"];
        SPHK        [label="Sphingosine kinase\nS1P generation"];
        UGCG        [label="Glucosylceramide synthase\nUGCG (Golgi)"];
        GLCCER      [label="Glucosylceramide\nGlcCer", penwidth=2.2];
        LACCER      [label="Lactosylceramide"];
        GM3         [label="GM3 ganglioside", penwidth=2.2];
        GM2         [label="GM2 ganglioside\ndendritic accumulation", penwidth=2.2];
        GBA1        [label="Acid β-glucosidase\nGBA1 (degradation)"];
        BIS_BMP     [label="Increased BMP/LBPA internal membranes\nmultilamellar bodies"];
        GSL_LOAD    [label="Total glycolipid burden\nGSL_LY", penwidth=2.6, fillcolor="#f9e79f"];

        SM_LY -> ASM [color="#1a7f37"];
        ASM -> CERAMIDE [color="#2471a3"];
        CERAMIDE -> ACID_CERase [color="#1a7f37"];
        ACID_CERase -> SPHINGOSINE [color="#2471a3"];
        SPHINGOSINE -> SPHK [color="#1a7f37"];
        CERAMIDE -> UGCG [color="#2471a3"];
        UGCG -> GLCCER [color="#2471a3", penwidth=1.6];
        GLCCER -> LACCER [color="#2471a3"];
        LACCER -> GM3 [color="#2471a3"];
        GM3 -> GM2 [color="#2471a3"];
        GBA1 -> GLCCER [color="#c0392b", arrowhead=tee];
        GLCCER -> GSL_LOAD [color="#2471a3"];
        GM2 -> GSL_LOAD [color="#2471a3"];
        GM3 -> GSL_LOAD [color="#2471a3"];
        CHOL_STORE -> SM_LY [label="degradation inhibited", color="#c0392b"];
        CHOL_STORE -> GBA1 [label="altered membrane composition → activity↓", color="#c0392b", arrowhead=tee];
        GSL_LOAD -> BIS_BMP [color="#1a7f37"];
        GSL_LOAD -> CHOL_STORE [label="mutually reinforcing loop", color="#c0392b", penwidth=1.6];
    }

    /* ================================================================== *
     * 6. Lysosomal Ca2+ · TRPML1 · fusion                                 *
     * ================================================================== */
    subgraph cluster_calcium {
        label=<<b>6. Lysosomal Ca²⁺ store · TRPML1 · membrane fusion</b><br/><font point-size="9">the upstream lesion that sphingosine creates (Lloyd-Evans 2008)</font>>;
        style="rounded,filled"; fillcolor="#eaf6f6"; color="#8fc0c0"; fontsize=11;
        node [fillcolor="#e0f2f1"];

        LY_CA_STORE [label="Acidic Ca²⁺ store\n(lysosomal lumen)", penwidth=2.2];
        CA_UPTAKE   [label="Ca²⁺ refilling mechanism\n(H⁺ gradient dependent)"];
        TRPML1      [label="TRPML1 (MCOLN1)\nCa²⁺ release channel"];
        PI35P2      [label="PI(3,5)P₂\nTRPML1 activating ligand"];
        LY_CA_REL   [label="Local Ca²⁺ release\n(triggers fusion)"];
        SNARE       [label="SNARE-mediated LE-LY fusion"];
        LY_TRAFFIC  [label="Normal endolysosomal trafficking"];
        LY_pH       [label="Rising intralysosomal pH\nhydrolase activity↓", fillcolor="#fdedec"];
        HYDROLASE   [label="Total lysosomal hydrolase activity"];

        SPHINGOSINE -> CA_UPTAKE [label="blocks refilling", color="#c0392b", arrowhead=tee, penwidth=1.8];
        CA_UPTAKE -> LY_CA_STORE [color="#2471a3"];
        LY_CA_STORE -> LY_CA_REL [color="#2471a3"];
        TRPML1 -> LY_CA_REL [color="#1a7f37"];
        PI35P2 -> TRPML1 [color="#1a7f37"];
        CHOL_STORE -> TRPML1 [label="cholesterol inhibition", color="#c0392b", arrowhead=tee];
        LY_CA_REL -> SNARE [color="#1a7f37"];
        SNARE -> LY_TRAFFIC [color="#1a7f37"];
        LY_TRAFFIC -> CHOL_STORE [label="assists egress", color="#c0392b", arrowhead=tee];
        CHOL_STORE -> LY_pH [color="#c0392b"];
        LY_pH -> HYDROLASE [color="#c0392b", arrowhead=tee];
        HYDROLASE -> ASM [color="#1a7f37"];
        HYDROLASE -> GBA1 [color="#1a7f37"];
    }

    /* ================================================================== *
     * 7. Autophagy · mTORC1 · TFEB                                        *
     * ================================================================== */
    subgraph cluster_autophagy {
        label=<<b>7. Blocked autophagic flux · mTORC1 · TFEB</b><br/><font point-size="9">failure to degrade the substrate is what accumulates in the neuron</font>>;
        style="rounded,filled"; fillcolor="#f4ecf7"; color="#c39bd3"; fontsize=11;
        node [fillcolor="#ebdef0"];

        AUTOPHAGO   [label="Autophagosome formation\nLC3-II↑ (induction normal/increased)"];
        AUTOLYSO    [label="Autolysosome formation\n(the fusion step)"];
        PROTEOLYSIS [label="Autophagic substrate degradation capacity", penwidth=2.2];
        P62         [label="p62/SQSTM1 accumulation", fillcolor="#fdedec"];
        MTORC1      [label="Deranged mTORC1 activity\nlysosomal surface signalling"];
        TFEB        [label="TFEB nuclear translocation\nlysosomal biogenesis programme"];
        LY_BIOGEN   [label="Lysosomal biogenesis"];
        MITOPHAGY   [label="Defective mitophagy", fillcolor="#fdedec"];
        DAMAGED_MITO[label="Accumulation of damaged mitochondria", penwidth=2.2, fillcolor="#fdedec"];

        AUTOPHAGO -> AUTOLYSO [color="#2471a3"];
        SNARE -> AUTOLYSO [color="#1a7f37"];
        AUTOLYSO -> PROTEOLYSIS [color="#2471a3"];
        HYDROLASE -> PROTEOLYSIS [color="#1a7f37"];
        PROTEOLYSIS -> P62 [color="#c0392b", arrowhead=tee];
        CHOL_STORE -> MTORC1 [color="#c0392b"];
        MTORC1 -> TFEB [color="#c0392b", arrowhead=tee];
        TFEB -> LY_BIOGEN [color="#1a7f37"];
        LY_BIOGEN -> HYDROLASE [color="#1a7f37"];
        PROTEOLYSIS -> MITOPHAGY [color="#1a7f37"];
        MITOPHAGY -> DAMAGED_MITO [color="#c0392b", arrowhead=tee];
    }

    /* ================================================================== *
     * 8. Mitochondria · oxidative stress                                  *
     * ================================================================== */
    subgraph cluster_mito {
        label=<<b>8. Mitochondrial function · oxidative stress</b><br/><font point-size="9">oxidation of the accumulated cholesterol is what makes the biomarkers</font>>;
        style="rounded,filled"; fillcolor="#eafaf1"; color="#82c9a0"; fontsize=11;
        node [fillcolor="#d5f5e3"];

        ETC_CIII    [label="Electron transport chain complex III\nreduced activity"];
        ROS         [label="Mitochondrial ROS\noxidative stress", penwidth=2.2];
        GSH         [label="Depletion of reduced glutathione"];
        ATP_NEURON  [label="Neuronal ATP production"];
        LIPID_PEROX [label="Lipid peroxidation"];
        GLUC_METAB  [label="Cerebral glucose metabolic efficiency\n(FDG-PET · lactate)"];

        MITO_CHOL -> ETC_CIII [color="#c0392b", arrowhead=tee];
        DAMAGED_MITO -> ETC_CIII [color="#c0392b", arrowhead=tee];
        ETC_CIII -> ROS [color="#c0392b"];
        ETC_CIII -> ATP_NEURON [color="#1a7f37"];
        ROS -> GSH [color="#c0392b", arrowhead=tee];
        ROS -> LIPID_PEROX [color="#1a7f37"];
        ATP_NEURON -> GLUC_METAB [color="#1a7f37"];
    }

    /* ================================================================== *
     * 9. Oxysterols · biomarker generation (the visceral readout)         *
     * ================================================================== */
    subgraph cluster_biomarker {
        label=<<b>9. Biomarker generation — the readout of the visceral compartment</b><br/><font point-size="9">an oxidation product of the liver · spleen store, not the state of the cerebellum</font>>;
        style="rounded,filled"; fillcolor="#fdedec"; color="#e6a8a0"; fontsize=11;
        node [fillcolor="#fadbd8"];

        CHOL_VISC   [label="Visceral (liver · spleen) lysosomal\ncholesterol store\nCHOL_VISC", penwidth=2.6, fillcolor="#f9e79f"];
        OX_7KC      [label="7-ketocholesterol\n7-KC"];
        OX_TRIOL    [label="cholestane-3β,5α,6β-triol\nC-triol (plasma)", penwidth=2.2];
        LYSOSM      [label="lysoSM (lysosphingomyelin)"];
        PPCS        [label="lysoSM-509 / PPCS\nN-palmitoyl-O-phosphocholineserine", penwidth=2.2];
        TCG_BILE    [label="Bile acid B / TCG\n3β,5α,6β-trihydroxy-cholanoyl-glycine", penwidth=2.2];
        CYP7B1      [label="CYP7B1 / CYP27A1\noxysterol metabolic pathway"];
        OHC24       [label="24(S)-hydroxycholesterol\n(brain derived · CYP46A1)", fillcolor="#eaf2f8"];
        NFL_CSF     [label="CSF/plasma neurofilament light chain\nNfL (readout of neuronal injury)", penwidth=2.2, fillcolor="#eaf2f8"];
        CALBINDIN   [label="CSF calbindin-D28K\n(readout of Purkinje loss)", penwidth=2.2, fillcolor="#eaf2f8"];
        FETUIN      [label="CSF fetuin-A"];

        CHOL_VISC -> OX_7KC [color="#2471a3"];
        ROS -> OX_7KC [label="non-enzymatic oxidation", color="#1a7f37"];
        OX_7KC -> OX_TRIOL [color="#2471a3", penwidth=1.6];
        CHOL_VISC -> TCG_BILE [color="#2471a3"];
        CYP7B1 -> TCG_BILE [color="#1a7f37"];
        SPHINGOSINE -> LYSOSM [color="#2471a3"];
        CHOL_VISC -> PPCS [color="#2471a3", penwidth=1.6];
        GSL_LOAD -> PPCS [color="#2471a3"];
    }

    /* ================================================================== *
     * 10. Liver · spleen (the visceral phenotype)                         *
     * ================================================================== */
    subgraph cluster_visceral {
        label=<<b>10. Liver · spleen: the visceral phenotype</b><br/><font point-size="9">neonatal cholestasis → hepatomegaly · splenomegaly</font>>;
        style="rounded,filled"; fillcolor="#fef5e7"; color="#e0be7a"; fontsize=11;
        node [fillcolor="#fdebd0"];

        HEPATOCYTE  [label="Hepatocyte lysosomal storage"];
        KUPFFER     [label="Kupffer cell / foam cell\nfoam cell infiltration", penwidth=2.2];
        SPLEEN_MAC  [label="Splenic macrophage storage"];
        NEO_CHOLE   [label="Neonatal cholestatic jaundice\n(~50% · mostly resolves spontaneously)", fillcolor="#fdebd0"];
        HEPATOMEG   [label="Hepatomegaly · splenomegaly\n(visceral severity)", penwidth=2.2];
        LFT         [label="Raised AST/ALT · bilirubin"];
        LIVER_FAIL  [label="Acute infantile liver failure\n(cause of death in the early infantile form)", fillcolor="#f5b7b1"];
        FOAM_LUNG   [label="Pulmonary macrophage foam cells\ninterstitial lung disease (prominent in NPC2)", fillcolor="#fdebd0"];

        CHOL_VISC -> HEPATOCYTE [color="#2471a3"];
        CHOL_VISC -> KUPFFER [color="#2471a3"];
        CHOL_VISC -> SPLEEN_MAC [color="#2471a3"];
        HEPATOCYTE -> NEO_CHOLE [color="#e67e22"];
        KUPFFER -> HEPATOMEG [color="#e67e22"];
        SPLEEN_MAC -> HEPATOMEG [color="#e67e22"];
        HEPATOCYTE -> LFT [color="#e67e22"];
        NEO_CHOLE -> LIVER_FAIL [color="#c0392b"];
        CHOL_VISC -> FOAM_LUNG [color="#2471a3"];
        MUT_NPC2 -> FOAM_LUNG [label="strengthens the pulmonary phenotype", color="#1a7f37", style=dashed];
    }

    /* ================================================================== *
     * 11. The neuronal compartment — cerebellar Purkinje cells            *
     * ================================================================== */
    subgraph cluster_neuron {
        label=<<b>11. The neuronal compartment — cerebellar Purkinje cells</b><br/><font point-size="9">the real stage of the disease · anterior→posterior lobe gradient of loss</font>>;
        style="rounded,filled"; fillcolor="#e8f8f5"; color="#7fc7b8"; fontsize=11;
        node [fillcolor="#d1f2eb"];

        CHOL_CNS    [label="Neuronal lysosomal cholesterol/GSL burden\nCHOL_CNS", penwidth=2.6, fillcolor="#f9e79f"];
        BBB         [label="Blood–brain barrier\nthe gate on drug access", shape=hexagon, fillcolor="#eaeded"];
        PC_HEALTHY  [label="Healthy Purkinje cell pool\nPC (state variable)", penwidth=2.6];
        PC_STRESS   [label="Stressed Purkinje cells\n(reversible dysfunction)", penwidth=2.4, fillcolor="#fdebd0"];
        PC_LOST     [label="Lost Purkinje cells\nPC_LOST — irreversible", penwidth=2.6, fillcolor="#f5b7b1"];
        AXON_SPHER  [label="Axonal spheroids · proximal axonal swelling"];
        MEGANEURITE [label="Meganeurites · ectopic dendrites"];
        GRANULE     [label="Granule cell layer atrophy"];
        DEEP_NUC    [label="Deep cerebellar nuclei (dentate) damage"];
        CBL_VOL     [label="Loss of cerebellar volume\n(MRI · superior cerebellum predominant)", penwidth=2.2];
        THAL_CORT   [label="Thalamic · cortical grey matter atrophy\n(correlates with cognitive · psychiatric symptoms)"];
        CC_THIN     [label="Corpus callosum · white matter microstructural damage\n(DTI FA↓)"];

        CHOL_STORE -> CHOL_CNS [label="the same mechanism in the neuron", color="#2471a3", penwidth=1.6];
        BBB -> CHOL_CNS [style=invis];
        CHOL_CNS -> PC_STRESS [label="cell-autonomous injury", color="#c0392b", penwidth=1.8];
        GM2 -> MEGANEURITE [color="#c0392b"];
        PC_HEALTHY -> PC_STRESS [color="#c0392b"];
        PC_STRESS -> PC_HEALTHY [label="recoverable if the burden is removed", color="#1a7f37", style=dashed];
        PC_STRESS -> PC_LOST [label="k_die (cannot be undone)", color="#c0392b", penwidth=2.0];
        ATP_NEURON -> PC_STRESS [color="#c0392b", arrowhead=tee];
        ROS -> PC_STRESS [color="#c0392b"];
        PC_STRESS -> AXON_SPHER [color="#c0392b"];
        PC_LOST -> GRANULE [color="#c0392b"];
        PC_LOST -> DEEP_NUC [color="#c0392b"];
        PC_LOST -> CBL_VOL [color="#e67e22", penwidth=1.6];
        PC_LOST -> CALBINDIN [label="calbindin leak", color="#e67e22"];
        CHOL_CNS -> THAL_CORT [color="#c0392b"];
        CHOL_CNS -> CC_THIN [color="#c0392b"];
        PC_LOST -> NFL_CSF [color="#e67e22"];
        CHOL_CNS -> OHC24 [color="#2471a3", style=dashed];
    }

    /* ================================================================== *
     * 12. Tau · APP · secondary proteinopathy                             *
     * ================================================================== */
    subgraph cluster_tau {
        label=<<b>12. Secondary proteinopathy (tau · APP)</b><br/><font point-size="9">a lysosomal disease in which Alzheimer-type neurofibrillary tangles appear</font>>;
        style="rounded,filled"; fillcolor="#f6eef8"; color="#c8a2c8"; fontsize=11;
        node [fillcolor="#eeddf2"];

        GSK3B       [label="GSK3β / CDK5 activation"];
        TAU_P       [label="Hyperphosphorylated tau"];
        NFT         [label="Neurofibrillary tangles (NFT)\n3R+4R · AD type", penwidth=2.2, fillcolor="#f5b7b1"];
        APP_PROC    [label="Altered APP cleavage\nβ/γ-secretase relocalisation"];
        ABETA       [label="Intracellular Aβ accumulation"];
        SNCA        [label="α-synuclein aggregation (in some)"];

        CHOL_CNS -> GSK3B [color="#1a7f37"];
        LY_CA_REL -> GSK3B [color="#c0392b", arrowhead=tee];
        GSK3B -> TAU_P [color="#1a7f37"];
        TAU_P -> NFT [color="#2471a3"];
