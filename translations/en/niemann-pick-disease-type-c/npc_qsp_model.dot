        APP_PROC -> ABETA [color="#2471a3"];
        NFT -> PC_LOST [color="#c0392b"];
        ABETA -> PC_STRESS [color="#c0392b"];
        PROTEOLYSIS -> SNCA [color="#c0392b", arrowhead=tee];
    }

    /* ================================================================== *
     * 13. Neuroinflammation                                               *
     * ================================================================== */
    subgraph cluster_inflam {
        label=<<b>13. Neuroinflammation — microglia · complement</b><br/><font point-size="9">feedback that amplifies neuronal loss (an amplifier, not a cause)</font>>;
        style="rounded,filled"; fillcolor="#fdf2f2"; color="#e8a2a2"; fontsize=11;
        node [fillcolor="#fadbd8"];

        MICROGLIA   [label="Microglial activation\n(CD68 · TSPO PET)", penwidth=2.2];
        ASTROCYTE   [label="Reactive astrocytes (GFAP↑)"];
        TNF_IL1     [label="TNF-α · IL-1β · IL-6"];
        C1Q_C3      [label="Complement C1q · C3 deposition\nsynaptic tagging"];
        SYN_LOSS    [label="Synaptic pruning · loss", penwidth=2.2];
        CCL_CHEMO   [label="CCL3/CXCL10 chemokines"];
        NEUROINFL   [label="Neuroinflammation index\nINFL (state variable)", penwidth=2.6, fillcolor="#f9e79f"];

        CHOL_CNS -> MICROGLIA [color="#1a7f37"];
        PC_LOST -> MICROGLIA [label="stimulus to clear the debris", color="#1a7f37"];
        MICROGLIA -> TNF_IL1 [color="#1a7f37"];
        MICROGLIA -> C1Q_C3 [color="#1a7f37"];
        MICROGLIA -> CCL_CHEMO [color="#1a7f37"];
        TNF_IL1 -> ASTROCYTE [color="#1a7f37"];
        C1Q_C3 -> SYN_LOSS [color="#1a7f37"];
        MICROGLIA -> NEUROINFL [color="#1a7f37"];
        TNF_IL1 -> NEUROINFL [color="#1a7f37"];
        NEUROINFL -> PC_STRESS [label="amplifying feedback", color="#c0392b", penwidth=1.8];
        SYN_LOSS -> PC_STRESS [color="#c0392b"];
    }

    /* ================================================================== *
     * 14. Function: reversible vs irreversible (the core structure)       *
     * ================================================================== */
    subgraph cluster_reserve {
        label=<<b>14. Function = f(reversible dysfunction, irreversible loss)</b><br/><font point-size="9">★ the core structure of the model — the point at which a symptomatic effect parts from a disease-modifying one</font>>;
        style="rounded,filled"; fillcolor="#fbeee6"; color="#d98880"; fontsize=12; penwidth=2.0;
        node [fillcolor="#fdebd0"];

        STRESS_NODE [label="Cerebellar stress S\n(sum of burden·inflammation·ROS·Ca²⁺·autophagy)", penwidth=2.2, fillcolor="#fdebd0"];
        DAM_NODE    [label="Cumulative damage integral\nDAM = ∫ S dt — no repair term", penwidth=2.6, fillcolor="#f5b7b1"];
        GATE_NODE   [label="Reserve gate\ndeath begins only where DAM > D_reserve", shape=hexagon, penwidth=2.4, fillcolor="#f9e79f"];
        VULN_NODE   [label="Developmental vulnerability\n1 + v_dev·e^(−age/τ)", shape=note, fillcolor="#eaf2f8"];
        LATENCY     [label="Onset latency ∝ 1/S\n→ genotype sets the age of onset", shape=note, fillcolor="#d4efdf"];
        SATRATE     [label="Rate saturates once the gate is passed\n→ the slope is independent of the age of onset", shape=note, fillcolor="#d4efdf"];
        F_REV       [label="Reversible dysfunction component\nD_rev — time constant in days\n(responds at once to burden·inflammation·metabolism)", penwidth=2.6];
        F_IRREV     [label="Irreversible loss component\nD_irr — time constant in years\n(the cumulative integral of neuronal loss)", penwidth=2.6, fillcolor="#f5b7b1"];
        RESERVE     [label="Functional reserve\n(the buffer before clinical expression)", penwidth=2.2];
        NEURO_FUNC  [label="Total neurological function\nFUNC = 1 − D_rev − D_irr", penwidth=2.8, fillcolor="#f9e79f"];
        SYMPT_ARROW [label="Symptomatic effect\n= reduces D_rev only\n(reverts on withdrawal)", shape=note, fillcolor="#e8daef"];
        DISMOD_ARROW[label="Disease-modifying effect\n= reduces dD_irr/dt\n(retained after withdrawal)", shape=note, fillcolor="#d4e6f1"];

        STRESS_NODE -> DAM_NODE [label="integration", color="#c0392b", penwidth=2.2];
        DAM_NODE -> GATE_NODE [color="#c0392b", penwidth=2.0];
        VULN_NODE -> GATE_NODE [color="#7f8c8d", style=dashed];
        DAM_NODE -> LATENCY [color="#7f8c8d", style=dashed];
        GATE_NODE -> SATRATE [color="#7f8c8d", style=dashed];
        STRESS_NODE -> F_REV [label="saturating function (immediate)", color="#c0392b", penwidth=1.8];
        NEUROINFL -> F_REV [color="#c0392b"];
        GLUC_METAB -> F_REV [color="#c0392b", arrowhead=tee];
        PC_LOST -> F_IRREV [color="#c0392b", penwidth=2.0];
        SYN_LOSS -> F_IRREV [color="#c0392b"];
        CBL_VOL -> F_IRREV [color="#c0392b"];
        F_REV -> NEURO_FUNC [color="#c0392b", arrowhead=tee, penwidth=2.0];
        F_IRREV -> NEURO_FUNC [color="#c0392b", arrowhead=tee, penwidth=2.0];
        RESERVE -> NEURO_FUNC [color="#1a7f37"];
        F_IRREV -> RESERVE [color="#c0392b", arrowhead=tee];
        SYMPT_ARROW -> F_REV [color="#8e44ad", style=dashed];
        DISMOD_ARROW -> F_IRREV [color="#8e44ad", style=dashed];
    }

    /* ================================================================== *
