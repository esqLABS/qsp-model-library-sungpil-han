    subgraph cluster_nal {
        label=<<b>18. Levacetylleucine (Aqneursa, N-acetyl-L-leucine)</b><br/><font point-size="9">oral up to 4 g/day · t½ ~1 h · rapid symptomatic effect + metabolic improvement</font>>;
        style="rounded,filled"; fillcolor="#f5eef8"; color="#a569bd"; fontsize=11;
        node [fillcolor="#ebdef0", color="#8e44ad"];

        NAL_DOSE    [label="Levacetylleucine oral\nby body weight · up to 4 g/day (divided)"];
        NAL_PLASMA  [label="Plasma concentration\nCmax ~8.3 μg/mL · t½ ~1 h\nno accumulation", penwidth=2.2];
        NAL_BRAIN   [label="Brain exposure\n(acetylated amino acid transport)", penwidth=2.2];
        NAL_METAB   [label="Normalisation of cerebral glucose·lactate metabolism\n(membrane potential · cerebellar metabolism)"];
        NAL_VEST    [label="Promotes vestibular·cerebellar compensation\n(the vestibular compensation mechanism)"];
        NAL_LYSO    [label="Slows lysosomal substrate accumulation\n(delayed progression in mice)"];
        NAL_AE      [label="Abdominal pain · dysphagia · vomiting", fillcolor="#fadbd8"];

        NAL_DOSE -> NAL_PLASMA [color="#8e44ad", style=dashed];
        NAL_PLASMA -> NAL_BRAIN [color="#2471a3"];
        NAL_BRAIN -> NAL_METAB [color="#8e44ad", style=dashed, penwidth=1.6];
        NAL_BRAIN -> NAL_VEST [color="#8e44ad", style=dashed];
        NAL_BRAIN -> NAL_LYSO [color="#8e44ad", style=dashed];
        NAL_METAB -> GLUC_METAB [color="#1a7f37", penwidth=1.8];
        NAL_VEST -> F_REV [label="reduces the reversible component only, at once\n(days-weeks)", color="#1a7f37", arrowhead=tee, penwidth=2.0];
        NAL_LYSO -> CHOL_CNS [color="#c0392b", arrowhead=tee, style=dashed];
        NAL_PLASMA -> NAL_AE [color="#c0392b"];
    }

    /* ================================================================== *
     * 19. Cyclodextrin (intrathecal) PK/PD + inseparable toxicity         *
     * ================================================================== */
    subgraph cluster_cd {
        label=<<b>19. Adrabetadex (2-HPβCD, intrathecal)</b><br/><font point-size="9">direct extraction that bypasses NPC1 · efficacy and ototoxicity are the same mechanism</font>>;
        style="rounded,filled"; fillcolor="#f5eef8"; color="#a569bd"; fontsize=11;
        node [fillcolor="#ebdef0", color="#8e44ad"];

        CD_DOSE     [label="Intrathecal 2-HPβCD\n900-1200 mg q2wk"];
        CD_CSF      [label="CSF concentration\nrapid elimination (t½ a few hours)", penwidth=2.2];
        CD_BRAIN_ECF[label="Brain extracellular fluid exposure\n(convective diffusion · a gradient exists)", penwidth=2.2];
        CD_IV       [label="Given intravenously\nalmost no BBB penetration", fillcolor="#eaeded"];
        CD_ENDOCYT  [label="Endocytosis → reaches LE/LY"];
        CD_EXTRACT  [label="Direct extraction of cholesterol from the membrane\n(inclusion complex · independent of NPC1)", penwidth=2.2];
        CD_OTO      [label="Cholesterol depletion in outer hair cells\nloss of prestin function", fillcolor="#f5b7b1"];
        CD_HEARING  [label="High-frequency sensorineural hearing loss\n(the dose-limiting toxicity)", penwidth=2.2, fillcolor="#f5b7b1"];
        CD_LP_AE    [label="Lumbar puncture related events\nheadache · infection risk", fillcolor="#fadbd8"];

        CD_DOSE -> CD_CSF [color="#8e44ad", style=dashed];
        CD_CSF -> CD_BRAIN_ECF [color="#2471a3"];
        CD_IV -> CD_BRAIN_ECF [color="#c0392b", arrowhead=tee, style=dashed];
        CD_BRAIN_ECF -> CD_ENDOCYT [color="#2471a3"];
        CD_ENDOCYT -> CD_EXTRACT [color="#8e44ad", style=dashed, penwidth=1.6];
        CD_EXTRACT -> CHOL_CNS [color="#c0392b", arrowhead=tee, penwidth=2.2];
        CD_IV -> CHOL_VISC [label="the IV route reaches only the viscera", color="#c0392b", arrowhead=tee, style=dashed];
        CD_EXTRACT -> CD_OTO [label="same mechanism, different cell", color="#c0392b", penwidth=1.8];
        CD_OTO -> CD_HEARING [color="#c0392b", penwidth=1.8];
        CD_HEARING -> HEARING [color="#c0392b", arrowhead=tee, penwidth=1.8];
        CD_DOSE -> CD_LP_AE [color="#c0392b"];
    }

