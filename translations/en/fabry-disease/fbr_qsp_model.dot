  ERT_Emax -> Gb3_KID_clear [label="renal Gb3 reduction" color="#7B1FA2"]
  ERT_Emax -> Gb3_HRT_clear [label="cardiac Gb3 reduction" color="#7B1FA2"]
  ERT_plasma_C -> ERT_t_half [style=dashed]
  ERT_plasma_C -> ERT_antibody [style=dashed label="immunogenicity"]
  ERT_antibody -> ERT_Emax [label="inhibits at high titre" arrowhead=tee color=red]
  AgaB_dose -> ERT_infusion_rxn [style=dashed]
  ERT_EC50 -> ERT_Emax [style=dashed]
  Gb3_KID_clear -> Podocyte_Gb3 [label="podocyte improvement" arrowhead=tee color=green]
  Gb3_HRT_clear -> CM_Gb3 [label="cardiomyocyte improvement" arrowhead=tee color=green]

  // =========================================================
  // EDGES: MIGALASTAT
  // =========================================================
  Migalastat_oral -> MIG_plasma [label="oral absorption\nF~75%"]
  MIG_plasma -> MIG_lysosome [label="lysosomal distribution"]
  MIG_lysosome -> Chaperone_bind -> GLA_stabilize -> Enzyme_restore
  Amenable_check -> Migalastat_oral [label="amenability confirmed first" style=dashed]
  Amenable_mut -> Amenable_check [label="amenable variant"]
