  LysoGb3_signal -> CM_Gb3 [label="direct toxicity" style=dashed]
  LysoGb3_signal -> DRG_Gb3 [label="direct toxicity" style=dashed]

  // Legend
  subgraph cluster_legend {
    label="Legend" style=filled fillcolor="#FFFFFF" color="#9E9E9E"
    L1 [label="→ activation/promotion" shape=plaintext]
    L2 [label="─┤ inhibition" shape=plaintext]
    L3 [label="- - → indirect/modelled link" shape=plaintext]
    L4 [label="green = therapeutic effect" shape=plaintext fontcolor=green]
    L5 [label="red = adverse effect/inhibition" shape=plaintext fontcolor=red]
  }
}
