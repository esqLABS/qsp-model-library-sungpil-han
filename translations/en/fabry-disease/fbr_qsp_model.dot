  Enzyme_restore -> Gb3_clearance [label="Gb3 degradation↑" color=green]
  MIG_plasma -> MIG_Emax [style=dashed]
  ATTRACT_trial -> Migalastat_oral [style=dashed label="clinical evidence"]

  // =========================================================
  // EDGES: SRT
  // =========================================================
  Lucerastat_oral -> SRT_plasma_C [label="oral PK"]
  Venglustat_oral -> SRT_plasma_C [label="oral PK"]
