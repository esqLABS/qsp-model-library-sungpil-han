/* ===========================================================================
   Drug-Induced Liver Injury (DILI) — Quantitative Systems Pharmacology map
   ---------------------------------------------------------------------------
   Organising thesis of this map (and of the accompanying mrgsolve model):

     DILI is a RATE problem, not a DOSE problem.

   Every arrow below that carries a reactive species is a FLUX. Injury occurs
   when a production flux outruns a disposal flux, and the liver's disposal
   fluxes (GSH resynthesis, mitochondrial ROS scavenging, BSEP export,
   hepatocyte regeneration) all saturate. Because the JNK -> Sab -> ROS -> JNK
   loop (cluster 6) is a POSITIVE feedback with a saturating gain, the system
   is BISTABLE: below a separatrix the liver adapts silently, above it the
   same drug at the same total exposure proceeds to necrosis. The therapeutic
   window of every antidote in cluster 14 is therefore not a pharmacokinetic
   half-life, it is the time at which the trajectory crosses that separatrix.

   Layout: 14 subgraph clusters, >210 nodes, >330 edges.
   Render:  dot -Tsvg dili_qsp_model.dot -o dili_qsp_model_en.svg
            dot -Tpng -Gdpi=150 dili_qsp_model.dot -o dili_qsp_model_en.png
   =========================================================================== */

digraph DILI_QSP {
    graph [ rankdir      = TB,
            newrank      = true,     /* required: cluster-crossing edges below
                                        break the legacy per-cluster ranker */
            splines      = spline,
            overlap      = false,
            concentrate  = false,
            compound     = true,
            nodesep      = 0.28,
            ranksep      = 0.55,
            fontname     = "Helvetica,Arial,sans-serif",
            fontsize     = 12,
            labelloc     = "t",
            label        = <<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2">
                            <TR><TD><FONT POINT-SIZE="40"><B>Drug-Induced Liver Injury (DILI) — QSP Mechanistic Map</B></FONT></TD></TR>
                            <TR><TD><FONT POINT-SIZE="20">Drug-induced liver injury · Quantitative Systems Pharmacology map</FONT></TD></TR>
                            <TR><TD><FONT POINT-SIZE="16">Reactive-metabolite flux vs. thiol resynthesis · mitochondrial bioenergetics · JNK–Sab bistable amplification ·<BR/>bile-acid (BSEP) cholestasis · innate DAMP signalling · HLA-restricted adaptive immunity · regeneration reserve</FONT></TD></TR>
                            <TR><TD><FONT POINT-SIZE="15" COLOR="#8B0000"><B>Central claim: injury = f(production rate / disposal rate), and the system is bistable — so the same AUC can be silent or fatal.</B></FONT></TD></TR>
                            </TABLE>>,
            bgcolor      = "white" ];

    node [ shape     = box,
           style     = "rounded,filled",
           fontname  = "Helvetica,Arial,sans-serif",
           fontsize  = 11,
           margin    = "0.10,0.055",
           penwidth  = 1.1 ];

    edge [ fontname  = "Helvetica,Arial,sans-serif",
           fontsize  = 9,
           penwidth  = 1.1,
           arrowsize = 0.7,
           color     = "#4a4a4a" ];

    /* ---------- colour semantics ------------------------------------------
       #DCE9F7 pale blue    drug / PK species
       #FBE3D6 pale orange  enzymes & transporters (catalytic machinery)
       #F8D7DA pale red     toxic species / damage
       #D8F0DC pale green   protective / adaptive / defence
       #EDE0F5 pale purple  immune cells & cytokines
       #FFF6C8 pale yellow  signalling nodes / second messengers
       #E2E3E5 pale grey    structural / physiological state
       #CFE7E4 pale teal    biomarkers
       #FADCE8 pale pink    clinical endpoints
       #FFE7B3 amber        therapeutics / interventions
       ---------------------------------------------------------------------- */

/* ==========================================================================
   CLUSTER 1 — Drug pharmacokinetics & hepatic disposition
   ========================================================================== */
subgraph cluster_pk {
    label = "1 · Drug PK & Hepatic Disposition";
    fontsize = 18; fontcolor = "#12406B"; style = "rounded,filled";
    fillcolor = "#F4F9FF"; color = "#12406B"; penwidth = 2;

    DOSE      [label = "Oral dose D (mg)\ntherapeutic dose vs overdose", fillcolor = "#DCE9F7"];
    GUT       [label = "Gut depot\n(ka, lag time)", fillcolor = "#DCE9F7"];
    GASTRIC   [label = "Delayed gastric emptying\n(opioid co-ingestion, food)", fillcolor = "#E2E3E5"];
    ACHARCOAL [label = "Activated charcoal adsorption\n(effective < 2–4 h)", fillcolor = "#FFE7B3"];
    PORTAL    [label = "Portal vein blood flow\nQ_H ≈ 1.35 L/min", fillcolor = "#DCE9F7"];
    FPM       [label = "First-pass extraction\nF = f(E_H)", fillcolor = "#DCE9F7"];
    CENT      [label = "Central plasma compartment\nC_p, V_c", fillcolor = "#DCE9F7"];
    PERIPH    [label = "Peripheral tissue compartment\nV_p, Q_inter", fillcolor = "#DCE9F7"];
    PPB       [label = "Plasma protein binding\nfu (albumin↓ → fu↑)", fillcolor = "#E2E3E5"];
    OATP      [label = "Hepatic uptake transporters\nOATP1B1 / 1B3 / NTCP\nSLCO1B1 c.521T>C", fillcolor = "#FBE3D6"];
    LIVDRUG   [label = "Intrahepatic drug\nC_liv (driving exposure)", fillcolor = "#DCE9F7", penwidth = 2.4];
    RENAL     [label = "Renal clearance\nCL_R", fillcolor = "#DCE9F7"];
    ENTERO    [label = "Enterohepatic recirculation\n(β-glucuronidase)", fillcolor = "#DCE9F7"];
    LIPOPHIL  [label = "Physicochemical risk factor\nlogP > 3 & daily dose > 100 mg\n(Rule-of-Two)", fillcolor = "#F8D7DA"];

    DOSE -> GUT [label = "ingestion"];
    GASTRIC -> GUT [label = "ka↓, Tmax delayed", style = dashed, color = "#7a7a7a"];
    ACHARCOAL -> GUT [label = "blocks absorption", color = "#B8860B", arrowhead = tee];
    GUT -> PORTAL [label = "ka"];
    PORTAL -> FPM;
    FPM -> CENT [label = "F·D"];
    CENT -> PERIPH [label = "Q"]; PERIPH -> CENT;
    PPB -> CENT [label = "sets fu", style = dashed];
    CENT -> OATP [label = "sinusoidal uptake"];
    OATP -> LIVDRUG;
    FPM -> LIVDRUG [label = "direct hepatic exposure"];
    LIVDRUG -> CENT [label = "efflux (MRP3/4)", style = dashed];
    CENT -> RENAL [label = "elimination"];
    ENTERO -> GUT [label = "reabsorption", style = dashed];
    LIPOPHIL -> LIVDRUG [label = "hepatic accumulation↑", style = dashed, color = "#B03A2E"];
}

/* ==========================================================================
   CLUSTER 2 — Biotransformation: bioactivation vs detoxification
   ========================================================================== */
subgraph cluster_biotrans {
    label = "2 · Biotransformation — Bioactivation vs Detoxification";
    fontsize = 18; fontcolor = "#8A4B10"; style = "rounded,filled";
    fillcolor = "#FFF8F2"; color = "#8A4B10"; penwidth = 2;

    CYP2E1  [label = "CYP2E1\n(principal bioactivating enzyme)\ninduced by ethanol and fasting", fillcolor = "#FBE3D6", penwidth = 2.2];
    CYP1A2  [label = "CYP1A2\n(smoking-induced)", fillcolor = "#FBE3D6"];
    CYP3A4  [label = "CYP3A4\n(rifampicin / carbamazepine induced)", fillcolor = "#FBE3D6"];
    CYP2C9  [label = "CYP2C9 / 2D6 / 2B6\npolymorphic metabolism", fillcolor = "#FBE3D6"];
    UGT     [label = "UGT1A1/1A6/1A9\nglucuronidation (Phase II)", fillcolor = "#FBE3D6"];
    SULT    [label = "SULT1A1/1A3/2A1\nsulfation (saturates at low dose)", fillcolor = "#FBE3D6"];
    GST     [label = "GST (M1/T1/P1)\ncatalyses GSH conjugation", fillcolor = "#FBE3D6"];
    NAT2    [label = "NAT2 acetylation\n(slow acetylator = isoniazid risk)", fillcolor = "#FBE3D6"];
    RM      [label = "Reactive metabolite (RM)\nNAPQI / nitroso / epoxide\n/ acyl glucuronide", fillcolor = "#F8D7DA", penwidth = 3, shape = octagon];
    PHASE2  [label = "Saturation of Phase II conjugation\n(therapeutic dose = unsaturated)", fillcolor = "#E2E3E5"];
    MERCAP  [label = "Mercapturic acid excretion\nurinary Cys / NAc-Cys adducts\n(exposure biomarker)", fillcolor = "#D8F0DC"];
    NQO1    [label = "NQO1 / AKR / carbonyl reductase\ntwo-electron reductive detoxification", fillcolor = "#D8F0DC"];
    ALDH    [label = "ALDH / epoxide hydrolase\n(mEH)", fillcolor = "#D8F0DC"];
    ACYLG   [label = "Acyl-glucuronide transacylation\n(diclofenac · NSAIDs)", fillcolor = "#F8D7DA"];
    IDIOSYN [label = "Structural alert\naniline · thiophene · furan · hydrazine\n· nitroaromatic", fillcolor = "#F8D7DA"];

    LIVDRUG -> CYP2E1 [label = "oxidative bioactivation", color = "#B03A2E", penwidth = 1.8];
    LIVDRUG -> CYP1A2; LIVDRUG -> CYP3A4; LIVDRUG -> CYP2C9;
    LIVDRUG -> UGT [label = "non-toxic excretion"];
    LIVDRUG -> SULT [label = "non-toxic excretion"];
    LIVDRUG -> NAT2;
    CYP2E1 -> RM [color = "#B03A2E", penwidth = 2.4];
    CYP1A2 -> RM [color = "#B03A2E"];
    CYP3A4 -> RM [color = "#B03A2E"];
    CYP2C9 -> RM [color = "#B03A2E"];
    NAT2 -> RM [label = "hydrazine route", color = "#B03A2E", style = dashed];
    IDIOSYN -> RM [label = "chemical liability", style = dashed, color = "#B03A2E"];
    ACYLG -> RM [style = dashed, color = "#B03A2E"];
    UGT -> ACYLG [label = "carboxylic acid drugs"];
    PHASE2 -> UGT [label = "dose-dependent saturation", style = dashed, arrowhead = tee];
    PHASE2 -> SULT [label = "dose-dependent saturation", style = dashed, arrowhead = tee];
    RM -> NQO1 [label = "bypass detoxification"];
    RM -> ALDH;
    GST -> MERCAP;
    RM -> GST [label = "GSH conjugation", color = "#1E7B34", penwidth = 2];
}

/* ==========================================================================
   CLUSTER 3 — Glutathione / thiol defence  (the disposal rate)
   ========================================================================== */
subgraph cluster_gsh {
    label = "3 · Glutathione / Thiol Defence — the Disposal Rate";
    fontsize = 18; fontcolor = "#14632A"; style = "rounded,filled";
    fillcolor = "#F3FBF4"; color = "#14632A"; penwidth = 2;

    GSH      [label = "Reduced glutathione (GSH)\nhepatic concentration 5–10 mM\nelimination t½ ≈ 2–4 h", fillcolor = "#D8F0DC", penwidth = 3, shape = octagon];
    GSSG     [label = "Oxidised glutathione (GSSG)\nGSH/GSSG ratio = redox index", fillcolor = "#D8F0DC"];
    GCL      [label = "GCLC / GCLM\nγ-glutamylcysteine ligase\n(rate-limiting enzyme)", fillcolor = "#FBE3D6", penwidth = 2];
    GSS      [label = "GSS\nGlutathione synthetase", fillcolor = "#FBE3D6"];
    CYS      [label = "Cysteine pool (rate-limiting substrate)\nplasma 10–15 µM", fillcolor = "#D8F0DC", penwidth = 2];
    TRANSSUL [label = "Transsulfuration pathway\nMethionine → Cys (CBS/CSE)", fillcolor = "#D8F0DC"];
    GR       [label = "Glutathione reductase (GR)\nNADPH-dependent", fillcolor = "#FBE3D6"];
    GPX      [label = "GPx1/4\nreduces H2O2 and lipid peroxides", fillcolor = "#FBE3D6"];
    NADPH    [label = "NADPH supply\nG6PD · malic enzyme", fillcolor = "#D8F0DC"];
    MITOGSH  [label = "Mitochondrial GSH pool\n(separate compartment, 2GSH transporter)\ndepletion is lethal", fillcolor = "#D8F0DC", penwidth = 2.2];
    THIOR    [label = "Thioredoxin / peroxiredoxin\nTrx-Prx axis", fillcolor = "#D8F0DC"];
    MTALLO   [label = "Metallothionein (MT)\nthiol buffering", fillcolor = "#D8F0DC"];
    FASTING  [label = "Fasting · malnutrition · chronic alcohol\nbaseline GSH 40–60%↓", fillcolor = "#F8D7DA"];
    GSHDEP   [label = "GSH depletion threshold\nbelow 30% of baseline\nprotein adducts surge", fillcolor = "#F8D7DA", penwidth = 2.4, shape = octagon];

    CYS -> GCL [label = "rate-limiting substrate", penwidth = 1.8];
    TRANSSUL -> CYS;
    GCL -> GSS; GSS -> GSH [label = "synthesis (k_syn)", color = "#1E7B34", penwidth = 2];
    GSH -> GST [label = "conjugative consumption (k_conj)", color = "#B03A2E", penwidth = 2];
    GSH -> GPX; GPX -> GSSG;
    GSSG -> GR; GR -> GSH [label = "re-reduction"];
    NADPH -> GR; NADPH -> THIOR;
    GSH -> MITOGSH [label = "mitochondrial import"];
    GSH -> GSHDEP [label = "on depletion", style = dashed, color = "#B03A2E"];
    MITOGSH -> GSHDEP [style = dashed, color = "#B03A2E"];
    FASTING -> GSH [label = "baseline↓", arrowhead = tee, color = "#B03A2E", penwidth = 1.8];
    FASTING -> CYS [arrowhead = tee, color = "#B03A2E"];
    MTALLO -> GSHDEP [arrowhead = tee, style = dashed];
    THIOR -> GSHDEP [arrowhead = tee, style = dashed];
    GSH -> GSSG [label = "under oxidative stress", style = dashed];
}

/* ==========================================================================
   CLUSTER 4 — Covalent binding & mitochondrial bioenergetics
   ========================================================================== */
subgraph cluster_mito {
    label = "4 · Covalent Adducts & Mitochondrial Bioenergetics";
    fontsize = 18; fontcolor = "#7D1128"; style = "rounded,filled";
    fillcolor = "#FFF5F6"; color = "#7D1128"; penwidth = 2;

    ADDUCT   [label = "Covalent protein adducts\n(APAP-Cys, detectable in blood)", fillcolor = "#F8D7DA", penwidth = 2.6, shape = octagon];
    MITOADD  [label = "Mitochondrial protein adducts\nGDH · ALDH2 · ATP synthase\n(the actual target of toxicity)", fillcolor = "#F8D7DA", penwidth = 2.4];
    ETC      [label = "Electron transport chain (ETC)\nComplex I / III inhibition", fillcolor = "#F8D7DA"];
    UNCOUPLE [label = "Uncoupling of oxidative phosphorylation\nproton-motive force dissipated\n(salicylate · fenoprofen)", fillcolor = "#F8D7DA"];
    BOX      [label = "Mitochondrial β-oxidation block\nFAO block (valproate · tetracycline)\n→ microvesicular steatosis", fillcolor = "#F8D7DA"];
    MTDNA    [label = "mtDNA polymerase γ inhibition\n(NRTIs · fialuridine)\nmtDNA depletion", fillcolor = "#F8D7DA"];
    ROS      [label = "Mitochondrial ROS\nO2•− → H2O2\n(early signal → late damage)", fillcolor = "#F8D7DA", penwidth = 2.6, shape = octagon];
    PEROXY   [label = "Peroxynitrite (ONOO−)\nnitrotyrosine formation", fillcolor = "#F8D7DA"];
    iNOS     [label = "iNOS / NO production", fillcolor = "#FBE3D6"];
    SOD2     [label = "SOD2 (MnSOD)\nscavenges mitochondrial O2•−", fillcolor = "#D8F0DC"];
    CAT      [label = "Catalase / GPx4", fillcolor = "#D8F0DC"];
    ATP      [label = "Hepatocyte ATP\n(normal 2.5–3 mM)\n< 25% → necrosis committed", fillcolor = "#F8D7DA", penwidth = 2.6, shape = octagon];
    MPT      [label = "Mitochondrial permeability transition (MPT)\nCyclophilin D-dependent pore\nirreversible tipping point", fillcolor = "#F8D7DA", penwidth = 2.8, shape = doubleoctagon];
    CYTC     [label = "Cytochrome c release", fillcolor = "#F8D7DA"];
    AIF      [label = "AIF / EndoG nuclear translocation\n→ DNA fragmentation", fillcolor = "#F8D7DA"];
    CALCIUM  [label = "Collapse of cytosolic Ca2+ homeostasis\nSERCA · PMCA adduction", fillcolor = "#F8D7DA"];
    MITOBIO  [label = "Mitochondrial biogenesis\nPGC-1α · NRF1 · TFAM\n(adaptive response)", fillcolor = "#D8F0DC"];
    MITOPHAG [label = "Mitophagy (Parkin/PINK1)\nclearance of damaged mitochondria", fillcolor = "#D8F0DC"];
    LIPOPEROX[label = "Lipid peroxidation · ferroptosis\nGPX4↓ · 4-HNE · MDA", fillcolor = "#F8D7DA"];

    RM -> ADDUCT [label = "covalent binding (after GSH depletion)", color = "#B03A2E", penwidth = 2.6];
    GSHDEP -> ADDUCT [label = "gate opens", color = "#B03A2E", penwidth = 2.2];
    ADDUCT -> MITOADD [penwidth = 2];
    MITOADD -> ETC [color = "#B03A2E", penwidth = 2];
    UNCOUPLE -> ATP [arrowhead = tee, color = "#B03A2E"];
    BOX -> ATP [arrowhead = tee, color = "#B03A2E"];
    MTDNA -> ETC [arrowhead = tee, color = "#B03A2E"];
    ETC -> ROS [label = "electron leak", color = "#B03A2E", penwidth = 2.2];
    ETC -> ATP [label = "ATP production↓", arrowhead = tee, color = "#B03A2E", penwidth = 2];
    iNOS -> PEROXY; ROS -> PEROXY;
    SOD2 -> ROS [arrowhead = tee, color = "#1E7B34"];
    CAT -> ROS [arrowhead = tee, color = "#1E7B34"];
    MITOGSH -> ROS [label = "scavenges mitochondrial ROS", arrowhead = tee, color = "#1E7B34", penwidth = 1.8];
    ROS -> MPT [color = "#B03A2E", penwidth = 2.2];
    PEROXY -> MPT [color = "#B03A2E"];
    CALCIUM -> MPT [color = "#B03A2E", penwidth = 1.8];
    ADDUCT -> CALCIUM [style = dashed];
    ATP -> MPT [label = "ATP↓ promotes pore opening", style = dashed, color = "#B03A2E"];
    MPT -> CYTC; MPT -> AIF;
    MPT -> ATP [label = "collapse", arrowhead = tee, color = "#B03A2E", penwidth = 2.4];
    MITOBIO -> ETC [label = "repair", color = "#1E7B34"];
    MITOPHAG -> MPT [arrowhead = tee, color = "#1E7B34"];
    ROS -> LIPOPEROX; LIPOPEROX -> MPT [style = dashed, color = "#B03A2E"];
}

/* ==========================================================================
   CLUSTER 5 — Oxidative stress sensing & Nrf2 adaptive response
   ========================================================================== */
subgraph cluster_stress {
    label = "5 · Oxidative Stress Sensing & Nrf2 Adaptation";
    fontsize = 18; fontcolor = "#0E5B5B"; style = "rounded,filled";
    fillcolor = "#F2FBFA"; color = "#0E5B5B"; penwidth = 2;

    KEAP1  [label = "KEAP1 cysteine sensor\nCys151/273/288 modification", fillcolor = "#FFF6C8"];
    NRF2   [label = "NRF2 stabilisation · nuclear translocation\n(the master switch of adaptation)", fillcolor = "#D8F0DC", penwidth = 2.6];
    ARE    [label = "ARE gene programme\nNQO1 · HO-1 · GCLC · GCLM · MRP", fillcolor = "#D8F0DC", penwidth = 2];
    HO1    [label = "HO-1 (HMOX1)\nbiliverdin · CO · iron", fillcolor = "#D8F0DC"];
    ATF4   [label = "Integrated stress response\nPERK-eIF2α-ATF4", fillcolor = "#FFF6C8"];
    ERSTRS [label = "ER stress (UPR)\nIRE1α · XBP1 · CHOP", fillcolor = "#F8D7DA"];
    AUTOPH [label = "Autophagy (LC3-II · p62)\nclearance of adducts and damaged organelles", fillcolor = "#D8F0DC"];
    HSP    [label = "Heat shock response (HSF1)\nHSP70 · HSP90", fillcolor = "#D8F0DC"];
    AMPK   [label = "AMPK (ATP↓ sensor)\nswitch to catabolism", fillcolor = "#FFF6C8"];
    SIRT1  [label = "SIRT1 / NAD+ axis", fillcolor = "#D8F0DC"];
    ADAPT  [label = "Adaptation\n'ALT rise then spontaneous resolution'\n— the outcome for most of those exposed", fillcolor = "#D8F0DC", penwidth = 3, shape = octagon];

    ROS -> KEAP1 [label = "Cys oxidation"];
    RM -> KEAP1 [label = "direct adduction", style = dashed];
    KEAP1 -> NRF2 [label = "repression lifted", color = "#1E7B34", penwidth = 2.2];
    NRF2 -> ARE [penwidth = 2];
    ARE -> HO1; ARE -> GCL [label = "GSH synthetic capacity↑", color = "#1E7B34", penwidth = 2.2];
    ARE -> NQO1 [color = "#1E7B34"];
    ARE -> SOD2 [color = "#1E7B34"];
    HO1 -> ROS [arrowhead = tee, color = "#1E7B34"];
    ATP -> AMPK [label = "ATP↓ → AMPK↑", style = dashed];
    AMPK -> AUTOPH [color = "#1E7B34"];
    AMPK -> MITOBIO [color = "#1E7B34"];
    SIRT1 -> MITOBIO [color = "#1E7B34"];
    AUTOPH -> ADDUCT [label = "clearance", arrowhead = tee, color = "#1E7B34"];
    AUTOPH -> MITOPHAG [color = "#1E7B34"];
    ERSTRS -> ATF4; ATF4 -> ADAPT [style = dashed];
    ERSTRS -> MPT [label = "CHOP pathway", style = dashed, color = "#B03A2E"];
    HSP -> ADAPT [color = "#1E7B34"];
    ARE -> ADAPT [color = "#1E7B34", penwidth = 2.4];
    NRF2 -> ADAPT [color = "#1E7B34", penwidth = 2];
}

/* ==========================================================================
   CLUSTER 6 — JNK–Sab amplification loop and the cell-death decision
   (this is the bistability that makes DILI a threshold disease)
   ========================================================================== */
subgraph cluster_jnk {
    label = "6 · JNK–Sab Amplification Loop: the Source of Bistability";
    fontsize = 18; fontcolor = "#6A1B9A"; style = "rounded,filled";
    fillcolor = "#FAF5FF"; color = "#6A1B9A"; penwidth = 2;

    ASK1   [label = "ASK1 (MAP3K5)\nactivated by Trx dissociation", fillcolor = "#FFF6C8", penwidth = 2];
    MKK4   [label = "MKK4 / MKK7", fillcolor = "#FFF6C8"];
    PJNK   [label = "Phosphorylated JNK (p-JNK)\nsustained activation = death signal\n(transient = survival)", fillcolor = "#F8D7DA", penwidth = 3, shape = octagon];
    SAB    [label = "Sab (SH3BP5)\nouter mitochondrial membrane docking protein", fillcolor = "#FFF6C8", penwidth = 2.2];
    SHP1   [label = "Intramitochondrial SHP1 activation\n→ Src dephosphorylation", fillcolor = "#FFF6C8"];
    LOOP   [label = "Positive feedback loop\np-JNK → Sab → ROS → ASK1 → p-JNK\nruns away when gain > 1", fillcolor = "#F8D7DA", penwidth = 3, shape = doubleoctagon];
    MLKL   [label = "RIPK1–RIPK3–MLKL\nnecroptosis", fillcolor = "#F8D7DA"];
    BAX    [label = "BAX / BAK oligomerisation\nBID → tBID", fillcolor = "#F8D7DA"];
    CASP9  [label = "Apaf-1 / caspase-9", fillcolor = "#F8D7DA"];
    CASP3  [label = "Caspase-3/7 execution\n(only where ATP remains = apoptosis)", fillcolor = "#F8D7DA"];
    NECROSIS [label = "Oncotic necrosis\nATP < 25% → caspases disabled\nmembrane rupture · content spillage", fillcolor = "#F8D7DA", penwidth = 3, shape = octagon];
    APOP   [label = "Apoptosis\nmembrane preserved · minimal DAMPs", fillcolor = "#F8D7DA"];
    SEPARAT[label = "Separatrix\nthe unstable boundary between adaptation and necrosis\n— the real definition of the antidote window", fillcolor = "#FFF6C8", penwidth = 3, shape = diamond];
    NFKB   [label = "NF-κB survival signalling\n(cFLIP · Bcl-xL · SOD2)", fillcolor = "#D8F0DC", penwidth = 2];

    ROS -> ASK1 [label = "Trx oxidation", color = "#B03A2E", penwidth = 2.2];
    ERSTRS -> ASK1 [style = dashed];
    ASK1 -> MKK4; MKK4 -> PJNK [penwidth = 2];
    PJNK -> SAB [color = "#B03A2E", penwidth = 2.4];
    SAB -> SHP1; SHP1 -> ETC [label = "Src inhibition → respiration impaired", color = "#B03A2E", penwidth = 2];
    SHP1 -> ROS [label = "further ROS generation", color = "#B03A2E", penwidth = 2.4];
    ROS -> LOOP [style = dashed]; PJNK -> LOOP [style = dashed]; SAB -> LOOP [style = dashed];
    LOOP -> SEPARAT [label = "gain exceeds threshold", color = "#B03A2E", penwidth = 2.4];
    PJNK -> MPT [label = "promotes MPT opening", color = "#B03A2E", penwidth = 2.4];
    PJNK -> BAX; BAX -> CYTC; CYTC -> CASP9; CASP9 -> CASP3;
    CASP3 -> APOP;
    ATP -> CASP3 [label = "ATP required", style = dashed];
    MPT -> NECROSIS [color = "#B03A2E", penwidth = 2.8];
    ATP -> NECROSIS [label = "ATP < 25%", arrowhead = tee, color = "#B03A2E", penwidth = 2.4];
    MLKL -> NECROSIS [color = "#B03A2E"];
    PJNK -> MLKL [style = dashed];
    NFKB -> PJNK [arrowhead = tee, color = "#1E7B34", penwidth = 1.8];
    NFKB -> APOP [arrowhead = tee, color = "#1E7B34"];
    SEPARAT -> NECROSIS [label = "when exceeded", color = "#B03A2E", penwidth = 2.4];
    SEPARAT -> ADAPT [label = "when not reached", color = "#1E7B34", penwidth = 2.4];
    NRF2 -> LOOP [label = "gain reduced", arrowhead = tee, color = "#1E7B34", penwidth = 2];
}

/* ==========================================================================
   CLUSTER 7 — Bile acid homeostasis and cholestatic injury
   ========================================================================== */
subgraph cluster_bile {
    label = "7 · Bile Acid Homeostasis & Cholestatic Injury";
    fontsize = 18; fontcolor = "#7A5C00"; style = "rounded,filled";
    fillcolor = "#FFFBF0"; color = "#7A5C00"; penwidth = 2;

    CYP7A1  [label = "CYP7A1\nrate-limiting step of bile acid synthesis", fillcolor = "#FBE3D6"];
    BAHC    [label = "Intracellular bile acids\n(toxic species: LCA · DCA · CDCA)", fillcolor = "#F8D7DA", penwidth = 2.6, shape = octagon];
    BSEP    [label = "BSEP (ABCB11)\ncanalicular bile acid export pump\ninhibition = core of cholestatic DILI", fillcolor = "#FBE3D6", penwidth = 2.8];
    MRP2    [label = "MRP2 (ABCC2)\nconjugate and bilirubin export", fillcolor = "#FBE3D6"];
    MRP34   [label = "MRP3 / MRP4 (basolateral)\ncompensatory regurgitation route", fillcolor = "#FBE3D6", penwidth = 2];
    MDR3    [label = "MDR3 (ABCB4)\nphospholipid flop — biliary micelle formation", fillcolor = "#FBE3D6"];
    NTCP    [label = "NTCP (SLC10A1)\nbile acid re-uptake", fillcolor = "#FBE3D6"];
    FXR     [label = "FXR (NR1H4)\nbile acid sensor", fillcolor = "#D8F0DC", penwidth = 2.2];
    SHP     [label = "SHP (NR0B2)\nCYP7A1 repression", fillcolor = "#D8F0DC"];
    FGF19   [label = "Intestinal FGF19 → FGFR4\ngut–liver axis feedback", fillcolor = "#D8F0DC"];
    BAPLASM [label = "Total serum bile acids\n(early sensitive marker)", fillcolor = "#CFE7E4", penwidth = 2];
    BADETER [label = "Bile acid cytotoxicity\nmicellar lysis · MPT · apoptosis\n· CXCL1/2 induction", fillcolor = "#F8D7DA", penwidth = 2.2];
    BILICONJ[label = "Bilirubin conjugation (UGT1A1)\n· MRP2 export", fillcolor = "#FBE3D6"];
    CHOLANG [label = "Cholangiocyte injury (cholangiopathy)\nVanishing bile duct syndrome", fillcolor = "#F8D7DA"];
    ALKPHOS [label = "ALP / GGT release\nfrom biliary epithelium", fillcolor = "#CFE7E4"];
    DRUGBSEP[label = "BSEP-inhibiting drugs\ntroglitazone · bosentan · ciclosporin\n· glibenclamide (IC50 < 25 µM = risk)", fillcolor = "#F8D7DA", penwidth = 2.2];

    CYP7A1 -> BAHC [label = "de novo synthesis"];
    NTCP -> BAHC [label = "portal re-uptake"];
    BAHC -> BSEP [label = "canalicular export (main route)", penwidth = 2.2];
    BAHC -> MRP34 [label = "regurgitation (compensatory)", color = "#1E7B34"];
    MRP34 -> BAPLASM [penwidth = 2];
    DRUGBSEP -> BSEP [label = "competitive inhibition", arrowhead = tee, color = "#B03A2E", penwidth = 2.6];
    LIVDRUG -> DRUGBSEP [style = dashed];
    BSEP -> BAHC [label = "clearance", arrowhead = tee, penwidth = 2];
    BAHC -> BADETER [label = "concentration threshold exceeded", color = "#B03A2E", penwidth = 2.4];
    BADETER -> MPT [color = "#B03A2E", penwidth = 2];
    BADETER -> ROS [color = "#B03A2E"];
    BADETER -> NECROSIS [color = "#B03A2E", style = dashed];
    BAHC -> FXR [label = "sensor activation", color = "#1E7B34"];
    FXR -> SHP; SHP -> CYP7A1 [arrowhead = tee, color = "#1E7B34", penwidth = 2];
    FXR -> BSEP [label = "transcriptional induction", color = "#1E7B34", penwidth = 1.8];
    FXR -> MRP34 [label = "induces escape route", color = "#1E7B34"];
    FGF19 -> CYP7A1 [arrowhead = tee, color = "#1E7B34"];
    MDR3 -> BADETER [label = "micellar protection", arrowhead = tee, color = "#1E7B34"];
    MRP2 -> BILICONJ [dir = back];
    BILICONJ -> ALKPHOS [style = invis];
    CHOLANG -> ALKPHOS [penwidth = 1.8];
    BADETER -> CHOLANG [color = "#B03A2E"];
    MRP2 -> CHOLANG [arrowhead = tee, style = dashed];
}

/* ==========================================================================
   CLUSTER 8 — Innate immunity: DAMPs, Kupffer cells, sterile inflammation
   ========================================================================== */
subgraph cluster_innate {
    label = "8 · Innate Immunity: DAMPs, Kupffer Cells, Sterile Inflammation";
    fontsize = 18; fontcolor = "#4A148C"; style = "rounded,filled";
    fillcolor = "#F8F4FD"; color = "#4A148C"; penwidth = 2;

    DAMP     [label = "DAMP release\nHMGB1 · mtDNA · ATP · F-actin\n· uric acid · HSP", fillcolor = "#F8D7DA", penwidth = 2.6, shape = octagon];
    TLR4     [label = "TLR4 / TLR9 / RAGE", fillcolor = "#FBE3D6"];
    NLRP3    [label = "NLRP3 inflammasome\n· caspase-1", fillcolor = "#FBE3D6", penwidth = 2];
    KUPFFER  [label = "Kupffer cell activation\nM1 (pro-inflammatory) ↔ M2 (repair)", fillcolor = "#EDE0F5", penwidth = 2.4];
    MONOCYTE [label = "Bone marrow-derived monocyte influx\nLy6C-hi → Ly6C-lo switch", fillcolor = "#EDE0F5"];
    NEUTRO   [label = "Neutrophil infiltration\nMPO · NETs · oxidative burst", fillcolor = "#EDE0F5", penwidth = 2];
    NKT      [label = "NK / NKT cells\nIFN-γ · perforin", fillcolor = "#EDE0F5"];
    TNFA     [label = "TNF-α\n(double-edged: death + regenerative priming)", fillcolor = "#EDE0F5", penwidth = 2.4];
    IL1B     [label = "IL-1β\n(caspase-1 cleaved)", fillcolor = "#EDE0F5"];
    IL6      [label = "IL-6 → STAT3\nhepatoprotection · acute phase response · regeneration", fillcolor = "#D8F0DC", penwidth = 2];
    IL10     [label = "IL-10 (anti-inflammatory)\nsuppresses injury", fillcolor = "#D8F0DC", penwidth = 2];
    CXCL     [label = "CXCL1 / CXCL2 / MCP-1\nchemotactic gradient", fillcolor = "#EDE0F5"];
    HSCELL   [label = "Hepatic stellate cell activation\n→ fibrosis when chronic", fillcolor = "#F8D7DA"];
    LSEC     [label = "Sinusoidal endothelial cell injury\nSinusoidal obstruction syndrome", fillcolor = "#F8D7DA"];
    COAG     [label = "Coagulation activation · fibrin deposition\n(TF · PAI-1)", fillcolor = "#F8D7DA"];
    EFFEROC  [label = "Efferocytosis of dying cells\ninflammation resolution programme", fillcolor = "#D8F0DC"];

    NECROSIS -> DAMP [color = "#B03A2E", penwidth = 2.8];
    DAMP -> TLR4 [penwidth = 2]; DAMP -> NLRP3 [penwidth = 2];
    TLR4 -> KUPFFER [penwidth = 2.2]; NLRP3 -> IL1B [penwidth = 2];
    KUPFFER -> TNFA [penwidth = 2.2]; KUPFFER -> IL1B; KUPFFER -> IL6; KUPFFER -> IL10;
    KUPFFER -> CXCL; CXCL -> NEUTRO [penwidth = 2]; CXCL -> MONOCYTE;
    MONOCYTE -> KUPFFER [label = "recruitment"];
    NEUTRO -> ROS [label = "secondary oxidative injury", color = "#B03A2E", penwidth = 1.8];
    NEUTRO -> NECROSIS [label = "extends secondary injury", color = "#B03A2E", style = dashed];
    NKT -> TNFA;
    TNFA -> NFKB [label = "triggers survival signalling too", color = "#1E7B34"];
    TNFA -> PJNK [label = "induces sustained JNK", color = "#B03A2E", penwidth = 2];
    IL1B -> CXCL;
    IL6 -> NFKB [color = "#1E7B34"];
    IL10 -> KUPFFER [arrowhead = tee, color = "#1E7B34", penwidth = 1.8];
    IL10 -> TNFA [arrowhead = tee, color = "#1E7B34"];
    EFFEROC -> IL10 [color = "#1E7B34"];
    NEUTRO -> EFFEROC [dir = back, style = dashed];
    TNFA -> HSCELL; HSCELL -> LSEC [style = dashed];
    LSEC -> COAG; COAG -> NECROSIS [label = "ischaemic extension", style = dashed, color = "#B03A2E"];
    BADETER -> CXCL [label = "bile acid-driven chemotaxis", color = "#B03A2E", style = dashed];
}

/* ==========================================================================
   CLUSTER 9 — Adaptive immunity: idiosyncratic, HLA-restricted DILI
   ========================================================================== */
subgraph cluster_adaptive {
    label = "9 · Adaptive Immunity: Idiosyncratic HLA-restricted DILI";
    fontsize = 18; fontcolor = "#1B5E20"; style = "rounded,filled";
    fillcolor = "#F4FBF4"; color = "#1B5E20"; penwidth = 2;

    HAPTEN  [label = "Hapten formation (hapten hypothesis)\ndrug-protein adduct = neoantigen", fillcolor = "#F8D7DA", penwidth = 2.2];
    PI      [label = "p-i concept (direct HLA binding)\nnon-covalent drug-HLA/TCR interaction", fillcolor = "#F8D7DA"];
    APC     [label = "Antigen-presenting cells (DC · KC)\nMHC-II presentation · co-stimulation (CD80/86)", fillcolor = "#EDE0F5", penwidth = 2];
    HLARISK [label = "HLA risk alleles\nB*57:01 (flucloxacillin)\nDRB1*15:01 (amoxicillin-clavulanate)\nB*35:02 (minocycline) · A*33:01", fillcolor = "#F8D7DA", penwidth = 2.6];
    CD8T    [label = "Drug-specific CD8+ T cells\nperforin · granzyme B · FasL", fillcolor = "#EDE0F5", penwidth = 2.4];
    CD4T    [label = "CD4+ Th1 / Th17\nIFN-γ · IL-17", fillcolor = "#EDE0F5"];
    TREG    [label = "Regulatory T cells (Treg)\nmaintain immune tolerance — decisive", fillcolor = "#D8F0DC", penwidth = 2.4];
    PD1     [label = "PD-1 / CTLA-4 checkpoints\nintrahepatic tolerance axis", fillcolor = "#D8F0DC", penwidth = 2.2];
    ICI     [label = "Immune checkpoint inhibitors (ICI)\ntolerance removed → ICI hepatitis (grade 3–4 ~2–10%)", fillcolor = "#F8D7DA", penwidth = 2.2];
    TOLER   [label = "Immune tolerance\nresolves spontaneously in most\n= why idiosyncratic DILI is rare", fillcolor = "#D8F0DC", penwidth = 2.6, shape = octagon];
    LATENCY [label = "Latency\n1–12 weeks (time to sensitisation)\nrapid recurrence on re-exposure", fillcolor = "#E2E3E5", penwidth = 2];
    AUTOAB  [label = "Autoantibodies (ANA · SMA · anti-LKM)\ndrug-induced autoimmune hepatitis", fillcolor = "#F8D7DA"];
    EOSIN   [label = "Eosinophilia · rash · fever\nDRESS phenotype", fillcolor = "#F8D7DA"];
    KILL    [label = "Cytotoxic hepatocyte killing\n(dose-independent · individual-specific)", fillcolor = "#F8D7DA", penwidth = 2.4];

    ADDUCT -> HAPTEN [penwidth = 2.2];
    LIVDRUG -> PI [style = dashed];
    HAPTEN -> APC [penwidth = 2]; PI -> APC;
    DAMP -> APC [label = "danger signal (signal 2)", penwidth = 2, color = "#B03A2E"];
    HLARISK -> APC [label = "determines the presentable peptides", penwidth = 2.2];
    APC -> CD8T [penwidth = 2.2]; APC -> CD4T;
    CD4T -> CD8T [label = "help"];
    CD8T -> KILL [penwidth = 2.4];
    CD4T -> EOSIN;
    KILL -> NECROSIS [color = "#B03A2E", penwidth = 2.4];
    KILL -> APOP [color = "#B03A2E"];
    TREG -> CD8T [arrowhead = tee, color = "#1E7B34", penwidth = 2.2];
    PD1 -> CD8T [arrowhead = tee, color = "#1E7B34", penwidth = 2.2];
    TREG -> TOLER [color = "#1E7B34", penwidth = 2]; PD1 -> TOLER [color = "#1E7B34", penwidth = 2];
    IL10 -> TREG [color = "#1E7B34"];
    ICI -> PD1 [arrowhead = tee, color = "#B03A2E", penwidth = 2.4];
    ICI -> TREG [arrowhead = tee, color = "#B03A2E"];
    TOLER -> KILL [arrowhead = tee, color = "#1E7B34", penwidth = 2.4];
    LATENCY -> CD8T [label = "sensitisation period", style = dashed];
    CD4T -> AUTOAB [style = dashed];
}

/* ==========================================================================
   CLUSTER 10 — Regeneration, repair and functional reserve
   ========================================================================== */
subgraph cluster_regen {
    label = "10 · Regeneration, Repair & Functional Reserve";
    fontsize = 18; fontcolor = "#00695C"; style = "rounded,filled";
    fillcolor = "#F1FAF8"; color = "#00695C"; penwidth = 2;

    HEPVIABLE [label = "Viable hepatocyte mass\n(functional reserve = determinant of prognosis)", fillcolor = "#E2E3E5", penwidth = 3, shape = octagon];
    HEPSTRESS [label = "Stressed hepatocyte pool\n(reversible · recoverable)", fillcolor = "#FFF6C8", penwidth = 2];
    PRIMING   [label = "Regenerative priming\nTNF-α · IL-6 → STAT3 → G0 exit", fillcolor = "#D8F0DC", penwidth = 2.2];
    HGF       [label = "HGF / c-Met\nprincipal mitogenic factor", fillcolor = "#D8F0DC", penwidth = 2.2];
    EGF       [label = "EGF / TGF-α / VEGF", fillcolor = "#D8F0DC"];
    CYCLIN    [label = "Cell cycle entry\nCyclin D1 · PCNA · Ki-67", fillcolor = "#D8F0DC"];
    TGFB      [label = "TGF-β1 (proliferative stop signal)\nterminates regeneration · drives fibrosis", fillcolor = "#F8D7DA"];
    PROGEN    [label = "Hepatic progenitor cells (ductular reaction)\nmobilised on massive loss", fillcolor = "#D8F0DC"];
    SYNTHFN   [label = "Hepatic synthetic function\nalbumin · clotting factors V/VII\n(sets INR)", fillcolor = "#E2E3E5", penwidth = 2.4];
    DETOXFN   [label = "Hepatic detoxifying function\nammonia clearance · drug clearance", fillcolor = "#E2E3E5", penwidth = 2];
    ZONAL     [label = "Zonal specificity (Zone 3 / centrilobular)\nnecrosis begins where CYP2E1 is highest", fillcolor = "#E2E3E5", penwidth = 2];
    FIBROSIS  [label = "Fibrosis (chronic DILI · 10–20%)\ncollagen I/III deposition", fillcolor = "#F8D7DA"];

    HEPVIABLE -> HEPSTRESS [label = "entry into injury"];
    HEPSTRESS -> HEPVIABLE [label = "recovery (k_rec)", color = "#1E7B34", penwidth = 2];
    HEPSTRESS -> NECROSIS [label = "threshold exceeded", color = "#B03A2E", penwidth = 2];
    NECROSIS -> HEPVIABLE [label = "mass loss", arrowhead = tee, color = "#B03A2E", penwidth = 2.6];
    TNFA -> PRIMING [color = "#1E7B34", penwidth = 2]; IL6 -> PRIMING [color = "#1E7B34", penwidth = 2];
    PRIMING -> CYCLIN; HGF -> CYCLIN [penwidth = 2]; EGF -> CYCLIN;
    CYCLIN -> HEPVIABLE [label = "mass restored (k_reg)", color = "#1E7B34", penwidth = 2.6];
    TGFB -> CYCLIN [arrowhead = tee, color = "#B03A2E", penwidth = 1.8];
    TGFB -> FIBROSIS; HSCELL -> FIBROSIS [penwidth = 1.8];
    PROGEN -> HEPVIABLE [label = "on massive loss", style = dashed, color = "#1E7B34"];
    HEPVIABLE -> SYNTHFN [penwidth = 2.4]; HEPVIABLE -> DETOXFN [penwidth = 2];
    ZONAL -> NECROSIS [label = "site where necrosis starts", style = dashed];
    CYP2E1 -> ZONAL [label = "centrilobular expression", style = dashed];
    NECROSIS -> EFFEROC [style = dashed];
}

/* ==========================================================================
   CLUSTER 11 — Host susceptibility modifiers
   ========================================================================== */
subgraph cluster_host {
    label = "11 · Host Susceptibility Modifiers";
    fontsize = 18; fontcolor = "#5D4037"; style = "rounded,filled";
    fillcolor = "#FAF7F5"; color = "#5D4037"; penwidth = 2;

    AGE      [label = "Age (>55 y)\n· regenerative capacity↓ · reserve↓", fillcolor = "#E2E3E5"];
    SEXF     [label = "Female sex\n(acute liver failure · autoimmune phenotype risk↑)", fillcolor = "#E2E3E5"];
    ETOH     [label = "Chronic alcohol intake\nCYP2E1 induction + GSH depletion\n(a double hit)", fillcolor = "#F8D7DA", penwidth = 2.2];
    MALNUT   [label = "Fasting · malnutrition · low body weight\nglycogen and cysteine depletion", fillcolor = "#F8D7DA"];
    NAFLD    [label = "Obesity · MASLD\nmitochondrial reserve↓ · CYP2E1↑", fillcolor = "#F8D7DA"];
    UNDERLIV [label = "Underlying liver disease (cirrhosis)\nreserve lost → recovery fails", fillcolor = "#F8D7DA", penwidth = 2];
    POLYPH   [label = "Polypharmacy · DDI\nCYP induction (rifampicin) / inhibition", fillcolor = "#F8D7DA"];
    HLAGEN   [label = "HLA and non-HLA genotype\nPTPN22 · HLA-DQA1*02:01", fillcolor = "#F8D7DA"];
    MITOHAP  [label = "Mitochondrial haplotype\nSOD2 Ala16Val · GPX1 Pro198Leu", fillcolor = "#F8D7DA"];
    MICROB   [label = "Gut microbiota\nLPS translocation · β-glucuronidase activity", fillcolor = "#E2E3E5"];
    HERBAL   [label = "Herbal and dietary supplements (HDS)\n20%+ of the US DILIN registry", fillcolor = "#F8D7DA"];
    PREGN    [label = "Pregnancy · hormonal state", fillcolor = "#E2E3E5"];

    ETOH -> CYP2E1 [label = "induction (2–3 fold)", color = "#B03A2E", penwidth = 2.4];
    ETOH -> GSH [label = "depletion", arrowhead = tee, color = "#B03A2E", penwidth = 2];
    MALNUT -> FASTING [penwidth = 2];
    MALNUT -> UGT [label = "glucuronide supply↓", arrowhead = tee, color = "#B03A2E"];
    NAFLD -> CYP2E1 [color = "#B03A2E"];
    NAFLD -> ETC [label = "mitochondrial reserve↓", arrowhead = tee, color = "#B03A2E"];
    AGE -> CYCLIN [arrowhead = tee, color = "#B03A2E"];
    UNDERLIV -> HEPVIABLE [label = "baseline mass↓", arrowhead = tee, color = "#B03A2E", penwidth = 2];
    POLYPH -> CYP3A4 [label = "induction/inhibition", style = dashed];
    HLAGEN -> HLARISK [penwidth = 2];
    MITOHAP -> SOD2 [arrowhead = tee, style = dashed];
    MICROB -> ENTERO [style = dashed];
    MICROB -> TLR4 [label = "LPS translocation", style = dashed];
    HERBAL -> LIVDRUG [style = dashed, color = "#B03A2E"];
    SEXF -> CD8T [style = dashed];
    PREGN -> CYP2E1 [style = dashed];
}

/* ==========================================================================
   CLUSTER 12 — Biomarkers
   ========================================================================== */
subgraph cluster_biomarker {
    label = "12 · Biomarkers: Mechanistic and Regulatory";
    fontsize = 18; fontcolor = "#00579B"; style = "rounded,filled";
    fillcolor = "#F1F8FE"; color = "#00579B"; penwidth = 2;

    ALT     [label = "Serum ALT\n= surrogate for the RATE of cell death\n(t½ ≈ 47 h)", fillcolor = "#CFE7E4", penwidth = 2.8, shape = octagon];
    AST     [label = "Serum AST\n(t½ ≈ 17 h · muscle-derived contribution)", fillcolor = "#CFE7E4"];
    TBIL    [label = "Total bilirubin\n= surrogate for remaining RESERVE\n(rises once functional mass < 50%)", fillcolor = "#CFE7E4", penwidth = 2.8, shape = octagon];
    ALPB    [label = "ALP\nmarker of biliary injury", fillcolor = "#CFE7E4"];
    INR     [label = "INR / factor V\ncollapse of synthetic function", fillcolor = "#CFE7E4", penwidth = 2.4];
    RRATIO  [label = "R ratio = (ALT/ULN)/(ALP/ULN)\nR≥5 hepatocellular · R≤2 cholestatic\n· 2<R<5 mixed", fillcolor = "#CFE7E4", penwidth = 2.4, shape = diamond];
    MIR122  [label = "miR-122\nliver-specific · rises earlier than ALT", fillcolor = "#CFE7E4", penwidth = 2];
    HMGB1B  [label = "HMGB1 (full-length/acetylated)\ndistinguishes necrosis from immune activation", fillcolor = "#CFE7E4", penwidth = 2];
    K18     [label = "K18 / ccK18 (M65/M30)\nnecrosis-to-apoptosis ratio", fillcolor = "#CFE7E4", penwidth = 2];
    GLDH    [label = "GLDH\nmitochondrially derived · liver-specific", fillcolor = "#CFE7E4"];
    CSF1R   [label = "MCSFR / osteopontin\nmarker of macrophage activation", fillcolor = "#CFE7E4"];
    APAPCYS [label = "APAP-Cys adducts (in blood)\nconfirmatory exposure biomarker", fillcolor = "#CFE7E4", penwidth = 2];
    TBAB    [label = "Serum total bile acids\nearly marker of cholestasis", fillcolor = "#CFE7E4"];
    LACTATE [label = "Arterial lactate · ammonia\nmitochondrial failure · prognostic marker", fillcolor = "#CFE7E4"];
    ALBUM   [label = "Albumin (t½ 20 days)\nchronic and subacute marker", fillcolor = "#CFE7E4"];

    NECROSIS -> ALT [label = "release (∝ rate of necrosis)", penwidth = 2.8];
    NECROSIS -> AST [penwidth = 2]; NECROSIS -> GLDH [penwidth = 1.8];
    NECROSIS -> MIR122 [penwidth = 2]; NECROSIS -> HMGB1B [penwidth = 2];
    NECROSIS -> K18 [penwidth = 1.8]; APOP -> K18 [label = "ccK18 (M30)"];
    HEPVIABLE -> TBIL [label = "rises as mass falls short", arrowhead = tee, penwidth = 2.6];
    BILICONJ -> TBIL [arrowhead = tee, penwidth = 1.8];
    MRP2 -> TBIL [arrowhead = tee, style = dashed];
    SYNTHFN -> INR [arrowhead = tee, penwidth = 2.6];
    SYNTHFN -> ALBUM [arrowhead = tee];
    ALKPHOS -> ALPB [penwidth = 2];
    ALT -> RRATIO [penwidth = 2]; ALPB -> RRATIO [penwidth = 2];
    ADDUCT -> APAPCYS [penwidth = 1.8];
    BAPLASM -> TBAB [penwidth = 2];
    ATP -> LACTATE [arrowhead = tee, penwidth = 1.8];
    DETOXFN -> LACTATE [arrowhead = tee, style = dashed];
    KUPFFER -> CSF1R [style = dashed];
}

/* ==========================================================================
   CLUSTER 13 — Clinical endpoints, causality and prognosis
   ========================================================================== */
subgraph cluster_clin {
    label = "13 · Clinical Endpoints, Causality & Prognosis";
    fontsize = 18; fontcolor = "#B71C1C"; style = "rounded,filled";
    fillcolor = "#FFF4F4"; color = "#B71C1C"; penwidth = 2;

    ASYMPT  [label = "Asymptomatic enzyme elevation\n(adaptation · spontaneous resolution)", fillcolor = "#FADCE8"];
    HEPATOC [label = "Hepatocellular injury\nALT ≥ 5×ULN · R ≥ 5", fillcolor = "#FADCE8", penwidth = 2];
    CHOLES  [label = "Cholestatic injury\nALP ≥ 2×ULN · R ≤ 2\n(slow recovery · pruritus)", fillcolor = "#FADCE8", penwidth = 2];
    MIXED   [label = "Mixed injury\n2 < R < 5", fillcolor = "#FADCE8"];
    HYLAW   [label = "Hy's Law\nALT ≥ 3×ULN AND TBIL ≥ 2×ULN\n(without biliary obstruction) → death/transplant ~10%", fillcolor = "#FADCE8", penwidth = 3, shape = doubleoctagon];
    ALFAIL  [label = "Acute liver failure (ALF)\nhepatic encephalopathy + INR ≥ 1.5", fillcolor = "#FADCE8", penwidth = 2.6];
    ENCEPH  [label = "Hepatic encephalopathy (grades I–IV)\nammonia · cerebral oedema", fillcolor = "#FADCE8"];
    KCC     [label = "King's College criteria\nAPAP type: pH<7.3 or\n(INR>6.5 + Cr>3.4 + HE III–IV)", fillcolor = "#FADCE8", penwidth = 2.6, shape = diamond];
    MELD    [label = "MELD / MELD-Na score", fillcolor = "#FADCE8"];
    TRANSPL [label = "Liver transplantation · death", fillcolor = "#FADCE8", penwidth = 2.4];
    RECOV   [label = "Complete recovery (the majority)\nusually within 6 months", fillcolor = "#D8F0DC", penwidth = 2.4];
    CHRONIC [label = "Chronic DILI (about 10–20%)\npersisting beyond 6 months", fillcolor = "#FADCE8"];
    VBDS    [label = "Vanishing bile duct syndrome (VBDS)\nirreversible bile duct loss", fillcolor = "#FADCE8"];
    RUCAM   [label = "Causality assessment\nRUCAM / RECAM · DILIN expert consensus\n(dechallenge / rechallenge)", fillcolor = "#E2E3E5", penwidth = 2];
    PRURIT  [label = "Pruritus · jaundice · fatigue\n· right upper quadrant pain", fillcolor = "#FADCE8"];
    REEXPO  [label = "Rechallenge\nrapid, severe recurrence — contraindicated in principle", fillcolor = "#FADCE8", penwidth = 2];

    ALT -> HEPATOC [penwidth = 2]; RRATIO -> HEPATOC; RRATIO -> CHOLES; RRATIO -> MIXED;
    ALPB -> CHOLES [penwidth = 2];
    ALT -> HYLAW [penwidth = 2.6]; TBIL -> HYLAW [penwidth = 2.6];
    ADAPT -> ASYMPT [color = "#1E7B34", penwidth = 2.2];
    HYLAW -> ALFAIL [penwidth = 2.2];
    INR -> ALFAIL [penwidth = 2.2]; ENCEPH -> ALFAIL [penwidth = 2];
    DETOXFN -> ENCEPH [arrowhead = tee, penwidth = 2];
    LACTATE -> KCC [penwidth = 1.8]; INR -> KCC [penwidth = 1.8]; ENCEPH -> KCC;
    ALFAIL -> KCC [penwidth = 2]; KCC -> TRANSPL [penwidth = 2.4];
    MELD -> TRANSPL;
    TBIL -> MELD; INR -> MELD;
    HEPVIABLE -> RECOV [label = "reserve sufficient", color = "#1E7B34", penwidth = 2.4];
    CYCLIN -> RECOV [color = "#1E7B34", penwidth = 2];
    CHOLES -> CHRONIC [penwidth = 1.8]; CHOLES -> PRURIT;
    CHOLANG -> VBDS [penwidth = 2]; VBDS -> CHRONIC;
    FIBROSIS -> CHRONIC;
    RUCAM -> HEPATOC [style = dashed, dir = back];
    REEXPO -> CD8T [label = "immediate memory T cell response", color = "#B03A2E", penwidth = 2];
    TBIL -> PRURIT [style = dashed];
    HEPATOC -> ALFAIL [style = dashed];
}

/* ==========================================================================
   CLUSTER 14 — Therapeutics and clinical management
   ========================================================================== */
subgraph cluster_tx {
    label = "14 · Therapeutics & Clinical Management";
    fontsize = 18; fontcolor = "#8A5B00"; style = "rounded,filled";
    fillcolor = "#FFFAF0"; color = "#8A5B00"; penwidth = 2;

    STOPDRUG [label = "Immediate withdrawal of the causative drug\n(the single most effective intervention)", fillcolor = "#FFE7B3", penwidth = 2.8];
    NAC      [label = "N-acetylcysteine (NAC)\nIV Prescott: 150→50→100 mg/kg\nor the 21-hour SNAP regimen", fillcolor = "#FFE7B3", penwidth = 3, shape = octagon];
    NACMECH1 [label = "NAC mechanism ①\ncysteine supply → GSH resynthesis", fillcolor = "#FFE7B3", penwidth = 2];
    NACMECH2 [label = "NAC mechanism ②\ndirect ROS scavenging · thiol reduction", fillcolor = "#FFE7B3"];
    NACMECH3 [label = "NAC mechanism ③\nimproved microcirculation and oxygen delivery\n(beneficial in non-APAP ALF too)", fillcolor = "#FFE7B3"];
    RUMACK   [label = "Rumack-Matthew nomogram\n4-hour concentration 150 µg/mL line\n(valid only for a single acute ingestion)", fillcolor = "#FFE7B3", penwidth = 2.2];
    FOMEP    [label = "Fomepizole (4-MP)\nCYP2E1 inhibition + JNK inhibition\n(adjunctive · investigational)", fillcolor = "#FFE7B3", penwidth = 2.2];
    CALMANG  [label = "Calmangafodipir\nSOD mimetic (phase 2)", fillcolor = "#FFE7B3"];
    CORTICO  [label = "Corticosteroids\nimmune-mediated · ICI hepatitis · DRESS\n(ineffective in the APAP type)", fillcolor = "#FFE7B3", penwidth = 2.2];
    MMF      [label = "Mycophenolate · tacrolimus\nsteroid-refractory ICI hepatitis", fillcolor = "#FFE7B3"];
    UDCA     [label = "UDCA\ncholestatic type · hydrophilises the bile acid pool", fillcolor = "#FFE7B3", penwidth = 2];
    CHOLEST  [label = "Colestyramine · rifampicin\npruritus · bile acid sequestration\n(leflunomide washout)", fillcolor = "#FFE7B3"];
    LCARN    [label = "L-carnitine\nvalproate toxicity · FAO rescue", fillcolor = "#FFE7B3", penwidth = 2];
    CARNIT   [label = "L-ornithine L-aspartate\n· lactulose · rifaximin (encephalopathy)", fillcolor = "#FFE7B3"];
    MARS     [label = "Extracorporeal liver support (MARS · plasma exchange)\nhigh-volume plasma exchange improves ALF survival", fillcolor = "#FFE7B3", penwidth = 2];
    LTX      [label = "Liver transplantation (salvage therapy)", fillcolor = "#FFE7B3", penwidth = 2.2];
    MONITOR  [label = "Prophylactic monitoring strategy\nALT follow-up on isoniazid and anti-TB therapy\n· 'stopping rule' (ALT>5×ULN)", fillcolor = "#FFE7B3", penwidth = 2];
    DEPRESCR [label = "Switch to an alternative agent · no rechallenge\n· patient alert card", fillcolor = "#FFE7B3"];

    STOPDRUG -> LIVDRUG [label = "blocks input", arrowhead = tee, color = "#B8860B", penwidth = 2.8];
    NAC -> NACMECH1 [penwidth = 2]; NAC -> NACMECH2; NAC -> NACMECH3;
    NACMECH1 -> CYS [label = "substrate supply", color = "#1E7B34", penwidth = 2.8];
    NACMECH2 -> ROS [arrowhead = tee, color = "#1E7B34", penwidth = 2];
    NACMECH3 -> ATP [color = "#1E7B34"];
    NAC -> SEPARAT [label = "pushes the trajectory back below the separatrix\n(window = the time at which the separatrix is reached)", color = "#1E7B34", penwidth = 2.8, style = bold];
    RUMACK -> NAC [label = "decision to start treatment", penwidth = 2];
    APAPCYS -> RUMACK [style = dashed, dir = back];
    FOMEP -> CYP2E1 [arrowhead = tee, color = "#B8860B", penwidth = 2.2];
    FOMEP -> PJNK [arrowhead = tee, color = "#B8860B", penwidth = 2];
    CALMANG -> ROS [arrowhead = tee, color = "#B8860B"];
    CORTICO -> CD8T [arrowhead = tee, color = "#B8860B", penwidth = 2.4];
    CORTICO -> KUPFFER [arrowhead = tee, color = "#B8860B"];
    MMF -> CD8T [arrowhead = tee, color = "#B8860B"];
    UDCA -> BAHC [label = "dilutes the toxic bile acids", arrowhead = tee, color = "#B8860B", penwidth = 2.2];
    UDCA -> BSEP [label = "stimulates trafficking", color = "#B8860B"];
    CHOLEST -> ENTERO [arrowhead = tee, color = "#B8860B", penwidth = 2];
    LCARN -> BOX [arrowhead = tee, color = "#B8860B", penwidth = 2];
    CARNIT -> ENCEPH [arrowhead = tee, color = "#B8860B"];
    MARS -> TBIL [arrowhead = tee, color = "#B8860B"];
    MARS -> ALFAIL [arrowhead = tee, color = "#B8860B", penwidth = 2];
    LTX -> TRANSPL [style = dashed];
    MONITOR -> STOPDRUG [label = "early detection", color = "#B8860B", penwidth = 2];
    ALT -> MONITOR [style = dashed, dir = back];
    DEPRESCR -> REEXPO [arrowhead = tee, color = "#B8860B", penwidth = 2.2];
    ACHARCOAL -> DOSE [style = invis];
}

/* ==========================================================================
   Cross-cluster integrating edges — the load-bearing structure
   ========================================================================== */

    /* the central rate comparison */
    RM   -> GSH      [label = "  consumption flux (v_conj)  ", color = "#B03A2E", penwidth = 2.8, arrowhead = tee, constraint = false];
    GCL  -> RM       [label = "  disposal capacity (v_syn)  ", color = "#1E7B34", penwidth = 2.6, style = dashed, arrowhead = tee, constraint = false];

    /* injury feeds inflammation feeds injury */
    TNFA -> HEPSTRESS [label = "secondary injury", color = "#B03A2E", style = dashed, constraint = false];
    IL6  -> HEPVIABLE [label = "hepatoprotection", color = "#1E7B34", style = dashed, constraint = false];

    /* bile arm converges on the same death node */
    BAHC -> HEPSTRESS [color = "#B03A2E", style = dashed, constraint = false];

    /* reserve determines whether the same rate is survivable */
    HEPVIABLE -> SEPARAT [label = "reserve shifts the position of the separatrix", style = dashed, color = "#6A1B9A", constraint = false];

    /* the two arms of Hy's Law are structurally different quantities */
    ALT  -> HYLAW    [style = bold, color = "#B71C1C", constraint = false];
    TBIL -> HYLAW    [style = bold, color = "#B71C1C", constraint = false];

/* ==========================================================================
   Legend
   ========================================================================== */
subgraph cluster_legend {
    label = "Legend";
    fontsize = 16; style = "rounded,filled"; fillcolor = "#FCFCFC"; color = "#666666";

    L1 [label = "Drug / PK species", fillcolor = "#DCE9F7"];
    L2 [label = "Enzymes · transporters", fillcolor = "#FBE3D6"];
    L3 [label = "Toxic species · damage", fillcolor = "#F8D7DA"];
    L4 [label = "Defence · adaptive mechanisms", fillcolor = "#D8F0DC"];
    L5 [label = "Immune cells · cytokines", fillcolor = "#EDE0F5"];
    L6 [label = "Signalling nodes", fillcolor = "#FFF6C8"];
    L7 [label = "Biomarkers", fillcolor = "#CFE7E4"];
    L8 [label = "Clinical endpoints", fillcolor = "#FADCE8"];
    L9 [label = "Therapeutic interventions", fillcolor = "#FFE7B3"];
    L10 [label = "Physiological · structural state", fillcolor = "#E2E3E5"];
    L11 [label = "Threshold · tipping point (octagon)", fillcolor = "#F8D7DA", shape = octagon];
    L12 [label = "Decision rule (diamond)", fillcolor = "#CFE7E4", shape = diamond];

    LE1 [label = "Promotes / induces", shape = plaintext, style = "", fillcolor = "white"];
    LE2 [label = "Inhibits (⊣)", shape = plaintext, style = "", fillcolor = "white"];
    LE3 [label = "Protective direction (green)", shape = plaintext, style = "", fillcolor = "white"];
    LE4 [label = "Injurious direction (red)", shape = plaintext, style = "", fillcolor = "white"];

    L1 -> L2 [style = invis]; L2 -> L3 [style = invis]; L3 -> L4 [style = invis];
    L4 -> L5 [style = invis]; L5 -> L6 [style = invis]; L6 -> L7 [style = invis];
    L7 -> L8 [style = invis]; L8 -> L9 [style = invis]; L9 -> L10 [style = invis];
    L10 -> L11 [style = invis]; L11 -> L12 [style = invis];
    LE1 -> LE2 [label = "example", color = "#4a4a4a"];
    LE2 -> LE3 [arrowhead = tee, color = "#1E7B34"];
    LE3 -> LE4 [color = "#B03A2E"];
}

}
