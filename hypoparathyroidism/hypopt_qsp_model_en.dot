/*
 * hypopt_qsp_model.dot
 * ---------------------------------------------------------------------------
 * Chronic Hypoparathyroidism (HypoPT)
 * Quantitative Systems Pharmacology mechanistic map
 *
 * 16 clusters · ~175 nodes · ~300 edges
 *
 * Render:
 *   dot -Tsvg hypopt_qsp_model.dot -o hypopt_qsp_model_en.svg
 *   dot -Tpng -Gdpi=150 hypopt_qsp_model.dot -o hypopt_qsp_model_en.png
 *
 * Legend (edge style):
 *   solid black  = mass flux / synthesis / conversion
 *   blue         = stimulation / activation
 *   red (tee)    = inhibition / loss of function
 *   dashed green = drug action
 *   dotted grey  = feedback loop
 * ---------------------------------------------------------------------------
 */
digraph HypoPT_QSP {
  graph [rankdir=TB, splines=spline, overlap=false, nodesep=0.28, ranksep=0.55,
         fontname="Helvetica", fontsize=11, compound=true,
         labelloc="t", label=<<B>Chronic Hypoparathyroidism — QSP Mechanistic Map</B><BR/>
         <FONT POINT-SIZE="11">Parathyroid chief cell · PTH1R signaling · bone–kidney–gut calcium axis · phosphate/FGF23 · PTH replacement pharmacology</FONT>>];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10,
         color="#555555", penwidth=1.0, margin="0.08,0.05"];
  edge  [fontname="Helvetica", fontsize=8, color="#444444", arrowsize=0.6];

  /* ===================================================================== */
  /* 1. Aetiology                                                           */
  /* ===================================================================== */
  subgraph cluster_etio {
    label=<<B>1. Aetiology — loss of parathyroid tissue · functional failure</B>>;
    style="rounded,filled"; fillcolor="#FDF2F2"; color="#C0392B"; fontcolor="#943126";
    node [fillcolor="#FADBD8"];

    e_surg     [label="Post-surgical (75–80%)", fillcolor="#F5B7B1", penwidth=2];
    e_thyroid  [label="Total thyroidectomy"];
    e_ptx      [label="Parathyroidectomy\n(after surgery for HPT)"];
    e_neck     [label="Radical neck dissection\nvascular injury"];
    e_transient[label="Transient (defined as chronic\nonce it persists >6 months)"];

    e_ai_aps1  [label="APS-1 / AIRE mutation\n(autoimmune polyglandular syndrome type 1)"];
    e_ai_nalp5 [label="Anti-NALP5 autoantibodies"];
    e_ai_casrab[label="Activating CaSR autoantibodies"];

    e_adh1     [label="ADH1: CASR gain of function\n(autosomal dominant hypocalcaemia type 1)", fillcolor="#F5B7B1", penwidth=2];
    e_adh2     [label="ADH2: GNA11 gain of function"];
    e_gcm2     [label="GCM2 loss of function\n(defective parathyroid development)"];
    e_pthgene  [label="PTH gene mutation\n(prepro-PTH signal sequence)"];
    e_gata3    [label="HDR syndrome (GATA3)\nwith deafness and renal anomaly"];
    e_22q11    [label="DiGeorge 22q11.2 deletion\n(TBX1)"];
    e_fam111a  [label="Kenny–Caffey / FAM111A"];
    e_mito     [label="Mitochondrial disease\n(KSS · MELAS · MTP deficiency)"];

    e_infilt   [label="Infiltrative: haemochromatosis · Wilson disease\nmetastasis · amyloid"];
    e_rad      [label="Neck irradiation / radioiodine"];
    e_mglow    [label="Severe hypomagnesaemia\n(functional and reversible)", fillcolor="#F5B7B1"];
    e_idio     [label="Idiopathic / unclassified"];
    e_maternal [label="Transient neonatal suppression\nfrom maternal hypercalcaemia"];
  }

  /* ===================================================================== */
  /* 2. Parathyroid chief cell biology                                      */
  /* ===================================================================== */
  subgraph cluster_pcell {
    label=<<B>2. Parathyroid chief cell — calcium sensing and PTH secretion</B>>;
    style="rounded,filled"; fillcolor="#FEF9E7"; color="#B7950B"; fontcolor="#7D6608";
    node [fillcolor="#FCF3CF"];

    pc_mass    [label="Functional chief-cell mass", fillcolor="#F9E79F", penwidth=2];
    pc_casr    [label="CaSR (calcium-sensing receptor, class C GPCR)", fillcolor="#F9E79F", penwidth=2];
    pc_gq      [label="Gq/11 → PLCβ → IP3 / DAG"];
    pc_gi      [label="Gi → adenylyl cyclase inhibition → cAMP ↓"];
    pc_cai     [label="Intracellular Ca²⁺ ↑ → secretion inhibited"];
    pc_setpt   [label="Ca set-point (EC₅₀ ≈ 1.15–1.25 mM)", fillcolor="#F9E79F", penwidth=2];
    pc_sigmoid [label="Sigmoid Ca–PTH response curve\n(4-parameter Hill, shifted down and left)"];
    pc_gene    [label="PTH gene transcription"];
    pc_mrna    [label="PTH mRNA stability\n(AUF1 · 3'-UTR)"];
    pc_prepro  [label="prepro-PTH (115 aa)"];
    pc_pro     [label="pro-PTH (90 aa)"];
    pc_pth184  [label="PTH(1-84) mature hormone", fillcolor="#F9E79F", penwidth=2];
    pc_gran    [label="Secretory granule store\n(immediately releasable pool)"];
    pc_secr    [label="PTH secretion rate (pulsatile · 25% basal)"];
    pc_deg     [label="Intracellular degradation → C-terminal fragments\nPTH(7-84) antagonism"];
    pc_vdrfb   [label="VDR negative feedback (1,25D → PTH transcription ↓)"];
    pc_klotho  [label="FGFR1–αKlotho (FGF23 feedback)"];
    pc_mgdep   [label="Mg²⁺-dependent Gα activity / exocytosis"];
    pc_prolif  [label="Chief cell proliferation (chronic hypocalcaemic drive)"];
  }

  /* ===================================================================== */
  /* 3. PTH1R signalling                                                    */
  /* ===================================================================== */
  subgraph cluster_pth1r {
    label=<<B>3. PTH1R receptor signalling (bone and kidney target cells)</B>>;
    style="rounded,filled"; fillcolor="#EAF2F8"; color="#2471A3"; fontcolor="#1A5276";
    node [fillcolor="#D4E6F1"];

    r_pth1r  [label="PTH1R (class B GPCR)", fillcolor="#AED6F1", penwidth=2];
    r_r0     [label="R0 high-affinity state\n→ prolonged cAMP signal", fillcolor="#AED6F1"];
    r_rg     [label="RG state (G protein-dependent)\n→ transient cAMP signal"];
    r_gs     [label="Gs → adenylyl cyclase"];
    r_camp   [label="cAMP ↑", fillcolor="#AED6F1", penwidth=2];
    r_pka    [label="PKA activation"];
    r_gq2    [label="Gq/11 → PLCβ → PKC / Ca²⁺"];
    r_barr   [label="β-arrestin recruitment → internalisation"];
    r_endo   [label="Sustained endosomal cAMP signalling\n(retromer-dependent termination)"];
    r_creb   [label="CREB / SIK target genes"];
    r_pthrp  [label="PTHrP (local ligand, competing)"];
    r_desens [label="Receptor desensitisation / recycling"];
  }

  /* ===================================================================== */
  /* 4. Renal handling                                                      */
  /* ===================================================================== */
  subgraph cluster_kidney {
    label=<<B>4. Kidney — calcium reabsorption · phosphate excretion · 1α-hydroxylation</B>>;
    style="rounded,filled"; fillcolor="#EAFAF1"; color="#1E8449"; fontcolor="#145A32";
    node [fillcolor="#D5F5E3"];

    k_gfr     [label="Glomerular filtration rate (GFR)", fillcolor="#ABEBC6"];
    k_filt    [label="Filtered calcium load\n(≈10 g/day, 98–99% reabsorbed)"];
    k_pt      [label="Proximal tubule (65% of Ca reabsorption)"];
    k_npt2a   [label="NPT2a / NPT2c (phosphate cotransporters)", fillcolor="#ABEBC6"];
    k_pireab  [label="Phosphate reabsorption ↑ → TmP/GFR ↑", fillcolor="#ABEBC6", penwidth=2];
    k_tal     [label="Thick ascending limb (TAL, 20%)"];
    k_cldn    [label="Claudin-16/19 paracellular route"];
    k_casrtal [label="TAL CaSR (inhibits cation reabsorption)"];
    k_nkcc2   [label="NKCC2 → lumen-positive potential"];
    k_dct     [label="Distal convoluted tubule (DCT, 10–15%, PTH-dependent)", fillcolor="#ABEBC6", penwidth=2];
    k_trpv5   [label="TRPV5 (apical entry)"];
    k_calb28  [label="Calbindin-D28k (intracellular shuttle)"];
    k_ncx1    [label="NCX1 / PMCA1b (basolateral extrusion)"];
    k_careab  [label="Distal calcium reabsorption ↓", fillcolor="#ABEBC6", penwidth=2];
    k_hyperca [label="Hypercalciuria (>4 mg/kg/day · >300 mg/day)", fillcolor="#82E0AA", penwidth=2];
    k_cyp27b1 [label="CYP27B1 (1α-hydroxylase) ↓", fillcolor="#ABEBC6", penwidth=2];
    k_cyp24a1 [label="CYP24A1 (24-hydroxylase) ↑"];
    k_mgreab  [label="TAL Mg²⁺ reabsorption (TRPM6/claudin)"];
    k_nephroc [label="Nephrocalcinosis (medullary calcium deposition)", fillcolor="#82E0AA", penwidth=2];
    k_stone   [label="Nephrolithiasis (calcium phosphate/oxalate)"];
    k_ckd     [label="Chronic kidney disease · falling eGFR\n(2–17× the risk in HypoPT)", fillcolor="#82E0AA", penwidth=2];
    k_conc    [label="Reduced urinary concentrating ability · polyuria"];
    k_hco3    [label="Proximal HCO₃⁻ reabsorption ↑ → mild metabolic alkalosis"];
  }

  /* ===================================================================== */
  /* 5. Bone remodelling                                                    */
  /* ===================================================================== */
  subgraph cluster_bone {
    label=<<B>5. Bone — the low bone turnover state</B>>;
    style="rounded,filled"; fillcolor="#F4ECF7"; color="#7D3C98"; fontcolor="#4A235A";
    node [fillcolor="#E8DAEF"];

    b_ocyte   [label="Osteocyte network"];
    b_sost    [label="Sclerostin (SOST) ↑"];
    b_wnt     [label="Wnt / β-catenin signalling ↓"];
    b_ob      [label="Osteoblast activity ↓", fillcolor="#D7BDE2"];
    b_oc      [label="Osteoclast activity ↓↓", fillcolor="#D7BDE2"];
    b_mcsf    [label="M-CSF"];
    b_rankl   [label="RANKL"];
    b_opg     [label="OPG"];
    b_ratio   [label="RANKL / OPG ratio ↓", fillcolor="#D7BDE2", penwidth=2];
    b_remod   [label="Bone remodelling unit (BMU) activation frequency ↓\n= low turnover bone", fillcolor="#C39BD3", penwidth=2];
    b_labile  [label="Rapidly exchangeable bone calcium pool\n≈ 1–2 g (of 4–5 g total exchangeable)"];
    b_mineral [label="Structural bone mineral (≈1,000 g Ca)"];
    b_p1np    [label="P1NP (bone formation marker) ↓"];
    b_ctx     [label="CTX (bone resorption marker) ↓"];
    b_bsap    [label="Bone-specific ALP ↓"];
    b_ocn     [label="Osteocalcin ↓"];
    b_bmd     [label="BMD ↑ (lumbar spine Z-score +1 ~ +2)", fillcolor="#D7BDE2", penwidth=2];
    b_micro   [label="Microstructure: cortical thickness↑ · porosity↓\ntrabecular TBS reduced · mineralisation heterogeneity↓"];
    b_fx      [label="Fracture risk (heterogeneous by site\nvertebral risk↑, hip risk↓ and unclear)"];
    b_marrow  [label="Marrow adiposity / osteocyte apoptosis"];
  }

  /* ===================================================================== */
  /* 6. Intestinal calcium and phosphate absorption                         */
  /* ===================================================================== */
  subgraph cluster_gut {
    label=<<B>6. Gut — calcium and phosphate absorption</B>>;
    style="rounded,filled"; fillcolor="#FEF5E7"; color="#CA6F1E"; fontcolor="#873600";
    node [fillcolor="#FAE5D3"];

    g_dietca  [label="Dietary calcium (800–1,200 mg/day)"];
    g_suppca  [label="Oral calcium salts\n(calcium carbonate 40% · calcium citrate 21%)", fillcolor="#F5CBA7"];
    g_ph      [label="Gastric pH-dependent dissolution\n(carbonate absorption↓ with PPIs or achlorhydria)"];
    g_trpv6   [label="TRPV6 (active duodenal entry)"];
    g_calb9   [label="Calbindin-D9k"];
    g_pmca    [label="PMCA1b (basolateral extrusion)"];
    g_para    [label="Paracellular passive diffusion (jejunum · ileum)"];
    g_frac    [label="Fractional calcium absorption\n(1,25D-dependent ~20% → 45%)", fillcolor="#F5CBA7", penwidth=2];
    g_dietpi  [label="Dietary phosphate (800–1,400 mg/day)"];
    g_npt2b   [label="NPT2b (phosphate absorption)"];
    g_binder  [label="Phosphate binders / low-phosphate diet"];
    g_oxal    [label="Intestinal oxalate absorption (↑ when calcium binding falls)"];
  }

  /* ===================================================================== */
  /* 7. Vitamin D axis                                                      */
  /* ===================================================================== */
  subgraph cluster_vitd {
    label=<<B>7. Vitamin D axis</B>>;
    style="rounded,filled"; fillcolor="#FDEDEC"; color="#CB4335"; fontcolor="#78281F";
    node [fillcolor="#FADBD8"];

    v_skin    [label="Cutaneous 7-DHC → cholecalciferol (UVB)"];
    v_diet    [label="Dietary / supplemental vitamin D₃"];
    v_cyp2r1  [label="Hepatic CYP2R1 (25-hydroxylation)"];
    v_25d     [label="25(OH)D (storage form, t½ ≈ 2–3 weeks)", fillcolor="#F5B7B1"];
    v_dbp     [label="DBP / albumin binding ↔ free fraction"];
    v_125d    [label="1,25(OH)₂D (calcitriol, t½ ≈ 4–6 h)", fillcolor="#F5B7B1", penwidth=2];
    v_vdr     [label="VDR–RXR transcriptional complex"];
    v_cyp24   [label="CYP24A1 → 24,25D · calcitroic acid"];
    v_exocal  [label="Exogenous calcitriol (0.25–2 µg/day)", fillcolor="#F5B7B1"];
    v_alfa    [label="Alfacalcidol → needs hepatic 25-hydroxylation"];
    v_dhtach  [label="Dihydrotachysterol (older regimen)"];
  }

  /* ===================================================================== */
  /* 8. Phosphate / FGF23 axis                                              */
  /* ===================================================================== */
  subgraph cluster_pi {
    label=<<B>8. Phosphate homeostasis · FGF23 · ectopic calcification</B>>;
    style="rounded,filled"; fillcolor="#EBF5FB"; color="#2E86C1"; fontcolor="#1B4F72";
    node [fillcolor="#D6EAF8"];

    p_piec    [label="Serum phosphate ↑ (hyperphosphataemia)", fillcolor="#AED6F1", penwidth=2];
    p_fgf23   [label="FGF23 (secreted by osteocytes)"];
    p_klotho  [label="αKlotho coreceptor"];
    p_dmp1    [label="DMP1 / PHEX regulation"];
    p_caxp    [label="Ca × P product ↑ (>55 mg²/dL²)", fillcolor="#AED6F1", penwidth=2];
    p_ppi     [label="Pyrophosphate / fetuin-A inhibitory capacity exceeded"];
    p_ectopic [label="Ectopic calcification\n(kidney · vessels · basal ganglia · lens)", fillcolor="#85C1E9", penwidth=2];
    p_vsmc    [label="Vascular smooth muscle osteogenic switch\n(RUNX2 · BMP2)"];
  }

  /* ===================================================================== */
  /* 9. Magnesium                                                           */
  /* ===================================================================== */
  subgraph cluster_mg {
    label=<<B>9. Magnesium interactions</B>>;
    style="rounded,filled"; fillcolor="#F2F4F4"; color="#5D6D7E"; fontcolor="#2E4053";
    node [fillcolor="#E5E7E9"];

    m_ec      [label="Serum Mg²⁺", fillcolor="#CCD1D1"];
    m_intake  [label="Intake / gastrointestinal absorption (TRPM6)"];
    m_loss    [label="Losses: diarrhoea · PPIs · diuretics\ncisplatin · alcohol"];
    m_secblk  [label="PTH secretion blocked (deficient Gα activity)"];
    m_res     [label="End-organ PTH resistance (adenylyl cyclase)"];
    m_repl    [label="Mg repletion → reversible recovery"];
  }

  /* ===================================================================== */
  /* 10. Calcium speciation · correction                                    */
  /* ===================================================================== */
  subgraph cluster_spec {
    label=<<B>10. Blood calcium speciation and correction</B>>;
    style="rounded,filled"; fillcolor="#FBEEE6"; color="#A04000"; fontcolor="#6E2C00";
    node [fillcolor="#F6DDCC"];

    s_total   [label="Total serum calcium (8.5–10.2 mg/dL)"];
    s_alb     [label="Albumin-bound fraction (≈40%)"];
    s_cmplx   [label="Anion complexes (citrate · phosphate · bicarbonate, ≈10%)"];
    s_ion     [label="Ionised calcium (≈50%, 1.15–1.30 mM)", fillcolor="#EDBB99", penwidth=2];
    s_ph      [label="Blood pH (alkalosis → albumin binding↑ → iCa↓)"];
    s_corr    [label="Correction: Ca + 0.8 × (4.0 − albumin)"];
    s_citrate [label="Citrate (massive transfusion · dialysis) → iCa ↓"];
    s_ecfvol  [label="Extracellular fluid calcium pool (≈1 g, very rapid turnover)"];
  }

  /* ===================================================================== */
  /* 11. Neuromuscular symptoms                                             */
  /* ===================================================================== */
  subgraph cluster_nm {
    label=<<B>11. Neuromuscular excitability · acute symptoms</B>>;
    style="rounded,filled"; fillcolor="#FDF2E9"; color="#D35400"; fontcolor="#943126";
    node [fillcolor="#FAE5D3"];

    n_nav     [label="Voltage-gated Na⁺ channel threshold destabilised\n(less screening of membrane surface charge)"];
    n_excit   [label="Neuromuscular excitability ↑", fillcolor="#F5CBA7", penwidth=2];
    n_pares   [label="Perioral and acral paraesthesia"];
    n_tetany  [label="Tetany · carpopedal spasm"];
    n_signs   [label="Chvostek · Trousseau signs"];
    n_laryngo [label="Laryngospasm · bronchospasm"];
    n_seiz    [label="Generalised seizures (EEG abnormality)"];
    n_qt      [label="QTc prolongation (ST prolongation)"];
    n_cmp     [label="Hypocalcaemic dilated cardiomyopathy (reversible)"];
    n_myopath [label="Myopathy · raised CK"];
  }

  /* ===================================================================== */
  /* 12. Chronic long-term complications · quality of life                  */
  /* ===================================================================== */
  subgraph cluster_cns {
    label=<<B>12. Chronic complications · quality of life</B>>;
    style="rounded,filled"; fillcolor="#F5EEF8"; color="#8E44AD"; fontcolor="#4A235A";
    node [fillcolor="#EBDEF0"];

    c_bg      [label="Basal ganglia calcification (Fahr syndrome pattern)", fillcolor="#D7BDE2"];
    c_parkin  [label="Extrapyramidal symptoms · movement disorder"];
    c_fog     [label="Brain fog · reduced executive function", fillcolor="#D7BDE2"];
    c_mood    [label="Anxiety · depression (twice the prevalence)"];
    c_fatig   [label="Fatigue · reduced vitality"];
    c_qol     [label="Quality of life (HPES · SF-36 reduced)", fillcolor="#D7BDE2", penwidth=2];
    c_cat     [label="Posterior subcapsular cataract"];
    c_dental  [label="Enamel hypoplasia · root abnormality (childhood onset)"];
    c_skin    [label="Dry skin · nail dysplasia · alopecia"];
    c_infect  [label="Increased risk of infection and hospitalisation"];
  }

  /* ===================================================================== */
  /* 13. Conventional therapy                                               */
  /* ===================================================================== */
  subgraph cluster_conv {
    label=<<B>13. Conventional therapy</B>>;
    style="rounded,filled"; fillcolor="#E9F7EF"; color="#229954"; fontcolor="#186A3B";
    node [style="rounded,filled,dashed", fillcolor="#D4EFDF"];

    t_cacarb  [label="Calcium carbonate (with meals, 1,000–3,000 mg elemental calcium/day)"];
    t_cacit   [label="Calcium citrate (PPI users · achlorhydria)"];
    t_calcitr [label="Calcitriol 0.25–2 µg/day (divided)", fillcolor="#A9DFBF"];
    t_alfa    [label="Alfacalcidol 0.5–4 µg/day"];
    t_chole   [label="Cholecalciferol (replenishes 25D stores)"];
    t_thiaz   [label="Thiazide diuretic (HCTZ 25–50 mg)\n+ low-sodium diet", fillcolor="#A9DFBF"];
    t_amil    [label="Amiloride (potassium-sparing add-on)"];
    t_pibind  [label="Phosphate binders · low-phosphate diet"];
    t_mg      [label="Magnesium supplementation"];
    t_ivca    [label="IV calcium gluconate (acute crisis)", fillcolor="#A9DFBF"];
    t_limit   [label="Limitations: urinary calcium cannot be controlled ·\nwide swings in blood calcium · renal risk persists", fillcolor="#F9E79F", penwidth=2];
  }

  /* ===================================================================== */
  /* 14. PTH replacement therapy (PK/PD)                                    */
  /* ===================================================================== */
  subgraph cluster_pthrx {
    label=<<B>14. PTH replacement therapy — PK / PD</B>>;
    style="rounded,filled"; fillcolor="#E8F8F5"; color="#117A65"; fontcolor="#0B5345";
    node [style="rounded,filled,dashed", fillcolor="#D1F2EB"];

    x_rhpth   [label="rhPTH(1-84) 50–100 µg SC QD\n(Natpara; withdrawn from market 2024)", fillcolor="#A3E4D7"];
    x_tpt     [label="Teriparatide PTH(1-34)\nBID / TID / continuous infusion pump"];
    x_tc      [label="Palopegteriparatide\n(TransCon PTH, 18–30 µg QD)", fillcolor="#A3E4D7", penwidth=2];
    x_prod    [label="pH-dependent hydrolysis of the TransCon linker\n→ sustained release of free PTH(1-34)"];
    x_eneb    [label="Eneboparatide (AZP-3601)\nRG-selective agonist"];
    x_lapth   [label="LA-PTH / long-acting analogues (preclinical)"];
    x_scdep   [label="SC absorption (F ≈ 0.53, Tmax 0.5–2 h)"];
    x_cl      [label="Linear clearance (CL/F, hepatic and renal degradation)"];
    x_expo    [label="Sustained low-concentration exposure\n(approximates the physiological profile)", fillcolor="#A3E4D7", penwidth=2];
    x_pulse   [label="Pulsatile high-concentration exposure\n(anabolic effect · surge in bone resorption)"];
    x_immuno  [label="Anti-PTH antibodies (little clinical impact)"];
    x_taper   [label="Stepwise tapering of calcium and active vitamin D"];
  }

  /* ===================================================================== */
  /* 15. CaSR-targeted therapy · other                                      */
  /* ===================================================================== */
  subgraph cluster_calci {
    label=<<B>15. CaSR-targeted therapy and other approaches</B>>;
    style="rounded,filled"; fillcolor="#FEF9E7"; color="#B9770E"; fontcolor="#7E5109";
    node [style="rounded,filled,dashed", fillcolor="#FCF3CF"];

    y_encal   [label="Encaleret (CaSR negative allosteric modulator)", fillcolor="#F9E79F", penwidth=2];
    y_shift   [label="CaSR set-point shifted to the right\n→ residual PTH secretion restored · urinary Ca ↓"];
    y_adh1tgt [label="ADH1 target (residual parathyroid tissue essential)"];
    y_autotx  [label="Parathyroid autotransplantation / allotransplantation"];
    y_cell    [label="Gene and cell therapy (iPSC-derived chief cells, research stage)"];
    y_pth1rag [label="Non-peptide PTH1R agonists (exploratory)"];
  }

  /* ===================================================================== */
  /* 16. Clinical endpoints                                                 */
  /* ===================================================================== */
  subgraph cluster_ep {
    label=<<B>16. Clinical endpoints · observed variables</B>>;
    style="rounded,filled"; fillcolor="#EBEDEF"; color="#34495E"; fontcolor="#212F3D";
    node [shape=note, fillcolor="#D5D8DC"];

    z_sca     [label="Albumin-corrected serum Ca\ntarget 8.0–9.0 mg/dL", penwidth=2];
    z_ion     [label="Ionised calcium (mmol/L)"];
    z_pi      [label="Serum phosphate (at or below the upper limit of normal)"];
    z_uca     [label="24-hour urinary calcium <300 mg (<250 in women)", penwidth=2];
    z_egfr    [label="eGFR slope (mL/min/1.73 m²/year)"];
    z_nc      [label="Imaging nephrocalcinosis / nephrolithiasis incidence"];
    z_comp    [label="Triple composite response (PaTHway/PARALLAX)\nnormal Ca + calcium ≤600 mg + active vitamin D 0", penwidth=2];
    z_indep   [label="Proportion independent of conventional therapy"];
    z_symp    [label="HPES symptom and impact scores"];
    z_bmdz    [label="BMD Z-score normalisation"];
    z_hosp    [label="Hypocalcaemia-related emergency visits and admissions"];
    z_qtc     [label="QTc (ms)"];
  }

  /* ===================================================================== */
  /* EDGES                                                                  */
  /* ===================================================================== */

  /* --- 1 → 2 : etiology to chief-cell mass --- */
  e_thyroid  -> e_surg;
  e_ptx      -> e_surg;
  e_neck     -> e_surg;
  e_surg     -> e_transient;
  e_transient-> pc_mass [color="#C0392B", arrowhead=tee, penwidth=1.6];
  e_ai_aps1  -> e_ai_nalp5;
  e_ai_nalp5 -> pc_mass [color="#C0392B", arrowhead=tee];
  e_ai_casrab-> pc_casr [color="#2471A3", label="activation"];
  e_adh1     -> pc_casr [color="#2471A3", label="gain of function", penwidth=1.6];
  e_adh2     -> pc_gq   [color="#2471A3", label="Gα11 overactivity"];
  e_gcm2     -> pc_mass [color="#C0392B", arrowhead=tee];
  e_pthgene  -> pc_prepro [color="#C0392B", arrowhead=tee];
  e_gata3    -> pc_mass [color="#C0392B", arrowhead=tee];
  e_22q11    -> pc_mass [color="#C0392B", arrowhead=tee];
  e_fam111a  -> pc_mass [color="#C0392B", arrowhead=tee];
  e_mito     -> pc_secr [color="#C0392B", arrowhead=tee];
  e_infilt   -> pc_mass [color="#C0392B", arrowhead=tee];
  e_rad      -> pc_mass [color="#C0392B", arrowhead=tee];
  e_idio     -> pc_mass [color="#C0392B", arrowhead=tee];
  e_maternal -> pc_secr [color="#C0392B", arrowhead=tee];
  e_mglow    -> m_secblk [color="#C0392B"];

  /* --- 2 : chief-cell internal --- */
  pc_casr -> pc_gq  [color="#2471A3"];
  pc_casr -> pc_gi  [color="#2471A3"];
  pc_gq   -> pc_cai [color="#2471A3"];
  pc_gi   -> pc_secr[color="#C0392B", arrowhead=tee];
  pc_cai  -> pc_secr[color="#C0392B", arrowhead=tee, label="secretion inhibited"];
  pc_casr -> pc_setpt;
  pc_setpt-> pc_sigmoid;
  pc_sigmoid -> pc_secr;
  pc_gene -> pc_mrna -> pc_prepro -> pc_pro -> pc_pth184 -> pc_gran -> pc_secr;
  pc_mass -> pc_gene;
  pc_mass -> pc_gran;
  pc_pth184 -> pc_deg;
  pc_deg  -> pc_secr [style=dotted, color="#7F8C8D", label="PTH(7-84) antagonism"];
  pc_vdrfb-> pc_gene [color="#C0392B", arrowhead=tee];
  pc_klotho -> pc_gene [color="#C0392B", arrowhead=tee];
  pc_mgdep -> pc_secr [color="#2471A3"];
  pc_prolif -> pc_mass [color="#2471A3"];
  pc_secr -> r_pth1r [label="circulating PTH", penwidth=1.8];

  /* --- 3 : PTH1R signaling --- */
  r_pth1r -> r_r0;
  r_pth1r -> r_rg;
  r_r0 -> r_gs [color="#2471A3"];
  r_rg -> r_gs [color="#2471A3"];
  r_gs -> r_camp -> r_pka -> r_creb;
  r_pth1r -> r_gq2 [color="#2471A3"];
  r_pth1r -> r_barr -> r_endo;
  r_endo -> r_camp [style=dotted, color="#7F8C8D", label="sustained signal"];
  r_barr -> r_desens;
  r_desens -> r_pth1r [style=dotted, color="#7F8C8D"];
  r_pthrp -> r_pth1r [color="#2471A3", style=dashed];

  /* --- 3 → 4/5 : receptor to organs --- */
  r_pka -> k_trpv5   [color="#2471A3", label="expression and activity ↑"];
  r_pka -> k_calb28  [color="#2471A3"];
  r_pka -> k_npt2a   [color="#C0392B", arrowhead=tee, label="internalisation and degradation"];
  r_pka -> k_cyp27b1 [color="#2471A3", penwidth=1.5];
  r_pka -> k_cyp24a1 [color="#C0392B", arrowhead=tee];
  r_pka -> b_rankl   [color="#2471A3"];
  r_pka -> b_opg     [color="#C0392B", arrowhead=tee];
  r_pka -> b_sost    [color="#C0392B", arrowhead=tee];
  r_creb -> b_ob     [color="#2471A3"];
  r_gq2 -> b_ob      [color="#2471A3", style=dotted];

  /* --- 4 : kidney internal --- */
  k_gfr -> k_filt;
  k_filt -> k_pt -> k_tal -> k_dct;
  k_nkcc2 -> k_cldn [color="#2471A3", label="lumen-positive potential"];
  k_cldn -> k_tal [color="#2471A3"];
  k_casrtal -> k_nkcc2 [color="#C0392B", arrowhead=tee];
  k_casrtal -> k_cldn  [color="#C0392B", arrowhead=tee];
  k_trpv5 -> k_calb28 -> k_ncx1 -> k_careab;
  k_dct -> k_careab;
  k_careab -> k_hyperca [color="#C0392B", arrowhead=tee, label="reabsorption↓ → urinary excretion↑"];
  k_npt2a -> k_pireab;
  k_pireab -> p_piec [color="#2471A3", penwidth=1.5];
  k_cyp27b1 -> v_125d [color="#2471A3", penwidth=1.5];
  k_cyp24a1 -> v_cyp24 [color="#2471A3"];
  k_mgreab -> m_ec [color="#2471A3"];
  k_hyperca -> k_nephroc [color="#C0392B", penwidth=1.6];
  k_hyperca -> k_stone [color="#C0392B"];
  k_nephroc -> k_ckd [color="#C0392B", penwidth=1.6];
  k_stone -> k_ckd [color="#C0392B"];
  k_ckd -> k_gfr [color="#C0392B", arrowhead=tee, style=dotted];
  k_ckd -> k_cyp27b1 [color="#C0392B", arrowhead=tee, style=dotted, label="vicious cycle"];
  k_hyperca -> k_conc;
  k_hco3 -> s_ph [color="#2471A3"];
  p_piec -> k_nephroc [color="#C0392B", label="Ca×P"];

  /* --- 5 : bone internal --- */
  b_ocyte -> b_sost;
  b_sost -> b_wnt [color="#C0392B", arrowhead=tee];
  b_wnt -> b_ob [color="#2471A3"];
  b_ob -> b_rankl;
  b_ob -> b_opg;
  b_ob -> b_mcsf;
  b_rankl -> b_ratio;
  b_opg -> b_ratio [color="#C0392B", arrowhead=tee];
  b_mcsf -> b_oc [color="#2471A3"];
  b_ratio -> b_oc [color="#2471A3", penwidth=1.5];
  b_oc -> b_remod;
  b_ob -> b_remod;
  b_remod -> b_labile [label="calcium release/deposition"];
  b_labile -> s_ecfvol [label="rapid buffering flux", penwidth=1.5];
  b_remod -> b_mineral;
  b_ob -> b_p1np; b_ob -> b_bsap; b_ob -> b_ocn;
  b_oc -> b_ctx;
  b_remod -> b_bmd [color="#C0392B", arrowhead=tee, label="low turnover → BMD↑"];
  b_bmd -> b_micro;
  b_micro -> b_fx;
  b_remod -> b_marrow;
  b_marrow -> b_ocyte [style=dotted, color="#7F8C8D"];
  b_mineral -> p_piec [label="phosphate release"];
  b_ocyte -> p_fgf23;

  /* --- 6 : gut --- */
  g_dietca -> g_frac;
  g_suppca -> g_ph -> g_frac;
  g_cacit_dummy [style=invis, shape=point, width=0.01];
  g_trpv6 -> g_calb9 -> g_pmca -> g_frac;
  g_para -> g_frac;
  g_frac -> s_ecfvol [label="influx of absorbed calcium", penwidth=1.6];
  g_dietpi -> g_npt2b -> p_piec;
  g_binder -> g_npt2b [color="#C0392B", arrowhead=tee, style=dashed];
  g_suppca -> g_oxal [color="#C0392B", arrowhead=tee, label="binds intestinal oxalate"];
  g_oxal -> k_stone [color="#C0392B"];
  v_125d -> g_trpv6 [color="#2471A3", penwidth=1.6];
  v_125d -> g_calb9 [color="#2471A3"];
  v_125d -> g_npt2b [color="#2471A3"];

  /* --- 7 : vitamin D --- */
  v_skin -> v_cyp2r1; v_diet -> v_cyp2r1;
  v_cyp2r1 -> v_25d -> v_dbp;
  v_dbp -> v_125d [label="substrate supply"];
  v_125d -> v_vdr;
  v_vdr -> pc_vdrfb [style=dotted, color="#7F8C8D"];
  v_125d -> v_cyp24 [color="#2471A3", label="induces its own catabolism"];
  v_cyp24 -> v_125d [color="#C0392B", arrowhead=tee, style=dotted];
  v_exocal -> v_125d [color="#229954", style=dashed, penwidth=1.6, label="direct replacement"];
  v_alfa -> v_cyp2r1 [color="#229954", style=dashed];
  v_alfa -> v_125d [color="#229954", style=dashed];
  v_dhtach -> v_vdr [color="#229954", style=dashed];
  v_125d -> p_fgf23 [color="#2471A3"];

  /* --- 8 : phosphate / FGF23 --- */
  p_fgf23 -> p_klotho;
  p_klotho -> k_npt2a [color="#C0392B", arrowhead=tee];
  p_klotho -> k_cyp27b1 [color="#C0392B", arrowhead=tee];
  p_dmp1 -> p_fgf23 [color="#C0392B", arrowhead=tee];
  p_piec -> p_fgf23 [color="#2471A3"];
  p_piec -> p_caxp;
  s_total -> p_caxp;
  p_caxp -> p_ectopic [color="#C0392B", penwidth=1.6];
  p_ppi -> p_ectopic [color="#C0392B", arrowhead=tee];
  p_caxp -> p_vsmc [color="#2471A3"];
  p_vsmc -> p_ectopic [color="#C0392B"];
  p_ectopic -> c_bg [color="#C0392B"];
  p_ectopic -> c_cat [color="#C0392B"];
  p_ectopic -> k_nephroc [color="#C0392B"];
  p_piec -> v_125d [color="#C0392B", arrowhead=tee, style=dotted, label="1α inhibition"];

  /* --- 9 : magnesium --- */
  m_intake -> m_ec; m_loss -> m_ec [color="#C0392B", arrowhead=tee];
  m_ec -> pc_mgdep [color="#2471A3"];
  m_secblk -> pc_secr [color="#C0392B", arrowhead=tee, penwidth=1.5];
  m_res -> r_gs [color="#C0392B", arrowhead=tee];
  m_repl -> m_ec [color="#229954", style=dashed];
  k_mgreab -> m_ec;
  r_pka -> k_mgreab [color="#2471A3", style=dotted];

  /* --- 10 : speciation --- */
  s_ecfvol -> s_total;
  s_total -> s_alb; s_total -> s_cmplx; s_total -> s_ion;
  s_ph -> s_alb [color="#2471A3", label="binding↑ in alkalosis"];
  s_alb -> s_ion [color="#C0392B", arrowhead=tee];
  s_cmplx -> s_ion [color="#C0392B", arrowhead=tee];
  s_citrate -> s_cmplx [color="#2471A3"];
  s_total -> s_corr;
  s_ion -> pc_casr [style=dotted, color="#7F8C8D", penwidth=1.6, label="principal feedback signal"];
  s_ion -> k_casrtal [style=dotted, color="#7F8C8D"];
  s_ion -> n_nav [color="#C0392B", arrowhead=tee];
  s_ecfvol -> k_filt;
  s_ecfvol -> b_labile [dir=both, label="bidirectional exchange"];

  /* --- 11 : neuromuscular --- */
  n_nav -> n_excit [color="#2471A3", penwidth=1.6];
  n_excit -> n_pares; n_excit -> n_tetany; n_excit -> n_signs;
  n_excit -> n_laryngo; n_excit -> n_seiz; n_excit -> n_myopath;
  s_ion -> n_qt [color="#C0392B", arrowhead=tee, label="low Ca → QTc↑"];
  s_ion -> n_cmp [color="#C0392B", arrowhead=tee];
  n_qt -> z_qtc;
  n_tetany -> z_hosp; n_seiz -> z_hosp; n_laryngo -> z_hosp;

  /* --- 12 : chronic complications --- */
  c_bg -> c_parkin;
  c_bg -> c_fog;
  s_ion -> c_fog [color="#C0392B", arrowhead=tee, style=dotted];
  c_fog -> c_qol [color="#C0392B", arrowhead=tee];
  c_mood -> c_qol [color="#C0392B", arrowhead=tee];
  c_fatig -> c_qol [color="#C0392B", arrowhead=tee];
  c_cat -> c_qol [color="#C0392B", arrowhead=tee];
  c_skin -> c_qol [color="#C0392B", arrowhead=tee];
  c_dental -> c_qol [color="#C0392B", arrowhead=tee];
  c_infect -> z_hosp;
  c_qol -> z_symp;
  k_ckd -> c_fatig [color="#2471A3", style=dotted];

  /* --- 13 : conventional therapy actions --- */
  t_cacarb -> g_suppca [color="#229954", style=dashed, penwidth=1.6];
  t_cacit  -> g_suppca [color="#229954", style=dashed];
  t_calcitr-> v_exocal [color="#229954", style=dashed, penwidth=1.6];
  t_alfa   -> v_alfa   [color="#229954", style=dashed];
  t_chole  -> v_diet   [color="#229954", style=dashed];
  t_thiaz  -> k_dct    [color="#229954", style=dashed, penwidth=1.6, label="NCC inhibition → distal Ca reabsorption↑"];
  t_thiaz  -> k_hyperca[color="#229954", style=dashed, arrowhead=tee];
  t_amil   -> k_hyperca[color="#229954", style=dashed, arrowhead=tee];
  t_pibind -> g_binder [color="#229954", style=dashed];
  t_mg     -> m_repl   [color="#229954", style=dashed];
  t_ivca   -> s_ecfvol [color="#229954", style=dashed, penwidth=1.6, label="immediate correction"];
  t_cacarb -> t_limit [style=dotted, color="#7F8C8D"];
  t_calcitr-> t_limit [style=dotted, color="#7F8C8D"];
  t_limit  -> k_hyperca [color="#C0392B", penwidth=1.5, label="urinary Ca uncontrolled"];
  t_limit  -> p_piec [color="#C0392B"];
  t_limit  -> c_qol [color="#C0392B", arrowhead=tee];

  /* --- 14 : PTH replacement --- */
  x_rhpth -> x_scdep [color="#117A65", style=dashed];
  x_tpt   -> x_scdep [color="#117A65", style=dashed];
  x_tc    -> x_prod  [color="#117A65", style=dashed, penwidth=1.6];
  x_prod  -> x_scdep [color="#117A65", style=dashed, penwidth=1.6];
  x_eneb  -> x_scdep [color="#117A65", style=dashed];
  x_lapth -> x_scdep [color="#117A65", style=dashed];
  x_scdep -> x_cl;
  x_scdep -> x_expo [label="gradual release"];
  x_scdep -> x_pulse [label="rapid release"];
  x_expo -> r_pth1r [color="#117A65", style=dashed, penwidth=2, label="physiological stimulation"];
  x_pulse -> r_pth1r [color="#117A65", style=dashed, penwidth=1.4];
  x_pulse -> b_oc [color="#C0392B", label="transient surge in bone resorption"];
  x_eneb  -> r_rg [color="#117A65", style=dashed, label="RG selectivity → bone resorption minimised"];
  x_rhpth -> x_immuno [style=dotted, color="#7F8C8D"];
  x_expo -> x_taper [color="#117A65", style=dashed];
  x_taper -> t_cacarb [color="#229954", style=dashed, arrowhead=tee];
  x_taper -> t_calcitr[color="#229954", style=dashed, arrowhead=tee];
  x_expo -> k_careab [color="#117A65", style=dashed, penwidth=1.6];
  x_expo -> k_pireab [color="#117A65", style=dashed, arrowhead=tee];
  x_expo -> k_cyp27b1 [color="#117A65", style=dashed];
  x_expo -> b_remod [color="#117A65", style=dashed, label="turnover normalised"];

  /* --- 15 : CaSR-targeted --- */
  y_encal -> pc_casr [color="#B9770E", style=dashed, penwidth=1.8, arrowhead=tee, label="NAM"];
  y_encal -> y_shift [color="#B9770E", style=dashed];
  y_shift -> pc_secr [color="#2471A3", penwidth=1.5];
  y_shift -> k_casrtal [color="#B9770E", style=dashed, arrowhead=tee];
  y_shift -> k_hyperca [color="#B9770E", style=dashed, arrowhead=tee, label="urinary Ca ↓"];
  y_adh1tgt -> y_encal [style=dotted, color="#7F8C8D"];
  y_autotx -> pc_mass [color="#B9770E", style=dashed];
  y_cell -> pc_mass [color="#B9770E", style=dashed];
  y_pth1rag -> r_pth1r [color="#B9770E", style=dashed];

  /* --- 16 : endpoints wiring --- */
  s_corr -> z_sca;
  s_ion -> z_ion;
  p_piec -> z_pi;
  k_hyperca -> z_uca [penwidth=1.6];
  k_gfr -> z_egfr;
  k_nephroc -> z_nc;
  z_sca -> z_comp; z_uca -> z_comp; x_taper -> z_indep; z_indep -> z_comp;
  b_bmd -> z_bmdz;
  b_ctx -> z_bmdz [style=dotted, color="#7F8C8D"];
  b_p1np -> z_bmdz [style=dotted, color="#7F8C8D"];

  /* --- core disease axis (thick backbone) --- */
  pc_secr -> s_ecfvol [color="#1A5276", penwidth=2.2, style=bold, label="the three routes lost when PTH is deficient"];
  k_careab -> s_ecfvol [color="#1A5276", penwidth=2.0, style=bold];
  b_labile -> s_ion [color="#1A5276", penwidth=2.0, style=bold];
  v_125d -> g_frac [color="#1A5276", penwidth=2.0, style=bold];

  /* --- Legend --- */
  subgraph cluster_legend {
    label=<<B>Legend</B>>;
    style="rounded,filled"; fillcolor="#FFFFFF"; color="#909497"; fontcolor="#5D6D7E";
    node [shape=plaintext, fillcolor="#FFFFFF", style=""];
    lg [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2">
      <TR><TD ALIGN="LEFT"><FONT COLOR="#444444">━━</FONT></TD><TD ALIGN="LEFT">Mass flow / synthesis / conversion</TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#2471A3">━━▶</FONT></TD><TD ALIGN="LEFT">Stimulation · activation</TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#C0392B">━━┤</FONT></TD><TD ALIGN="LEFT">Inhibition · loss of function</TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#229954">╌╌▶</FONT></TD><TD ALIGN="LEFT">Drug action</TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#7F8C8D">┈┈▶</FONT></TD><TD ALIGN="LEFT">Feedback loop</TD></TR>
      <TR><TD ALIGN="LEFT"><FONT COLOR="#1A5276"><B>━━▶</B></FONT></TD><TD ALIGN="LEFT">Core disease axis (the three routes of PTH deficiency)</TD></TR>
    </TABLE>>];
  }
}
