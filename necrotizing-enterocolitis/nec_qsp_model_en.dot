/* ===========================================================================
   nec_qsp_model.dot
   Necrotising Enterocolitis (NEC) of the preterm infant — QSP mechanistic map
   a quantitative systems pharmacology mechanistic map

   Rendering:
       dot -Tsvg nec_qsp_model.dot -o nec_qsp_model_en.svg
       dot -Tpng -Gdpi=150 nec_qsp_model.dot -o nec_qsp_model_en.png

   READING THE MAP
   ---------------
   The heavy crimson ring is THE CLOSED POSITIVE LOOP the ODE model is built
   around:

        villus integrity E  ->  permeability Pb  ->  translocation Jtr
          ->  TLR4/NF-kB  ->  (apoptosis UP, crypt proliferation DOWN)  ->  E

   Everything else on this map is either (a) a term that sets the GAIN of that
   ring, (b) a term that sets its THRESHOLD, or (c) a downstream readout.
   Drug and nutrition nodes are labelled with which of the two they move,
   because in this model those are not interchangeable.

   Edge grammar
       solid black arrow   ..... activation / mass flow
       red tee-headed      ..... inhibition
       blue arrow          ..... pharmacological / nutritional intervention
       heavy crimson       ..... the core positive-feedback ring
       dashed grey         ..... measurement / clinical readout
=========================================================================== */

digraph NEC_QSP {
    graph [rankdir=TB, splines=spline, overlap=false, nodesep=0.22,
           ranksep=0.55, fontname="Helvetica", fontsize=11, compound=true,
           bgcolor="white", labelloc="t", pad=0.4,
           label=<<B>Necrotising Enterocolitis (NEC) — QSP Mechanistic Map</B><BR/>
<FONT POINT-SIZE="12">necrotising enterocolitis of the newborn · 39-state mrgsolve model</FONT><BR/>
<FONT POINT-SIZE="10">core ring (crimson): villus integrity → permeability → translocation → TLR4/NF-κB → epithelial loss → villus integrity</FONT>>];

    node  [shape=box, style="rounded,filled", fontname="Helvetica",
           fontsize=10, color="#40454d", fillcolor="#f6f7f9", penwidth=1.0];
    edge  [color="#5a616b", arrowsize=0.62, penwidth=0.9];

    /* ---------- reusable edge classes ------------------------------------ */
    /* inhibition */  // edge [color="#c0392b", arrowhead=tee]
    /* drug */        // edge [color="#1f6fb2", style=bold]

    /* =====================================================================
       1. PREMATURITY AND MUCOSAL MATURATION
       ===================================================================== */
    subgraph cluster_mat {
        label="① Prematurity & mucosal maturation";
        style="rounded,filled"; fillcolor="#eef3fa"; color="#9db6d6";
        fontsize=12; fontcolor="#2a4a75";
        node [fillcolor="#dbe7f6", color="#7d9fc7"];

        GA        [label="Gestational age GA\n23–34 wk", shape=octagon,
                   fillcolor="#c3d7ef"];
        PMA       [label="Postmenstrual age PMA\nGA + postnatal age"];
        MAT       [label="Mucosal maturation MAT\nMAT = PMA⁶/(30.5⁶+PMA⁶)",
                   shape=box, fillcolor="#b8cfe9", penwidth=1.6];
        BW        [label="Birth weight BW\nVLBW / ELBW"];
        IUGR      [label="Intrauterine growth restriction IUGR\nabsent/reversed end-diastolic flow"];
        CHORIO    [label="Histological chorioamnionitis\n(fetal priming)"];
        ANTESTER  [label="Antenatal steroids\nantenatal betamethasone"];
        CSECT     [label="Caesarean section · antibiotic exposure\n(the seeding route is lost)"];
        TLR4EXPR  [label="TLR4 over-expression\nTLR4expr = 1 − 0.55·MAT\n(immature gut over-expresses TLR4)",
                   fillcolor="#f6d9d5", color="#c08b84"];
        PAFAH     [label="PAF acetylhydrolase\nPAF-AH = 1.2 + 6·MAT\n(preterm deficiency)"];
        IL10CAP   [label="IL-10 response capacity\n∝ MAT (immature = deficient)"];
        IAP       [label="Intestinal alkaline phosphatase IAP\nLPS dephosphorylation"];
        MOTIL     [label="Immature motility\nimmature motility → stasis"];
    }

    /* =====================================================================
       2. ENTERAL NUTRITION
       ===================================================================== */
    subgraph cluster_nutr {
        label="② Enteral nutrition — the two-signed input";
        style="rounded,filled"; fillcolor="#eef7ef"; color="#a8ccab";
        fontsize=12; fontcolor="#2f5f34";
        node [fillcolor="#dcefdd", color="#8bb890"];

        MOM       [label="Mother's own milk", shape=octagon,
                   fillcolor="#c2e3c5"];
        DM        [label="Donor milk (pasteurised)"];
        PASTEUR   [label="Holder pasteurisation\n(destroys sIgA · lactoferrin · EGF, preserves HMO)"];
        FORMULA   [label="Preterm formula", shape=octagon,
                   fillcolor="#f3ddd9"];
        FORTIF    [label="Human-milk fortifier (bovine-based)\nosmolality↑"];
        FEEDVOL   [label="Feed volume FEED\nmL/kg/d"];
        FEEDRATE  [label="Rate of advancement\nadvance rate mL/kg/d²",
                   shape=octagon, fillcolor="#c2e3c5"];
        TROPHIC   [label="Minimal enteral nutrition\ntrophic / gut-priming feeds"];
        NPO       [label="Nil by mouth NPO\ngut rest"];
        TPN       [label="Parenteral nutrition TPN"];
        HMO       [label="Human milk oligosaccharides HMO\n2′-FL · LNnT · 6′-SL  ~13 g/L",
                   fillcolor="#c2e3c5", penwidth=1.5];
        SIGA      [label="Secretory IgA\n(immune exclusion)"];
        LACTOF    [label="Lactoferrin\n(Fe sequestration)"];
        EGFMILK   [label="EGF · HB-EGF · TGF-β2\n(milk growth factors)"];
        MFGM      [label="Milk fat globule membrane · glutamine · arginine"];
        OSMOL     [label="Osmotic load\nfeed osmolality > 450 mOsm/kg"];
        SUB       [label="Unabsorbed fermentable substrate SUB\n[g/kg]",
                   fillcolor="#f6f0d0", color="#bda85f", penwidth=1.5];
        SMUC      [label="Host-derived substrate\nmucin O-glycans (not zero even on NPO)"];
        MALABS    [label="Malabsorption\nVabs = 14·E  → if E↓ then SUB↑",
                   fillcolor="#f6d9d5", color="#c08b84"];
    }

    /* =====================================================================
       3. LUMINAL ECOLOGY
       ===================================================================== */
    subgraph cluster_lumen {
        label="③ Luminal ecology — the STATE variable";
        style="rounded,filled"; fillcolor="#fdf4e8"; color="#dcbd8a";
        fontsize=12; fontcolor="#7a5418";
        node [fillcolor="#f9e6cc", color="#c9a877"];

        B         [label="Pathogen load B\nEnterobacteriaceae\n(Klebsiella · E. coli · Enterobacter)",
                   shape=box, fillcolor="#f2c9c0", color="#bd7a6c", penwidth=2.0];
        C         [label="Obligate anaerobic commensals C\nBifidobacterium · Clostridiales",
                   fillcolor="#cfe7d1", color="#7ea883", penwidth=1.6];
        BINF      [label="Whether B. infantis is carried\nHMO-utilising strain\n(only ~35 % of industrialised cohorts)",
                   shape=octagon, fillcolor="#cfe7d1"];
        CPERF     [label="Clostridium perfringens\n· Cronobacter (toxigenic subtypes)"];
        PROB      [label="Probiotics P\nB. infantis · L. rhamnosus · B. lactis",
                   fillcolor="#cfe0f2", color="#7b9ec9"];
        NICHE     [label="Colonisation niche Ktot = 26\nα = 0.55 cross-competition → coexistence possible"];
        FERM      [label="Fermentation\nfermentation flux"];
        SCFA      [label="Short-chain fatty acids SCFA\nbutyrate · acetate [mM]",
                   fillcolor="#cfe7d1", color="#7ea883", penwidth=1.5];
        PHLUM     [label="Luminal pH↓\nfpH = 1/(1+(SCFA/10)²)"];
        GAS       [label="Luminal gas GAS\nH₂ · CO₂ (hydrogen production)"];
        BILE      [label="Bile acid pool\nunconjugated bile acid toxicity"];
        DYSB      [label="Dysbiosis\nEnterobacteriaceae bloom\n· loss of diversity",
                   fillcolor="#f2c9c0", color="#bd7a6c"];
        BLOOM     [label="the colonisation contest resolves\ninto two stable states\n(Bifido-dominant vs Entero-dominant)",
                   shape=note, fillcolor="#fff8ea"];
    }

    /* =====================================================================
       4. MUCOSAL BARRIER
       ===================================================================== */
    subgraph cluster_barrier {
        label="④ Mucosal barrier — the LOOP variable";
        style="rounded,filled"; fillcolor="#fdeeee"; color="#e0aaa4";
        fontsize=12; fontcolor="#84302a";
        node [fillcolor="#f9dcda", color="#cf9a92"];

        CRYPT     [label="Crypt stem cells (Lgr5⁺)\ncrypt stem compartment"];
        PROLIF    [label="Enterocyte proliferation\nprolif = kE(1−E)·Ftroph·block"];
        BLOCK     [label="Proliferation block\nblock = 1/(1+(INJ/0.25)²)",
                   fillcolor="#f2c9c0", color="#bd7a6c"];
        E         [label="Enterocyte / villus integrity  E\n[0–1]",
                   shape=box, fillcolor="#e88f83", fontcolor="white",
                   color="#a33a2c", penwidth=2.6];
        APOP      [label="Enterocyte loss\nkA·INJ·E/(E+0.08)\napoptosis + necroptosis + shedding"];
        TJ        [label="Tight junctions TJ\nZO-1 · claudin-3 · occludin"];
        MUC2      [label="Mucus layer MUC2\ngoblet cell mucin"];
        GOBLET    [label="Goblet cells"];
        PANETH    [label="Paneth cells\nHD5 · HD6 · lysozyme"];
        DEF       [label="Defensins DEF\nα-defensin index"];
        GLYCO     [label="Glycocalyx\n· sialylation"];
        AUTOPH    [label="Autophagy\n(enterocyte survival)"];
        PB        [label="Permeability Pb\nPb = 0.05 + 1.15·(1−BI)³",
                   shape=box, fillcolor="#e88f83", fontcolor="white",
                   color="#a33a2c", penwidth=2.0];
        BI        [label="Barrier integrity BI\nBI = E·(0.35+0.65·TJ)·(0.55+0.45·MUC)"];
        JTR       [label="Bacterial translocation flux Jtr\nJtr = Pb · B",
                   shape=box, fillcolor="#e88f83", fontcolor="white",
                   color="#a33a2c", penwidth=2.4];
    }

    /* =====================================================================
       5. INNATE SENSING
       ===================================================================== */
    subgraph cluster_tlr {
        label="⑤ Innate sensing — the THRESHOLD";
        style="rounded,filled"; fillcolor="#f4eefa"; color="#c3a8d8";
        fontsize=12; fontcolor="#553170";
        node [fillcolor="#e8dcf4", color="#a98cc4"];

        LPS       [label="LPS · peptidoglycan · flagellin\nMAMPs"];
        TLR4      [label="TLR4 / MD-2\n(enterocyte apical + basolateral)"];
        KTLR      [label="Signalling threshold Ktlr\nKtlr = 60 · (1+0.15·HMO/(HMO+0.4)) · (1+0.10·IgA)",
                   shape=box, fillcolor="#d9c6ec", color="#8c6bad", penwidth=2.2];
        MYD88     [label="MyD88 · IRAK4 · TRAF6"];
        TRIF      [label="TRIF / IRF3"];
        NFKB      [label="NF-κB activity TLR4s\nTLR4s = TLR4expr · Jtr/(Jtr+Ktlr)",
                   shape=box, fillcolor="#c9b0e4", color="#7a5399", penwidth=2.2];
        NLRP3     [label="NLRP3 inflammasome\ncaspase-1 → IL-1β/IL-18"];
        HMGB1     [label="HMGB1 · DAMPs\n(from necrotic tissue)"];
        SIGIRR    [label="SIGIRR / IL-1R8\nnegative regulation (loss-of-function variants)"];
        A20       [label="A20 / TNFAIP3\nNF-κB brake"];
        NOD2      [label="NOD2 (bacterial peptide)"];
        TLR9      [label="TLR9 (CpG DNA, protective)"];
    }

    /* =====================================================================
       6. CYTOKINES AND LIPID MEDIATORS
       ===================================================================== */
    subgraph cluster_cyto {
        label="⑥ Cytokines & lipid mediators";
        style="rounded,filled"; fillcolor="#fef6ec"; color="#e0bb8f";
        fontsize=12; fontcolor="#7d4f14";
        node [fillcolor="#fbe8d0", color="#cfa871"];

        TNF       [label="TNF-α"];
        IL1B      [label="IL-1β"];
        IL6       [label="IL-6"];
        IL8       [label="IL-8 / CXCL8\n(neutrophil chemokine)"];
        IL17      [label="IL-17A (Th17)"];
        IL18      [label="IL-18"];
        IL10      [label="IL-10 (counter-regulatory)",
                   fillcolor="#dcefdd", color="#8bb890"];
        TGFB      [label="TGF-β / Smad (Treg)",
                   fillcolor="#dcefdd", color="#8bb890"];
        PAF       [label="Platelet-activating factor PAF",
                   fillcolor="#f2c9c0", color="#bd7a6c", penwidth=1.6];
        LTB4      [label="LTB₄ · 5-LOX"];
        RESOLV    [label="Resolvins · protectin D1\n(n-3-derived pro-resolving lipids)",
                   fillcolor="#dcefdd", color="#8bb890"];
    }

    /* =====================================================================
       7. CELLULAR IMMUNITY
       ===================================================================== */
    subgraph cluster_immune {
        label="⑦ Cellular immunity";
        style="rounded,filled"; fillcolor="#f1f6fb"; color="#a9c1d9";
        fontsize=12; fontcolor="#28496b";
        node [fillcolor="#dfeaf5", color="#8ba9c6"];

        MACRO     [label="Mucosal macrophages\nM1 polarisation"];
        NEUT      [label="Neutrophil infiltration NEUT\nsaturating pool (NEUmax = 4)",
                   fillcolor="#f2c9c0", color="#bd7a6c"];
        NET       [label="Neutrophil extracellular traps\nNETs · elastase · MPO"];
        TH17      [label="Th17 (RORγt)"];
        TREG      [label="Treg (Foxp3)", fillcolor="#dcefdd", color="#8bb890"];
        ILC3      [label="ILC3 · IL-22"];
        DC        [label="Dendritic cells · CX3CR1⁺"];
        MAST      [label="Mast cells"];
        EOSIN     [label="Eosinophils"];
    }

    /* =====================================================================
       8. SPLANCHNIC PERFUSION
       ===================================================================== */
    subgraph cluster_perf {
        label="⑧ Splanchnic perfusion & O₂ balance";
        style="rounded,filled"; fillcolor="#eef8fa"; color="#96c6d0";
        fontsize=12; fontcolor="#1e5964";
        node [fillcolor="#d6eef3", color="#7fb4c0";]

        PERF      [label="Intestinal perfusion PERF\nmesenteric perfusion index",
                   shape=box, fillcolor="#a9d9e4", color="#3f8896", penwidth=2.0];
        DEMAND    [label="Oxygen demand\ndemand = 1 + 0.40·FEED/200"];
        SDR       [label="Supply-demand ratio SDR = PERF/demand\nISCH = max(0, 1 − SDR/0.80)",
                   shape=box, fillcolor="#a9d9e4", color="#3f8896", penwidth=2.0];
        AUTOREG   [label="Immature flow autoregulation\nimmature autoregulation"];
        ET1       [label="Endothelin-1 ET-1\nvasoconstriction"];
        ENOS      [label="eNOS → NO (vasodilator)",
                   fillcolor="#dcefdd", color="#8bb890"];
        INOS      [label="iNOS → excess NO"];
        ONOO      [label="Peroxynitrite ONOO⁻\nnitrosative injury",
                   fillcolor="#f2c9c0", color="#bd7a6c"];
        PGE       [label="Vasodilator prostanoids PGE\nPGE₂ · PGI₂ (COX-1/2)",
                   fillcolor="#dcefdd", color="#8bb890"];
        PDA       [label="Patent ductus arteriosus PDA\ndiastolic steal", shape=octagon];
        HYPOT     [label="Hypotension · apnoea-bradycardia\nA-B episodes",
                   shape=octagon, fillcolor="#f2c9c0"];
        ANEMIA    [label="Anaemia (Hb↓, O₂ carriage↓)"];
        TRANSF    [label="Packed red cell transfusion PRBC\ntransfusion-associated NEC",
                   shape=octagon, fillcolor="#f2c9c0"];
        IRINJ     [label="Ischaemia-reperfusion injury\nXO · ROS"];
    }

    /* =====================================================================
       9. THE LESION
       ===================================================================== */
    subgraph cluster_lesion {
        label="⑨ The lesion — irreversible above NECa_crit = INJth/wNEC";
        style="rounded,filled"; fillcolor="#fdecec"; color="#dc9d99";
        fontsize=12; fontcolor="#7d2320";
        node [fillcolor="#f7d3d0", color="#c3837e"];

        INJ       [label="Total injury INJ\nINJ = TLR4s + 0.35·NO + 0.90·ISCH + 1.80·NECa",
                   shape=box, fillcolor="#e07a6d", fontcolor="white",
                   color="#993226", penwidth=2.4];
        MUCNEC    [label="Mucosal · submucosal necrosis\n(re-epithelialisation possible if NECa < 0.10)"];
        NECA      [label="Transmural necrotic area NECa\n[0–1]",
                   shape=box, fillcolor="#e07a6d", fontcolor="white",
                   color="#993226", penwidth=2.2];
        NOCRIT    [label="Point of no return\nNECa_crit = 0.35/1.80 = 0.194\nthe necrosis itself sustains the injury",
                   shape=doubleoctagon, fillcolor="#c8483a", fontcolor="white",
                   color="#8a2418", penwidth=2.0];
        PNEU      [label="Intramural gas (pneumatosis)\ngas dissects only if Pb > 0.20"];
        PVGAS     [label="Portal venous gas"];
        PERFOR    [label="Perforation · peritonitis"];
        STRIC     [label="Late stricture\npost-NEC stricture (~10–25 %)"];
        SBS       [label="Short bowel syndrome · intestinal failure"];
        REPAIR    [label="Granulation · re-epithelialisation\nkrep·min(NECa, 0.10)·E",
                   fillcolor="#dcefdd", color="#8bb890"];
    }

    /* =====================================================================
       10. SYSTEMIC RESPONSE
       ===================================================================== */
    subgraph cluster_sys {
        label="⑩ Systemic response";
        style="rounded,filled"; fillcolor="#f5f2fb"; color="#b9aed6";
        fontsize=12; fontcolor="#413169";
        node [fillcolor="#e5dff3", color="#a094c4"];

        LPSP      [label="Circulating endotoxin LPSp\nendotoxaemia · bacteraemia"];
        SEPSIS    [label="Late-onset sepsis"];
        DIC       [label="Disseminated intravascular coagulation DIC"];
        PLT       [label="Platelets PLT\nthrombocytopenia (< 100 ×10⁹/L)"];
        CRP       [label="CRP · procalcitonin"];
        LAC       [label="Lactate · base deficit"];
        SHOCK     [label="Shock · multi-organ failure"];
        IFABP     [label="I-FABP (urine/blood)\nmarker of enterocyte injury"];
        CALPRO    [label="Faecal calprotectin"];
    }

    /* =====================================================================
       11. DISTANT ORGANS
       ===================================================================== */
    subgraph cluster_organ {
        label="⑪ Distant organ consequences";
        style="rounded,filled"; fillcolor="#f2f6f2"; color="#aec4ae";
        fontsize=12; fontcolor="#38553a";
        node [fillcolor="#e0ebe0", color="#93ab93"];

        LIVER     [label="TPN cholestasis · IFALD\nconjugated bilirubin↑"];
        BRAIN     [label="Neuroinflammation NIN\nWMI · NDI at 18–24 mo"];
        KIDNEY    [label="Aminoglycoside tubular injury\nAKI · KIN index"];
        LUNG      [label="Bronchopulmonary dysplasia BPD\n(inflammatory crosstalk)"];
        BONE      [label="Metabolic bone disease of prematurity\nMBDP"];
        GROWTH    [label="Growth failure\nweight z-score · EUGR"];
        ROP       [label="Retinopathy of prematurity ROP"];
    }

    /* =====================================================================
       12. PHARMACOLOGY — WHICH FACTOR DOES IT MOVE?
       ===================================================================== */
    subgraph cluster_drug {
        label="⑫ Pharmacology — threshold-movers vs state-movers";
        style="rounded,filled"; fillcolor="#eaf1f9"; color="#9cb7d5";
        fontsize=12; fontcolor="#1f456f";
        node [fillcolor="#cfe0f2", color="#7b9ec9"];

        AMP       [label="Ampicillin AMP\n100 mg/kg q12h  (strong collateral harm to anaerobes)", shape=cds];
        GEN       [label="Gentamicin GEN\n4 mg/kg q36h  (the mainstay of killing B)", shape=cds];
        MTZ       [label="Metronidazole MTZ\n7.5 mg/kg q24h  (destroys C)", shape=cds];
        VANCPIP   [label="Vancomycin · piperacillin-tazobactam\n(second line)", shape=cds];
        ABXDUR    [label="Empirical antibiotic DURATION",
                   shape=octagon, fillcolor="#f2c9c0"];
        PROBDRUG  [label="Probiotics (STATE-MOVER)\nlowers the B load", shape=cds,
                   fillcolor="#cfe7d1"];
        HMODRUG   [label="Synthetic HMO 2′-FL/LNnT (THRESHOLD-MOVER)\nraises Ktlr",
                   shape=cds, fillcolor="#cfe7d1"];
        BLF       [label="Bovine lactoferrin", shape=cds];
        IAPSUP    [label="IAP supplementation (LPS dephosphorylation)", shape=cds];
        GLN       [label="Glutamine · arginine · citrulline", shape=cds];
        PTX       [label="Pentoxifylline (PDE inhibition)", shape=cds];
        ANTITNF   [label="Anti-TNF · IL-1Ra (experimental)", shape=cds];
        DEX       [label="Dexamethasone · hydrocortisone\n(NF-κB inhibition)", shape=cds];
        INDO      [label="Indomethacin (PDA)\nCOX inhibition → PGE↓", shape=cds,
                   fillcolor="#f2c9c0"];
        IBU       [label="Ibuprofen (PDA)\nless effect on intestinal blood flow", shape=cds];
        AFSC      [label="Amniotic-fluid stem cells · EVs (preclinical)", shape=cds];
        SURG      [label="Surgery: drain · laparotomy · resection\nperitoneal drain / laparotomy", shape=cds,
                   fillcolor="#f2c9c0"];
        NPORX     [label="NPO + gastric decompression + broad-spectrum antibiotics\nstandard care for Bell ≥ II (dx_lag = 1.2 d)", shape=cds];
    }

    /* =====================================================================
       13. PHARMACOKINETICS
       ===================================================================== */
    subgraph cluster_pk {
        label="⑬ Neonatal PK — PMA-scaled clearance";
        style="rounded,filled"; fillcolor="#f7f7f2"; color="#c6c6a9";
        fontsize=12; fontcolor="#5b5b34";
        node [fillcolor="#eeeee0", color="#b3b392"];

        PKGUT     [label="Luminal drug concentration\nluminal exposure"];
        PKPLAS    [label="Plasma compartment\nV ≈ 0.32–1.10 L/kg"];
        PKPER     [label="Peripheral · renal cortical compartment\ngentamicin accumulation"];
        PKCL      [label="Clearance CL·(PMA/40)^1.3\nglomerular maturation"];
        PKEMAX    [label="Emax kill model\nEmax·C/(C+EC50)  per taxon"];
    }

    /* =====================================================================
       14. CLINICAL ENDPOINTS
       ===================================================================== */
    subgraph cluster_clin {
        label="⑭ Clinical endpoints";
        style="rounded,filled"; fillcolor="#f9f9f9"; color="#bcbcbc";
        fontsize=12; fontcolor="#333333";
        node [fillcolor="#ececec", color="#a6a6a6", shape=note];

        FEEDINTOL [label="Poor feeding · gastric residuals↑\nfeeding intolerance"];
        DISTEND   [label="Abdominal distension · discoloration of the abdominal wall"];
        BLOODST   [label="Bloody stool\nhaematochezia"];
        BELL1     [label="Bell I  suspected NEC"];
        BELL2     [label="Bell II  definite NEC\n(pneumatosis or NECa > 0.10)"];
        BELL3     [label="Bell III  advanced NEC\n(NECa > 0.28 or PLT<100 & Lac>4)"];
        SURGRATE  [label="Proportion needing surgery\nsurgical NEC"];
        MORT      [label="Mortality\ncase fatality (GA-dependent)"];
        DAYSFULL  [label="Days to full enteral feeds\ndays to full feeds"];
        LOS       [label="Length of stay LOS"];
        NDI       [label="Neurodevelopmental impairment at 18–24 months NDI"];
    }

    /* =====================================================================
       EDGES — maturation
       ===================================================================== */
    GA -> PMA; PMA -> MAT; GA -> BW; GA -> MAT;
    IUGR -> BW; IUGR -> PERF [label="mesenteric flow↓", fontsize=8];
    CHORIO -> NFKB [label="fetal priming", fontsize=8];
    ANTESTER -> MAT [color="#1f6fb2", style=bold];
    CSECT -> C [color="#c0392b", arrowhead=tee, label="seeding fails", fontsize=8];
    CSECT -> BINF [color="#c0392b", arrowhead=tee];
    MAT -> TLR4EXPR [color="#c0392b", arrowhead=tee];
    MAT -> PAFAH; MAT -> IL10CAP; MAT -> IAP;
    MAT -> TJ; MAT -> MUC2; MAT -> PANETH;
    GA -> MOTIL [color="#c0392b", arrowhead=tee];
    MOTIL -> SUB [label="stasis → substrate retention", fontsize=8];
    MOTIL -> B;
    TLR4EXPR -> NFKB [penwidth=1.6];
    IL10CAP -> IL10;
    PAFAH -> PAF [color="#c0392b", arrowhead=tee, penwidth=1.4];
    IAP -> LPS [color="#c0392b", arrowhead=tee];

    /* ---------- nutrition ---------- */
    MOM -> HMO [penwidth=1.6]; MOM -> SIGA; MOM -> LACTOF; MOM -> EGFMILK; MOM -> MFGM;
    MOM -> C [label="Bifidobacterium seeding", fontsize=8];
    DM -> PASTEUR; PASTEUR -> HMO [label="preserved", fontsize=8];
    PASTEUR -> SIGA [color="#c0392b", arrowhead=tee, label="destroyed", fontsize=8];
    PASTEUR -> EGFMILK [color="#c0392b", arrowhead=tee];
    PASTEUR -> LACTOF [color="#c0392b", arrowhead=tee];
    FORMULA -> SUB; FORMULA -> OSMOL;
    FORTIF -> SUB; FORTIF -> OSMOL;
    OSMOL -> TJ [color="#c0392b", arrowhead=tee];
    FEEDRATE -> FEEDVOL; TROPHIC -> FEEDVOL; FEEDVOL -> SUB [penwidth=1.4];
    FEEDVOL -> DEMAND [penwidth=1.4, label="oxygen demand↑", fontsize=8];
    FEEDVOL -> PROLIF [label="Ftroph↑ (trophic stimulus)", fontsize=8, penwidth=1.4];
    NPO -> FEEDVOL [color="#c0392b", arrowhead=tee]; NPO -> TPN;
    NPO -> PROLIF [color="#c0392b", arrowhead=tee, label="atrophy (floor 0.25)", fontsize=8];
    SMUC -> SUB [label="substrate that remains even on NPO", fontsize=8];
    E -> SMUC;
    TPN -> LIVER; TPN -> GROWTH;
    HMO -> KTLR [penwidth=1.8, label="decoy receptor", fontsize=8];
    SIGA -> KTLR [penwidth=1.4, label="immune exclusion", fontsize=8];
    SIGA -> B [color="#c0392b", arrowhead=tee];
    LACTOF -> B [color="#c0392b", arrowhead=tee];
    EGFMILK -> PROLIF [penwidth=1.4]; MFGM -> PROLIF;
    HMO -> C [penwidth=1.8, label="a private substrate B cannot use", fontsize=8];
    BINF -> C [penwidth=1.6];
    E -> MALABS [color="#c0392b", arrowhead=tee];
    MALABS -> SUB [penwidth=1.6, label="a second positive feedback", fontsize=8, fontcolor="#b03a2e"];

    /* ---------- ecology ---------- */
    SUB -> B [penwidth=1.6]; SUB -> C; SUB -> PROB; SUB -> FERM;
    NICHE -> B [color="#c0392b", arrowhead=tee]; NICHE -> C [color="#c0392b", arrowhead=tee];
    B -> NICHE; C -> NICHE; PROB -> NICHE;
    C -> FERM; PROB -> FERM; FERM -> SCFA [penwidth=1.5]; FERM -> GAS;
    SCFA -> PHLUM; PHLUM -> B [color="#c0392b", arrowhead=tee, penwidth=1.8];
    SCFA -> PROLIF [penwidth=1.3, label="butyrate as a nutrient", fontsize=8];
    SCFA -> TJ; SCFA -> TREG;
    B -> DYSB; DYSB -> B; CPERF -> B; B -> CPERF;
    BILE -> E [color="#c0392b", arrowhead=tee];
    GAS -> PNEU [penwidth=1.4];
    PROB -> C; PROB -> B [color="#c0392b", arrowhead=tee, penwidth=1.6];
    DEF -> B [color="#c0392b", arrowhead=tee];
    BLOOM -> DYSB [style=dashed, color="#999999"];

    /* ---------- barrier: THE CORE RING ---------- */
    CRYPT -> PROLIF; PROLIF -> E [color="#a33a2c", penwidth=2.6];
    BLOCK -> PROLIF [color="#c0392b", arrowhead=tee, penwidth=2.2];
    APOP -> E [color="#c0392b", arrowhead=tee, penwidth=2.6];
    E -> BI [color="#a33a2c", penwidth=2.6];
    TJ -> BI [penwidth=1.5]; MUC2 -> BI [penwidth=1.5];
    GOBLET -> MUC2; PANETH -> DEF; DEF -> BI; GLYCO -> BI; AUTOPH -> E;
    BI -> PB [color="#a33a2c", penwidth=2.6, label="Pb = 0.05+1.15(1−BI)³", fontsize=8];
    PB -> JTR [color="#a33a2c", penwidth=2.6];
    B -> JTR [color="#a33a2c", penwidth=2.4, label="× B", fontsize=9];
    JTR -> LPS [penwidth=1.6]; JTR -> NFKB [color="#a33a2c", penwidth=2.6];
    JTR -> LPSP [penwidth=1.4];
    E -> CRYPT;

    /* ---------- innate sensing ---------- */
    LPS -> TLR4 [penwidth=1.5]; TLR4 -> MYD88; TLR4 -> TRIF;
    MYD88 -> NFKB [penwidth=1.6]; TRIF -> NFKB;
    KTLR -> NFKB [color="#c0392b", arrowhead=tee, penwidth=2.2,
                  label="threshold", fontsize=9];
    NFKB -> NLRP3; NLRP3 -> IL1B [penwidth=1.5]; NLRP3 -> IL18;
    HMGB1 -> TLR4; NECA -> HMGB1 [penwidth=1.4];
    SIGIRR -> NFKB [color="#c0392b", arrowhead=tee];
    A20 -> NFKB [color="#c0392b", arrowhead=tee];
    NOD2 -> NFKB; TLR9 -> A20;
    NFKB -> INJ [color="#a33a2c", penwidth=2.4];

    /* ---------- cytokines ---------- */
    NFKB -> TNF [penwidth=1.5]; NFKB -> IL1B; NFKB -> IL6; NFKB -> IL8;
    NFKB -> PAF [penwidth=1.5];
    TNF -> IL8; IL1B -> IL8; TNF -> PAF;
    TNF -> TJ [color="#c0392b", arrowhead=tee, penwidth=1.5];
    IL1B -> TJ [color="#c0392b", arrowhead=tee];
    TNF -> APOP [penwidth=1.5]; IL1B -> APOP;
    IL8 -> NEUT [penwidth=1.8]; PAF -> NEUT [penwidth=1.4];
    IL17 -> IL8; TH17 -> IL17; IL18 -> IL17;
    IL10 -> NFKB [color="#c0392b", arrowhead=tee, penwidth=1.6];
    TGFB -> TREG; TREG -> IL10; RESOLV -> NEUT [color="#c0392b", arrowhead=tee];
    LTB4 -> NEUT;
    TNF -> IL10; IL1B -> IL10;
    NEUT -> TNF [label="saturating feedback NEU/(1+NEU)", fontsize=8];
    NEUT -> IL1B;

    /* ---------- cellular ---------- */
    NFKB -> MACRO; MACRO -> TNF; MACRO -> IL1B;
    NEUT -> NET; NET -> MUC2 [color="#c0392b", arrowhead=tee];
    NET -> E [color="#c0392b", arrowhead=tee, penwidth=1.4];
    DC -> TH17; ILC3 -> MUC2; MAST -> PAF; EOSIN -> IL8;
    NEUT -> INOS;

    /* ---------- perfusion ---------- */
    PAF -> PERF [color="#c0392b", arrowhead=tee, penwidth=2.0];
    ET1 -> PERF [color="#c0392b", arrowhead=tee];
    PGE -> PERF [penwidth=1.6]; ENOS -> PERF;
    PDA -> PERF [color="#c0392b", arrowhead=tee, penwidth=1.4];
    HYPOT -> PERF [color="#c0392b", arrowhead=tee, penwidth=1.8];
    ANEMIA -> SDR [color="#c0392b", arrowhead=tee];
    TRANSF -> NFKB [label="transfusion-associated inflammation", fontsize=8];
    TRANSF -> PERF [color="#c0392b", arrowhead=tee];
    ANEMIA -> TRANSF;
    AUTOREG -> PERF [color="#c0392b", arrowhead=tee];
    PERF -> SDR [penwidth=2.0]; DEMAND -> SDR [color="#c0392b", arrowhead=tee, penwidth=2.0];
    SDR -> INJ [penwidth=2.0, label="0.90 · ISCH", fontsize=9];
    SDR -> IRINJ [color="#c0392b", arrowhead=tee]; IRINJ -> ONOO;
    NFKB -> INOS; INOS -> ONOO [penwidth=1.5];
    ONOO -> INJ [penwidth=1.8, label="0.35 · NO", fontsize=9];
    ONOO -> TJ [color="#c0392b", arrowhead=tee];
    NECA -> PERF [color="#c0392b", arrowhead=tee, penwidth=1.4];

    /* ---------- lesion ---------- */
    INJ -> BLOCK [color="#a33a2c", penwidth=2.4];
    INJ -> APOP [color="#a33a2c", penwidth=2.4];
    INJ -> MUCNEC [penwidth=1.6]; MUCNEC -> NECA [penwidth=1.8];
    INJ -> NECA [penwidth=2.0, label="INJ > INJth = 0.35", fontsize=9];
    NECA -> INJ [color="#a33a2c", penwidth=2.4,
                 label="1.80 · NECa  (the lesion is itself the stimulus)", fontsize=9, fontcolor="#993226"];
    NECA -> NOCRIT [penwidth=1.6]; NOCRIT -> NECA [penwidth=1.6];
    REPAIR -> NECA [color="#c0392b", arrowhead=tee, penwidth=1.4];
    E -> REPAIR; NOCRIT -> REPAIR [color="#c0392b", arrowhead=tee, penwidth=1.6];
    PB -> PNEU [penwidth=1.4, label="requires Pb > 0.20", fontsize=8];
    PNEU -> PVGAS; NECA -> PERFOR [penwidth=1.6]; PERFOR -> SHOCK;
    NECA -> STRIC; STRIC -> SBS; SURG -> SBS;

    /* ---------- systemic ---------- */
    LPSP -> SEPSIS; LPSP -> PLT [color="#c0392b", arrowhead=tee, penwidth=1.4];
    NECA -> PLT [color="#c0392b", arrowhead=tee, penwidth=1.8];
    LPSP -> DIC; DIC -> PLT [color="#c0392b", arrowhead=tee];
    TNF -> CRP; IL1B -> CRP; IL6 -> CRP;
    SDR -> LAC [color="#c0392b", arrowhead=tee]; NECA -> LAC [penwidth=1.5];
    LAC -> SHOCK; PLT -> DIC;
    E -> IFABP [color="#c0392b", arrowhead=tee, style=dashed];
    NEUT -> CALPRO [style=dashed];

    /* ---------- distant organs ---------- */
    LPSP -> BRAIN [penwidth=1.4]; TNF -> BRAIN; IL1B -> BRAIN;
    BRAIN -> NDI [style=dashed, color="#999999"];
    LIVER -> GROWTH; PKPER -> KIDNEY [penwidth=1.4];
    TNF -> LUNG; IL8 -> LUNG; LUNG -> ROP;
    TPN -> BONE; GROWTH -> NDI [style=dashed, color="#999999"];
    E -> GROWTH [penwidth=1.4]; NECA -> GROWTH;

    /* ---------- pharmacology ---------- */
    AMP -> PKPLAS [color="#1f6fb2", style=bold];
    GEN -> PKPLAS [color="#1f6fb2", style=bold];
    MTZ -> PKPLAS [color="#1f6fb2", style=bold];
    VANCPIP -> PKPLAS [color="#1f6fb2", style=bold];
    INDO -> PKPLAS [color="#1f6fb2", style=bold];
    IBU -> PKPLAS [color="#1f6fb2", style=bold];
    DEX -> PKPLAS [color="#1f6fb2", style=bold];
    PTX -> PKPLAS [color="#1f6fb2", style=bold];
    PKPLAS -> PKPER; PKPLAS -> PKCL; PKPLAS -> PKGUT; PKGUT -> PKEMAX;
    PKCL -> PKPLAS [color="#c0392b", arrowhead=tee];
    PKEMAX -> B [color="#1f6fb2", arrowhead=tee, style=bold, penwidth=1.6];
    PKEMAX -> C [color="#1f6fb2", arrowhead=tee, style=bold, penwidth=1.8,
                 label="ampicillin and metronidazole\nkill more of the anaerobes", fontsize=8];
    PKEMAX -> PROB [color="#1f6fb2", arrowhead=tee, style=bold];
    ABXDUR -> AMP; ABXDUR -> GEN; ABXDUR -> MTZ;
    ABXDUR -> C [color="#c0392b", arrowhead=tee, penwidth=1.8,
                 label="the sign flips as the duration lengthens", fontsize=8];
    INDO -> PGE [color="#1f6fb2", arrowhead=tee, style=bold, penwidth=1.8];
    IBU -> PGE [color="#1f6fb2", arrowhead=tee, style=bold];
    DEX -> NFKB [color="#1f6fb2", arrowhead=tee, style=bold, penwidth=1.6];
    PROBDRUG -> PROB [color="#1f6fb2", style=bold, penwidth=1.8];
    HMODRUG -> HMO [color="#1f6fb2", style=bold, penwidth=1.8];
    HMODRUG -> KTLR [color="#1f6fb2", style=bold, penwidth=1.6];
    BLF -> LACTOF [color="#1f6fb2", style=bold];
    IAPSUP -> IAP [color="#1f6fb2", style=bold];
    GLN -> PROLIF [color="#1f6fb2", style=bold];
    PTX -> TNF [color="#1f6fb2", arrowhead=tee, style=bold];
    ANTITNF -> TNF [color="#1f6fb2", arrowhead=tee, style=bold];
    AFSC -> PROLIF [color="#1f6fb2", style=bold];
    NPORX -> NPO [color="#1f6fb2", style=bold];
    NPORX -> AMP [color="#1f6fb2", style=bold];
    SURG -> NECA [color="#1f6fb2", arrowhead=tee, style=bold];

    /* ---------- clinical readouts ---------- */
    SUB -> FEEDINTOL [style=dashed, color="#999999"];
    GAS -> DISTEND [style=dashed, color="#999999"];
    MUCNEC -> BLOODST [style=dashed, color="#999999"];
    CRP -> BELL1 [style=dashed, color="#999999"];
    FEEDINTOL -> BELL1 [style=dashed, color="#999999"];
    PNEU -> BELL2 [style=dashed, color="#999999", penwidth=1.4];
    NECA -> BELL2 [style=dashed, color="#999999", penwidth=1.4];
    NECA -> BELL3 [style=dashed, color="#999999", penwidth=1.4];
    PLT -> BELL3 [style=dashed, color="#999999"];
    LAC -> BELL3 [style=dashed, color="#999999"];
    BELL2 -> NPORX [style=dashed, color="#999999"];
    BELL3 -> SURG [style=dashed, color="#999999"];
    BELL3 -> SURGRATE [style=dashed, color="#999999"];
    BELL3 -> MORT [style=dashed, color="#999999"];
    GA -> MORT [style=dashed, color="#999999"];
    NPO -> DAYSFULL [style=dashed, color="#999999"];
    FEEDRATE -> DAYSFULL [style=dashed, color="#999999"];
    SBS -> LOS [style=dashed, color="#999999"];
    BELL2 -> LOS [style=dashed, color="#999999"];

    /* ---------- legend ---------- */
    subgraph cluster_legend {
        label="Legend";
        style="rounded,filled"; fillcolor="#ffffff"; color="#bbbbbb"; fontsize=11;
        node [shape=plaintext, fillcolor="white", style=""];
        LEG [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3">
<TR><TD ALIGN="LEFT"><FONT COLOR="#a33a2c"><B>━━━</B></FONT></TD>
    <TD ALIGN="LEFT">core positive-feedback ring</TD></TR>
<TR><TD ALIGN="LEFT"><B>───▶</B></TD><TD ALIGN="LEFT">activation / mass flow</TD></TR>
<TR><TD ALIGN="LEFT"><FONT COLOR="#c0392b"><B>───┤</B></FONT></TD>
    <TD ALIGN="LEFT">inhibition</TD></TR>
<TR><TD ALIGN="LEFT"><FONT COLOR="#1f6fb2"><B>━━▶</B></FONT></TD>
    <TD ALIGN="LEFT">drug or nutritional intervention</TD></TR>
<TR><TD ALIGN="LEFT"><FONT COLOR="#999999"><B>- - ▶</B></FONT></TD>
    <TD ALIGN="LEFT">clinical readout</TD></TR>
<TR><TD ALIGN="LEFT"><B>⬡</B></TD><TD ALIGN="LEFT">exogenous input / exposure</TD></TR>
<TR><TD ALIGN="LEFT" COLSPAN="2"><BR/><B>STATE-MOVER</B> = moves B (probiotics)<BR/>
<B>THRESHOLD-MOVER</B> = moves Ktlr (HMO · sIgA)<BR/>
Mother's milk is <B>both</B>, and that is why it cannot be replaced.</TD></TR>
</TABLE>>];
    }
}
