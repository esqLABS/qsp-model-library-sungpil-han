/*
 * mhg_qsp_model.dot — Male Hypogonadism
 * Quantitative Systems Pharmacology mechanistic map
 *
 * ORGANISING IDEA
 * ---------------
 * The quantity that is measured (total testosterone) is not the quantity that
 * acts (free testosterone), and the map between them is a nonlinear mass-action
 * binding equilibrium whose dominant partner — SHBG — is itself a regulated
 * state variable, driven in opposite directions by the disease (obesity,
 * insulin resistance -> SHBG down), by ageing (SHBG up ~1%/yr) and by the
 * treatment (androgen -> SHBG down). Two consequences propagate through this
 * whole map and are what the accompanying mrgsolve model computes:
 *
 *   (1) FREE T IS A CONVEX FUNCTION OF TOTAL T. The SHBG buffer saturates, so
 *       free fraction rises from 1.75% at TT 100 ng/dL to 2.75% at TT 2000.
 *       By Jensen's inequality a peaky regimen delivers MORE time-averaged
 *       free T than a flat regimen at the same mean total T. Verified in the
 *       mrgsolve model: every second difference of FT(TT) is positive.
 *   (2) BUT THE CONVEXITIES DO NOT STACK, AND THE MODEL SAYS SO AGAINST THE
 *       HYPOTHESIS IT WAS BUILT TO EXPRESS. The erythropoietic response is
 *       convex only in its lower limb; supraphysiologic peaks overshoot the
 *       Hill midpoint into the CONCAVE upper limb, so the response step
 *       contributes a Jensen gap of ~zero or slightly NEGATIVE for exactly
 *       the peaky regimens that were supposed to benefit. At matched weekly
 *       dose the whole waveform effect on haematocrit is ~0.1 points.
 *       What actually manufactures the ~3x excess of erythrocytosis on IM
 *       versus transdermal is a FIXED THRESHOLD (Hct > 54%) applied to a
 *       spread-out population — a property of the stopping rule, not of the
 *       molecule. The pink notes in cluster 12 carry this result.
 *
 * The third axis of the map is the FEEDBACK LOOP that exogenous androgen
 * breaks: LH -> Leydig -> intratesticular testosterone (ITT, ~35-100x serum)
 * -> spermatogenesis. Serum T can be normalised while ITT collapses, which is
 * why "replacement" and "fertility" are different therapeutic problems.
 *
 * Clusters: 22 (+ legend) · Nodes: 224 · Edges: 268
 * Render:  dot -Tsvg mhg_qsp_model.dot -o mhg_qsp_model_en.svg
 *          dot -Tpng -Gdpi=150 mhg_qsp_model.dot -o mhg_qsp_model_en.png
 */

digraph MaleHypogonadism_QSP {
    graph [rankdir=TB, splines=spline, overlap=false, nodesep=0.30, ranksep=0.55,
           fontname="Helvetica", fontsize=11, compound=true,
           labelloc="t", fontcolor="#1a1a1a",
           label="Male Hypogonadism — QSP Mechanistic Map\nHPG axis · SHBG binding equilibrium · intratesticular testosterone · erythropoiesis · bone · body composition · 7 testosterone formulations + 5 non-androgen strategies"];
    node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9,
           penwidth=0.8, color="#5a5a5a", margin="0.07,0.045"];
    edge  [fontname="Helvetica", fontsize=7.5, arrowsize=0.6, penwidth=0.9, color="#666666"];

    /* ===================== 1. HYPOTHALAMUS / KNDy ===================== */
    subgraph cluster_hypo {
        label="① Hypothalamus — GnRH pulse generator (KNDy neurons)";
        style="rounded,filled"; fillcolor="#f2f6fd"; color="#7fa6d9"; fontsize=11; fontcolor="#28496f";
        node [fillcolor="#dde9f9"];
        KISS1     [label="KISS1 neurons (ARC/AVPV)\nkisspeptin-54/10"];
        NKB       [label="Neurokinin B (TAC3)\n→ NK3R autostimulation"];
        DYN       [label="Dynorphin (PDYN)\n→ KOR autoinhibition"];
        KNDy      [label="KNDy pulse generator"];
        KISS1R    [label="KISS1R (GPR54)\nGnRH neuron surface"];
        GNRH_N    [label="GnRH neurons (~2,000)\nseptal-preoptic area"];
        GNRH_PULS [label="GnRH pulses\nfrequency ~8-14 pulse/24h\namplitude"];
        PORTAL    [label="Hypothalamic-pituitary\nportal circulation"];
        AR_HYPO   [label="AR (hypothalamus)\nnegative feedback receptor"];
        ERA_HYPO  [label="ERα (ESR1, hypothalamus)\nE2 negative feedback — dominant"];
        LEP_HYPO  [label="Leptin signalling (LEPR)\nmetabolic gate (permissive)"];
        GHRELIN   [label="Ghrelin / energy deficit\nGnRH inhibition"];
        CRH_N     [label="CRH / stress axis\nGnRH inhibition"];
        OPIOID_R  [label="μ-opioid receptor\n(exogenous opioids)"];
        KNDy -> KISS1R [label="kisspeptin"];
        KISS1 -> KNDy; NKB -> KNDy [label="+ (NK3R)"];
        DYN -> KNDy [label="− (KOR)", color="#c0392b"];
        KISS1R -> GNRH_N; GNRH_N -> GNRH_PULS -> PORTAL;
        AR_HYPO -> KNDy [label="− DHT/T", color="#c0392b"];
        ERA_HYPO -> KNDy [label="−− E2 (dominant)", color="#c0392b", penwidth=1.4];
        LEP_HYPO -> KISS1 [label="+ permissive"];
        GHRELIN -> KISS1 [label="−", color="#c0392b"];
        CRH_N -> GNRH_PULS [label="−", color="#c0392b"];
        OPIOID_R -> DYN [label="+ KOR/MOR", color="#c0392b"];
    }

    /* ===================== 2. PITUITARY ===================== */
    subgraph cluster_pit {
        label="② Anterior pituitary — gonadotropes";
        style="rounded,filled"; fillcolor="#f2f6fd"; color="#7fa6d9"; fontsize=11; fontcolor="#28496f";
        node [fillcolor="#dde9f9"];
        GNRHR     [label="GnRH receptor (GNRHR)\nGq/11 → PLC → Ca²⁺/PKC"];
        GONADO    [label="Gonadotropes\n(~10% of the anterior lobe)"];
        LHB       [label="LHB transcription\n(favours high-frequency pulses)"];
        FSHB      [label="FSHB transcription\n(favours low-frequency pulses)"];
        CGA       [label="CGA (common α-subunit)"];
        LH_S      [label="Serum LH\n1-9 IU/L · t½ ~30-60 min\npulsatile"];
        FSH_S     [label="Serum FSH\n1-12 IU/L · t½ ~3-4 h\nnon-pulsatile"];
        PRL_S     [label="Serum prolactin\n(hyperprolactinaemia → GnRH inhibition)"];
        AR_PIT    [label="AR (pituitary)\nnegative feedback"];
        FOLLI     [label="Follistatin (local)\nactivin neutralisation"];
        ACTIVIN   [label="Activin B (local)\nFSHB stimulation"];
        GNRHR -> GONADO; GONADO -> LHB; GONADO -> FSHB; CGA -> LH_S; CGA -> FSH_S;
        LHB -> LH_S; FSHB -> FSH_S;
        AR_PIT -> LHB [label="−", color="#c0392b"];
        ACTIVIN -> FSHB [label="+"]; FOLLI -> ACTIVIN [label="−", color="#c0392b"];
        PRL_S -> GNRHR [label="− (via KNDy)", style=dashed, color="#c0392b"];
    }
    PORTAL -> GNRHR [label="GnRH pulses"];

    /* ===================== 3. LEYDIG / STEROIDOGENESIS ===================== */
    subgraph cluster_leydig {
        label="③ Testis — Leydig cell steroidogenesis";
        style="rounded,filled"; fillcolor="#fdf4ee"; color="#dd9a6a"; fontsize=11; fontcolor="#8a4f1d";
        node [fillcolor="#fbe6d6"];
        LHCGR     [label="LHCGR (LH/hCG receptor)\nshared Gs — hCG t½ far longer"];
        CAMP      [label="cAMP / PKA"];
        STAR      [label="StAR protein\nrate-limiting step: cholesterol import into mitochondria"];
        CHOL_L    [label="Intracellular cholesterol pool\n(LDLR / de novo / CE)"];
        CYP11A1   [label="CYP11A1 (P450scc)\n→ pregnenolone"];
        CYP17A1   [label="CYP17A1 (17α-OH/17,20-lyase)"];
        HSD3B2    [label="HSD3B2"];
        HSD17B3   [label="HSD17B3\n→ testosterone"];
        LEYDIG_M  [label="Leydig cell mass/function\n(vulnerable to ageing · chemotherapy · radiation)"];
        ITT       [label="Intratesticular testosterone (ITT)\n~600-1,250 nmol/L\n~35-100× serum", fillcolor="#f6c9a2", penwidth=1.6];
        INSL3     [label="INSL3\nLeydig function biomarker"];
        LHCGR -> CAMP -> STAR -> CYP11A1 -> CYP17A1 -> HSD3B2 -> HSD17B3 -> ITT;
        CHOL_L -> STAR; LEYDIG_M -> LHCGR; LEYDIG_M -> INSL3;
        CAMP -> CHOL_L [label="+ HSL/LDLR"];
    }
    LH_S -> LHCGR [label="pulsatile drive", penwidth=1.3];

    /* ===================== 4. SERTOLI / SPERMATOGENESIS ===================== */
    subgraph cluster_sertoli {
        label="④ Testis — Sertoli cells and spermatogenesis (74-day cycle + epididymal transit)";
        style="rounded,filled"; fillcolor="#fdf4ee"; color="#dd9a6a"; fontsize=11; fontcolor="#8a4f1d";
        node [fillcolor="#fbe6d6"];
        FSHR      [label="FSHR (Sertoli cell)"];
        SERTOLI   [label="Sertoli cell support capacity\n(sets the ceiling on sperm output)"];
        ABP       [label="Androgen-binding protein\n(testicular SHBG) → concentrates ITT"];
        AR_SERT   [label="AR (Sertoli)\nITT-dependent — essential"];
        BTB       [label="Blood-testis barrier\n(tight junction)"];
        SPGONIA   [label="Spermatogonia\nA_dark / A_pale / B"];
        SPCYTE    [label="Spermatocytes\nmeiosis I/II"];
        SPTID     [label="Spermatids\nspermiogenesis"];
        SPZOA     [label="Spermatozoa\nrelease into the tubule"];
        EPIDID    [label="Epididymal transit\n~10-14 days of maturation"];
        SPERM_OUT [label="Ejaculate sperm concentration\nnormal ≥16 M/mL (WHO 6th ed.)", fillcolor="#f6c9a2", penwidth=1.4];
        INHB      [label="Inhibin B\nSertoli-derived · FSH negative feedback"];
        AMH_S     [label="AMH (immature Sertoli marker)"];
        SPERM_THR [label="ITT threshold\nbelow ~20-30% of normal → spermatogenesis arrests", shape=note, fillcolor="#fdebd0"];
        FSHR -> SERTOLI -> ABP; SERTOLI -> BTB; SERTOLI -> INHB; SERTOLI -> AMH_S;
        AR_SERT -> SPGONIA [label="+ essential"];
        SPGONIA -> SPCYTE -> SPTID -> SPZOA -> EPIDID -> SPERM_OUT;
        SERTOLI -> SPCYTE [label="support capacity"];
        SPERM_THR -> SPGONIA [style=dashed, color="#c0392b"];
        ABP -> AR_SERT;
    }
    FSH_S -> FSHR [penwidth=1.2];
    ITT -> AR_SERT [label="ITT → AR occupancy", penwidth=1.6, color="#b9770e"];
    ITT -> SPERM_THR [style=dashed];
    INHB -> FSHB [label="− selective", color="#c0392b", lhead=cluster_pit];

    /* ===================== 5. BINDING EQUILIBRIUM (CORE) ===================== */
    subgraph cluster_bind {
        label="⑤ Circulating binding equilibrium — the mathematical centre of this map (Vermeulen mass action)";
        style="rounded,filled"; fillcolor="#fdf2f6"; color="#d98cae"; fontsize=11; fontcolor="#8e2f5a";
        node [fillcolor="#fadbe8"];
        T_TOT     [label="Total testosterone (TT)\nthe quantity measured · normal 300-1,000 ng/dL", penwidth=1.5];
        T_FREE    [label="Free testosterone (FT)\nthe quantity that acts · ~2% · 50-210 pg/mL", fillcolor="#f2a7c9", penwidth=1.8];
        T_ALB     [label="Albumin-bound T (~44%)\nK_A ≈ 3.6×10⁴ M⁻¹ · low affinity · high capacity"];
        T_SHBG    [label="SHBG-bound T (~54%)\nK_S ≈ 1.0×10⁹ M⁻¹ · high affinity · saturable"];
        T_BIO     [label="Bioavailable T (FT + albumin-bound)\n≈ 46%"];
        SHBG_P    [label="Serum SHBG\n10-80 nmol/L — a regulated state variable", penwidth=1.5];
        ALB_P     [label="Serum albumin (4.3 g/dL)"];
        VERM      [label="Vermeulen quadratic\naFT² + bFT − T = 0\na = N·K_S,  b = N + K_S·S − K_S·T\nN = 1 + K_A·[Alb]", shape=note, fillcolor="#fce4ec", fontsize=8];
        CONVEX    [label="⚑ CONVEXITY\nfree fraction: TT 300 → 1.9%\nTT 1000 → 2.3% · TT 2000 → 2.8%\n⇒ FT is a convex function of TT", shape=note, fillcolor="#f8bbd0", penwidth=1.6, fontsize=8];
        JENSEN    [label="⚑ Jensen's inequality\nE[FT(TT)] ≥ FT(E[TT])\nat the same mean TT a higher-amplitude regimen\ndelivers more time-averaged free T", shape=note, fillcolor="#f8bbd0", penwidth=1.6, fontsize=8];
        T_TOT -> T_FREE; T_TOT -> T_ALB; T_TOT -> T_SHBG;
        SHBG_P -> T_SHBG [penwidth=1.4]; ALB_P -> T_ALB;
        T_FREE -> T_BIO; T_ALB -> T_BIO;
        VERM -> T_FREE [style=dashed]; CONVEX -> JENSEN [style=dashed];
        T_SHBG -> CONVEX [style=dashed, label="saturation"];
    }
    ITT -> T_TOT [label="efflux to blood · production ~6 mg/day", penwidth=1.4];

    /* ===================== 6. SHBG REGULATION ===================== */
    subgraph cluster_shbg {
        label="⑥ SHBG regulation — disease, treatment and ageing push it opposite ways";
        style="rounded,filled"; fillcolor="#fdf2f6"; color="#d98cae"; fontsize=11; fontcolor="#8e2f5a";
        node [fillcolor="#fadbe8"];
        HNF4A     [label="Hepatocyte HNF-4α\nmaster regulator of the SHBG promoter"];
        SHBG_SYN  [label="Hepatic SHBG synthesis (SHBG gene 17p13)"];
        INS_SHBG  [label="Insulin / insulin resistance\n→ HNF-4α ↓ → SHBG ↓", fillcolor="#f7c6d9"];
        DNL_SHBG  [label="Hepatic de novo lipogenesis / monosaccharides\n→ SHBG ↓"];
        T4_SHBG   [label="Thyroid hormone (T3/T4)\n→ SHBG ↑"];
        E2_SHBG   [label="Oestrogen (E2)\n→ SHBG ↑"];
        AND_SHBG  [label="Androgen (T/DHT)\n→ SHBG ↓ (treatment effect)", fillcolor="#f7c6d9"];
        AGE_SHBG  [label="Ageing\n→ SHBG ↑ about 1%/yr", fillcolor="#f7c6d9"];
        CIRR_SHBG [label="Cirrhosis / alcohol\n→ SHBG ↑"];
        OPP       [label="⚑ Opposing shifts\ntreating obesity raises TT and lowers SHBG at once\n⇒ FT rises further than TT does", shape=note, fillcolor="#f8bbd0", penwidth=1.5, fontsize=8];
        HNF4A -> SHBG_SYN;
        INS_SHBG -> HNF4A [label="−", color="#c0392b"]; DNL_SHBG -> HNF4A [label="−", color="#c0392b"];
        T4_SHBG -> SHBG_SYN [label="+"]; E2_SHBG -> SHBG_SYN [label="+"];
        AND_SHBG -> SHBG_SYN [label="−", color="#c0392b"]; AGE_SHBG -> SHBG_SYN [label="+"];
        CIRR_SHBG -> SHBG_SYN [label="+"];
        INS_SHBG -> OPP [style=dashed]; AND_SHBG -> OPP [style=dashed];
    }
    SHBG_SYN -> SHBG_P [label="secretion", penwidth=1.3];

    /* ===================== 7. PERIPHERAL METABOLISM ===================== */
    subgraph cluster_metab {
        label="⑦ Peripheral metabolism — one hormone splits three ways";
        style="rounded,filled"; fillcolor="#f5f9f0"; color="#8fbc6b"; fontsize=11; fontcolor="#4a6b2a";
        node [fillcolor="#e3f0d5"];
        SRD5A1    [label="SRD5A1 (liver · skin)"];
        SRD5A2    [label="SRD5A2 (prostate · genitalia)\n→ finasteride/dutasteride target"];
        DHT_S     [label="DHT (5α-DHT)\nAR affinity ~2-5× that of T\ncannot be aromatised", fillcolor="#cfe4bb", penwidth=1.3];
        CYP19A1   [label="CYP19A1 (aromatase)\nadipose-dominant — proportional to fat mass", penwidth=1.3];
        E2_S      [label="Oestradiol (E2)\nmen 20-40 pg/mL\nessential for bone · fat · libido", fillcolor="#cfe4bb", penwidth=1.4];
        ARO_FAT   [label="Adipose tissue mass\n= aromatase capacity", fillcolor="#dbead0"];
        HSD3A     [label="3α-HSD → androstanediol\nglucuronide (marker of 5α activity)"];
        UGT2B17   [label="UGT2B17 glucuronidation\n(deletion polymorphism common in Asians)"];
        HEP_CL    [label="Hepatic clearance (CL)\nacts on the bioavailable fraction only\n⇒ SHBG↓ raises CL", shape=note, fillcolor="#eef7e4", fontsize=8];
        URINE_T   [label="Urinary T/E ratio\n(doping testing)"];
        SRD5A1 -> DHT_S; SRD5A2 -> DHT_S; DHT_S -> HSD3A -> UGT2B17 -> URINE_T;
        CYP19A1 -> E2_S; ARO_FAT -> CYP19A1 [label="+ capacity", penwidth=1.3];
    }
    T_FREE -> SRD5A1; T_FREE -> SRD5A2; T_FREE -> CYP19A1 [penwidth=1.2];
    T_BIO -> HEP_CL [label="clearance substrate"]; HEP_CL -> T_TOT [label="− elimination", color="#c0392b"];
    E2_S -> ERA_HYPO [label="principal feedback signal", penwidth=1.5, color="#c0392b"];
    E2_S -> E2_SHBG; DHT_S -> AND_SHBG; T_FREE -> AND_SHBG;
    T_FREE -> AR_HYPO; T_FREE -> AR_PIT;

    /* ===================== 8. RECEPTOR SIGNALLING ===================== */
    subgraph cluster_ar {
        label="⑧ Receptor signalling — AR / ER";
        style="rounded,filled"; fillcolor="#f5f9f0"; color="#8fbc6b"; fontsize=11; fontcolor="#4a6b2a";
        node [fillcolor="#e3f0d5"];
        AR        [label="Androgen receptor (AR, Xq12)"];
        CAG       [label="CAG repeat length (exon 1)\nshorter → higher transcriptional activity — varies between subjects"];
        HSP90     [label="HSP90 chaperone complex"];
        AR_NUC    [label="AR dimer nuclear translocation"];
        ARE       [label="ARE (androgen response element)\ntarget gene transcription"];
        COACT     [label="Coactivators (SRC-1/ARA70/p160)"];
        AR_NG     [label="Non-genomic AR signalling\nSrc/MAPK · seconds"];
        ESR1_P    [label="ERα (ESR1) — bone · fat · feedback"];
        ESR2_P    [label="ERβ (ESR2)"];
        GPER      [label="GPER1 (membrane ER)"];
        AIS       [label="AR mutation (partial androgen insensitivity)\ntarget-level resistance", shape=note, fillcolor="#eef7e4", fontsize=8];
        AR -> HSP90 -> AR_NUC -> ARE; CAG -> AR [label="modulates transcriptional activity"];
        COACT -> ARE; AR -> AR_NG; AIS -> AR [style=dashed, color="#c0392b"];
    }
    T_FREE -> AR [penwidth=1.4]; DHT_S -> AR [label="high affinity", penwidth=1.4];
    E2_S -> ESR1_P; E2_S -> ESR2_P; E2_S -> GPER;

    /* ===================== 9. PRIMARY (TESTICULAR) AETIOLOGY ===================== */
    subgraph cluster_prim {
        label="⑨ Primary (testicular) hypogonadism — LH/FSH ↑";
        style="rounded,filled"; fillcolor="#fbf1f1"; color="#d98080"; fontsize=11; fontcolor="#8e2323";
        node [fillcolor="#f7dcdc"];
        KLINE     [label="Klinefelter syndrome 47,XXY\n1 in 600 men · commonest genetic cause"];
        CRYPT     [label="Cryptorchidism"];
        ORCHITIS  [label="Mumps orchitis / trauma"];
        CHEMO     [label="Alkylating chemotherapy / radiation\nloss of Leydig and spermatogonial cells"];
        VARICO    [label="Varicocele"];
        AGE_TEST  [label="Age-related Leydig loss\nTT ~1%/yr · FT ~2-3%/yr"];
        MYOTONIC  [label="Myotonic dystrophy (DM1)"];
        HEMO_T    [label="Haemochromatosis — testicular iron deposition"];
        AR_MUT    [label="AR/LHCGR/HSD17B3 mutations"];
        PRIM_LAB  [label="Laboratory picture: TT ↓, LH ↑, FSH ↑\ninhibin B ↓", shape=note, fillcolor="#fdeaea", fontsize=8];
        KLINE -> PRIM_LAB; CRYPT -> PRIM_LAB; ORCHITIS -> PRIM_LAB; CHEMO -> PRIM_LAB;
        VARICO -> PRIM_LAB; AGE_TEST -> PRIM_LAB; MYOTONIC -> PRIM_LAB; HEMO_T -> PRIM_LAB;
    }
    KLINE -> LEYDIG_M [label="−−", color="#c0392b"]; CHEMO -> LEYDIG_M [label="−", color="#c0392b"];
    CHEMO -> SERTOLI [label="−−", color="#c0392b"]; AGE_TEST -> LEYDIG_M [label="−", color="#c0392b"];

    /* ===================== 10. SECONDARY (CENTRAL) AETIOLOGY ===================== */
    subgraph cluster_sec {
        label="⑩ Secondary (central) hypogonadism — LH/FSH normal or ↓";
        style="rounded,filled"; fillcolor="#fbf1f1"; color="#d98080"; fontsize=11; fontcolor="#8e2323";
        node [fillcolor="#f7dcdc"];
        KALL      [label="Kallmann syndrome\nANOS1/FGFR1/PROKR2/CHD7\nfailed GnRH neuron migration · anosmia"];
        IHH       [label="Normosmic idiopathic hypogonadotropic\nhypogonadism (nIHH)"];
        PITAD     [label="Pituitary adenoma / surgery / radiation"];
        PROLACT   [label="Hyperprolactinaemia (prolactinoma · drugs)"];
        HEMO_P    [label="Haemochromatosis — pituitary iron deposition"];
        TBI       [label="Traumatic brain injury / subarachnoid haemorrhage"];
        OPIOID    [label="Opioid-induced androgen deficiency\n(~50-75% of chronic users)", fillcolor="#f2c6c6"];
        GC_SUPP   [label="Glucocorticoids / Cushing's"];
        AAS_PRIOR [label="Past anabolic steroid abuse\n(ASIH — persistent suppression)", fillcolor="#f2c6c6"];
        SEC_LAB   [label="Laboratory picture: TT ↓, LH normal/↓, FSH normal/↓\n⇒ reversible · fertility can recover", shape=note, fillcolor="#fdeaea", fontsize=8];
        KALL -> SEC_LAB; IHH -> SEC_LAB; PITAD -> SEC_LAB; PROLACT -> SEC_LAB;
        HEMO_P -> SEC_LAB; TBI -> SEC_LAB; OPIOID -> SEC_LAB; GC_SUPP -> SEC_LAB; AAS_PRIOR -> SEC_LAB;
    }
    KALL -> GNRH_N [label="neurons absent", color="#c0392b"]; OPIOID -> OPIOID_R;
    GC_SUPP -> CRH_N; PROLACT -> PRL_S; PITAD -> GONADO [label="−", color="#c0392b"];
    AAS_PRIOR -> AR_HYPO [label="long-term suppression", color="#c0392b"];

    /* ===================== 11. FUNCTIONAL / OBESITY CYCLE ===================== */
    subgraph cluster_func {
        label="⑪ Functional hypogonadism — the self-reinforcing obesity · inflammation loop (reversible)";
        style="rounded,filled"; fillcolor="#fdf6e8"; color="#d9b45a"; fontsize=11; fontcolor="#8a6a10";
        node [fillcolor="#faeccc"];
        OBESITY   [label="Visceral obesity (BMI ≥30)\nlargest cause of functional hypogonadism", penwidth=1.4];
        AROM_UP   [label="Adipose aromatase activity ↑\n→ E2 ↑"];
        IR_FUNC   [label="Insulin resistance"];
        TNF_IL6   [label="TNF-α / IL-6 / adipose tissue macrophages\n→ direct KNDy inhibition"];
        LEP_RES   [label="Leptin resistance\n→ loss of kisspeptin drive"];
        OSA_F     [label="Obstructive sleep apnoea (OSA)\nsleep fragmentation → loss of nocturnal LH pulses"];
        SLEEP     [label="Sleep deprivation / shift work\nTT −10-15%"];
        T2DM_F    [label="Type 2 diabetes\nlow TT in ~30-40% of men"];
        VICIOUS   [label="⚑ Vicious cycle\nobesity → E2↑ · inflammation↑ → LH↓ → T↓\n→ lean mass↓ · fat↑ → obesity ↑", shape=note, fillcolor="#f9e0a0", penwidth=1.6, fontsize=8];
        WT_LOSS   [label="Weight loss / metabolic surgery\nTT +2-3 nmol/L per 10% lost", fillcolor="#d5efd0"];
        OBESITY -> AROM_UP -> VICIOUS; OBESITY -> IR_FUNC; OBESITY -> TNF_IL6; OBESITY -> LEP_RES;
        OBESITY -> OSA_F; OSA_F -> SLEEP; IR_FUNC -> T2DM_F; VICIOUS -> OBESITY [color="#c0392b"];
        WT_LOSS -> OBESITY [label="−", color="#1e8449", penwidth=1.4];
    }
    OBESITY -> ARO_FAT [penwidth=1.4]; IR_FUNC -> INS_SHBG [penwidth=1.3];
    TNF_IL6 -> KNDy [label="−", color="#c0392b"]; LEP_RES -> LEP_HYPO [label="−", color="#c0392b"];
    SLEEP -> GNRH_PULS [label="−", color="#c0392b"];

    /* ===================== 12. ERYTHROPOIESIS ===================== */
    subgraph cluster_ery {
        label="⑫ Erythropoiesis — mechanism of the commonest TRT adverse event (the second convexity)";
        style="rounded,filled"; fillcolor="#fbeff0"; color="#cc6677"; fontsize=11; fontcolor="#8e1f33";
        node [fillcolor="#f6d8dc"];
        HEPCIDIN  [label="Hepatic hepcidin (HAMP)\nT → suppression (BMP/SMAD · STAT3 pathways)", penwidth=1.3];
        FPN       [label="Ferroportin (SLC40A1)\nhepcidin ↓ → more retained at the membrane"];
        IRON_AV   [label="Transferrin-bound iron availability ↑\nferritin ↓ · TSAT ↑"];
        EPO_K     [label="Renal EPO\nT → upward shift of the oxygen set point"];
        ERFE      [label="Erythroferrone (ERFE)\nerythroblast-derived → further hepcidin suppression"];
        BFUE      [label="Erythroid progenitors (BFU-E/CFU-E)"];
        RETIC     [label="Reticulocytes (~1-2 days)"];
        RBC_M     [label="Red cell mass\nlifespan ~120 days — integrates the signal", penwidth=1.4];
        HCT       [label="Haematocrit (Hct)\nstopping rule >54%", fillcolor="#f2b8c0", penwidth=1.5];
        VISCOS    [label="Blood viscosity ↑\n(supralinear in Hct)"];
        PHLEB     [label="Therapeutic phlebotomy / dose reduction / change of formulation", fillcolor="#d5efd0"];
        CONVEX2   [label="⚑ The second convexity does not compose\nthe erythroid response is convex only in its lower limb\nand supraphysiologic peaks cross into Hill's concave upper limb\n⇒ model result: peak gain ≈ 0 or negative\n(the point that refuted the hypothesis — reported, not hidden)", shape=note, fillcolor="#f8bbd0", penwidth=1.6, fontsize=8];
        THRESH    [label="⚑ What manufactures the gap is the decision rule\napplying a fixed Hct>54% threshold to a population distribution\nturns a ~1-point mean shift into a ~2.5-fold difference in incidence\n⇒ a property of the stopping rule, not of the molecule", shape=note, fillcolor="#f8bbd0", penwidth=1.6, fontsize=8];
        HEPCIDIN -> FPN [label="− degradation", color="#c0392b"]; FPN -> IRON_AV;
        ERFE -> HEPCIDIN [label="−", color="#c0392b"];
        IRON_AV -> BFUE; EPO_K -> BFUE -> RETIC -> RBC_M -> HCT -> VISCOS;
        BFUE -> ERFE; PHLEB -> HCT [label="−", color="#1e8449"];
        CONVEX2 -> HEPCIDIN [style=dashed];
        HCT -> THRESH [style=dashed, penwidth=1.3];
    }
    T_FREE -> HEPCIDIN [label="− suppression", color="#c0392b", penwidth=1.4];
    T_FREE -> EPO_K [label="+ set point", penwidth=1.3];
    JENSEN -> CONVEX2 [style=dashed, label="does not compose", penwidth=1.3, color="#c0392b"];

    /* ===================== 13. BONE ===================== */
    subgraph cluster_bone {
        label="⑬ Bone — the effect runs mostly through E2, not T";
        style="rounded,filled"; fillcolor="#f3f2fb"; color="#8f8ad9"; fontsize=11; fontcolor="#3f3a8e";
        node [fillcolor="#dedcf7"];
        OSTEOB    [label="Osteoblasts / osteocytes"];
        OSTEOC    [label="Osteoclasts"];
        RANKL     [label="RANKL / OPG ratio"];
        SCLERO    [label="Sclerostin (SOST)"];
        CTX_P1NP  [label="Bone markers: CTX (resorption) · P1NP (formation)"];
        BMD_TRAB  [label="Lumbar spine trabecular vBMD (QCT)\nT-Trials: +7.5% (1 year)", fillcolor="#cbc8f2", penwidth=1.4];
        BMD_CORT  [label="Cortical bone density / thickness"];
        FX_RISK   [label="Clinical fracture risk\n⚠ TRAVERSE fracture substudy:\nincreased instead in the TRT arm (HR 1.43)", fillcolor="#f2b8c0", penwidth=1.5];
        FALLS     [label="Change in activity level and fall exposure\n(hypothesis for the BMD-fracture discordance)"];
        OSTEOB -> RANKL; RANKL -> OSTEOC [label="+"]; SCLERO -> OSTEOB [label="−", color="#c0392b"];
        OSTEOC -> CTX_P1NP; OSTEOB -> CTX_P1NP;
        OSTEOB -> BMD_TRAB; OSTEOC -> BMD_TRAB [label="−", color="#c0392b"];
        OSTEOB -> BMD_CORT; BMD_TRAB -> FX_RISK [label="−", color="#1e8449"];
        FALLS -> FX_RISK [label="+", color="#c0392b"];
    }
    E2_S -> SCLERO [label="− (dominant route)", color="#c0392b", penwidth=1.6];
    E2_S -> RANKL [label="−", color="#c0392b", penwidth=1.4];
    T_FREE -> OSTEOB [label="+ (secondary)", style=dashed];

    /* ===================== 14. MUSCLE & BODY COMPOSITION ===================== */
    subgraph cluster_body {
        label="⑭ Muscle · body composition — the most clearly dose-dependent endpoints";
        style="rounded,filled"; fillcolor="#f3f2fb"; color="#8f8ad9"; fontsize=11; fontcolor="#3f3a8e";
        node [fillcolor="#dedcf7"];
        SATELL    [label="Satellite cell recruitment · myonuclear accretion"];
        MYOSTAT   [label="Myostatin (MSTN) ↓"];
        IGF1_M    [label="Intramuscular IGF-1 / mTOR"];
        MPS       [label="Muscle protein synthesis rate ↑"];
        LEAN      [label="Lean body mass (kg)\ndose-dependent · +1.5-4 kg", fillcolor="#cbc8f2", penwidth=1.3];
        STRENGTH  [label="Muscle strength (leg press 1RM)"];
        FATMASS   [label="Fat mass / % body fat\n(rises instead when E2 is deficient)", fillcolor="#cbc8f2", penwidth=1.3];
        PREADIPO  [label="Preadipocyte differentiation inhibited\n(mesenchymal lineage switch)"];
        FINK      [label="⚑ Finkelstein dissociation (NEJM 2013)\nlean mass · strength = T-dependent\nbody fat = E2-dependent (rises under aromatase inhibition)\nsexual function = both", shape=note, fillcolor="#e8e6fa", penwidth=1.6, fontsize=8];
        SATELL -> MPS; MYOSTAT -> MPS [label="−", color="#c0392b"]; IGF1_M -> MPS -> LEAN -> STRENGTH;
        PREADIPO -> FATMASS [label="−", color="#1e8449"];
        FINK -> LEAN [style=dashed]; FINK -> FATMASS [style=dashed];
    }
    T_FREE -> SATELL [penwidth=1.3]; T_FREE -> MYOSTAT [label="−", color="#c0392b"];
    T_FREE -> PREADIPO; E2_S -> FATMASS [label="− (E2 deficiency → fat↑)", color="#1e8449", penwidth=1.4];
    FATMASS -> ARO_FAT [penwidth=1.2]; LEAN -> WT_LOSS [style=dashed];

    /* ===================== 15. CNS / SEXUAL / MOOD ===================== */
    subgraph cluster_cns {
        label="⑮ Central nervous system — libido · erection · mood · cognition";
        style="rounded,filled"; fillcolor="#eef7f7"; color="#5aa9a9"; fontsize=11; fontcolor="#1f6b6b";
        node [fillcolor="#d3ecec"];
        LIBIDO    [label="Sexual desire (libido)\ndepends on both T and E2 · continuous in dose", fillcolor="#b9e0e0", penwidth=1.3];
        MPOA      [label="Medial preoptic area (MPOA)\ndopamine · oxytocin"];
        NOS_CC    [label="Penile corpus cavernosum nNOS/eNOS\n→ cGMP"];
        PDE5      [label="PDE5 → cGMP breakdown\n(PDE5 inhibitor target)"];
        ERECT     [label="Erectile function (IIEF-EF)\nTRT alone has limited effect", fillcolor="#b9e0e0"];
        PDQ4      [label="PDQ-Q4 sexual activity score\nprimary T-Trials endpoint (+0.58)"];
        MOOD_D    [label="Mood / dysphoria\nPHQ-9 · mild improvement"];
        VITAL     [label="Vitality / fatigue (FACIT-F)\nT-Trials primary endpoint not met", fillcolor="#b9e0e0"];
        COGN      [label="Cognition (memory)\nT-Trials cognition substudy: no effect"];
        SLEEP_CNS [label="Sleep quality / possible worsening of OSA"];
        MPOA -> LIBIDO -> PDQ4; NOS_CC -> ERECT; PDE5 -> NOS_CC [label="−", color="#c0392b"];
        LIBIDO -> ERECT; MOOD_D -> VITAL;
    }
    T_FREE -> MPOA [penwidth=1.3]; E2_S -> MPOA [label="+ partial contribution", penwidth=1.2];
    T_FREE -> NOS_CC; T_FREE -> MOOD_D; T_FREE -> VITAL; T_FREE -> COGN;
    SLEEP_CNS -> OSA_F [style=dashed];

    /* ===================== 16. PROSTATE / LUTS ===================== */
    subgraph cluster_prost {
        label="⑯ Prostate — DHT-dependent · saturation model";
        style="rounded,filled"; fillcolor="#eef7f7"; color="#5aa9a9"; fontsize=11; fontcolor="#1f6b6b";
        node [fillcolor="#d3ecec"];
        PROST_EP  [label="Prostatic epithelium / stroma"];
        PSA       [label="Serum PSA\n+0.3-0.5 ng/mL in the first 6 months of TRT", fillcolor="#b9e0e0"];
        PROST_VOL [label="Prostate volume / IPSS (LUTS)"];
        SATUR     [label="Saturation model\nAR is saturated above ~TT 250 ng/dL, so\nthe prostate growth response flattens", shape=note, fillcolor="#e0f2f2", fontsize=8];
        PCA_RISK  [label="Prostate cancer detection\nno signal of increase in meta-analyses or TRAVERSE"];
        PROST_EP -> PSA; PROST_EP -> PROST_VOL; SATUR -> PROST_EP [style=dashed];
        PROST_EP -> PCA_RISK;
    }
    DHT_S -> PROST_EP [penwidth=1.4]; SRD5A2 -> PROST_EP;

    /* ===================== 17. CARDIOMETABOLIC & SAFETY ===================== */
    subgraph cluster_cv {
        label="⑰ Cardiovascular · safety — the landscape after TRAVERSE";
        style="rounded,filled"; fillcolor="#fbeff0"; color="#cc6677"; fontsize=11; fontcolor="#8e1f33";
        node [fillcolor="#f6d8dc"];
        HDL_D     [label="HDL-C ↓ (especially oral and high dose)"];
        LIPID     [label="Total cholesterol / LDL slightly ↓"];
        INS_SENS  [label="Insulin sensitivity / HbA1c slightly improved"];
        BP_T      [label="Blood pressure — raised on oral TU (boxed warning)"];
        AF_R      [label="Atrial fibrillation (TRAVERSE 3.5% vs 2.4%)", fillcolor="#f2b8c0"];
        VTE_R     [label="Pulmonary embolism / venous thrombosis (0.9% vs 0.5%)", fillcolor="#f2b8c0"];
        AKI_R     [label="Acute kidney injury (2.3% vs 1.5%)"];
        MACE      [label="MACE — TRAVERSE HR 0.96\nnon-inferiority met (95% CI 0.78-1.17)", penwidth=1.4];
        PLAQUE    [label="Non-calcified coronary plaque volume\nincreased in the T-Trials CV substudy"];
        GYNECO    [label="Gynaecomastia (when E2 rises)"];
        HDL_D -> MACE [style=dashed]; VISCOS -> VTE_R [penwidth=1.2]; VISCOS -> MACE [style=dashed];
        HCT -> AF_R [style=dashed]; PLAQUE -> MACE [style=dashed];
    }
    T_FREE -> HDL_D [label="−", color="#c0392b"]; T_FREE -> INS_SENS; E2_S -> GYNECO;
    LEAN -> INS_SENS [label="+", color="#1e8449"];

    /* ===================== 18. TESTOSTERONE FORMULATION PK ===================== */
    subgraph cluster_pk {
        label="⑱ Testosterone formulation PK — same weekly dose, different waveform";
        style="rounded,filled"; fillcolor="#eef0f4"; color="#8a93a8"; fontsize=11; fontcolor="#39415a";
        node [fillcolor="#dbe0e8"];
        TE_IM     [label="Testosterone enanthate/cypionate IM\n100-200 mg q1-2wk · ka ~0.15/day\npeak 1,100-1,500 → trough 300 ng/dL", penwidth=1.3];
        TU_IM     [label="Testosterone undecanoate IM (Nebido/Aveed)\n750-1,000 mg q10-12wk · very slow release\n⚠ pulmonary oil microembolism (POME)"];
        TU_PO     [label="Oral testosterone undecanoate\n(Jatenzo/Kyzatrex) 158-396 mg BID\nlymphatic uptake · fat-meal dependent · high peaks"];
        GEL_TD    [label="Transdermal gel 1.62% 20.25-81 mg/day\nnear steady state · small diurnal swing\n⚠ secondary transfer", penwidth=1.3];
        SC_AI     [label="Subcutaneous autoinjector (Xyosted)\n50-100 mg once weekly · gentle waveform", penwidth=1.2];
        PELLET    [label="Subcutaneous pellets (Testopel)\n6-12 pellets q3-6 months · near zero-order release"];
        NASAL_T   [label="Nasal gel (Natesto) 11 mg TID\nbrief peaks · minimal LH suppression"];
        ESTER_H   [label="Ester hydrolysis (plasma/tissue esterases)\nmolar conversion factor: cypionate 0.70\nenanthate 0.72 · undecanoate 0.63"];
        FLIPFLOP  [label="Absorption rate-limited (flip-flop) kinetics\napparent t½ = absorption t½", shape=note, fillcolor="#e8ebf0", fontsize=8];
        WAVEFORM  [label="⚑ Waveform: smaller than expected\ndoubling the amplitude at the same weekly dose\nchanges Hct by only ~0.1 points (model result)\nmost of the gap between formulations is a dose difference", shape=note, fillcolor="#f8bbd0", penwidth=1.6, fontsize=8];
        TE_IM -> ESTER_H; TU_IM -> ESTER_H; TU_PO -> ESTER_H; PELLET -> ESTER_H;
        TE_IM -> FLIPFLOP; TU_IM -> FLIPFLOP;
        TE_IM -> WAVEFORM; GEL_TD -> WAVEFORM; SC_AI -> WAVEFORM; TU_PO -> WAVEFORM;
    }
    ESTER_H -> T_TOT [penwidth=1.5]; GEL_TD -> T_TOT [penwidth=1.3]; NASAL_T -> T_TOT;
    WAVEFORM -> JENSEN [style=dashed, penwidth=1.3];

    /* ===================== 19. NON-ANDROGEN THERAPY ===================== */
    subgraph cluster_alt {
        label="⑲ Non-androgen strategies — raising T without switching the axis off (fertility preserved)";
        style="rounded,filled"; fillcolor="#eef0f4"; color="#8a93a8"; fontsize=11; fontcolor="#39415a";
        node [fillcolor="#dbe0e8"];
        HCG_D     [label="hCG 500-3,000 IU SC 2-3× weekly\nLHCGR agonist · t½ ~24-36 h", penwidth=1.3];
        HMG_FSH   [label="hMG / recombinant FSH 75-150 IU\n(Sertoli support — induces spermatogenesis)"];
        CLOMI     [label="Clomiphene citrate 25-50 mg\nSERM — blocks hypothalamic ERα → LH↑\nzuclomiphene accumulates (t½ of weeks)", penwidth=1.2];
        ENCLOMI   [label="Enclomiphene (trans isomer)\nless accumulation · sperm count preserved"];
        ANAST     [label="Anastrozole 1 mg/day\naromatase inhibition → E2↓ → LH↑\n⚠ at the cost of bone loss", penwidth=1.2];
        KISSPEP   [label="Kisspeptin-54 analogues (investigational)\nrestarting the axis from upstream"];
        GNRH_PUMP [label="Pulsatile GnRH pump\n(Kallmann/nIHH — physiological reproduction)"];
        SARM      [label="Selective AR modulators (SARMs, unapproved)\nclaimed tissue selectivity · hepatotoxicity signal"];
        FERT_NOTE [label="⚑ Two different problems\nnormalising serum T ≠ maintaining ITT.\nIf fertility is the goal, the LH signal must not be switched off.", shape=note, fillcolor="#f8bbd0", penwidth=1.6, fontsize=8];
        HCG_D -> FERT_NOTE [style=dashed]; CLOMI -> ENCLOMI [style=dotted];
    }
    HCG_D -> LHCGR [label="direct action (bypasses LH)", penwidth=1.5, color="#1e8449"];
    HMG_FSH -> FSHR [label="+", color="#1e8449", penwidth=1.2];
    CLOMI -> ERA_HYPO [label="− blockade → LH↑", color="#1e8449", penwidth=1.3];
    ENCLOMI -> ERA_HYPO [label="− blockade", color="#1e8449"];
    ANAST -> CYP19A1 [label="− inhibition", color="#c0392b", penwidth=1.3];
    KISSPEP -> KISS1R [color="#1e8449"]; GNRH_PUMP -> GNRHR [color="#1e8449"];
    SARM -> AR [label="partial agonist"];
    ANAST -> SCLERO [label="E2↓ → sclerostin↑ → bone loss", style=dashed, color="#c0392b"];

    /* ===================== 20. AXIS SUPPRESSION BY EXOGENOUS T ===================== */
    subgraph cluster_supp {
        label="⑳ Axis shutdown by exogenous androgen — the pathophysiology treatment creates";
        style="rounded,filled"; fillcolor="#fdf6e8"; color="#d9b45a"; fontsize=11; fontcolor="#8a6a10";
        node [fillcolor="#faeccc"];
        SUPP_LH   [label="LH suppression (below assay limit within days)"];
        SUPP_FSH  [label="FSH suppression"];
        ITT_CRASH [label="ITT collapse — ~2-6% of normal\n(−94% on TE 200 mg once weekly)", fillcolor="#f2c6c6", penwidth=1.5];
        AZOO      [label="Azoospermia/oligospermia\nafter 3-6 months of exposure"];
        TEST_ATR  [label="Testicular volume reduction (20-30% of baseline)"];
        RECOVERY  [label="Recovery after discontinuation\nLiu 2006 pooled analysis: reaching 20 M/mL\n6 months 67% · 12 months 90% · 24 months 100%", fillcolor="#d5efd0"];
        HCG_RESCUE[label="Concomitant hCG rescue (250-500 IU EOD)\nkeeps ITT near baseline", fillcolor="#d5efd0", penwidth=1.3];
        RESTART   [label="Recovery protocol\nhCG ± SERM ± FSH"];
        SUPP_LH -> ITT_CRASH [penwidth=1.4, color="#c0392b"]; SUPP_FSH -> AZOO;
        ITT_CRASH -> AZOO [penwidth=1.4, color="#c0392b"]; ITT_CRASH -> TEST_ATR;
        AZOO -> RECOVERY; RECOVERY -> RESTART [style=dashed];
        HCG_RESCUE -> ITT_CRASH [label="− prevents", color="#1e8449", penwidth=1.4];
    }
    T_FREE -> SUPP_LH [label="negative feedback", penwidth=1.5, color="#c0392b"];
    E2_S -> SUPP_LH [label="potent (via aromatase)", penwidth=1.4, color="#c0392b"];
    SUPP_LH -> LH_S [style=dashed, color="#c0392b"]; SUPP_FSH -> FSH_S [style=dashed, color="#c0392b"];
    ITT_CRASH -> ITT [style=dashed, color="#c0392b"]; HCG_D -> HCG_RESCUE;
    AZOO -> SPERM_OUT [style=dashed, color="#c0392b"];

    /* ===================== 21. DIAGNOSIS & MONITORING ===================== */
    subgraph cluster_dx {
        label="㉑ Diagnosis · monitoring — the problem that the threshold depends on SHBG";
        style="rounded,filled"; fillcolor="#f7f7f2"; color="#a8a88a"; fontsize=11; fontcolor="#5a5a39";
        node [fillcolor="#e9e9d9"];
        MORNING   [label="Morning (07:00-10:00) fasting TT\nconfirmed twice on separate days"];
        LCMS      [label="LC-MS/MS reference method\n(immunoassay is inaccurate at low concentrations)"];
        CUTOFF    [label="Diagnostic threshold TT <300 ng/dL (10.4 nmol/L)\nCDC harmonisation standard"];
        FT_CUT    [label="Free T threshold <65 pg/mL\n(equilibrium dialysis or Vermeulen calculation)"];
        MISCLASS  [label="⚑ Misclassification\nlow SHBG: TT is low but FT is normal\nhigh SHBG: TT is normal but FT is low\n⇒ a single TT threshold is wrong in both directions", shape=note, fillcolor="#f8bbd0", penwidth=1.6, fontsize=8];
        SYMPT     [label="Symptom confirmation essential\n(low libido · loss of morning erections · gynaecomastia)"];
        MONITOR   [label="Monitoring: 3 · 6 · 12 months, then annually\nTT · Hct · PSA · symptoms"];
        STOPRULE  [label="Stop/dose-reduction rules\nHct >54% · PSA velocity · unresolved LUTS", fillcolor="#f2dede"];
        MORNING -> LCMS -> CUTOFF; CUTOFF -> MISCLASS [style=dashed]; FT_CUT -> MISCLASS [style=dashed];
        SYMPT -> CUTOFF; MONITOR -> STOPRULE;
    }
    SHBG_P -> MISCLASS [penwidth=1.5, color="#8e2f5a"];
    T_TOT -> MORNING; T_FREE -> FT_CUT; HCT -> STOPRULE [penwidth=1.3]; PSA -> STOPRULE;

    /* ===================== 22. CLINICAL ENDPOINTS ===================== */
    subgraph cluster_end {
        label="㉒ Clinical endpoints and key trials (model calibration targets)";
        style="rounded,filled"; fillcolor="#f7f7f2"; color="#a8a88a"; fontsize=11; fontcolor="#5a5a39";
        node [fillcolor="#e9e9d9"];
        TTRIAL_S  [label="T-Trials sexual function (NEJM 2016)\nPDQ-Q4 +0.58 vs +0.10"];
        TTRIAL_B  [label="T-Trials bone (JAMA IM 2017)\nlumbar spine trabecular vBMD +7.5%"];
        TTRIAL_A  [label="T-Trials anaemia (JAMA IM 2017)\nunexplained anaemia corrected 54% vs 15%"];
        TTRIAL_V  [label="T-Trials vitality/walking: primary endpoint not met"];
        TRAVERSE  [label="TRAVERSE (NEJM 2023) n=5,246\nMACE HR 0.96 — non-inferior", penwidth=1.4];
        TRAV_FX   [label="TRAVERSE fractures (NEJM 2024)\n3.50% vs 2.46% · HR 1.43", penwidth=1.3];
        FINK_T    [label="Finkelstein (NEJM 2013)\ndissociation of the T vs E2 contributions"];
        LIU_REC   [label="Liu 2006 (Lancet) pooled recovery analysis"];
        HCT_INC   [label="Erythrocytosis incidence\nIM ~35-40% vs gel ~10-15%"];
        QOL       [label="Patient-reported outcomes (PRO)\nlibido · vitality · mood"];
        TTRIAL_S -> QOL; TTRIAL_V -> QOL;
    }
    PDQ4 -> TTRIAL_S; BMD_TRAB -> TTRIAL_B; HCT -> TTRIAL_A [style=dashed];
    VITAL -> TTRIAL_V; MACE -> TRAVERSE; FX_RISK -> TRAV_FX;
    FINK -> FINK_T; RECOVERY -> LIU_REC; HCT -> HCT_INC [penwidth=1.3];
    WAVEFORM -> HCT_INC [style=dashed, label="what the formulation gap has to explain", penwidth=1.2];

    /* ===================== CROSS-CUTTING LEGEND ===================== */
    subgraph cluster_legend {
        label="Legend";
        style="rounded,filled"; fillcolor="#ffffff"; color="#999999"; fontsize=10; fontcolor="#444444";
        node [shape=plaintext, fillcolor="#ffffff", fontsize=8];
        LEG1 [label="Black arrow = activation/flow   Red arrow = inhibition   Green arrow = therapeutic intervention"];
        LEG2 [label="⚑ marked = the quantitative core claim of this model (computed by the analysis functions of the mrgsolve model)"];
        LEG3 [label="Pink notes = convexity · Jensen · misclassification — one connected argument"];
        LEG1 -> LEG2 [style=invis]; LEG2 -> LEG3 [style=invis];
    }
}
